<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.ViewModels"
             xmlns:models="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.Models"
             xmlns:converters="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.Converters"
             x:Class="MonitoringAndEvaluationPlatform.Mobile.Views.FrameworkPerformancePage"
             x:DataType="vm:FrameworkPerformanceViewModel"
             Title="Framework Performance"
             BackgroundColor="{StaticResource LightBackground}">

    <ContentPage.Resources>
        <converters:PerformanceToColorConverter x:Key="PerformanceToColor" />
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding LoadDataCommand}">
        <Grid RowDefinitions="Auto,*">

            <!-- Ministry Filter -->
            <Frame Grid.Row="0" Style="{StaticResource CardStyle}" Margin="8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Filter by Ministry" FontSize="14" FontAttributes="Bold" />
                    <Picker Title="All Ministries"
                            ItemsSource="{Binding Ministries}"
                            SelectedItem="{Binding SelectedMinistry}"
                            ItemDisplayBinding="{Binding Name}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Frameworks List -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding Frameworks}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FrameworkPerformance">
                        <Frame Style="{StaticResource CardStyle}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />

                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <ProgressBar Progress="{Binding IndicatorsPerformance, Converter={StaticResource PerformanceToProgress}}"
                                                 ProgressColor="{Binding IndicatorsPerformance, Converter={StaticResource PerformanceToColor}}"
                                                 HeightRequest="10" />
                                    <Label Grid.Column="1"
                                           Text="{Binding IndicatorsPerformance, StringFormat='{0:F1}%'}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{Binding IndicatorsPerformance, Converter={StaticResource PerformanceToColor}}"
                                           Margin="8,0,0,0" />
                                </Grid>

                                <Label Text="{Binding IndicatorCount, StringFormat='{0} Indicators'}"
                                       FontSize="12" TextColor="{StaticResource TextSecondary}" />

                                <!-- Projects sub-list -->
                                <CollectionView ItemsSource="{Binding Projects}"
                                                IsVisible="{Binding Projects.Count, Converter={StaticResource IsNotZeroConverter}}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProjectPerformance">
                                            <Grid ColumnDefinitions="*,Auto" Padding="8,4">
                                                <Label Text="{Binding ProjectName}" FontSize="12"
                                                       TextColor="{StaticResource TextSecondary}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Performance, StringFormat='{0:F1}%'}"
                                                       FontSize="12"
                                                       TextColor="{Binding Performance, Converter={StaticResource PerformanceToColor}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator Grid.RowSpan="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </RefreshView>
</ContentPage>
