<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.ViewModels"
             xmlns:converters="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.Converters"
             x:Class="MonitoringAndEvaluationPlatform.Mobile.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard"
             BackgroundColor="{StaticResource LightBackground}">

    <ContentPage.Resources>
        <converters:PerformanceToColorConverter x:Key="PerformanceToColor" />
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding LoadDataCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="8" Padding="8">

                <!-- Summary Cards -->
                <Label Text="Dashboard" Style="{StaticResource PageTitle}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="8" RowSpacing="8" Padding="8,0">

                    <Frame Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Summary.TotalFrameworks}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Frameworks" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Summary.TotalOutcomes}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Outcomes" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Summary.TotalOutputs}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Outputs" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Summary.TotalIndicators}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Indicators" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Summary.TotalProjects}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Projects" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Summary.TotalGovernorates}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Governorates" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="3" Grid.Column="0" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Summary.TotalMinistries}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Ministries" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="3" Grid.Column="1" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Summary.TotalSubOutputs}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Sub Outputs" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Framework Performance -->
                <Label Text="Framework Performance" FontSize="18" FontAttributes="Bold"
                       Margin="16,16,16,4" TextColor="{StaticResource TextPrimary}" />

                <CollectionView ItemsSource="{Binding Frameworks}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:FrameworkPerformance"
                                      xmlns:models="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.Models">
                            <Frame Style="{StaticResource CardStyle}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <ProgressBar Progress="{Binding IndicatorsPerformance, Converter={StaticResource PerformanceToProgress}}"
                                                     ProgressColor="{Binding IndicatorsPerformance, Converter={StaticResource PerformanceToColor}}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding IndicatorsPerformance, StringFormat='{0:F1}%'}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{Binding IndicatorsPerformance, Converter={StaticResource PerformanceToColor}}"
                                               Margin="8,0,0,0" />
                                    </Grid>
                                    <Label Text="{Binding IndicatorCount, StringFormat='{0} Indicators'}"
                                           FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Loading -->
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
