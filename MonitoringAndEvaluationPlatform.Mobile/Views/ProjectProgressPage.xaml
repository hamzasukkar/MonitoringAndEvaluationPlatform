<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.ViewModels"
             xmlns:models="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.Models"
             xmlns:converters="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.Converters"
             x:Class="MonitoringAndEvaluationPlatform.Mobile.Views.ProjectProgressPage"
             x:DataType="vm:ProjectProgressViewModel"
             Title="Project Progress"
             BackgroundColor="{StaticResource LightBackground}">

    <ContentPage.Resources>
        <converters:PerformanceToColorConverter x:Key="PerformanceToColor" />
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding LoadDataCommand}">
        <CollectionView ItemsSource="{Binding Projects}">
            <CollectionView.Header>
                <Label Text="Project Progress" Style="{StaticResource PageTitle}" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ProjectProgress">
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding ProjectName}" FontSize="14" FontAttributes="Bold" />

                            <Grid ColumnDefinitions="*,Auto">
                                <ProgressBar Progress="{Binding CompletionRate, Converter={StaticResource PerformanceToProgress}}"
                                             ProgressColor="{Binding CompletionRate, Converter={StaticResource PerformanceToColor}}"
                                             HeightRequest="8" />
                                <Label Grid.Column="1"
                                       Text="{Binding CompletionRate, StringFormat='{0:F1}%'}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{Binding CompletionRate, Converter={StaticResource PerformanceToColor}}"
                                       Margin="8,0,0,0" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*">
                                <VerticalStackLayout>
                                    <Label Text="{Binding TotalIndicators}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="Indicators" FontSize="10" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding TotalTarget, StringFormat='{0:F0}'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="Target" FontSize="10" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="{Binding TotalAchieved, StringFormat='{0:F0}'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="Achieved" FontSize="10" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No project data available" HorizontalOptions="Center" Margin="20"
                       TextColor="{StaticResource TextSecondary}" />
            </CollectionView.EmptyView>
        </CollectionView>
    </RefreshView>
</ContentPage>
