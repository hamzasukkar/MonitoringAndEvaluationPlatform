<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.ViewModels"
             xmlns:models="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.Models"
             xmlns:converters="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.Converters"
             x:Class="MonitoringAndEvaluationPlatform.Mobile.Views.ReportsPage"
             x:DataType="vm:ReportsViewModel"
             Title="Reports"
             BackgroundColor="{StaticResource LightBackground}">

    <ContentPage.Resources>
        <converters:PerformanceToColorConverter x:Key="PerformanceToColor" />
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding LoadDataCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="8" Padding="8">

                <Label Text="Reports" Style="{StaticResource PageTitle}" />

                <!-- Summary Stats -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Summary" FontSize="16" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <Label Text="{Binding Summary.TotalFrameworks, StringFormat='Frameworks: {0}'}" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding Summary.TotalOutcomes, StringFormat='Outcomes: {0}'}" FontSize="13" />
                            <Label Grid.Row="1" Text="{Binding Summary.TotalOutputs, StringFormat='Outputs: {0}'}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Summary.TotalIndicators, StringFormat='Indicators: {0}'}" FontSize="13" />
                            <Label Grid.Row="2" Text="{Binding Summary.TotalProjects, StringFormat='Projects: {0}'}" FontSize="13" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Summary.AverageIndicatorsPerformance, StringFormat='Avg Performance: {0:F1}%'}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Performance Distribution -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Performance Distribution" FontSize="16" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*,*">
                            <Frame BackgroundColor="{StaticResource SuccessGreen}" CornerRadius="8" Padding="12" Margin="4,0" HasShadow="False">
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label Text="{Binding Distribution.HighPerformanceCount}" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                    <Label Text="High" FontSize="11" TextColor="White" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1" BackgroundColor="{StaticResource WarningOrange}" CornerRadius="8" Padding="12" Margin="4,0" HasShadow="False">
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label Text="{Binding Distribution.MediumPerformanceCount}" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                    <Label Text="Medium" FontSize="11" TextColor="White" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="2" BackgroundColor="{StaticResource DangerRed}" CornerRadius="8" Padding="12" Margin="4,0" HasShadow="False">
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label Text="{Binding Distribution.LowPerformanceCount}" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                    <Label Text="Low" FontSize="11" TextColor="White" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Budget Overview -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Budget Overview" FontSize="16" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" RowSpacing="4">
                            <VerticalStackLayout>
                                <Label Text="{Binding BudgetOverview.TotalEstimatedBudget, StringFormat='${0:N0}'}"
                                       FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Text="Estimated" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding BudgetOverview.TotalRealBudget, StringFormat='${0:N0}'}"
                                       FontSize="18" FontAttributes="Bold" TextColor="{StaticResource SuccessGreen}" />
                                <Label Text="Actual" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Top Performers -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Top Performing Frameworks" FontSize="16" FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding TopPerformers.TopFrameworks}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PerformanceItem">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                        <Label Text="{Binding Name}" FontSize="13" />
                                        <Label Grid.Column="1"
                                               Text="{Binding IndicatorsPerformance, StringFormat='{0:F1}%'}"
                                               FontSize="13" FontAttributes="Bold"
                                               TextColor="{Binding IndicatorsPerformance, Converter={StaticResource PerformanceToColor}}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Bottom Performers -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Bottom Performing Frameworks" FontSize="16" FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding BottomPerformers.BottomFrameworks}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PerformanceItem">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                        <Label Text="{Binding Name}" FontSize="13" />
                                        <Label Grid.Column="1"
                                               Text="{Binding IndicatorsPerformance, StringFormat='{0:F1}%'}"
                                               FontSize="13" FontAttributes="Bold"
                                               TextColor="{Binding IndicatorsPerformance, Converter={StaticResource PerformanceToColor}}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Loading -->
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
