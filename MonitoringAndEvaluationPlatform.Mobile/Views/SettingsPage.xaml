<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.ViewModels"
             x:Class="MonitoringAndEvaluationPlatform.Mobile.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{StaticResource LightBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <Label Text="Settings" Style="{StaticResource PageTitle}" />

            <!-- Server URL -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Server URL" FontSize="14" FontAttributes="Bold" />
                    <Entry Text="{Binding ServerUrl}" Placeholder="https://server-address:port"
                           Keyboard="Url" ClearButtonVisibility="WhileEditing" />
                </VerticalStackLayout>
            </Frame>

            <!-- Language -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Language" FontSize="14" FontAttributes="Bold" />
                    <Picker Title="Select Language"
                            ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Save Button -->
            <Button Text="Save Settings"
                    Command="{Binding SaveSettingsCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="8" />

            <!-- Logout Button -->
            <Button Text="Logout"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource DangerRed}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="8" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
