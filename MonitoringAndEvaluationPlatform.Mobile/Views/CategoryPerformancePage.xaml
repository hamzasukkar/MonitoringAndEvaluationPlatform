<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.ViewModels"
             xmlns:models="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.Models"
             xmlns:converters="clr-namespace:MonitoringAndEvaluationPlatform.Mobile.Converters"
             x:Class="MonitoringAndEvaluationPlatform.Mobile.Views.CategoryPerformancePage"
             x:DataType="vm:CategoryPerformanceViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource LightBackground}">

    <ContentPage.Resources>
        <converters:PerformanceToColorConverter x:Key="PerformanceToColor" />
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding LoadDataCommand}">
        <CollectionView ItemsSource="{Binding Items}">
            <CollectionView.Header>
                <Label Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CategoryReport">
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" />

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <VerticalStackLayout>
                                    <Label Text="{Binding ProjectCount, StringFormat='{0}'}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Projects" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding TotalBudget, StringFormat='${0:N0}'}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Budget" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1">
                                    <Label Text="{Binding IndicatorsPerformance, StringFormat='{0:F1}%'}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{Binding IndicatorsPerformance, Converter={StaticResource PerformanceToColor}}" />
                                    <Label Text="Indicators" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                    <Label Text="{Binding DisbursementPerformance, StringFormat='{0:F1}%'}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{Binding DisbursementPerformance, Converter={StaticResource PerformanceToColor}}" />
                                    <Label Text="Disbursement" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="2">
                                    <Label Text="{Binding FieldMonitoring, StringFormat='{0:F1}%'}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{Binding FieldMonitoring, Converter={StaticResource PerformanceToColor}}" />
                                    <Label Text="Field Monitoring" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                                    <Label Text="{Binding ImpactAssessment, StringFormat='{0:F1}%'}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{Binding ImpactAssessment, Converter={StaticResource PerformanceToColor}}" />
                                    <Label Text="Impact Assessment" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No data available" HorizontalOptions="Center" Margin="20"
                       TextColor="{StaticResource TextSecondary}" />
            </CollectionView.EmptyView>
        </CollectionView>
    </RefreshView>
</ContentPage>
