            background-color: rgba(40, 167, 69, 0.1);
        }

        /* Search Results Styling */
        .search-results-container {
            padding: 1rem;
        }

        .framework-search-result {
            border: 1px solid #e0e0e0;
            border-radius: 10px;
            overflow: hidden;
            background: white;
        }

        .result-header {
            padding: 1rem 1.25rem;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .result-header:hover {
            background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
        }

        .result-header .toggle-icon {
            transition: transform 0.3s ease;
            color: var(--primary-color);
        }

        .result-header[aria-expanded="false"] .toggle-icon {
            transform: rotate(-90deg);
        }

        .matches-list {
            padding: 0.5rem;
        }

        .match-item {
            margin-bottom: 0.5rem;
        }

        .match-link {
            display: flex;
            align-items: center;
            padding: 1rem;
            border-radius: 8px;
            background: white;
            border: 1px solid #e0e0e0;
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }

        .match-link:hover {
            border-color: var(--primary-color);
            box-shadow: 0 4px 12px rgba(33, 150, 243, 0.15);
            transform: translateX(5px);
        }

        [dir="rtl"] .match-link:hover {
            transform: translateX(-5px);
        }

        .match-icon {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            font-size: 1.2rem;
            margin-right: 1rem;
            flex-shrink: 0;
        }

        [dir="rtl"] .match-icon {
            margin-right: 0;
            margin-left: 1rem;
        }

        .match-icon.framework { background: rgba(33, 150, 243, 0.1); color: #2196F3; }
        .match-icon.outcome { background: rgba(76, 175, 80, 0.1); color: #4CAF50; }
        .match-icon.output { background: rgba(255, 152, 0, 0.1); color: #FF9800; }
        .match-icon.suboutput { background: rgba(156, 39, 176, 0.1); color: #9C27B0; }
        .match-icon.indicator { background: rgba(233, 30, 99, 0.1); color: #E91E63; }
        .match-icon.project { background: rgba(0, 188, 212, 0.1); color: #00BCD4; }

        .match-content {
            flex: 1;
        }

        .match-type-badge {
            margin-bottom: 0.25rem;
        }

        .match-name {
            font-weight: 600;
            font-size: 1.05rem;
            color: #333;
            margin-bottom: 0.25rem;
        }

        .match-path {
            font-size: 0.85rem;
            color: #6c757d;
        }

        .match-action {
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary-color);
            color: white;
            border-radius: 50%;
            font-size: 0.9rem;
            margin-left: 1rem;
            flex-shrink: 0;
        }

        [dir="rtl"] .match-action {
            margin-left: 0;
            margin-right: 1rem;
            transform: rotate(180deg);
        }

        .badge.match-framework { background-color: #2196F3; }
        .badge.match-outcome { background-color: #4CAF50; }
        .badge.match-output { background-color: #FF9800; }
        .badge.match-suboutput { background-color: #9C27B0; }
        .badge.match-indicator { background-color: #E91E63; }
        .badge.match-project { background-color: #00BCD4; }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .col-lg-3 {
                order: 2;
            }
            
            .col-lg-9 {
                order: 1;
            }
            
            .framework-name-cell {
                min-width: auto;
            }
            
            .performance-metric {
                min-width: auto;
            }
            
            .action-buttons {
                flex-direction: column;
                gap: 3px;
            }
            
            .table-header th {
                padding: 15px 10px;
                font-size: 0.85rem;
            }
            
            .table-row td {
                padding: 15px 10px;
            }
        }
        
        @@media (max-width: 576px) {
            .header-link {
                flex-direction: column;
                text-align: center;
            }

            .header-link i:first-child {
                margin-bottom: 5px;
                margin-right: 0 !important;
            }
        }

        /* Fix for Expand/Collapse All buttons hover */
        #expandAllBtn:hover,
        #collapseAllBtn:hover {
            background-color: rgba(33, 150, 243, 0.1);
            color: var(--primary-color) !important;
            border-color: var(--primary-color);
        }

        #expandAllBtn:active,
        #collapseAllBtn:active {
            background-color: rgba(33, 150, 243, 0.2);
            color: var(--primary-dark) !important;
            border-color: var(--primary-dark);
        }
    </style>
}

