@model MonitoringAndEvaluationPlatform.ViewModel.FrameworkFilterViewModel

@using MonitoringAndEvaluationPlatform.Helpers
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "Results Frameworks";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    ViewData["HelpFeature"] = "FRAMEWORKS";
    var culture = Context.Features.Get<IRequestCultureFeature>().RequestCulture.Culture.Name;
    var isArabic = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var userMinistryCode = ViewBag.UserMinistryCode as int?;
    var isAdminUser = User.IsInRole(UserRoles.SystemAdministrator);

    string MinistryName(Ministry ministry) =>
        isArabic ? ministry.MinistryDisplayName_AR : ministry.MinistryDisplayName_EN;

    string GetMatchColorClass(string type)
    {
        return type.ToLower() switch
        {
            "framework" => "framework",
            "outcome" => "outcome",
            "output" => "output",
            "suboutput" => "suboutput",
            "indicator" => "indicator",
            "project" => "project",
            _ => "framework"
        };
    }

    string GetMatchBadgeClass(string type)
    {
        return type.ToLower() switch
        {
            "framework" => "match-framework",
            "outcome" => "match-outcome",
            "output" => "match-output",
            "suboutput" => "match-suboutput",
            "indicator" => "match-indicator",
            "project" => "match-project",
            _ => "match-framework"
        };
    }
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="dashboard-title">
                <i class="fas fa-sitemap me-3"></i>
                @Localizer["Results Frameworks"]
            </h1>
            <p class="dashboard-subtitle">
                @Localizer["Comprehensive overview of monitoring frameworks and their performance metrics"]
            </p>
        </div>
        <div class="d-flex gap-2">
            @await Html.PartialAsync("_HelpButton")
            @if (SignInManager.IsSignedIn(User))
            {
                var user = await UserManager.GetUserAsync(User);
                if (user != null)
                {
                    var roles = await UserManager.GetRolesAsync(user);
                    if (roles.Contains("SystemAdministrator") || roles.Contains("MinistryStrategyManager"))
                    {
                        <button onclick="toggleInlineCreate()" class="btn btn-primary btn-lg shadow-sm" id="createFrameworkBtn">
                            <i class="fas fa-plus me-2"></i>@Localizer["Quick Create"]
                        </button>
                    }
                }
            }
        </div>
    </div>
</div>

<!-- Inline Create Framework Form -->
<div id="inlineCreateForm" class="inline-create-container d-none">
    <div class="chart-card inline-create-card">
        <div class="inline-create-header">
            <div class="create-form-title">
                <i class="fas fa-magic me-2"></i>
                <span>@Localizer["Create New Framework"]</span>
            </div>
            <button type="button" class="btn-close-custom" onclick="toggleInlineCreate()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form id="createFrameworkForm" class="inline-create-form">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-5">
                    <div class="form-floating">
                        <input type="text" class="form-control form-control-modern" id="frameworkName"
                               placeholder="@Localizer["Enter framework name"]" required>
                        <label for="frameworkName">
                            <i class="fas fa-sitemap me-2"></i>@Localizer["Framework Name"]
                        </label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        @* Ministry users are locked onto their own ministry; the server enforces
                           this too, so a tampered value is ignored rather than trusted. *@
                        <select class="form-select form-control-modern" id="frameworkMinistry" required
                                @(Model.IsMinistryUser ? "disabled" : "")>
                            <option value="">@Localizer["Select Ministry"]</option>
                            @foreach (var ministry in Model.Ministries)
                            {
                                var selected = userMinistryCode == ministry.Code;
                                <option value="@ministry.Code" selected="@selected">
                                    @(string.IsNullOrEmpty(ministry.Logo) ? "" : ministry.Logo + " ")@MinistryName(ministry)
                                </option>
                            }
                        </select>
                        <label for="frameworkMinistry">
                            <i class="fas fa-landmark me-2"></i>@Localizer["Ministry"]
                        </label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="d-flex gap-2 h-100">
                        <button type="submit" class="btn btn-success btn-modern flex-fill">
                            <div class="btn-content">
                                <i class="fas fa-check me-2"></i>
                                <span>@Localizer["Create"]</span>
                                <div class="btn-spinner d-none">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </div>
                            </div>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-modern" onclick="toggleInlineCreate()">
                            <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                        </button>
                    </div>
                </div>
            </div>
        </form>

        <div class="create-form-progress">
            <div class="progress-bar-create"></div>
        </div>
    </div>
</div>

<!-- Search Form -->
<div class="chart-card mb-4">
    <div class="chart-title">
        <i class="fas fa-search"></i>
        @Localizer["Search & Filter Frameworks"]
    </div>
    <form asp-action="Index" method="get" class="row g-3 align-items-center" id="frameworkSearchForm">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="searchString" id="frameworkSearchInput" class="form-control form-control-lg"
                       placeholder="@Localizer["Search frameworks, outcomes, outputs, suboutputs, indicators, and projects"]"
                       value="@ViewData["CurrentFilter"]" />
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-search me-2"></i>@Localizer["Search"]
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-sync-alt me-2"></i>@Localizer["Reset"]
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Search Results Section -->
@if (ViewBag.HasSearchResults == true && ViewBag.SearchResults != null)
{
    var searchResults = (List<MonitoringAndEvaluationPlatform.ViewModel.FrameworkSearchResultViewModel>)ViewBag.SearchResults;
    var totalMatches = searchResults.Sum(r => r.TotalMatches);

    <div class="chart-card mb-4">
        <div class="chart-title d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-search me-2"></i>
                @Localizer["Search Results"] - <span class="badge bg-primary">@totalMatches @Localizer["matches found"]</span>
            </div>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-sm btn-outline-primary" id="expandAllBtn">
                    <i class="fas fa-expand-alt me-1"></i>@Localizer["Expand All"]
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary" id="collapseAllBtn">
                    <i class="fas fa-compress-alt me-1"></i>@Localizer["Collapse All"]
                </button>
            </div>
        </div>
        <div class="search-results-container">
            @foreach (var result in searchResults)
            {
                <div class="framework-search-result mb-3">
                    <div class="result-header" data-bs-toggle="collapse" data-bs-target="#matches-@result.Framework.Code">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-sitemap text-primary me-2"></i>
                                <strong>@result.Framework.Name</strong>
                                <span class="badge bg-success ms-2">@result.TotalMatches @Localizer["matches"]</span>
                            </div>
                            <i class="fas fa-chevron-down toggle-icon"></i>
                        </div>
                    </div>

                    <div id="matches-@result.Framework.Code" class="collapse show">
                        <div class="matches-list">
                            @foreach (var match in result.Matches)
                            {
                                <div class="match-item">
                                    <a href="@match.NavigationUrl" class="match-link">
                                        <div class="match-icon @GetMatchColorClass(match.Type)">
                                            <i class="@match.Icon"></i>
                                        </div>
                                        <div class="match-content">
                                            <div class="match-type-badge">
                                                <span class="badge @GetMatchBadgeClass(match.Type)">@Localizer[match.Type]</span>
                                            </div>
                                            <div class="match-name">@match.Name</div>
                                            @if (!string.IsNullOrEmpty(match.ParentPath))
                                            {
                                                <div class="match-path">
                                                    <i class="fas fa-sitemap me-1"></i>@match.ParentPath
                                                </div>
                                            }
                                        </div>
                                        <div class="match-action">
                                            <i class="fas fa-arrow-right"></i>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Frameworks Grid -->
<div class="row">
    <!-- Filter Sidebar -->
    <div class="col-lg-3 col-md-4 mb-4">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-filter"></i>
                @Localizer["Filters"]
            </div>
            <form asp-action="Index" method="get">
                <div class="d-grid gap-2 mb-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-filter me-2"></i>@Localizer["Apply Filters"]
                    </button>
                </div>
                
                <!-- Ministry Filter -->
                @if (!Model.IsMinistryUser)
                {
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="fas fa-building me-2"></i>@Localizer["Ministry"]
                        </h6>
                        <div class="filter-options">
                            @foreach (var ministry in Model.Ministries)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="SelectedMinistries"
                                           value="@ministry.Code" id="ministry-@ministry.Code"
                                    @(Model.SelectedMinistries.Contains(ministry.Code) ? "checked" : "")>
                                    <label class="form-check-label text-sm" for="ministry-@ministry.Code">
                                        @if (!string.IsNullOrEmpty(ministry.Logo))
                                        {
                                            <span class="ministry-logo me-1">@ministry.Logo</span>
                                        }
                                        @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? ministry.MinistryDisplayName_AR : ministry.MinistryDisplayName_EN)
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Donor Filter -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="fas fa-handshake me-2"></i>@Localizer["Donor"]
                    </h6>
                    <div class="filter-options">
                        @foreach (var donor in Model.Donors)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="SelectedDonors"
                                       value="@donor.Code" id="donor-@donor.Code"
                                @(Model.SelectedDonors.Contains(donor.Code) ? "checked" : "")>
                                <label class="form-check-label text-sm" for="donor-@donor.Code">
                                    @donor.Partner
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Sector Filter -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="fas fa-industry me-2"></i>@Localizer["Sector"]
                    </h6>
                    <div class="filter-options">
                        @foreach (var sector in Model.Sectors)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="SelectedSector"
                                       value="@sector.Code" id="sector-@sector.Code"
                                @(Model.SelectedSector.Contains(sector.Code) ? "checked" : "")>
                                <label class="form-check-label text-sm" for="sector-@sector.Code">
                                    @if (culture.StartsWith("ar"))
                                    {
                                        @sector.AR_Name
                                    }
                                    else
                                    {
                                        @sector.EN_Name
                                    }
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Frameworks Table -->
    <div class="col-lg-9 col-md-8">
        <div class="chart-card">
            <div class="chart-title d-flex justify-content-between align-items-center">
                <span>
                    <i class="fas fa-sitemap"></i>
                    @Localizer["Results Frameworks"] (@Model.Frameworks.Count())
                </span>
                <div class="d-flex gap-2">
                    <a asp-action="ExportExcel" asp-route-searchString="@ViewData["CurrentFilter"]"
                       class="btn btn-sm btn-success" title="@Localizer["Export Excel"]" data-bs-toggle="tooltip">
                        <i class="fas fa-file-excel"></i>
                    </a>
                    <a asp-action="ExportPdf" asp-route-searchString="@ViewData["CurrentFilter"]"
                       class="btn btn-sm btn-danger" title="@Localizer["Export PDF"]" data-bs-toggle="tooltip">
                        <i class="fas fa-file-pdf"></i>
                    </a>
                </div>
            </div>
            
            @if (Model.Frameworks.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover modern-table">
                        <thead class="table-header">
                            <tr>
                                <th class="sortable-header">
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["NameSortParm"]"
                                       asp-route-searchString="@ViewData["CurrentFilter"]"
                                       class="header-link">
                                        <i class="fas fa-sitemap me-2"></i>@Localizer["Framework Name"]
                                        @if (ViewData["CurrentSort"]?.ToString() == "name_desc")
                                        {
                                            <i class="fas fa-chevron-down ms-2"></i>
                                        }
                                        else if (ViewData["CurrentSort"]?.ToString() == "")
                                        {
                                            <i class="fas fa-chevron-up ms-2"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-sort ms-2 text-muted"></i>
                                        }
                                    </a>
                                </th>
                                <th>
                                    <i class="fas fa-landmark me-2"></i>@Localizer["Ministry"]
                                </th>
                                <th class="sortable-header text-center">
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["IndicatorsSortParm"]"
                                       asp-route-searchString="@ViewData["CurrentFilter"]"
                                       class="header-link">
                                        <i class="fas fa-chart-line me-2"></i>@Localizer["Indicators Performance"]
                                        @if (ViewData["CurrentSort"]?.ToString() == "indicators_desc")
                                        {
                                            <i class="fas fa-chevron-down ms-2"></i>
                                        }
                                        else if (ViewData["CurrentSort"]?.ToString() == "indicators")
                                        {
                                            <i class="fas fa-chevron-up ms-2"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-sort ms-2 text-muted"></i>
                                        }
                                    </a>
                                </th>
                                <th class="sortable-header text-center">
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["DisbursementSortParm"]"
                                       asp-route-searchString="@ViewData["CurrentFilter"]"
                                       class="header-link">
                                        <i class="fas fa-money-bill-wave me-2"></i>@Localizer["Disbursement Performance"]
                                        @if (ViewData["CurrentSort"]?.ToString() == "disbursement_desc")
                                        {
                                            <i class="fas fa-chevron-down ms-2"></i>
                                        }
                                        else if (ViewData["CurrentSort"]?.ToString() == "disbursement")
                                        {
                                            <i class="fas fa-chevron-up ms-2"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-sort ms-2 text-muted"></i>
                                        }
                                    </a>
                                </th>
                                <th class="text-center">
                                    <i class="fas fa-cogs me-2"></i>@Localizer["Actions"]
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Frameworks)
                            {
                                string indicatorsClass = ProgressBarHelper.GetProgressBarClass(item.IndicatorsPerformance);
                                string disbursementClass = ProgressBarHelper.GetProgressBarClass(item.DisbursementPerformance);
                                double IndicatorsPerformance = Math.Round(item.IndicatorsPerformance, 2);
                                double DisbursementPerformance = Math.Round(item.DisbursementPerformance, 2);
                                var frameworkIndicators = item.Outcomes
                                    .SelectMany(o => o.Outputs)
                                    .SelectMany(op => op.SubOutputs)
                                    .SelectMany(so => so.Indicators)
                                    .ToList();

                                <tr id="framework-row-@item.Code" class="table-row">
                                    <td class="framework-name-cell">
                                        <div class="d-flex align-items-center">
                                            <div class="framework-icon me-3">
                                                <i class="fas fa-sitemap"></i>
                                            </div>
                                            <div>
                                                <span id="fw-name-@item.Code" class="fw-name-view">
                                                    <a asp-controller="Outcomes" asp-action="Index" asp-route-frameworkCode="@item.Code"
                                                       class="framework-name-link">
                                                        @item.Name
                                                    </a>
                                                </span>
                                                <div id="fw-name-edit-container-@item.Code" class="d-none">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <input type="text" id="fw-name-input-@item.Code"
                                                               class="form-control form-control-sm" value="@item.Name" />
                                                        <button type="button" class="btn btn-success btn-sm" onclick="saveFrameworkName(@item.Code)" title="@Localizer["Save"]">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cancelFrameworkEdit(@item.Code)" title="@Localizer["Cancel"]">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="framework-ministry-cell">
                                        <span id="fw-ministry-@item.Code" class="fw-ministry-view">
                                            @if (item.Ministry != null)
                                            {
                                                <span class="ministry-badge">
                                                    @if (!string.IsNullOrEmpty(item.Ministry.Logo))
                                                    {
                                                        <span class="ministry-logo me-1">@item.Ministry.Logo</span>
                                                    }
                                                    @MinistryName(item.Ministry)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="ministry-badge ministry-badge-empty">
                                                    <i class="fas fa-unlink me-1"></i>@Localizer["Not linked"]
                                                </span>
                                            }
                                        </span>
                                        @* Reassigning a strategy transfers ownership, so only admins get the editor. *@
                                        @if (isAdminUser)
                                        {
                                            <button type="button" class="btn btn-link btn-sm p-0 ms-2 fw-ministry-edit-btn"
                                                    onclick="toggleFrameworkMinistryEdit(@item.Code)" title="@Localizer["Change Ministry"]">
                                                <i class="fas fa-pen"></i>
                                            </button>
                                            <div id="fw-ministry-edit-container-@item.Code" class="d-none mt-1">
                                                <div class="d-flex align-items-center gap-2">
                                                    <select id="fw-ministry-select-@item.Code" class="form-select form-select-sm">
                                                        <option value="">@Localizer["Select Ministry"]</option>
                                                        @foreach (var ministry in Model.Ministries)
                                                        {
                                                            var selected = item.MinistryCode == ministry.Code;
                                                            <option value="@ministry.Code" selected="@selected">
                                                                @(string.IsNullOrEmpty(ministry.Logo) ? "" : ministry.Logo + " ")@MinistryName(ministry)
                                                            </option>
                                                        }
                                                    </select>
                                                    <button type="button" class="btn btn-success btn-sm" onclick="saveFrameworkMinistry(@item.Code)" title="@Localizer["Save"]">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cancelFrameworkMinistryEdit(@item.Code)" title="@Localizer["Cancel"]">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="performance-metric">
                                            @await Html.PartialAsync("_ProgressBar", Tuple.Create(IndicatorsPerformance, indicatorsClass))
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="performance-metric">
                                            @await Html.PartialAsync("_ProgressBar", Tuple.Create(DisbursementPerformance, disbursementClass))
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group action-buttons" role="group">
                                            <button class="btn btn-outline-info btn-sm action-btn"
                                                    onclick="toggleOutcomes(@item.Code)" title="@Localizer["Show Outcomes"]">
                                                <i class="fas fa-chevron-down" id="chevron-@item.Code"></i>
                                            </button>
                                            <button class="btn btn-outline-success btn-sm action-btn"
                                                    onclick="toggleIndicators(@item.Code)" title="@Localizer["Show Indicators"]">
                                                <i class="fas fa-chart-line" id="indicators-chevron-@item.Code"></i>
                                            </button>
                                            @if (SignInManager.IsSignedIn(User))
                                            {
                                                var user = await UserManager.GetUserAsync(User);
                                                if (user != null)
                                                {
                                                    var roles = await UserManager.GetRolesAsync(user);
                                                    if (roles.Contains("SystemAdministrator") || roles.Contains("MinistryStrategyManager"))
                                                    {
                                                        <form asp-controller="Tree" asp-action="Index2" asp-route-id="@item.Code" method="post" class="d-inline">
                                                            <button class="btn btn-outline-success btn-sm action-btn" title="Tree View">
                                                                <i class="fas fa-tree"></i>
                                                            </button>
                                                        </form>
                                                        <button class="btn btn-outline-primary btn-sm action-btn"
                                                                onclick="toggleFrameworkEdit(@item.Code)" title="Edit Name">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger btn-sm action-btn"
                                                                onclick="confirmFrameworkDelete(@item.Code)" title="Delete">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    }
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                                <!-- Expandable Outcomes Row -->
                                <tr id="outcomes-row-@item.Code" class="outcomes-row" style="display: none;">
                                    <td colspan="5" class="p-0">
                                        <div class="outcomes-container">
                                            <div class="outcomes-header d-flex justify-content-between align-items-center">
                                                <span>
                                                    <i class="fas fa-bullseye me-2"></i>
                                                    @Localizer["Outcomes"] (@item.Outcomes.Count)
                                                </span>
                                                @if (SignInManager.IsSignedIn(User))
                                                {
                                                    var currentUser = await UserManager.GetUserAsync(User);
                                                    if (currentUser != null)
                                                    {
                                                        var userRoles = await UserManager.GetRolesAsync(currentUser);
                                                        if (userRoles.Contains("SystemAdministrator") || userRoles.Contains("MinistryStrategyManager"))
                                                        {
                                                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="toggleInlineOutcomeForm(@item.Code)">
                                                                <i class="fas fa-plus me-1"></i>@Localizer["Add Outcome"]
                                                            </button>
                                                        }
                                                    }
                                                }
                                            </div>

                                            <!-- Inline Add Outcome Form -->
                                            <div id="inline-outcome-form-@item.Code" class="inline-create-outcome-form mb-3" style="display: none;">
                                                <div class="row g-2 align-items-center">
                                                    <div class="col">
                                                        <input type="text" class="form-control" id="new-outcome-name-@item.Code"
                                                               placeholder="@Localizer["Enter outcome name"]" />
                                                    </div>
                                                    <div class="col-auto">
                                                        <button type="button" class="btn btn-primary btn-sm" onclick="createInlineOutcome(@item.Code)">
                                                            <i class="fas fa-save me-1"></i>@Localizer["Save"]
                                                        </button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleInlineOutcomeForm(@item.Code)">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>

                                            @if (item.Outcomes.Any())
                                            {
                                                <table class="table table-sm outcomes-table mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>@Localizer["Outcome Name"]</th>
                                                            <th class="text-center">@Localizer["Weight"]</th>
                                                            <th class="text-center">@Localizer["Indicators Performance"]</th>
                                                            <th class="text-center">@Localizer["Disbursement Performance"]</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var outcome in item.Outcomes)
                                                        {
                                                            string outcomeIndicatorsClass = ProgressBarHelper.GetProgressBarClass(outcome.IndicatorsPerformance);
                                                            string outcomeDisbursementClass = ProgressBarHelper.GetProgressBarClass(outcome.DisbursementPerformance);
                                                            <tr data-outcome-code="@outcome.Code">
                                                                <td>
                                                                    <a asp-controller="Outputs" asp-action="Index" asp-route-outcomeCode="@outcome.Code" class="outcome-name-link">
                                                                        @outcome.Name
                                                                    </a>
                                                                </td>
                                                                <td class="text-center">
                                                                    <span class="badge bg-info">@Math.Round(outcome.Weight, 1)%</span>
                                                                </td>
                                                                <td class="text-center">
                                                                    @await Html.PartialAsync("_ProgressBar", Tuple.Create(Math.Round(outcome.IndicatorsPerformance, 2), outcomeIndicatorsClass))
                                                                </td>
                                                                <td class="text-center">
                                                                    @await Html.PartialAsync("_ProgressBar", Tuple.Create(Math.Round(outcome.DisbursementPerformance, 2), outcomeDisbursementClass))
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                            else
                                            {
                                                <div class="text-center py-3 text-muted">
                                                    <i class="fas fa-info-circle me-2"></i>
                                                    @Localizer["No outcomes found for this framework"]
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                <!-- Expandable Indicators Row -->
                                <tr id="indicators-row-@item.Code" class="indicators-row" style="display: none;">
                                    <td colspan="5" class="p-0">
                                        <div class="indicators-container">
                                            <div class="indicators-header">
                                                <i class="fas fa-chart-line me-2"></i>
                                                @Localizer["Indicators"] (@frameworkIndicators.Count)
                                            </div>
                                            @if (frameworkIndicators.Any())
                                            {
                                                @foreach (var indicator in frameworkIndicators)
                                                {
                                                    var indicatorProjects = indicator.Project != null
                                                        ? new List<MonitoringAndEvaluationPlatform.Models.Project> { indicator.Project }
                                                        : new List<MonitoringAndEvaluationPlatform.Models.Project>();
                                                    var indPerf = Math.Round(indicator.IndicatorsPerformance, 1);
                                                    var indPerfClass = ProgressBarHelper.GetProgressBarClass(indicator.IndicatorsPerformance);
                                                    <div class="indicator-group">
                                                        <div class="indicator-group-header">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="indicator-icon-badge">
                                                                    <i class="fas fa-chart-bar"></i>
                                                                </div>
                                                                <div class="flex-grow-1">
                                                                    <span class="fw-semibold">@indicator.Name</span>
                                                                </div>
                                                                <span class="badge bg-info">@Localizer["Weight"]: @Math.Round(indicator.Weight / 100, 1)%</span>
                                                                <span class="badge indicator-perf-badge @indPerfClass">@indPerf%</span>
                                                                <span class="badge bg-secondary">@indicatorProjects.Count @Localizer["Projects"]</span>
                                                            </div>
                                                        </div>
                                                        @if (indicatorProjects.Any())
                                                        {
                                                            <table class="table table-sm indicator-projects-table mb-0">
                                                                <thead>
                                                                    <tr>
                                                                        <th>@Localizer["Project Name"]</th>
                                                                        <th class="text-center">@Localizer["Indicators Performance"]</th>
                                                                        <th class="text-center">@Localizer["Disbursement Performance"]</th>
                                                                        <th class="text-center">@Localizer["Actions"]</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var project in indicatorProjects)
                                                                    {
                                                                        var projectIndicatorsClass = ProgressBarHelper.GetProgressBarClass(project.performance);
                                                                        var projectDisbursementClass = ProgressBarHelper.GetProgressBarClass(project.DisbursementPerformance);
                                                                        <tr>
                                                                            <td>
                                                                                <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.ProjectID" class="project-name-link">
                                                                                    <i class="fas fa-folder-open me-1 text-muted"></i>@project.ProjectName
                                                                                </a>
                                                                            </td>
                                                                            <td class="text-center">
                                                                                @await Html.PartialAsync("_ProgressBar", Tuple.Create(Math.Round(project.performance, 2), projectIndicatorsClass))
                                                                            </td>
                                                                            <td class="text-center">
                                                                                @await Html.PartialAsync("_ProgressBar", Tuple.Create(Math.Round(project.DisbursementPerformance, 2), projectDisbursementClass))
                                                                            </td>
                                                                            <td class="text-center">
                                                                                <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.ProjectID"
                                                                                   class="btn btn-outline-primary btn-sm" title="@Localizer["View Details"]">
                                                                                    <i class="fas fa-eye"></i>
                                                                                </a>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <div class="text-center py-2 text-muted small px-3">
                                                                <i class="fas fa-info-circle me-1"></i>
                                                                @Localizer["No projects assigned to this indicator"]
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="text-center py-3 text-muted">
                                                    <i class="fas fa-info-circle me-2"></i>
                                                    @Localizer["No indicators found for this framework"]
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="stat-icon warning mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="fas fa-search"></i>
                    </div>
                    <h4 class="text-muted">@Localizer["No frameworks found"]</h4>
                    <p class="text-muted">@Localizer["Try adjusting your search criteria or filters"]</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Search on Enter key only
        const frameworkSearchInput = document.getElementById('frameworkSearchInput');
        const frameworkSearchForm = document.getElementById('frameworkSearchForm');

        if (frameworkSearchInput && frameworkSearchForm) {
            frameworkSearchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    frameworkSearchForm.submit();
                }
            });
        }

        // Inline Create Functions
        function toggleInlineCreate() {
            const form = $('#inlineCreateForm');
            const btn = $('#createFrameworkBtn');

            if (form.hasClass('d-none')) {
                // Show form with animation
                form.removeClass('d-none');
                form.hide().slideDown(400, function() {
                    $('#frameworkName').focus();
                });
                btn.html('<i class="fas fa-times me-2"></i>@Localizer["Cancel"]');
                btn.removeClass('btn-primary').addClass('btn-outline-secondary');
            } else {
                // Hide form with animation
                form.slideUp(400, function() {
                    form.addClass('d-none');
                    $('#frameworkName').val('');
                    $('.progress-bar-create').css('width', '0%');
                });
                btn.html('<i class="fas fa-plus me-2"></i>@Localizer["Create New Framework"]');
                btn.removeClass('btn-outline-secondary').addClass('btn-primary');
            }
        }

        // Handle inline form submission
        $('#createFrameworkForm').on('submit', function(e) {
            e.preventDefault();

            const frameworkName = $('#frameworkName').val().trim();
            if (!frameworkName) {
                Swal.fire({
                    icon: 'warning',
                    title: '@Localizer["Validation Error"]',
                    text: '@Localizer["Please enter a framework name"]',
                    customClass: {
                        popup: 'swal2-modern'
                    }
                });
                return;
            }

            // A ministry user's dropdown is disabled and the server forces their own
            // ministry, so only validate the choice when they can actually make one.
            const ministrySelect = $('#frameworkMinistry');
            const frameworkMinistry = ministrySelect.val();
            if (!ministrySelect.prop('disabled') && !frameworkMinistry) {
                Swal.fire({
                    icon: 'warning',
                    title: '@Localizer["Validation Error"]',
                    text: '@Localizer["Please select a ministry"]',
                    customClass: {
                        popup: 'swal2-modern'
                    }
                });
                return;
            }

            // Show loading state
            const submitBtn = $(this).find('button[type="submit"]');
            const btnContent = submitBtn.find('.btn-content');
            const btnText = btnContent.find('span');
            const btnSpinner = btnContent.find('.btn-spinner');

            submitBtn.prop('disabled', true);
            btnText.addClass('d-none');
            btnSpinner.removeClass('d-none');

            // Animate progress bar
            $('.progress-bar-create').animate({ width: '100%' }, 1500);

            // AJAX call to create framework
            $.ajax({
                url: '/Frameworks/CreateInline',
                type: 'POST',
                data: {
                    Name: frameworkName,
                    MinistryCode: frameworkMinistry,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success!"]',
                            text: '@Localizer["Framework created successfully!"]',
                            timer: 2000,
                            showConfirmButton: false,
                            customClass: {
                                popup: 'swal2-modern'
                            }
                        }).then(() => {
                            // Add new framework to table with animation
                            addFrameworkToTable(response.framework);
                            toggleInlineCreate();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: response.message || '@Localizer["Could not create framework. Please try again."]',
                            customClass: {
                                popup: 'swal2-modern'
                            }
                        });
                    }
                },
                error: function(xhr) {
                    let errorMessage = '@Localizer["Could not create framework. Please try again."]';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }

                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: errorMessage,
                        customClass: {
                            popup: 'swal2-modern'
                        }
                    });
                },
                complete: function() {
                    // Reset button state
                    submitBtn.prop('disabled', false);
                    btnText.removeClass('d-none');
                    btnSpinner.addClass('d-none');
                    $('.progress-bar-create').css('width', '0%');
                }
            });
        });

        // Add framework to table dynamically
        function addFrameworkToTable(framework) {
            const tableBody = $('.modern-table tbody');
            const ministryLogo = framework.ministryLogo
                ? `<span class="ministry-logo me-1">${framework.ministryLogo}</span>`
                : '';
            const ministryCell = framework.ministryName
                ? `<span class="ministry-badge">${ministryLogo}${framework.ministryName}</span>`
                : `<span class="ministry-badge ministry-badge-empty"><i class="fas fa-unlink me-1"></i>@Localizer["Not linked"]</span>`;
            const newRow = `
                <tr id="framework-row-${framework.code}" class="table-row new-framework-row" style="opacity: 0; transform: translateX(-20px);">
                    <td class="framework-name-cell">
                        <div class="d-flex align-items-center">
                            <div class="framework-icon me-3">
                                <i class="fas fa-sitemap"></i>
                            </div>
                            <div>
                                <span id="fw-name-${framework.code}" class="fw-name-view">
                                    <a href="/Outcomes?frameworkCode=${framework.code}" class="framework-name-link">
                                        ${framework.name}
                                    </a>
                                </span>
                                <input type="text" id="fw-name-input-${framework.code}"
                                       class="form-control fw-name-edit d-none" value="${framework.name}" />
                            </div>
                        </div>
                    </td>
                    <td class="framework-ministry-cell">
                        <span id="fw-ministry-${framework.code}" class="fw-ministry-view">${ministryCell}</span>
                    </td>
                    <td class="text-center">
                        <div class="performance-metric">
                            <div class="progress-container">
                                <div class="progress modern-progress-bar">
                                    <div class="progress-bar bg-secondary progress-bar-striped" role="progressbar"
                                         style="width: 0%" title="0% Performance">
                                        <span class="progress-text-inside d-none">0%</span>
                                    </div>
                                </div>
                                <div class="progress-value-display">
                                    <span class="progress-percentage bg-secondary-text">0%</span>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="text-center">
                        <div class="performance-metric">
                            <div class="progress-container">
                                <div class="progress modern-progress-bar">
                                    <div class="progress-bar bg-secondary progress-bar-striped" role="progressbar"
                                         style="width: 0%" title="0% Performance">
                                        <span class="progress-text-inside d-none">0%</span>
                                    </div>
                                </div>
                                <div class="progress-value-display">
                                    <span class="progress-percentage bg-secondary-text">0%</span>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="text-center">
                        <div class="btn-group action-buttons" role="group">
                            <form action="/Tree/Index/${framework.code}" method="post" class="d-inline">
                                <button class="btn btn-outline-success btn-sm action-btn" title="Tree View">
                                    <i class="fas fa-project-diagram"></i>
                                </button>
                            </form>
                            <button class="btn btn-outline-primary btn-sm action-btn"
                                    onclick="toggleFrameworkEdit(${framework.code})" title="Edit Name">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm action-btn"
                                    onclick="confirmFrameworkDelete(${framework.code})" title="Delete">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `;

            if (tableBody.children().length === 0) {
                // If table is empty, replace the "no frameworks" message
                $('.text-center.py-5').parent().html(`
                    <div class="table-responsive">
                        <table class="table table-hover modern-table">
                            <thead class="table-header">
                                <tr>
                                    <th class="sortable-header">
                                        <a href="#" class="header-link">
                                            <i class="fas fa-sitemap me-2"></i>@Localizer["Framework Name"]
                                            <i class="fas fa-sort ms-2 text-muted"></i>
                                        </a>
                                    </th>
                                    <th>
                                        <i class="fas fa-landmark me-2"></i>@Localizer["Ministry"]
                                    </th>
                                    <th class="sortable-header text-center">
                                        <a href="#" class="header-link">
                                            <i class="fas fa-chart-line me-2"></i>@Localizer["Indicators Performance"]
                                            <i class="fas fa-sort ms-2 text-muted"></i>
                                        </a>
                                    </th>
                                    <th class="sortable-header text-center">
                                        <a href="#" class="header-link">
                                            <i class="fas fa-money-bill-wave me-2"></i>@Localizer["Disbursement Performance"]
                                            <i class="fas fa-sort ms-2 text-muted"></i>
                                        </a>
                                    </th>
                                    <th class="text-center">
                                        <i class="fas fa-cogs me-2"></i>@Localizer["Actions"]
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                ${newRow}
                            </tbody>
                        </table>
                    </div>
                `);
            } else {
                tableBody.prepend(newRow);
            }

            // Animate new row
            setTimeout(() => {
                $(`#framework-row-${framework.code}`).css({
                    'transition': 'all 0.6s ease',
                    'opacity': '1',
                    'transform': 'translateX(0)'
                });
            }, 100);
        }

        function toggleFrameworkEdit(code) {
            const viewSpan = $(`#fw-name-${code}`);
            const editContainer = $(`#fw-name-edit-container-${code}`);
            const input = $(`#fw-name-input-${code}`);

            // Enter edit mode
            editContainer.removeClass('d-none');
            viewSpan.addClass('d-none');
            input.focus().select();
        }

        function saveFrameworkName(code) {
            const viewSpan = $(`#fw-name-${code}`);
            const editContainer = $(`#fw-name-edit-container-${code}`);
            const input = $(`#fw-name-input-${code}`);
            const newName = input.val();

            $.ajax({
                url: `/Frameworks/UpdateName`,
                type: 'POST',
                data: { id: code, name: newName },
                success: function () {
                    viewSpan.html(`<a href="/Outcomes?frameworkCode=${code}" class="framework-name-link">${newName}</a>`);
                    editContainer.addClass('d-none');
                    viewSpan.removeClass('d-none');
                    Swal.fire({
                        icon: 'success',
                        title: '@Localizer["Saved!"]',
                        text: '@Localizer["Framework name updated successfully."]',
                        timer: 2000,
                        showConfirmButton: false
                    });
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["Could not update framework name."]'
                    });
                }
            });
        }

        function cancelFrameworkEdit(code) {
            const viewSpan = $(`#fw-name-${code}`);
            const editContainer = $(`#fw-name-edit-container-${code}`);
            const input = $(`#fw-name-input-${code}`);

            // Reset input to original value
            const originalName = viewSpan.find('a').text();
            input.val(originalName);

            editContainer.addClass('d-none');
            viewSpan.removeClass('d-none');
        }

        // Ministry reassignment - rendered for administrators only; UpdateMinistry
        // rejects anyone else server-side.
        function toggleFrameworkMinistryEdit(code) {
            $(`#fw-ministry-${code}`).addClass('d-none');
            $(`.fw-ministry-edit-btn`, `#framework-row-${code}`).addClass('d-none');
            $(`#fw-ministry-edit-container-${code}`).removeClass('d-none');
        }

        function cancelFrameworkMinistryEdit(code) {
            $(`#fw-ministry-edit-container-${code}`).addClass('d-none');
            $(`#fw-ministry-${code}`).removeClass('d-none');
            $(`.fw-ministry-edit-btn`, `#framework-row-${code}`).removeClass('d-none');
        }

        function saveFrameworkMinistry(code) {
            const select = $(`#fw-ministry-select-${code}`);
            const ministryCode = select.val();

            if (!ministryCode) {
                Swal.fire({
                    icon: 'warning',
                    title: '@Localizer["Validation Error"]',
                    text: '@Localizer["Please select a ministry"]'
                });
                return;
            }

            $.ajax({
                url: '/Frameworks/UpdateMinistry',
                type: 'POST',
                data: { id: code, ministryCode: ministryCode },
                success: function (response) {
                    if (!response.success) {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: response.message || '@Localizer["Could not update the ministry."]'
                        });
                        return;
                    }

                    const logo = response.ministryLogo
                        ? `<span class="ministry-logo me-1">${response.ministryLogo}</span>`
                        : '';
                    $(`#fw-ministry-${code}`)
                        .html(`<span class="ministry-badge">${logo}${response.ministryName}</span>`);
                    cancelFrameworkMinistryEdit(code);

                    Swal.fire({
                        icon: 'success',
                        title: '@Localizer["Saved!"]',
                        text: '@Localizer["Ministry updated successfully."]',
                        timer: 2000,
                        showConfirmButton: false
                    });
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["Could not update the ministry."]'
                    });
                }
            });
        }

        function toggleOutcomes(code) {
            const outcomesRow = document.getElementById(`outcomes-row-${code}`);
            const chevron = document.getElementById(`chevron-${code}`);

            if (outcomesRow.style.display === 'none') {
                outcomesRow.style.display = 'table-row';
                chevron.classList.remove('fa-chevron-down');
                chevron.classList.add('fa-chevron-up');

                // Animate the container
                const container = outcomesRow.querySelector('.outcomes-container');
                container.style.opacity = '0';
                container.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    container.style.transition = 'all 0.3s ease';
                    container.style.opacity = '1';
                    container.style.transform = 'translateY(0)';
                }, 10);
            } else {
                outcomesRow.style.display = 'none';
                chevron.classList.remove('fa-chevron-up');
                chevron.classList.add('fa-chevron-down');
            }
        }

        function toggleIndicators(code) {
            const indicatorsRow = document.getElementById(`indicators-row-${code}`);
            const icon = document.getElementById(`indicators-chevron-${code}`);

            if (indicatorsRow.style.display === 'none') {
                indicatorsRow.style.display = 'table-row';
                icon.classList.remove('fa-chart-line');
                icon.classList.add('fa-times');

                // Animate the container
                const container = indicatorsRow.querySelector('.indicators-container');
                container.style.opacity = '0';
                container.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    container.style.transition = 'all 0.3s ease';
                    container.style.opacity = '1';
                    container.style.transform = 'translateY(0)';
                }, 10);
            } else {
                indicatorsRow.style.display = 'none';
                icon.classList.remove('fa-times');
                icon.classList.add('fa-chart-line');
            }
        }

        function toggleInlineOutcomeForm(frameworkCode) {
            const form = document.getElementById(`inline-outcome-form-${frameworkCode}`);
            if (form.style.display === 'none') {
                form.style.display = 'block';
                document.getElementById(`new-outcome-name-${frameworkCode}`).focus();
            } else {
                form.style.display = 'none';
                document.getElementById(`new-outcome-name-${frameworkCode}`).value = '';
            }
        }

        function createInlineOutcome(frameworkCode) {
            const nameInput = document.getElementById(`new-outcome-name-${frameworkCode}`);
            const name = nameInput.value.trim();

            if (!name) {
                Swal.fire({
                    icon: 'warning',
                    title: '@Localizer["Warning"]',
                    text: '@Localizer["Please enter an outcome name"]',
                });
                return;
            }

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/Outcomes/CreateInline',
                type: 'POST',
                data: {
                    name: name,
                    frameworkCode: frameworkCode,
                    __RequestVerificationToken: token
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success"]',
                            text: '@Localizer["Outcome created successfully!"]',
                            timer: 2000,
                            showConfirmButton: false
                        });

                        // Update weights of all existing outcome rows
                        if (response.allOutcomes) {
                            response.allOutcomes.forEach(function(o) {
                                $(`#outcomes-row-${frameworkCode} tr[data-outcome-code="${o.code}"] .badge.bg-info`)
                                    .text(o.weight + '%');
                            });
                        }

                        // Add new row to the outcomes table
                        const outcomesTable = $(`#outcomes-row-${frameworkCode} .outcomes-table tbody`);
                        if (outcomesTable.length) {
                            const newRow = `
                                <tr class="new-outcome-row" data-outcome-code="${response.outcome.code}">
                                    <td>
                                        <a href="/Outputs?outcomeCode=${response.outcome.code}" class="outcome-name-link">
                                            ${response.outcome.name}
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info">${response.outcome.weight}%</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="progress-container">
                                            <div class="progress modern-progress-bar">
                                                <div class="progress-bar bg-secondary" role="progressbar"
                                                     style="width: 0%">
                                                </div>
                                            </div>
                                            <div class="progress-value-display">
                                                <span class="progress-percentage">0%</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="progress-container">
                                            <div class="progress modern-progress-bar">
                                                <div class="progress-bar bg-secondary" role="progressbar"
                                                     style="width: 0%">
                                                </div>
                                            </div>
                                            <div class="progress-value-display">
                                                <span class="progress-percentage">0%</span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            `;
                            outcomesTable.append(newRow);
                        } else {
                            // If no table exists, reload to show the new outcome
                            location.reload();
                        }

                        // Update the outcomes count in the header
                        const header = $(`#outcomes-row-${frameworkCode} .outcomes-header`);
                        const currentText = header.text();
                        const match = currentText.match(/\((\d+)\)/);
                        if (match) {
                            const newCount = parseInt(match[1]) + 1;
                            header.html(`<i class="fas fa-bullseye me-2"></i>@Localizer["Outcomes"] (${newCount})`);
                        }

                        // Clear and hide the form
                        nameInput.value = '';
                        toggleInlineOutcomeForm(frameworkCode);
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: response.message || '@Localizer["Could not create outcome. Please try again."]'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["Could not create outcome. Please try again."]'
                    });
                }
            });
        }

        function confirmFrameworkDelete(code) {
            Swal.fire({
                title: '@Localizer["Are you sure?"]',
                text: '@Localizer["This will permanently delete the framework and all associated data!"]',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '@Localizer["Yes, delete it!"]',
                cancelButtonText: '@Localizer["Cancel"]',
                customClass: {
                    popup: 'swal2-modern',
                    confirmButton: 'btn btn-danger',
                    cancelButton: 'btn btn-secondary'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/Frameworks/DeleteConfirmed/${code}`,
                        type: 'POST',
                        success: function () {
                            $(`#framework-row-${code}`).fadeOut(400, function() {
                                $(this).remove();
                            });
                            Swal.fire({
                                icon: 'success',
                                title: '@Localizer["Deleted!"]',
                                text: '@Localizer["Framework has been deleted successfully."]',
                                timer: 2000,
                                showConfirmButton: false
                            });
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: '@Localizer["Could not delete framework. Please try again."]'
                            });
                        }
                    });
                }
            });
        }
        
        // Initialize page animations
        document.addEventListener('DOMContentLoaded', function() {
            // Animate table rows on load
            const tableRows = document.querySelectorAll('.table-row');
            tableRows.forEach((row, index) => {
                row.style.opacity = '0';
                row.style.transform = 'translateX(-20px)';
                setTimeout(() => {
                    row.style.transition = 'all 0.6s ease';
                    row.style.opacity = '1';
                    row.style.transform = 'translateX(0)';
                }, index * 100);
            });
            
            // Progress bar animation
            const progressBars = document.querySelectorAll('.progress-fill-modern');
            progressBars.forEach((bar, index) => {
                setTimeout(() => {
                    const width = bar.style.width;
                    bar.style.width = '0%';
                    setTimeout(() => {
                        bar.style.transition = 'width 1.5s ease-out';
                        bar.style.width = width;
                    }, 200);
                }, index * 100);
            });
        });

        // Expand All / Collapse All functionality for search results
        const expandAllBtn = document.getElementById('expandAllBtn');
        const collapseAllBtn = document.getElementById('collapseAllBtn');

        if (expandAllBtn) {
            expandAllBtn.addEventListener('click', function() {
                const collapseElements = document.querySelectorAll('.framework-search-result .collapse');
                collapseElements.forEach(element => {
                    const bsCollapse = new bootstrap.Collapse(element, { toggle: false });
                    bsCollapse.show();
                });
            });
        }

        if (collapseAllBtn) {
            collapseAllBtn.addEventListener('click', function() {
                const collapseElements = document.querySelectorAll('.framework-search-result .collapse');
                collapseElements.forEach(element => {
                    const bsCollapse = new bootstrap.Collapse(element, { toggle: false });
                    bsCollapse.hide();
