@model MonitoringAndEvaluationPlatform.Models.Plan

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_ProjectsLayout.cshtml";
}

<h1>Create</h1>

<h4>Plan</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                @{ var _createDateVal = Model.Date == default(DateTime) ? DateTime.Today.ToString("yyyy-MM") : Model.Date.ToString("yyyy-MM"); }
                <div class="month-year-picker">
                    <input type="hidden" name="Date" id="Date" value="@_createDateVal" />
                    <div class="d-flex align-items-center gap-1">
                        <select class="form-control mypicker-month" style="max-width:80px">
                            @for (int _m = 1; _m <= 12; _m++) { <option value="@_m">@_m</option> }
                        </select>
                        <span class="text-muted px-1 fw-bold">/</span>
                        <input type="number" class="form-control mypicker-year" min="2000" max="2100" style="max-width:100px" placeholder="YYYY" />
                    </div>
                </div>
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Planned" class="control-label"></label>
                <input asp-for="Planned" class="form-control" />
                <span asp-validation-for="Planned" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Realised" class="control-label"></label>
                <input asp-for="Realised" class="form-control" />
                <span asp-validation-for="Realised" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ActivityCode" class="control-label"></label>
                <select asp-for="ActivityCode" class ="form-control" asp-items="ViewBag.ActivityCode"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

<script>
(function () {
    document.querySelectorAll('.month-year-picker').forEach(function (picker) {
        var hidden = picker.querySelector('input[type="hidden"]');
        var monthSel = picker.querySelector('.mypicker-month');
        var yearInput = picker.querySelector('.mypicker-year');
        if (hidden.value) {
            var parts = hidden.value.split('-');
            if (parts.length >= 2) {
                yearInput.value = parseInt(parts[0], 10);
                monthSel.value = parseInt(parts[1], 10);
            }
        }
        function sync() {
            var m = monthSel.value, y = yearInput.value;
            if (m && y) hidden.value = String(parseInt(y)).padStart(4, '0') + '-' + String(parseInt(m)).padStart(2, '0');
        }
        monthSel.addEventListener('change', sync);
        yearInput.addEventListener('change', sync);
        yearInput.addEventListener('input', sync);
    });
})();
</script>

