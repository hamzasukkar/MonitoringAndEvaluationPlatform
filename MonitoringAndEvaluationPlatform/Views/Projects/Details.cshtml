@model MonitoringAndEvaluationPlatform.Models.Project
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Localization
@using System.Globalization
@using MonitoringAndEvaluationPlatform.Helpers

@{
    ViewData["Title"] = "Project Details";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var culture = Context.Features.Get<IRequestCultureFeature>().RequestCulture.Culture.Name;
    ViewData["HelpFeature"] = "PROJECTS";
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <h1 class="dashboard-title">
        <i class="fas fa-info-circle me-3"></i>
        @Model.ProjectName
    </h1>
    <p class="dashboard-subtitle">
        @Localizer["Comprehensive project overview with performance metrics and detailed information"];
    </p>
    <div class="dashboard-actions">
        @await Html.PartialAsync("_HelpButton")
        <a asp-action="Edit" asp-route-id="@Model?.ProjectID" class="btn btn-gradient-primary me-2">
            <i class="fas fa-edit me-1"></i>@Localizer["Edit"]
        </a>
        <a asp-action="Index" class="btn btn-light">
            <i class="fas fa-arrow-left me-1"></i>@Localizer["Back to List"]
        </a>
    </div>
</div>

<div class="container-fluid">
    <!-- Project Information -->
    <div class="chart-card mb-4">
        <h3 class="chart-title">
            <i class="fas fa-info-circle"></i>
            @Localizer["Project Information"]
        </h3>
        <div class="chart-content">
            <div class="project-details-grid">
                <!-- Basic Info -->
                <div class="info-section">
                    <div class="info-card">
                        <div class="info-header">
                            <i class="fas fa-info-circle me-2"></i>
                            <h5 class="info-title">@Localizer["Basic Information"]</h5>
                        </div>
                        <div class="info-content">
                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-user-tie me-2"></i>
                                    @Localizer["Project Manager"]
                                </div>
                                <div class="info-value">@Html.DisplayFor(model => model.ProjectManager.Name)</div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-user-check me-2"></i>
                                    @Localizer["Supervisor"]
                                </div>
                                <div class="info-value">@Html.DisplayFor(model => model.SuperVisor.Name)</div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-handshake me-2"></i>
                                    @Localizer["Donors & Funding"]
                                </div>
                                <div class="info-value">
                                    @if (Model.ProjectDonors != null && Model.ProjectDonors.Any())
                                    {
                                        @foreach (var projectDonor in Model.ProjectDonors)
                                        {
                                            <div class="donor-funding-item mb-2">
                                                <div class="donor-info">
                                                    <span class="modern-badge badge-primary">
                                                        @projectDonor.Donor.Partner
                                                    </span>
                                                    <div class="funding-details mt-1">
                                                        <small class="text-muted">
                                                            <i class="fas fa-percentage me-1"></i>
                                                            @projectDonor.FundingPercentage.ToString("0.##")%
                                                        </small>
                                                        <small class="text-muted ms-2">
                                                            <span class="me-1">@Model.CurrencySymbol</span>
                                                            @projectDonor.FundingAmount.ToString("0")
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var donor in Model.Donors)
                                        {
                                            <span class="modern-badge badge-primary">
                                                @donor.Partner
                                            </span>
                                        }
                                    }
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-building me-2"></i>
                                    @Localizer["Ministry"]
                                </div>
                                <div class="info-value">
                                    @foreach (var ministry in Model.Ministries)
                                    {
                                        <span class="modern-badge badge-primary">
                                            @if (!string.IsNullOrEmpty(ministry.Logo))
                                            {
                                                <span class="ministry-logo me-1">@ministry.Logo</span>
                                            }
                                            @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? ministry.MinistryDisplayName_AR : ministry.MinistryDisplayName_EN)
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-bullseye me-2"></i>
                                    @Localizer["SDGs"]
                                </div>
                                <div class="info-value">
                                    @if (CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar")
                                    {
                                        @Html.DisplayFor(model => model.Goal.AR_Name)
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(model => model.Goal.EN_Name)
                                    }
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-calendar-alt me-2"></i>
                                    @Localizer["Start Date"]
                                </div>
                                <div class="info-value">@Model.StartDate.ToString("MMM yyyy")</div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-calendar-check me-2"></i>
                                    @Localizer["End Date"]
                                </div>
                                <div class="info-value">@Model.EndDate.ToString("MMM yyyy")</div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-industry me-2"></i>
                                    @Localizer["Sector"]
                                </div>
                                <div class="info-value">
                                    @foreach (var sector in Model.Sectors)
                                    {
                                        <span class="modern-badge badge-secondary me-1">
                                            @if (culture.StartsWith("ar"))
                                            {
                                                @sector.AR_Name
                                            }
                                            else
                                            {
                                                @sector.EN_Name
                                            }
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Region Info -->
                <div class="info-section">
                    <div class="info-card">
                        <div class="info-header">
                            <i class="fas fa-map-marker-alt me-2"></i>
                            <h5 class="info-title">@Localizer["Regions Information"]</h5>
                        </div>
                        <div class="info-content">
                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-map me-2"></i>
                                    @Localizer["Governorate"]
                                </div>
                                <div class="info-value">
                                    @if (Model.IsEntireCountry)
                                    {
                                        <span class="modern-badge badge-success me-1">
                                            <i class="fas fa-flag me-1"></i>
                                            @Localizer["Entire Country"]
                                        </span>
                                    }
                                    else
                                    {
                                        @foreach (var governorate in Model.Governorates)
                                        {
                                            <span class="modern-badge badge-info me-1">

                                                @if (culture.StartsWith("ar"))
                                                {
                                                    @governorate.AR_Name
                                                }
                                                else
                                                {
                                                    @governorate.EN_Name
                                                }
                                            </span>
                                        }
                                    }
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-location-arrow me-2"></i>
                                    @Localizer["District"]
                                </div>
                                <div class="info-value">
                                    @foreach (var district in Model.Districts)
                                    {
                                        <span class="modern-badge badge-info me-1">
                                            @if (culture.StartsWith("ar"))
                                            {
                                                @district.AR_Name
                                            }
                                            else
                                            {
                                                @district.EN_Name
                                            }
                                         
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-map-pin me-2"></i>
                                    @Localizer["SubDistrict"]
                                </div>
                                <div class="info-value">
                                    @foreach (var subDistrict in Model.SubDistricts)
                                    {
                                        <span class="modern-badge badge-info me-1">
                                           
                                            @if (culture.StartsWith("ar"))
                                            {
                                                @subDistrict.AR_Name
                                            }
                                            else
                                            {
                                                @subDistrict.EN_Name
                                            }
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-users me-2"></i>
                                    @Localizer["Community"]
                                </div>
                                <div class="info-value">
                                    @foreach (var community in Model.Communities)
                                    {
                                        <span class="modern-badge badge-info me-1">
                                            
                                            @if (culture.StartsWith("ar"))
                                            {
                                                @community.AR_Name
                                            }
                                            else
                                            {
                                                @community.EN_Name
                                            }
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Budget Info -->
                <div class="info-section">
                    <div class="info-card">
                        <div class="info-header">
                            <i class="fas fa-dollar-sign me-2"></i>
                            <h5 class="info-title">@Localizer["Financial Information"]</h5>
                        </div>
                        <div class="info-content">
                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-money-bill-wave me-2"></i>
                                    @Localizer["Estimated Budget"]
                                </div>
                                <div class="info-value">
                                    <span class="budget-amount">@Model.CurrencySymbol@Model.EstimatedBudget.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <small class="text-muted ms-1">(@Model.Currency)</small>
                                    @if (Model.EstimatedBudget >= 1000)
                                    {
                                        <div class="mt-1" dir="rtl">
                                            <small class="text-muted">
                                                <i class="fas fa-language me-1"></i>
                                                @ArabicNumberHelper.ToArabicWords(Model.EstimatedBudget)
                                            </small>
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (Model.ProjectDonors != null && Model.ProjectDonors.Any())
                            {
                                <div class="info-row">
                                    <div class="info-label">
                                        <i class="fas fa-hand-holding-usd me-2"></i>
                                        @Localizer["Total Donor Funding"]
                                    </div>
                                    <div class="info-value">
                                        @{
                                            var totalDonorFunding = Model.ProjectDonors.Sum(pd => pd.FundingAmount);
                                            var fundingPercentage = Model.EstimatedBudget > 0 ? (double)(totalDonorFunding / (decimal)Model.EstimatedBudget) * 100 : 0;
                                        }
                                        <span class="budget-amount text-success">@Model.CurrencySymbol@totalDonorFunding.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
                                        <div class="mt-1">
                                            <small class="text-muted">
                                                <i class="fas fa-chart-pie me-1"></i>
                                                @fundingPercentage.ToString("0.##")% @Localizer["of total budget"]
                                            </small>
                                        </div>
                                    </div>
                                </div>

                                <div class="info-row">
                                    <div class="info-label">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        @Localizer["Funding Gap"]
                                    </div>
                                    <div class="info-value">
                                        @{
                                            var remainingBudget = (decimal)Model.EstimatedBudget - totalDonorFunding;
                                            var remainingPercentage = Model.EstimatedBudget > 0 ? (double)(remainingBudget / (decimal)Model.EstimatedBudget) * 100 : 0;
                                        }
                                        <span class="budget-amount @(remainingBudget > 0 ? "text-warning" : "text-success")">@Model.CurrencySymbol@remainingBudget.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
                                        <div class="mt-1">
                                            <small class="text-muted">
                                                <i class="fas fa-chart-pie me-1"></i>
                                                @remainingPercentage.ToString("0.##")% @Localizer["remaining to fund"]
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ═══════════════════════════ RELATED FRAMEWORKS HIERARCHY ═══════════════════════════ -->
    @{
        var linkedIndicators = Model.Indicators?
            .Where(i => i.SubOutput?.Output?.Outcome?.Framework != null)
            .ToList();
    }
    @if (linkedIndicators != null && linkedIndicators.Any())
    {
        var byFramework = linkedIndicators
            .GroupBy(i => i.SubOutput.Output.Outcome.Framework.Code);

        <div class="chart-card mb-4">
            <h3 class="chart-title">
                <i class="fas fa-sitemap me-2"></i>
                @Localizer["Related Frameworks"]
            </h3>
            <div class="chart-content">
                @foreach (var fwGroup in byFramework)
                {
                    var fw = fwGroup.First().SubOutput.Output.Outcome.Framework;
                    <div class="hierarchy-framework mb-3">
                        <!-- Framework -->
                        <div class="hierarchy-level hierarchy-fw">
                            <a asp-action="Index" asp-controller="Outcomes" asp-route-frameworkCode="@fw.Code"
                               class="hierarchy-badge badge-fw text-decoration-none">
                                <i class="fas fa-sitemap me-2"></i>@fw.Name
                            </a>
                        </div>

                        @foreach (var outcomeGroup in fwGroup.GroupBy(i => i.SubOutput.Output.OutcomeCode))
                        {
                            var outcome = outcomeGroup.First().SubOutput.Output.Outcome;
                            <!-- Outcome -->
                            <div class="hierarchy-level hierarchy-outcome">
                                <span class="hierarchy-connector"><i class="fas fa-angle-right"></i></span>
                                <a asp-action="Index" asp-controller="Outputs"
                                   asp-route-frameworkCode="@fw.Code"
                                   asp-route-outcomeCode="@outcome.Code"
                                   class="hierarchy-badge badge-outcome text-decoration-none">
                                    <i class="fas fa-bullseye me-2"></i>@outcome.Name
                                </a>
                            </div>

                            @foreach (var outputGroup in outcomeGroup.GroupBy(i => i.SubOutput.OutputCode))
                            {
                                var output = outputGroup.First().SubOutput.Output;
                                <!-- Output -->
                                <div class="hierarchy-level hierarchy-output">
                                    <span class="hierarchy-connector"><i class="fas fa-angle-right"></i></span>
                                    <a asp-action="Index" asp-controller="SubOutputs"
                                       asp-route-outputCode="@output.Code"
                                       class="hierarchy-badge badge-output text-decoration-none">
                                        <i class="fas fa-layer-group me-2"></i>@output.Name
                                    </a>
                                </div>

                                @foreach (var subOutputGroup in outputGroup.GroupBy(i => i.SubOutputCode))
                                {
                                    var subOutput = subOutputGroup.First().SubOutput;
                                    <!-- SubOutput -->
                                    <div class="hierarchy-level hierarchy-suboutput">
                                        <span class="hierarchy-connector"><i class="fas fa-angle-right"></i></span>
                                        <a asp-action="Index" asp-controller="Indicators"
                                           asp-route-frameworkCode="@fw.Code"
                                           asp-route-subOutputCode="@subOutput.Code"
                                           class="hierarchy-badge badge-suboutput text-decoration-none">
                                            <i class="fas fa-list-ul me-2"></i>@subOutput.Name
                                        </a>
                                    </div>

                                    @foreach (var indicator in subOutputGroup)
                                    {
                                        <!-- Indicator -->
                                        <div class="hierarchy-level hierarchy-indicator">
                                            <span class="hierarchy-connector"><i class="fas fa-angle-right"></i></span>
                                            <a asp-action="Details" asp-controller="Indicators"
                                               asp-route-id="@indicator.IndicatorCode"
                                               class="hierarchy-badge badge-indicator text-decoration-none">
                                                <i class="fas fa-chart-bar me-2"></i>@indicator.Name
                                            </a>
                                        </div>
                                    }
                                }
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }

    <style>
        .hierarchy-framework { border-left: 3px solid var(--primary-color); padding-left: 0; }
        .hierarchy-level { display: flex; align-items: center; margin: 4px 0; }
        .hierarchy-connector { color: #adb5bd; margin: 0 6px 0 12px; }
        .hierarchy-outcome  { padding-left: 1.5rem; }
        .hierarchy-output   { padding-left: 3rem; }
        .hierarchy-suboutput { padding-left: 4.5rem; }
        .hierarchy-indicator { padding-left: 6rem; }
        .hierarchy-badge {
            display: inline-flex; align-items: center;
            padding: 4px 12px; border-radius: 20px;
            font-size: 0.85rem; font-weight: 500;
            transition: opacity 0.2s;
        }
        .hierarchy-badge:hover { opacity: 0.82; }
        .badge-fw         { background: #6f42c1; color: #fff; }
        .badge-outcome    { background: #dc3545; color: #fff; }
        .badge-output     { background: #007bff; color: #fff; }
        .badge-suboutput  { background: #28a745; color: #fff; }
        .badge-indicator  { background: #fd7e14; color: #fff; }
    </style>

    <!-- ═══════════════════════════ PROJECT PHASES ═══════════════════════════ -->
    <div class="chart-card mb-4" id="phases-section">
        <h3 class="chart-title">
            <i class="fas fa-layer-group me-2"></i>
            @Localizer["Project Phases"]
        </h3>
        <div class="chart-content">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted mb-0">
                    @Localizer["Phases define execution stages with weighted contributions to overall project performance."]
                </p>
            </div>

            @{
                double totalPhaseBudget = (Model.Phases != null && Model.Phases.Any()) ? Model.Phases.Sum(pp => pp.Budget) : 0;
                double budgetDiff = Model.EstimatedBudget - totalPhaseBudget;
            }
            @if (Model.Phases != null && Model.Phases.Any())
            {
                <!-- Budget summary -->
                <div class="alert @(Math.Abs(budgetDiff) < 0.01 ? "alert-success" : "alert-warning") py-2 mb-3 small">
                    <i class="fas fa-info-circle me-1"></i>
                    @Localizer["Phase budgets total:"]: <strong>@Model.CurrencySymbol@totalPhaseBudget.ToString("0")</strong>
                    @if (Math.Abs(budgetDiff) >= 0.01)
                    {
                        <span class="ms-2">(@Localizer["Remaining"]: @Model.CurrencySymbol@budgetDiff.ToString("0"))</span>
                    }
                    else
                    {
                        <span class="ms-2 text-success">✓ @Localizer["Fully allocated"]</span>
                    }
                </div>

                <!-- Weight editor (inline AJAX) -->
                <div id="weight-editor" class="mb-3 p-3 bg-light rounded border">
                    <h6 class="mb-2"><i class="fas fa-balance-scale me-1"></i>@Localizer["Phase Weights"] <small class="text-muted">(@Localizer["must sum to 100"])</small></h6>
                    <div class="row g-2 align-items-end" id="weight-inputs">
                        @foreach (var ph in Model.Phases)
                        {
                            <div class="col-auto">
                                <label class="form-label small mb-1">@ph.Name</label>
                                <div class="input-group input-group-sm" style="width:120px">
                                    <input type="number" step="0.01" min="0" max="100"
                                           class="form-control phase-weight-input"
                                           data-phase-id="@ph.Id"
                                           value="@ph.Weight.ToString("0.00")" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mt-2 d-flex align-items-center gap-2">
                        <button id="save-weights-btn" class="btn btn-sm btn-primary" onclick="saveWeights(@Model.ProjectID)">
                            <i class="fas fa-save me-1"></i>@Localizer["Save Weights"]
                        </button>
                        <span id="weight-sum-display" class="small text-muted">
                            @Localizer["Sum"]: <strong id="weight-sum">@Model.Phases.Sum(pp => pp.Weight).ToString("0.00")</strong>
                        </span>
                        <span id="weight-status" class="small"></span>
                    </div>
                </div>

                <!-- Phases table -->
                <div class="modern-table-container">
                    <table class="modern-table">
                        <thead class="table-header">
                            <tr>
                                <th>#</th>
                                <th><i class="fas fa-tag me-1"></i>@Localizer["Phase Name"]</th>
                                <th><i class="fas fa-calendar-alt me-1"></i>@Localizer["Start"]</th>
                                <th><i class="fas fa-calendar-check me-1"></i>@Localizer["End"]</th>
                                <th><i class="fas fa-dollar-sign me-1"></i>@Localizer["Budget"]</th>
                                <th class="text-center"><i class="fas fa-weight me-1"></i>@Localizer["Weight %"]</th>
                                <th class="text-center"><i class="fas fa-check-double me-1"></i>@Localizer["Total Realised"]</th>
                                <th class="text-center"><i class="fas fa-chart-line me-1"></i>@Localizer["Performance %"]</th>
                                <th class="text-center"><i class="fas fa-cogs me-1"></i>@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int phaseIdx = 0;}
                            @foreach (var phase in Model.Phases.OrderBy(pp => pp.StartDate))
                            {
                                phaseIdx++;
                                <tr class="table-row">
                                    <td>@phaseIdx</td>
                                    <td><strong>@phase.Name</strong></td>
                                    <td>@phase.StartDate.ToString("MMM yyyy")</td>
                                    <td>@phase.EndDate.ToString("MMM yyyy")</td>
                                    <td>@Model.CurrencySymbol@phase.Budget.ToString("0")</td>
                                    <td class="text-center">
                                        <span class="modern-badge badge-primary">@phase.Weight.ToString("0.##")%</span>
                                    </td>
                                    <td class="text-center">
                                        @{
                                            double realisedAmount = phase.ActionPlan?.Plans
                                                .Sum(p => (double)p.Realised) ?? 0;
                                        }
                                        <span class="@(realisedAmount > phase.Budget ? "modern-badge badge-danger" : "fw-bold")">@Model.CurrencySymbol@realisedAmount.ToString("0")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="modern-badge @MonitoringAndEvaluationPlatform.Helpers.ProgressBarHelper.GetBadgeClass(phase.PhasePerformance)">
                                            @phase.PhasePerformance.ToString("0.##")%
                                            @if (phase.PhasePerformance >= 100)
                                            {
                                                <i class="fas fa-check-circle ms-1"></i>
                                            }
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @{
                                            var phaseMeasureFiles = phase.Measures?
                                                .SelectMany(m => m.Files ?? Enumerable.Empty<MonitoringAndEvaluationPlatform.Models.MeasureFile>())
                                                .ToList();
                                        }
                                        @if (phaseMeasureFiles != null && phaseMeasureFiles.Any())
                                        {
                                            <div class="mb-2 d-flex flex-wrap gap-1 justify-content-center">
                                                @foreach (var mf in phaseMeasureFiles)
                                                {
                                                    <a href="@mf.FilePath" target="_blank" class="text-decoration-none" title="@mf.FileName">
                                                        <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill border bg-white text-secondary" style="font-size:0.75rem; max-width:160px;">
                                                            <i class="fas fa-file-alt text-primary"></i>
                                                            <span class="text-truncate" style="max-width:110px;">@mf.FileName</span>
                                                            <i class="fas fa-download" style="font-size:0.65rem;"></i>
                                                        </span>
                                                    </a>
                                                }
                                            </div>
                                        }
                                        <div class="btn-group action-buttons" role="group">
                                            <a asp-controller="Measures" asp-action="Index" asp-route-phaseId="@phase.Id"
                                               class="btn btn-outline-info btn-sm action-btn" title="@Localizer["Measures"]">
                                                <i class="fas fa-chart-bar"></i>
                                            </a>
                                            <a asp-controller="ActionPlans" asp-action="ActionPlan" asp-route-phaseId="@phase.Id"
                                               class="btn btn-outline-secondary btn-sm action-btn" title="@Localizer["Action Plan"]">
                                                <i class="fas fa-tasks"></i>
                                            </a>
                                            <a asp-controller="ProjectPhases" asp-action="Edit" asp-route-id="@phase.Id"
                                               class="btn btn-outline-primary btn-sm action-btn" title="@Localizer["Edit"]">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-controller="ProjectPhases" asp-action="Delete" asp-route-id="@phase.Id"
                                                  method="post" style="display:inline"
                                                  onsubmit="return confirm('@Localizer["Delete this phase? Its measures and action plan will also be deleted."]')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm action-btn" title="@Localizer["Delete"]">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="fas fa-layer-group"></i></div>
                    <h5 class="empty-title">@Localizer["No Phases Yet"]</h5>
                    <p class="empty-text">@Localizer["No phases have been added to this project."]</p>
                </div>
            }
        </div>
    </div>

    @{
        double performance = Math.Round(@Model.performance, 2);
        double disbursementPerformance = Math.Round(@Model.DisbursementPerformance, 2);
    }
    <!-- Performance Metrics -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="card-title text-muted">@Localizer["Performance"]</h6>
                    <div class="progress-circle progress-@((int)performance)" data-value="@performance">
                        <span class="progress-circle-value">@performance%</span>
                    </div>
                    <p class="text-muted mt-2 mb-0">@Localizer["Overall project performance"]</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="card-title text-muted">@Localizer["Disbursement"]</h6>
                    <div class="progress-circle progress-@((int)Model.DisbursementPerformance)" data-value="@Model.DisbursementPerformance">
                        <span class="progress-circle-value">@disbursementPerformance%</span>
                    </div>
                    <p class="text-muted mt-2 mb-0">@Localizer["Budget utilization"]</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Project Files Section -->
    <div class="chart-card mb-4">
        <h3 class="chart-title">
            <i class="fas fa-file-alt"></i>
            @Localizer["Uploaded Files"]
        </h3>
        <div class="chart-content">
            @if (Model.ProjectFiles != null && Model.ProjectFiles.Any())
            {
                <div class="modern-table-container">
                    <table class="modern-table">
                        <thead class="table-header">
                            <tr>
                                <th><i class="fas fa-hashtag me-2"></i>#</th>
                                <th><i class="fas fa-file me-2"></i>@Localizer["File Name"]</th>
                                <th class="text-center"><i class="fas fa-cogs me-2"></i>@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.ProjectFiles.Count; i++)
                            {
                                var file = Model.ProjectFiles.ElementAt(i);
                                <tr class="table-row">
                                    <td>@(i + 1)</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="file-icon me-3">
                                                <i class="fas fa-file-alt"></i>
                                            </div>
                                            <span class="file-name">@file.FileName</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group action-buttons" role="group">
                                            @{
                                                var fileExt = System.IO.Path.GetExtension(file.FileName).ToLowerInvariant();
                                                var isViewable = new[] { ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".txt" }.Contains(fileExt);
                                            }
                                            @if (isViewable)
                                            {
                                                <a asp-action="ViewFile" asp-route-id="@file.Id" target="_blank" class="btn btn-outline-primary btn-sm action-btn" title="@Localizer["View"]">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            }
                                            <a asp-action="DownloadFile" asp-route-id="@file.Id" class="btn btn-outline-success btn-sm action-btn" title="@Localizer["Download"]">
                                                <i class="fas fa-download"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger btn-sm action-btn"
                                                    onclick="deleteFile(@file.Id, '@file.FileName')" title="@Localizer["Delete"]">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-folder-open"></i>
                    </div>
                    <h5 class="empty-title">@Localizer["No Files Found"]</h5>
                    <p class="empty-text">@Localizer["No files uploaded for this project."]</p>
                </div>
            }
        </div>
    </div>
</div>



@section Styles {
    <!-- Optimized external CSS -->
    <link rel="stylesheet" href="~/css/project-details.css" asp-append-version="true" />
}

@section Scripts {
    <!-- SweetAlert2 - loaded asynchronously -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>

    <!-- Pass localized strings to JavaScript -->
    <script>
        window.deleteFileStrings = {
            title: '@Localizer["Are you sure?"]',
            text: '@Localizer["This will delete the file"]',
            cancel: '@Localizer["Cancel"]',
            confirm: '@Localizer["Yes, delete it!"]'
        };
        window.saveWeightsStrings = {
            mustSum: '@Localizer["Weights must sum to exactly 100. Current sum:"]',
            saving: '@Localizer["Saving..."]',
            saved: '@Localizer["Saved!"]',
            saveWeights: '@Localizer["Save Weights"]',
            errorSaving: '@Localizer["Error saving weights."]',
            networkError: '@Localizer["Network error saving weights."]'
        };
    </script>

    <!-- Optimized external JavaScript -->
    <script src="~/js/project-details.js" asp-append-version="true" defer></script>

    <!-- Phase weight editor -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputs = document.querySelectorAll('.phase-weight-input');
            const sumEl = document.getElementById('weight-sum');
            const statusEl = document.getElementById('weight-status');

            function updateSum() {
                if (!inputs.length || !sumEl) return;
                let total = 0;
                inputs.forEach(inp => total += parseFloat(inp.value) || 0);
                sumEl.textContent = total.toFixed(2);
                if (Math.abs(total - 100) < 0.01) {
                    statusEl.innerHTML = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>@Localizer["Valid"]</span>';
                } else {
                    statusEl.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>@Localizer["Must sum to 100"]</span>';
                }
            }
            inputs.forEach(inp => inp.addEventListener('input', updateSum));
            updateSum();
        });

        async function saveWeights(projectId) {
            const inputs = document.querySelectorAll('.phase-weight-input');
            const phases = [];
            inputs.forEach(inp => {
                phases.push({ phaseId: parseInt(inp.dataset.phaseId), weight: parseFloat(inp.value) || 0 });
            });

            const total = phases.reduce((s, p) => s + p.weight, 0);
            if (Math.abs(total - 100) > 0.01) {
                alert(window.saveWeightsStrings.mustSum + ' ' + total.toFixed(2));
                return;
            }

            const btn = document.getElementById('save-weights-btn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>' + window.saveWeightsStrings.saving;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const resp = await fetch('/ProjectPhases/UpdateWeights', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({ phases })
                });
                if (resp.ok) {
                    btn.innerHTML = '<i class="fas fa-check me-1"></i>' + window.saveWeightsStrings.saved;
                    btn.classList.replace('btn-primary', 'btn-success');
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    const err = await resp.json();
                    alert(err.message || window.saveWeightsStrings.errorSaving);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-save me-1"></i>' + window.saveWeightsStrings.saveWeights;
                }
            } catch (e) {
                alert(window.saveWeightsStrings.networkError);
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save me-1"></i>' + window.saveWeightsStrings.saveWeights;
            }
        }
    </script>

}

@if (TempData["ClearDraftKey"] is string clearDraftKey && !string.IsNullOrEmpty(clearDraftKey))
{
    <script>
        try { localStorage.removeItem('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(clearDraftKey))'); } catch (e) {}
    </script>
}

