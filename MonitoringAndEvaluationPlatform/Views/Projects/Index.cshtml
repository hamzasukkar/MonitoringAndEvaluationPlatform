@model MonitoringAndEvaluationPlatform.ViewModel.ProgramFilterViewModel
@using MonitoringAndEvaluationPlatform.Helpers
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Localization
@{
    ViewData["Title"] = "Projects Dashboard";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    ViewData["HelpFeature"] = "PROJECTS";
    var culture = Context.Features.Get<IRequestCultureFeature>().RequestCulture.Culture.Name;
}
<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="dashboard-title">
                <i class="fas fa-project-diagram me-3"></i>
                @Localizer["Projects Dashboard"]
            </h1>
            <p class="dashboard-subtitle">
                @Localizer["Filter and analyze project performance with comprehensive insights"]
            </p>
        </div>
        <div class="dashboard-actions d-flex gap-2 align-items-center">
            @await Html.PartialAsync("_HelpButton")
            @if ((User.IsInRole("SystemAdministrator") || User.IsInRole("MinistryStrategyManager")))
            {
                <button type="button" id="deleteSelectedBtn" class="btn btn-danger d-none" onclick="deleteSelectedProjects()">
                    <i class="fas fa-trash-alt me-2"></i>@Localizer["Delete Selected"] (<span id="selectedCount">0</span>)
                </button>
            }
            @{
                // Flatten the current filters into repeated query keys (e.g. SelectedMinistries=1&SelectedMinistries=2)
                // so the model binder rebuilds the List<> properties on ExportExcel exactly as displayed.
                var exportRouteData = new Dictionary<string, string>();
                if (!string.IsNullOrEmpty(Model.SearchQuery)) exportRouteData["SearchQuery"] = Model.SearchQuery;
                if (Model.SelectedFrameworkCode.HasValue) exportRouteData["SelectedFrameworkCode"] = Model.SelectedFrameworkCode.ToString();
                if (Model.SelectedOutcomeCode.HasValue) exportRouteData["SelectedOutcomeCode"] = Model.SelectedOutcomeCode.ToString();
                if (Model.SelectedOutputCode.HasValue) exportRouteData["SelectedOutputCode"] = Model.SelectedOutputCode.ToString();
                if (Model.SelectedSubOutputCode.HasValue) exportRouteData["SelectedSubOutputCode"] = Model.SelectedSubOutputCode.ToString();
                if (Model.SubOutputCode.HasValue) exportRouteData["SubOutputCode"] = Model.SubOutputCode.ToString();
                if (Model.StartDateFrom.HasValue) exportRouteData["StartDateFrom"] = Model.StartDateFrom.Value.ToString("yyyy-MM-dd");
                if (Model.StartDateTo.HasValue) exportRouteData["StartDateTo"] = Model.StartDateTo.Value.ToString("yyyy-MM-dd");
                if (Model.EndDateFrom.HasValue) exportRouteData["EndDateFrom"] = Model.EndDateFrom.Value.ToString("yyyy-MM-dd");
                if (Model.EndDateTo.HasValue) exportRouteData["EndDateTo"] = Model.EndDateTo.Value.ToString("yyyy-MM-dd");
                for (int i = 0; i < Model.SelectedMinistries.Count; i++) exportRouteData[$"SelectedMinistries[{i}]"] = Model.SelectedMinistries[i].ToString();
                for (int i = 0; i < Model.SelectedDonors.Count; i++) exportRouteData[$"SelectedDonors[{i}]"] = Model.SelectedDonors[i].ToString();
                for (int i = 0; i < Model.SelectedSectors.Count; i++) exportRouteData[$"SelectedSectors[{i}]"] = Model.SelectedSectors[i].ToString();
                for (int i = 0; i < Model.SelectedGovernorates.Count; i++) exportRouteData[$"SelectedGovernorates[{i}]"] = Model.SelectedGovernorates[i];
            }
            <a asp-action="ExportExcel" asp-all-route-data="exportRouteData" class="btn btn-success">
                <i class="fas fa-file-excel me-2"></i>@Localizer["Export to Excel"]
            </a>
        </div>
    </div>

    <!-- Hierarchy Filter in Header -->
    <form asp-action="Index" method="get" id="hierarchyFilterForm" class="mt-3">
        <!-- Hidden fields to preserve other filters -->
        @foreach (var ministry in Model.SelectedMinistries)
        {
            <input type="hidden" name="SelectedMinistries" value="@ministry" />
        }
        @foreach (var donor in Model.SelectedDonors)
        {
            <input type="hidden" name="SelectedDonors" value="@donor" />
        }
        @foreach (var sector in Model.SelectedSectors)
        {
            <input type="hidden" name="SelectedSectors" value="@sector" />
        }
        <input type="hidden" id="currentFramework" value="@Model.SelectedFrameworkCode" />
        <input type="hidden" id="currentOutcome" value="@Model.SelectedOutcomeCode" />
        <input type="hidden" id="currentOutput" value="@Model.SelectedOutputCode" />
        <input type="hidden" id="currentSubOutput" value="@Model.SelectedSubOutputCode" />

        <div class="hierarchy-header-filters">
            <div class="d-flex flex-wrap align-items-end gap-3">
                <!-- Search Box -->
                <div class="hierarchy-filter-item search-filter-item">
                    <label class="form-label small mb-1">@Localizer["Search"]</label>
                    <div class="search-input-wrapper">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text"
                               class="form-control form-control-sm search-header-input"
                               id="projectSearch"
                               name="SearchQuery"
                               value="@Model.SearchQuery"
                               placeholder="@Localizer["Search projects, frameworks, indicators..."]"
                               autocomplete="off" />
                        @if (!string.IsNullOrEmpty(Model.SearchQuery))
                        {
                            <button type="button" class="search-clear-btn" id="clearSearch">
                                <i class="fas fa-times"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- Framework Dropdown -->
                <div class="hierarchy-filter-item">
                    <label class="form-label small mb-1">@Localizer["Framework"]</label>
                    <select class="form-select form-select-sm hierarchy-header-select" id="frameworkFilter" name="SelectedFrameworkCode">
                        <option value="">@Localizer["-- All Frameworks --"]</option>
                        @foreach (var framework in Model.Frameworks)
                        {
                            if (Model.SelectedFrameworkCode == framework.Code)
                            {
                                <option value="@framework.Code" selected>@framework.Name</option>
                            }
                            else
                            {
                                <option value="@framework.Code">@framework.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- Outcome Dropdown -->
                <div class="hierarchy-filter-item">
                    <label class="form-label small mb-1">@Localizer["Outcome"]</label>
                    @if (Model.SelectedFrameworkCode.HasValue)
                    {
                        <select class="form-select form-select-sm hierarchy-header-select" id="outcomeFilter" name="SelectedOutcomeCode">
                            <option value="">@Localizer["-- All Outcomes --"]</option>
                        </select>
                    }
                    else
                    {
                        <select class="form-select form-select-sm hierarchy-header-select" id="outcomeFilter" name="SelectedOutcomeCode" disabled>
                            <option value="">@Localizer["-- Select Framework --"]</option>
                        </select>
                    }
                </div>

                <!-- Output Dropdown -->
                <div class="hierarchy-filter-item">
                    <label class="form-label small mb-1">@Localizer["Output"]</label>
                    @if (Model.SelectedOutcomeCode.HasValue)
                    {
                        <select class="form-select form-select-sm hierarchy-header-select" id="outputFilter" name="SelectedOutputCode">
                            <option value="">@Localizer["-- All Outputs --"]</option>
                        </select>
                    }
                    else
                    {
                        <select class="form-select form-select-sm hierarchy-header-select" id="outputFilter" name="SelectedOutputCode" disabled>
                            <option value="">@Localizer["-- Select Outcome --"]</option>
                        </select>
                    }
                </div>

                <!-- SubOutput Dropdown -->
                <div class="hierarchy-filter-item">
                    <label class="form-label small mb-1">@Localizer["SubOutput"]</label>
                    @if (Model.SelectedOutputCode.HasValue)
                    {
                        <select class="form-select form-select-sm hierarchy-header-select" id="subOutputFilter" name="SelectedSubOutputCode">
                            <option value="">@Localizer["-- All SubOutputs --"]</option>
                        </select>
                    }
                    else
                    {
                        <select class="form-select form-select-sm hierarchy-header-select" id="subOutputFilter" name="SelectedSubOutputCode" disabled>
                            <option value="">@Localizer["-- Select Output --"]</option>
                        </select>
                    }
                </div>

                <!-- Clear Filters Button -->
                @if (Model.SelectedFrameworkCode.HasValue || Model.SelectedOutcomeCode.HasValue ||
                     Model.SelectedOutputCode.HasValue || Model.SelectedSubOutputCode.HasValue)
                {
                    <div class="hierarchy-filter-item">
                        <label class="form-label small mb-1">&nbsp;</label>
                        <a href="@Url.Action("Index", new { SelectedMinistries = Model.SelectedMinistries, SelectedDonors = Model.SelectedDonors, SelectedSectors = Model.SelectedSectors })" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-times me-1"></i>@Localizer["Clear"]
                        </a>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

@{
    // ── Active-filter chips ──────────────────────────────────────────────
    // Build the full set of current filters as repeated query keys, then each
    // chip's remove-link rebuilds that set with one value dropped.
    var baseRoute = new Dictionary<string, string>();
    if (!string.IsNullOrEmpty(Model.SearchQuery)) baseRoute["SearchQuery"] = Model.SearchQuery;
    if (Model.SelectedFrameworkCode.HasValue) baseRoute["SelectedFrameworkCode"] = Model.SelectedFrameworkCode.ToString();
    if (Model.SelectedOutcomeCode.HasValue) baseRoute["SelectedOutcomeCode"] = Model.SelectedOutcomeCode.ToString();
    if (Model.SelectedOutputCode.HasValue) baseRoute["SelectedOutputCode"] = Model.SelectedOutputCode.ToString();
    if (Model.SelectedSubOutputCode.HasValue) baseRoute["SelectedSubOutputCode"] = Model.SelectedSubOutputCode.ToString();
    if (Model.SubOutputCode.HasValue) baseRoute["SubOutputCode"] = Model.SubOutputCode.ToString();
    if (Model.StartDateFrom.HasValue) baseRoute["StartDateFrom"] = Model.StartDateFrom.Value.ToString("yyyy-MM-dd");
    if (Model.StartDateTo.HasValue) baseRoute["StartDateTo"] = Model.StartDateTo.Value.ToString("yyyy-MM-dd");
    if (Model.EndDateFrom.HasValue) baseRoute["EndDateFrom"] = Model.EndDateFrom.Value.ToString("yyyy-MM-dd");
    if (Model.EndDateTo.HasValue) baseRoute["EndDateTo"] = Model.EndDateTo.Value.ToString("yyyy-MM-dd");
    for (int i = 0; i < Model.SelectedMinistries.Count; i++) baseRoute[$"SelectedMinistries[{i}]"] = Model.SelectedMinistries[i].ToString();
    for (int i = 0; i < Model.SelectedDonors.Count; i++) baseRoute[$"SelectedDonors[{i}]"] = Model.SelectedDonors[i].ToString();
    for (int i = 0; i < Model.SelectedSectors.Count; i++) baseRoute[$"SelectedSectors[{i}]"] = Model.SelectedSectors[i].ToString();
    for (int i = 0; i < Model.SelectedPublicSectorTypes.Count; i++) baseRoute[$"SelectedPublicSectorTypes[{i}]"] = Model.SelectedPublicSectorTypes[i].ToString();
    for (int i = 0; i < Model.SelectedGovernorates.Count; i++) baseRoute[$"SelectedGovernorates[{i}]"] = Model.SelectedGovernorates[i];

    // Helper: produce a route dict with a single key removed (for list filters,
    // we drop the whole list and re-add every value except the removed one).
    Func<string, object, Dictionary<string, string>> routeWithout = (listName, removeValue) =>
    {
        var rd = new Dictionary<string, string>(baseRoute);
        // Drop all indexed entries for this list
        var keysToRemove = rd.Keys.Where(k => k.StartsWith(listName + "[")).ToList();
        foreach (var k in keysToRemove) rd.Remove(k);
        return rd;
    };

    bool hasAnyChip = baseRoute.Count > 0;
}

@if (hasAnyChip)
{
    <div class="active-filters-bar">
        <span class="active-filters-label"><i class="fas fa-filter me-1"></i>@Localizer["Active Filters"]:</span>

        @* Search *@
        @if (!string.IsNullOrEmpty(Model.SearchQuery))
        {
            var rd = new Dictionary<string, string>(baseRoute); rd.Remove("SearchQuery");
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["Search"]</span>
                <span class="chip-val">@Model.SearchQuery</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }

        @* Framework hierarchy — show the deepest selected level only *@
        @if (Model.SelectedSubOutputCode.HasValue && !string.IsNullOrEmpty(Model.SubOutputName))
        {
            var rd = new Dictionary<string, string>(baseRoute); rd.Remove("SelectedSubOutputCode");
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["SubOutput"]</span>
                <span class="chip-val">@Model.SubOutputName</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }
        else if (Model.SelectedOutputCode.HasValue && !string.IsNullOrEmpty(Model.OutputName))
        {
            var rd = new Dictionary<string, string>(baseRoute); rd.Remove("SelectedOutputCode");
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["Output"]</span>
                <span class="chip-val">@Model.OutputName</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }
        else if (Model.SelectedOutcomeCode.HasValue && !string.IsNullOrEmpty(Model.OutcomeName))
        {
            var rd = new Dictionary<string, string>(baseRoute); rd.Remove("SelectedOutcomeCode");
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["Outcome"]</span>
                <span class="chip-val">@Model.OutcomeName</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }
        else if (Model.SelectedFrameworkCode.HasValue && !string.IsNullOrEmpty(Model.FrameworkName))
        {
            var rd = new Dictionary<string, string>(baseRoute); rd.Remove("SelectedFrameworkCode");
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["Framework"]</span>
                <span class="chip-val">@Model.FrameworkName</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }

        @* Ministries *@
        @foreach (var code in Model.SelectedMinistries)
        {
            var m = Model.Ministries.FirstOrDefault(x => x.Code == code);
            if (m == null) { continue; }
            var name = culture.StartsWith("ar") ? m.MinistryDisplayName_AR : m.MinistryDisplayName_EN;
            var rd = new Dictionary<string, string>(routeWithout("SelectedMinistries", code));
            var idx = 0;
            foreach (var other in Model.SelectedMinistries.Where(c => c != code)) { rd[$"SelectedMinistries[{idx++}]"] = other.ToString(); }
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["Ministry"]</span>
                <span class="chip-val">@name</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }

        @* Donors *@
        @foreach (var code in Model.SelectedDonors)
        {
            var d = Model.Donors.FirstOrDefault(x => x.Code == code);
            if (d == null) { continue; }
            var rd = new Dictionary<string, string>(routeWithout("SelectedDonors", code));
            var idx = 0;
            foreach (var other in Model.SelectedDonors.Where(c => c != code)) { rd[$"SelectedDonors[{idx++}]"] = other.ToString(); }
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["Donor"]</span>
                <span class="chip-val">@d.Partner</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }

        @* Sectors *@
        @foreach (var code in Model.SelectedSectors)
        {
            var s = Model.Sectors.FirstOrDefault(x => x.Code == code);
            if (s == null) { continue; }
            var name = culture.StartsWith("ar") ? s.AR_Name : s.EN_Name;
            var rd = new Dictionary<string, string>(routeWithout("SelectedSectors", code));
            var idx = 0;
            foreach (var other in Model.SelectedSectors.Where(c => c != code)) { rd[$"SelectedSectors[{idx++}]"] = other.ToString(); }
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["Sector"]</span>
                <span class="chip-val">@name</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }

        @* Public Sector Types *@
        @foreach (var code in Model.SelectedPublicSectorTypes)
        {
            var t = Model.PublicSectorTypes.FirstOrDefault(x => x.Code == code);
            if (t == null) { continue; }
            var name = culture.StartsWith("ar") ? t.AR_Name : t.EN_Name;
            var rd = new Dictionary<string, string>(routeWithout("SelectedPublicSectorTypes", code));
            var idx = 0;
            foreach (var other in Model.SelectedPublicSectorTypes.Where(c => c != code)) { rd[$"SelectedPublicSectorTypes[{idx++}]"] = other.ToString(); }
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["Public Sector Type"]</span>
                <span class="chip-val">@name</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }

        @* Governorates *@
        @foreach (var code in Model.SelectedGovernorates)
        {
            var g = Model.Governorates.FirstOrDefault(x => x.Code == code);
            if (g == null) { continue; }
            var name = culture.StartsWith("ar") ? g.AR_Name : g.EN_Name;
            var rd = new Dictionary<string, string>(routeWithout("SelectedGovernorates", code));
            var idx = 0;
            foreach (var other in Model.SelectedGovernorates.Where(c => c != code)) { rd[$"SelectedGovernorates[{idx++}]"] = other; }
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["Governorate"]</span>
                <span class="chip-val">@name</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }

        @* Date filters *@
        @if (Model.StartDateFrom.HasValue)
        {
            var rd = new Dictionary<string, string>(baseRoute); rd.Remove("StartDateFrom");
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["Start Date"] @Localizer["From"]</span>
                <span class="chip-val">@Model.StartDateFrom.Value.ToString("MMM yyyy")</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }
        @if (Model.StartDateTo.HasValue)
        {
            var rd = new Dictionary<string, string>(baseRoute); rd.Remove("StartDateTo");
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["Start Date"] @Localizer["To"]</span>
                <span class="chip-val">@Model.StartDateTo.Value.ToString("MMM yyyy")</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }
        @if (Model.EndDateFrom.HasValue)
        {
            var rd = new Dictionary<string, string>(baseRoute); rd.Remove("EndDateFrom");
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["End Date"] @Localizer["From"]</span>
                <span class="chip-val">@Model.EndDateFrom.Value.ToString("MMM yyyy")</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }
        @if (Model.EndDateTo.HasValue)
        {
            var rd = new Dictionary<string, string>(baseRoute); rd.Remove("EndDateTo");
            <a asp-action="Index" asp-all-route-data="rd" class="filter-chip">
                <span class="chip-key">@Localizer["End Date"] @Localizer["To"]</span>
                <span class="chip-val">@Model.EndDateTo.Value.ToString("MMM yyyy")</span>
                <i class="fas fa-times chip-x"></i>
            </a>
        }

        @* Clear all *@
        <a asp-action="Index" class="filter-chip filter-chip-clear-all">
            <i class="fas fa-times-circle me-1"></i>@Localizer["Clear All"]
        </a>
    </div>
}

<!-- Summary Statistics Cards -->
<div class="summary-cards-container">
    <div class="row g-3">
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-total">
                <div class="summary-card-icon">
                    <i class="fas fa-project-diagram"></i>
                </div>
                <div class="summary-card-content">
                    <div class="summary-card-value">@Model.TotalProjects.ToString("N0")</div>
                    <div class="summary-card-label">@Localizer["Total Projects"]</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-not-started">
                <div class="summary-card-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="summary-card-content">
                    <div class="summary-card-value">@Model.NotStartedProjects.ToString("N0")</div>
                    <div class="summary-card-label">@Localizer["Not Started"]</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-in-progress">
                <div class="summary-card-icon">
                    <i class="fas fa-spinner"></i>
                </div>
                <div class="summary-card-content">
                    <div class="summary-card-value">@Model.InProgressProjects.ToString("N0")</div>
                    <div class="summary-card-label">@Localizer["In Progress"]</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-completed">
                <div class="summary-card-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="summary-card-content">
                    <div class="summary-card-value">@Model.CompletedProjects.ToString("N0")</div>
                    <div class="summary-card-label">@Localizer["Completed"]</div>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-3 mt-2">
        <div class="col-12">
            <div class="summary-card summary-card-budget">
                <div class="summary-card-icon">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="summary-card-content">
                    <div class="summary-card-value">@Model.TotalBudget.ToString("N0")</div>
                    <div class="summary-card-label">@Localizer["Total Budget"]</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">

    <div class="row">
        <!-- Filter Sidebar -->
        <div class="col-md-3">
            <div class="chart-card mb-4">
                <h3 class="chart-title">
                    <i class="fas fa-filter"></i>
                    @Localizer["Filters"]
                </h3>
                <div class="chart-content">
                    <form asp-action="Index" method="get" id="sidebarFilterForm">
                        <!-- Hidden fields to preserve hierarchy selections -->
                        <input type="hidden" name="SelectedFrameworkCode" value="@Model.SelectedFrameworkCode" />
                        <input type="hidden" name="SelectedOutcomeCode" value="@Model.SelectedOutcomeCode" />
                        <input type="hidden" name="SelectedOutputCode" value="@Model.SelectedOutputCode" />
                        <input type="hidden" name="SelectedSubOutputCode" value="@Model.SelectedSubOutputCode" />

                        <!-- Ministry Filter -->
                        @if (!Model.IsMinistryUser)
                        {
                            <div class="mb-4">
                                <h6 class="filter-section-title">@Localizer["Ministry"]</h6>
                                <div class="filter-options-modern" >
                                    @foreach (var ministry in Model.Ministries)
                                    {
                                        <div class="modern-checkbox">
                                            <input class="modern-checkbox-input" type="checkbox" name="SelectedMinistries"
                                                   value="@ministry.Code" id="ministry-@ministry.Code"
                                            @(Model.SelectedMinistries.Contains(ministry.Code) ? "checked" : "")>
                                            <label class="modern-checkbox-label" for="ministry-@ministry.Code">
                                                <span class="checkbox-custom"></span>
                                                <span class="checkbox-text">
                                                    @if (!string.IsNullOrEmpty(ministry.Logo))
                                                    {
                                                        <span class="ministry-logo me-1">@ministry.Logo</span>
                                                    }
                                                    @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? ministry.MinistryDisplayName_AR : ministry.MinistryDisplayName_EN)
                                                </span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>

                        }


                        <!-- Donor Filter -->
                        <div class="mb-4">
                            <h6 class="filter-section-title">@Localizer["Donor"]</h6>
                            <div class="filter-options-modern" >
                                @foreach (var donor in Model.Donors)
                                {
                                    <div class="modern-checkbox">
                                        <input class="modern-checkbox-input" type="checkbox" name="SelectedDonors"
                                               value="@donor.Code" id="donor-@donor.Code"
                                        @(Model.SelectedDonors.Contains(donor.Code) ? "checked" : "")>
                                        <label class="modern-checkbox-label" for="donor-@donor.Code">
                                            <span class="checkbox-custom"></span>
                                            <span class="checkbox-text">@donor.Partner</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Sector Filter -->
                        <div class="mb-4">
                            <h6 class="filter-section-title">@Localizer["Sector"]</h6>
                            <div class="filter-options-modern">
                                @foreach (var sector in Model.Sectors)
                                {
                                    <div class="modern-checkbox">
                                        <input class="modern-checkbox-input" type="checkbox" name="SelectedSectors"
                                               value="@sector.Code" id="sector-@sector.Code"
                                        @(Model.SelectedSectors.Contains(sector.Code) ? "checked" : "")>
                                        <label class="modern-checkbox-label" for="sector-@sector.Code">
                                            <span class="checkbox-custom"></span>
                                            @if (culture.StartsWith("ar"))
                                            {
                                                @sector.AR_Name
                                            }
                                            else
                                            {
                                                @sector.EN_Name
                                            }
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Public Sector Type Filter -->
                        <div class="mb-4">
                            <h6 class="filter-section-title">@Localizer["Public Sector Type"]</h6>
                            <div class="filter-options-modern">
                                @foreach (var publicSectorType in Model.PublicSectorTypes)
                                {
                                    <div class="modern-checkbox">
                                        <input class="modern-checkbox-input" type="checkbox" name="SelectedPublicSectorTypes"
                                               value="@publicSectorType.Code" id="public-sector-type-@publicSectorType.Code"
                                        @(Model.SelectedPublicSectorTypes.Contains(publicSectorType.Code) ? "checked" : "")>
                                        <label class="modern-checkbox-label" for="public-sector-type-@publicSectorType.Code">
                                            <span class="checkbox-custom"></span>
                                            @if (culture.StartsWith("ar"))
                                            {
                                                @publicSectorType.AR_Name
                                            }
                                            else
                                            {
                                                @publicSectorType.EN_Name
                                            }
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Governorate Filter -->
                        <div class="mb-4">
                            <h6 class="filter-section-title">@Localizer["Governorate"]</h6>
                            <div class="filter-options-modern">
                                @foreach (var governorate in Model.Governorates)
                                {
                                    <div class="modern-checkbox">
                                        <input class="modern-checkbox-input" type="checkbox" name="SelectedGovernorates"
                                               value="@governorate.Code" id="governorate-@governorate.Code"
                                        @(Model.SelectedGovernorates.Contains(governorate.Code) ? "checked" : "")>
                                        <label class="modern-checkbox-label" for="governorate-@governorate.Code">
                                            <span class="checkbox-custom"></span>
                                            @if (culture.StartsWith("ar"))
                                            {
                                                @governorate.AR_Name
                                            }
                                            else
                                            {
                                                @governorate.EN_Name
                                            }
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Date Filters -->
                        <div class="mb-4">
                            <h6 class="filter-section-title">@Localizer["Start Date"]</h6>
                            <div class="date-filter-group">
                                <div class="date-input-wrapper">
                                    <label class="date-label">@Localizer["From"]</label>
                                    <div class="month-year-picker">
                                        <input type="hidden" name="StartDateFrom" id="StartDateFrom" value="@(Model.StartDateFrom?.ToString("yyyy-MM") ?? "")" />
                                        <div class="d-flex align-items-center gap-1">
                                            <select class="form-control form-control-sm mypicker-month" style="max-width:65px">
                                                <option value="">--</option>
                                                @for (int _m = 1; _m <= 12; _m++) { <option value="@_m">@_m</option> }
                                            </select>
                                            <span class="text-muted fw-bold">/</span>
                                            <input type="number" class="form-control form-control-sm mypicker-year" min="2000" max="2100" style="max-width:82px" placeholder="YYYY" />
                                        </div>
                                    </div>
                                </div>
                                <div class="date-input-wrapper">
                                    <label class="date-label">@Localizer["To"]</label>
                                    <div class="month-year-picker">
                                        <input type="hidden" name="StartDateTo" id="StartDateTo" value="@(Model.StartDateTo?.ToString("yyyy-MM") ?? "")" />
                                        <div class="d-flex align-items-center gap-1">
                                            <select class="form-control form-control-sm mypicker-month" style="max-width:65px">
                                                <option value="">--</option>
                                                @for (int _m = 1; _m <= 12; _m++) { <option value="@_m">@_m</option> }
                                            </select>
                                            <span class="text-muted fw-bold">/</span>
                                            <input type="number" class="form-control form-control-sm mypicker-year" min="2000" max="2100" style="max-width:82px" placeholder="YYYY" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h6 class="filter-section-title">@Localizer["End Date"]</h6>
                            <div class="date-filter-group">
                                <div class="date-input-wrapper">
                                    <label class="date-label">@Localizer["From"]</label>
                                    <div class="month-year-picker">
                                        <input type="hidden" name="EndDateFrom" id="EndDateFrom" value="@(Model.EndDateFrom?.ToString("yyyy-MM") ?? "")" />
                                        <div class="d-flex align-items-center gap-1">
                                            <select class="form-control form-control-sm mypicker-month" style="max-width:65px">
                                                <option value="">--</option>
                                                @for (int _m = 1; _m <= 12; _m++) { <option value="@_m">@_m</option> }
                                            </select>
                                            <span class="text-muted fw-bold">/</span>
                                            <input type="number" class="form-control form-control-sm mypicker-year" min="2000" max="2100" style="max-width:82px" placeholder="YYYY" />
                                        </div>
                                    </div>
                                </div>
                                <div class="date-input-wrapper">
                                    <label class="date-label">@Localizer["To"]</label>
                                    <div class="month-year-picker">
                                        <input type="hidden" name="EndDateTo" id="EndDateTo" value="@(Model.EndDateTo?.ToString("yyyy-MM") ?? "")" />
                                        <div class="d-flex align-items-center gap-1">
                                            <select class="form-control form-control-sm mypicker-month" style="max-width:65px">
                                                <option value="">--</option>
                                                @for (int _m = 1; _m <= 12; _m++) { <option value="@_m">@_m</option> }
                                            </select>
                                            <span class="text-muted fw-bold">/</span>
                                            <input type="number" class="form-control form-control-sm mypicker-year" min="2000" max="2100" style="max-width:82px" placeholder="YYYY" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="filter-actions">
                            <button type="submit" class="btn btn-gradient-primary">
                                <i class="fas fa-filter me-2"></i>@Localizer["Apply Filters"]
                            </button>
                            <a asp-action="Index" class="btn btn-modern-secondary">
                                <i class="fas fa-sync-alt me-2"></i>@Localizer["Reset"]
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Projects Table -->
        <div class="col-md-9">
            <div class="chart-card">
                <h3 class="chart-title">
                    <i class="fas fa-list"></i>
                    @Localizer["Projects Overview"]
                    @if (Model.SubOutputCode.HasValue && !string.IsNullOrEmpty(Model.SubOutputName))
                    {
                        <span class="badge bg-info ms-3">
                            <i class="fas fa-filter me-2"></i>@Localizer["Filtered by SubOutput"]: @Model.SubOutputName
                        </span>
                    }
                    @if (Model.SelectedFrameworkCode.HasValue || Model.SelectedOutcomeCode.HasValue ||
                         Model.SelectedOutputCode.HasValue || Model.SelectedSubOutputCode.HasValue)
                    {
                        <span class="badge bg-primary ms-2">
                            <i class="fas fa-sitemap me-2"></i>
                            @if (Model.SelectedSubOutputCode.HasValue && !string.IsNullOrEmpty(Model.SubOutputName))
                            {
                                <text>@Localizer["SubOutput"]: @Model.SubOutputName</text>
                            }
                            else if (Model.SelectedOutputCode.HasValue && !string.IsNullOrEmpty(Model.OutputName))
                            {
                                <text>@Localizer["Output"]: @Model.OutputName</text>
                            }
                            else if (Model.SelectedOutcomeCode.HasValue && !string.IsNullOrEmpty(Model.OutcomeName))
                            {
                                <text>@Localizer["Outcome"]: @Model.OutcomeName</text>
                            }
                            else if (Model.SelectedFrameworkCode.HasValue && !string.IsNullOrEmpty(Model.FrameworkName))
                            {
                                <text>@Localizer["Framework"]: @Model.FrameworkName</text>
                            }
                        </span>
                    }
                </h3>
                <div class="chart-content">
                    <div class="modern-table-container">
                        <table class="modern-table">
                            <thead class="table-header">
                                <tr>
                                    @if ((User.IsInRole("SystemAdministrator") || User.IsInRole("MinistryStrategyManager")))
                                    {
                                        <th style="width:48px; text-align:center;">
                                            <input type="checkbox" id="selectAllCheckbox" class="project-checkbox" title="@Localizer["Select All"]" style="width:18px;height:18px;cursor:pointer;" />
                                        </th>
                                    }
                                    <th>
                                        <i class="fas fa-project-diagram me-2"></i>@Localizer["Project Name"]
                                    </th>
                                    <th>
                                        <i class="fas fa-landmark me-2"></i>@Localizer["Ministry"]
                                    </th>
                                    <th>
                                        <i class="fas fa-sitemap me-2"></i>@Localizer["Framework"]
                                    </th>
                                    <th class="text-center">
                                        <i class="fas fa-calendar-alt me-2"></i>@Localizer["Start Date"]
                                    </th>
                                    <th class="text-center">
                                        <i class="fas fa-calendar-check me-2"></i>@Localizer["End Date"]
                                    </th>
                                    <th class="text-center sortable-header" onclick="sortProjectsTable('lastmodified')" style="cursor: pointer;">
                                        <i class="fas fa-history me-2"></i>@Localizer["Last Modified"]
                                        <i class="fas fa-sort ms-2" id="lastmodified-sort-icon"></i>
                                    </th>
                                    <th class="text-center">
                                        <i class="fas fa-info-circle me-2"></i>@Localizer["Status"]
                                    </th>
                                    <th class="text-center sortable-header" onclick="sortProjectsTable('performance')" style="cursor: pointer;">
                                        <i class="fas fa-chart-line me-2"></i>@Localizer["Performance"]
                                        <i class="fas fa-sort ms-2" id="performance-sort-icon"></i>
                                    </th>
                                    <th class="text-center sortable-header" onclick="sortProjectsTable('disbursement')" style="cursor: pointer;">
                                        <i class="fas fa-dollar-sign me-2"></i>@Localizer["Disbursement"]
                                        <i class="fas fa-sort ms-2" id="disbursement-sort-icon"></i>
                                    </th>
                                    <th class="text-center">
                                        <i class="fas fa-cogs me-2"></i>@Localizer["Actions"]
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="projectsTableBody">
                                @{
                                    var hasSelectColumn = User.IsInRole("SystemAdministrator") || User.IsInRole("MinistryStrategyManager");
                                    var emptyColspan = hasSelectColumn ? 11 : 10;
                                    var hasActiveFilters = hasAnyChip;
                                }
                                @if (!Model.Projects.Any())
                                {
                                    <tr class="empty-state-row">
                                        <td colspan="@emptyColspan">
                                            <div class="empty-state">
                                                <i class="fas fa-folder-open empty-state-icon"></i>
                                                @if (hasActiveFilters)
                                                {
                                                    <div class="empty-state-title">@Localizer["No projects match these filters"]</div>
                                                    <div class="empty-state-text">@Localizer["Try adjusting or clearing your filters to see more results."]</div>
                                                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2">
                                                        <i class="fas fa-times-circle me-1"></i>@Localizer["Clear All"]
                                                    </a>
                                                }
                                                else
                                                {
                                                    <div class="empty-state-title">@Localizer["No projects yet"]</div>
                                                    <div class="empty-state-text">@Localizer["Get started by creating your first project."]</div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @foreach (var item in Model.Projects)
                                {
                                    double performance = Math.Round(@item.performance, 2);
                                    double disbursement = Math.Round(item.DisbursementPerformance, 2);
                                    string performanceClass = ProgressBarHelper.GetProgressBarClass(performance);
                                    string disbursementClass = ProgressBarHelper.GetProgressBarClass(item.DisbursementPerformance);
                                    var rowId = "row_" + item.ProjectID;

                                    // Calculate project status based on performance
                                    string statusText;
                                    string statusClass;
                                    string statusIcon;
                                    if (performance == 0)
                                    {
                                        statusText = Localizer["Not Started"].Value;
                                        statusClass = "status-not-started";
                                        statusIcon = "fa-clock";
                                    }
                                    else if (performance > 0 && performance < 100)
                                    {
                                        statusText = Localizer["In Progress"].Value;
                                        statusClass = "status-in-progress";
                                        statusIcon = "fa-spinner";
                                    }
                                    else
                                    {
                                        statusText = Localizer["Completed"].Value;
                                        statusClass = "status-completed";
                                        statusIcon = "fa-check-circle";
                                    }

                                    <tr id="row_@item.ProjectID" class="table-row" data-performance="@performance" data-disbursement="@disbursement" data-lastmodified="@(new DateTimeOffset(DateTime.SpecifyKind(item.LastModifiedAt, DateTimeKind.Utc)).ToUnixTimeMilliseconds())">
                                        @if ((User.IsInRole("SystemAdministrator") || User.IsInRole("MinistryStrategyManager")))
                                        {
                                            <td style="text-align:center; vertical-align:middle;">
                                                <input type="checkbox" class="project-row-checkbox" data-id="@item.ProjectID" style="width:18px;height:18px;cursor:pointer;" />
                                            </td>
                                        }
                                        <td class="project-name-cell">
                                            <div class="d-flex align-items-center">
                                                <div class="project-icon me-3">
                                                    <i class="fas fa-project-diagram"></i>
                                                </div>
                                                <div>
                                                    <a href="@Url.Action("Details", "Projects", new { id = item.ProjectID })" class="project-name fw-semibold">@item.ProjectName</a>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @{
                                                var ministryNames = (item.Ministries ?? new List<MonitoringAndEvaluationPlatform.Models.Ministry>())
                                                    .Select(m => culture.StartsWith("ar") ? m.MinistryDisplayName_AR : m.MinistryDisplayName_EN)
                                                    .Where(n => !string.IsNullOrWhiteSpace(n))
                                                    .Distinct()
                                                    .ToList();
                                            }
                                            @if (ministryNames.Any())
                                            {
                                                foreach (var name in ministryNames)
                                                {
                                                    <span class="relation-badge relation-badge-ministry">@name</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">@Localizer["—"]</span>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                var frameworkNames = (item.Indicators ?? new List<MonitoringAndEvaluationPlatform.Models.Indicator>())
                                                    .Select(i => i.SubOutput?.Output?.Outcome?.Framework?.Name)
                                                    .Where(n => !string.IsNullOrWhiteSpace(n))
                                                    .Distinct()
                                                    .ToList();
                                            }
                                            @if (frameworkNames.Any())
                                            {
                                                foreach (var name in frameworkNames)
                                                {
                                                    <span class="relation-badge relation-badge-framework">@name</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">@Localizer["—"]</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <span class="date-cell">@item.StartDate.ToString("MMM yyyy")</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="date-cell">@item.EndDate.ToString("MMM yyyy")</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="date-cell">@DateTime.SpecifyKind(item.LastModifiedAt, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="status-badge @statusClass">
                                                <i class="fas @statusIcon me-1"></i>@statusText
                                            </span>
                                        </td>
                                        <td class="text-center" title="@Localizer["Performance"]: @performance%">
                                            @await Html.PartialAsync("_ProgressBar", Tuple.Create(performance, performanceClass))
                                        </td>
                                        <td class="text-center" title="@Localizer["Disbursement"]: @Math.Round(item.DisbursementPerformance, 2)%">
                                            @await Html.PartialAsync("_ProgressBar", Tuple.Create(item.DisbursementPerformance, disbursementClass))
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group action-buttons" role="group">
                                                <a asp-action="Details" asp-route-id="@item.ProjectID" class="btn btn-outline-info btn-sm action-btn" title="@Localizer["View Details"]">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <button type="button" class="btn btn-outline-primary btn-sm action-btn"
                                                        onclick="editProjectName(@item.ProjectID, '@item.ProjectName.Replace("'", "\\'")')" title="@Localizer["Edit Project"]">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger btn-sm action-btn"
                                                        onclick="deleteProject(@item.ProjectID)" title="@Localizer["Delete Project"]">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                                @if (User.IsInRole("SystemAdministrator"))
                                                {
                                                    <a asp-controller="AuditLogs" asp-action="ProjectHistory" asp-route-projectId="@item.ProjectID"
                                                       class="btn btn-outline-secondary btn-sm action-btn" title="@Localizer["Project History"]">
                                                        <i class="fas fa-history"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @Html.AntiForgeryToken() <!-- Required for AJAX security -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /* Summary Cards Styles */
        .summary-cards-container {
            padding: 20px 30px;
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.5) 0%, rgba(51, 65, 85, 0.5) 100%);
        }

        .summary-card {
            display: flex;
            align-items: center;
            padding: 20px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.3s ease;
        }

        .summary-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }

        .summary-card-icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
            margin-right: 15px;
        }

        html[dir="rtl"] .summary-card-icon {
            margin-right: 0;
            margin-left: 15px;
        }

        .summary-card-content {
            flex: 1;
        }

        .summary-card-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: white;
            line-height: 1.2;
        }

        .summary-card-label {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.7);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .summary-card-total .summary-card-icon {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
        }

        .summary-card-not-started .summary-card-icon {
            background: linear-gradient(135deg, #64748b, #94a3b8);
        }

        .summary-card-in-progress .summary-card-icon {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
        }

        .summary-card-completed .summary-card-icon {
            background: linear-gradient(135deg, #10b981, #34d399);
        }

        .summary-card-budget .summary-card-icon {
            background: linear-gradient(135deg, #3b82f6, #60a5fa);
        }

        .summary-card-budget {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(96, 165, 250, 0.2));
        }

        /* Modern Table Styles */
        .modern-table {
            width:100%;
            background: transparent;
            border: none;
            border-radius: 15px;
            overflow: hidden;
        }

        .table-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            color: white;
        }

        .table-header th {
            border: none;
            padding: 20px 15px;
            font-weight: 600;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-row {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: none;
            transition: all 0.3s ease;
        }

        .table-row:hover {
            background: rgba(255, 255, 255, 1);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .table-row td {
            border: none;
            padding: 20px 15px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .project-name-cell {
            min-width: 250px;
        }

        .project-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }

        .project-name {
            color: #333;
            text-decoration: none;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .project-name:hover {
            color: var(--primary-color);
            text-decoration: none;
            transform: translateX(5px);
        }

        .action-buttons {
            gap: 5px;
        }

        .action-btn {
            width: 35px;
            height: 35px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            border-width: 1px;
        }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

        .modern-table-container {
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .filter-section-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-color);
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
    }

    .filter-section-title::before {
        content: '';
        width: 4px;
        height: 20px;
        background: linear-gradient(45deg, var(--primary-color), var(--primary-light));
        border-radius: 2px;
        margin-right: 0.75rem;
    }

    .filter-options-modern {
        max-height: 200px;
        overflow-y: auto;
        padding-right: 0.5rem;
    }

    .modern-checkbox {
        margin-bottom: 0.75rem;
        position: relative;
    }

    .modern-checkbox-input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
    }

    .modern-checkbox-label {
        display: flex;
        align-items: center;
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        color: var(--text-color);
        font-weight: 500;
    }

    .modern-checkbox-label:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateX(5px);
    }

    .checkbox-custom {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 4px;
        margin-right: 0.75rem;
