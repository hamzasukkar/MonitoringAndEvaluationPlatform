<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    const token = $('input[name="__RequestVerificationToken"]').val();

    function editProjectName(projectId, currentName) {
        Swal.fire({
            title: '@Localizer["Edit Project Name"]',
            input: 'text',
            inputLabel: '@Localizer["Project Name"]',
            inputValue: currentName,
            showCancelButton: true,
            confirmButtonText: '@Localizer["Save"]',
            cancelButtonText: '@Localizer["Cancel"]',
            confirmButtonColor: 'var(--primary-color)',
            cancelButtonColor: 'var(--secondary-color)',
            preConfirm: (newName) => {
                if (!newName.trim()) {
                    Swal.showValidationMessage('@Localizer["Project name cannot be empty"]');
                }
                return newName.trim();
            },
            customClass: {
                popup: 'modern-swal-popup',
                title: 'modern-swal-title',
                input: 'modern-swal-input'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Projects/UpdateProjectName',
                    type: 'POST',
                    data: {
                        projectId: projectId,
                        projectName: result.value,
                        __RequestVerificationToken: token
                    },
                    success: function () {
                        $(`#row_${projectId} .project-name`).text(result.value);
                        Swal.fire({
                            title: '@Localizer["Updated!"]',
                            text: '@Localizer["Project name has been updated."]',
                            icon: 'success',
                            confirmButtonColor: 'var(--primary-color)',
                            customClass: {
                                popup: 'modern-swal-popup'
                            }
                        });
                        $(`#row_${projectId}`).addClass('table-row-success');
                        setTimeout(() => {
                            $(`#row_${projectId}`).removeClass('table-row-success');
                        }, 2000);
                    },
                    error: function () {
                        Swal.fire({
                            title: '@Localizer["Error"]',
                            text: '@Localizer["Failed to update project name."]',
                            icon: 'error',
                            confirmButtonColor: 'var(--danger-color)',
                            customClass: {
                                popup: 'modern-swal-popup'
                            }
                        });
                    }
                });
            }
        });
    }

    function deleteProject(projectId) {
        Swal.fire({
            title:'@Localizer["Are you sure?"]',
            text: '@Localizer["This will delete the project!"]',
            icon: 'warning',
            showCancelButton: true,
            cancelButtonText: '@Localizer["Cancel"]',
            confirmButtonText: '@Localizer["Yes, delete it!"]',
            reverseButtons: true,
            confirmButtonColor: 'var(--danger-color)',
            cancelButtonColor: 'var(--secondary-color)',
            customClass: {
                popup: 'modern-swal-popup',
                title: 'modern-swal-title'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Projects/DeleteConfirmed',
                    type: 'POST',
                    data: {
                        id: projectId,
                        __RequestVerificationToken: token
                    },
                    success: function () {
                        // Animate row removal
                        $(`#row_${projectId}`).fadeOut(500, function() {
                            $(this).remove();
                        });
                        Swal.fire({
                            title: '@Localizer["Deleted!"]',
                            text: '@Localizer["Project has been deleted."]',
                            icon: 'success',
                            confirmButtonColor: 'var(--primary-color)',
                            customClass: {
                                popup: 'modern-swal-popup'
                            }
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: '@Localizer["Error"]',
                            text: '@Localizer["Failed to delete project."]',
                            icon: 'error',
                            confirmButtonColor: 'var(--danger-color)',
                            customClass: {
                                popup: 'modern-swal-popup'
                            }
                        });
                    }
                });
            }
        });
    }

    // Add loading animation on page load
    document.addEventListener('DOMContentLoaded', function() {
        // Animate table rows
        const tableRows = document.querySelectorAll('.table-row-hover');
        tableRows.forEach((row, index) => {
            row.style.opacity = '0';
            row.style.transform = 'translateY(20px)';
            row.style.transition = 'all 0.6s ease';

            setTimeout(() => {
                row.style.opacity = '1';
                row.style.transform = 'translateY(0)';
            }, index * 100);
        });

        // Animate progress bars
        const progressBars = document.querySelectorAll('.progress-fill-modern');
        progressBars.forEach(bar => {
            const width = bar.style.width;
            bar.style.width = '0%';
            setTimeout(() => {
                bar.style.width = width;
            }, 500);
        });

        // Auto-sort by Performance (highest to lowest) on page load
        if ($('#projectsTableBody tr').length > 0) {
            sortProjectsTable('performance');
        }
    });

    // Sorting functionality for Projects
    let currentProjectSort = {
        column: null,
        direction: 'desc' // Start with descending (highest to lowest)
    };

    function sortProjectsTable(column) {
        const tbody = document.getElementById('projectsTableBody');
        const rows = Array.from(tbody.querySelectorAll('tr'));

        // Determine sort direction
        if (currentProjectSort.column === column) {
            // Toggle direction if clicking the same column
            currentProjectSort.direction = currentProjectSort.direction === 'desc' ? 'asc' : 'desc';
        } else {
            // Default to descending (highest to lowest) for new column
            currentProjectSort.direction = 'desc';
            currentProjectSort.column = column;
        }

        // Sort rows
        rows.sort((a, b) => {
            const aValue = parseFloat(a.getAttribute(`data-${column}`)) || 0;
            const bValue = parseFloat(b.getAttribute(`data-${column}`)) || 0;

            if (currentProjectSort.direction === 'desc') {
                return bValue - aValue; // Highest to lowest
            } else {
                return aValue - bValue; // Lowest to highest
            }
        });

        // Clear tbody and append sorted rows
        tbody.innerHTML = '';
        rows.forEach(row => tbody.appendChild(row));

        // Update sort icons
        updateProjectSortIcons(column);
    }

    function updateProjectSortIcons(activeColumn) {
        // Reset all icons
        document.getElementById('performance-sort-icon').className = 'fas fa-sort ms-2';
        document.getElementById('disbursement-sort-icon').className = 'fas fa-sort ms-2';
        document.getElementById('lastmodified-sort-icon').className = 'fas fa-sort ms-2';

        // Set active icon
        const iconId = `${activeColumn}-sort-icon`;
        const icon = document.getElementById(iconId);
        if (currentProjectSort.direction === 'desc') {
            icon.className = 'fas fa-sort-down ms-2';
        } else {
            icon.className = 'fas fa-sort-up ms-2';
        }
    }

    // ── Admin: Select-All & Delete Selected ──────────────────────────────────
    function updateDeleteSelectedBtn() {
        const checked = $('.project-row-checkbox:checked').length;
        $('#selectedCount').text(checked);
        if (checked > 0) {
            $('#deleteSelectedBtn').removeClass('d-none');
        } else {
            $('#deleteSelectedBtn').addClass('d-none');
        }
    }

    // Select-all checkbox
    $(document).on('change', '#selectAllCheckbox', function () {
        $('.project-row-checkbox').prop('checked', this.checked);
        updateDeleteSelectedBtn();
    });

    // Individual row checkbox
    $(document).on('change', '.project-row-checkbox', function () {
        const total = $('.project-row-checkbox').length;
        const checked = $('.project-row-checkbox:checked').length;
        $('#selectAllCheckbox').prop('indeterminate', checked > 0 && checked < total);
        $('#selectAllCheckbox').prop('checked', checked === total);
        updateDeleteSelectedBtn();
    });

    function deleteSelectedProjects() {
        const selectedIds = $('.project-row-checkbox:checked').map(function () {
            return parseInt($(this).data('id'));
        }).get();

        if (selectedIds.length === 0) return;

        Swal.fire({
            title: '@Localizer["Are you sure?"]',
            html: `@Localizer["You are about to permanently delete"] <strong>${selectedIds.length}</strong> @Localizer["project(s). This action cannot be undone!"]`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '@Localizer["Yes, delete all!"]',
            cancelButtonText: '@Localizer["Cancel"]',
            reverseButtons: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: 'var(--secondary-color)',
            customClass: { popup: 'modern-swal-popup', title: 'modern-swal-title' }
        }).then((result) => {
            if (!result.isConfirmed) return;

            // Second confirmation for extra safety
            Swal.fire({
                title: '@Localizer["Final Confirmation"]',
                html: `@Localizer["Type"] <strong>DELETE</strong> @Localizer["to confirm"]`,
                input: 'text',
                inputPlaceholder: 'DELETE',
                showCancelButton: true,
                confirmButtonText: '@Localizer["Confirm Delete"]',
                cancelButtonText: '@Localizer["Cancel"]',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: 'var(--secondary-color)',
                customClass: { popup: 'modern-swal-popup' },
                preConfirm: (value) => {
                    if (value !== 'DELETE') {
                        Swal.showValidationMessage('@Localizer["Please type DELETE to confirm"]');
                    }
                }
            }).then((res) => {
                if (!res.isConfirmed) return;

                $.ajax({
                    url: '@Url.Action("DeleteSelected", "Projects")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(selectedIds),
                    headers: { 'RequestVerificationToken': token },
                    success: function (response) {
                        if (response.success) {
                            // Remove rows from table
                            response.deletedIds.forEach(id => {
                                $(`#row_${id}`).fadeOut(400, function () { $(this).remove(); });
                            });
                            // Reset checkboxes & button
                            $('#selectAllCheckbox').prop('checked', false).prop('indeterminate', false);
                            $('#deleteSelectedBtn').addClass('d-none');
                            $('#selectedCount').text('0');

                            Swal.fire({
                                title: '@Localizer["Deleted!"]',
                                text: response.message,
                                icon: 'success',
                                confirmButtonColor: 'var(--primary-color)',
                                customClass: { popup: 'modern-swal-popup' }
                            });
                        } else {
                            Swal.fire({
                                title: '@Localizer["Error"]',
                                text: response.message,
                                icon: 'error',
                                confirmButtonColor: '#dc3545',
                                customClass: { popup: 'modern-swal-popup' }
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: '@Localizer["Error"]',
                            text: '@Localizer["Failed to delete selected projects."]',
                            icon: 'error',
                            confirmButtonColor: '#dc3545',
                            customClass: { popup: 'modern-swal-popup' }
                        });
                    }
                });
            });
        });
    }
    // ─────────────────────────────────────────────────────────────────────────

    // Search on Enter key only
    $(document).ready(function() {
        $('#projectSearch').on('keypress', function(e) {
            if (e.which === 13) {
                e.preventDefault();
                $('#hierarchyFilterForm').submit();
            }
        });

        // Clear search button
        $(document).on('click', '#clearSearch', function() {
            $('#projectSearch').val('');
            $('#hierarchyFilterForm').submit();
        });
    });

    // Hierarchy Filter Cascading Logic with Instant Submit
    // Localized strings for JavaScript
    const hierarchyLabels = {
        selectFramework: '@Html.Raw(Localizer["-- Select Framework --"].Value)',
        selectOutcome: '@Html.Raw(Localizer["-- Select Outcome --"].Value)',
        selectOutput: '@Html.Raw(Localizer["-- Select Output --"].Value)',
        allOutcomes: '@Html.Raw(Localizer["-- All Outcomes --"].Value)',
        allOutputs: '@Html.Raw(Localizer["-- All Outputs --"].Value)',
        allSubOutputs: '@Html.Raw(Localizer["-- All SubOutputs --"].Value)'
    };

    $(document).ready(function() {
        const currentFramework = $('#currentFramework').val();
        const currentOutcome = $('#currentOutcome').val();
        const currentOutput = $('#currentOutput').val();
        const currentSubOutput = $('#currentSubOutput').val();
        let isInitializing = true;

        // If returning with selections, load the cascaded options
        if (currentFramework) {
            loadOutcomes(currentFramework, currentOutcome, function() {
                if (currentOutcome) {
                    loadOutputs(currentOutcome, currentOutput, function() {
                        if (currentOutput) {
                            loadSubOutputs(currentOutput, currentSubOutput, function() {
                                isInitializing = false;
                            });
                        } else {
                            isInitializing = false;
                        }
                    });
                } else {
                    isInitializing = false;
                }
            });
        } else {
            isInitializing = false;
        }

        // Framework change handler - submit form immediately
        $('#frameworkFilter').change(function() {
            // Clear child values and submit
            $('#outcomeFilter').val('');
            $('#outputFilter').val('');
            $('#subOutputFilter').val('');
            submitHierarchyForm();
        });

        // Outcome change handler - submit form immediately
        $('#outcomeFilter').change(function() {
            // Clear child values and submit
            $('#outputFilter').val('');
            $('#subOutputFilter').val('');
            submitHierarchyForm();
        });

        // Output change handler - submit form immediately
        $('#outputFilter').change(function() {
            // Clear child value and submit
            $('#subOutputFilter').val('');
            submitHierarchyForm();
        });

        // SubOutput change handler - submit form immediately
        $('#subOutputFilter').change(function() {
            submitHierarchyForm();
        });

        // Submit the hierarchy filter form
        function submitHierarchyForm() {
            if (!isInitializing) {
                $('#hierarchyFilterForm').submit();
            }
        }

        // Helper functions to load cascaded data (for restoring state on page load)
        function loadOutcomes(frameworkCode, selectedValue, callback) {
            $.getJSON('/Projects/GetOutcomes', { frameworkCode: frameworkCode })
                .done(function(data) {
                    $('#outcomeFilter').empty().append('<option value="">' + hierarchyLabels.allOutcomes + '</option>');
                    $.each(data, function(i, item) {
                        const selected = (selectedValue && item.code == selectedValue) ? 'selected' : '';
                        $('#outcomeFilter').append('<option value="' + item.code + '" ' + selected + '>' + item.name + '</option>');
                    });
                    $('#outcomeFilter').prop('disabled', false);
                    if (callback) callback();
                });
        }

        function loadOutputs(outcomeCode, selectedValue, callback) {
            $.getJSON('/Projects/GetOutputs', { outcomeCode: outcomeCode })
                .done(function(data) {
                    $('#outputFilter').empty().append('<option value="">' + hierarchyLabels.allOutputs + '</option>');
                    $.each(data, function(i, item) {
                        const selected = (selectedValue && item.code == selectedValue) ? 'selected' : '';
                        $('#outputFilter').append('<option value="' + item.code + '" ' + selected + '>' + item.name + '</option>');
                    });
                    $('#outputFilter').prop('disabled', false);
                    if (callback) callback();
                });
        }

        function loadSubOutputs(outputCode, selectedValue, callback) {
            $.getJSON('/Projects/GetSubOutputs', { outputCode: outputCode })
                .done(function(data) {
                    $('#subOutputFilter').empty().append('<option value="">' + hierarchyLabels.allSubOutputs + '</option>');
                    $.each(data, function(i, item) {
                        const selected = (selectedValue && item.code == selectedValue) ? 'selected' : '';
                        $('#subOutputFilter').append('<option value="' + item.code + '" ' + selected + '>' + item.name + '</option>');
                    });
                    $('#subOutputFilter').prop('disabled', false);
                    if (callback) callback();
                });
        }
    });

    // Month-Year Picker
    (function () {
        document.querySelectorAll('.month-year-picker').forEach(function (picker) {
            var hidden = picker.querySelector('input[type="hidden"]');
            var monthSel = picker.querySelector('.mypicker-month');
            var yearInput = picker.querySelector('.mypicker-year');
            if (hidden.value) {
                var parts = hidden.value.split('-');
                if (parts.length >= 2) {
                    yearInput.value = parseInt(parts[0], 10);
                    monthSel.value = parseInt(parts[1], 10);
                }
            }
            function sync() {
                var m = monthSel.value, y = yearInput.value;
                if (m && y && y.length === 4) {
                    hidden.value = String(parseInt(y)).padStart(4, '0') + '-' + String(parseInt(m)).padStart(2, '0');
                } else {
                    hidden.value = '';
                }
            }
            monthSel.addEventListener('change', sync);
            yearInput.addEventListener('change', sync);
            yearInput.addEventListener('input', sync);
        });
    })();
</script>
}

@section Modals {
    @await Html.PartialAsync("_HelpModal")
}

@if (TempData["ClearDraftKey"] is string clearDraftKey && !string.IsNullOrEmpty(clearDraftKey))
{
    <script>
        try { localStorage.removeItem('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(clearDraftKey))'); } catch (e) {}
    </script>
}
