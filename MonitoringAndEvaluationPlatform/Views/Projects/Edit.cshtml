<script src="~/js/form-draft.js" asp-append-version="true"></script>
<script>
    // Persist the in-progress edit to localStorage so a connection drop or refresh
    // doesn't lose the user's input. Cleared when the edit succeeds (see Index.cshtml).
    document.addEventListener('DOMContentLoaded', function () {
        new FormDraft({
            form: 'form.needs-validation',
            key: 'draft:project:edit:@Model.ProjectID',
            restoredText: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Unsaved draft restored"].Value))',
            discardText: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Discard draft"].Value))'
        }).init();
    });
</script>

<script>
    // Localized strings for JavaScript
    const localizedStrings = {
        select: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Select"].Value))',
        clear: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Clear"].Value))',
        pleaseSelectAllLocationLevels: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Please select all location levels."].Value))',
        locationAlreadyAdded: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["This location has already been added."].Value))',
        thisProjectWillCover: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["This project will cover all locations in the country. Specific location selection is disabled."].Value))',
        pleaseSelectDonorFirst: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Please select a donor first."].Value))',
        donorAlreadyAdded: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["This donor has already been added."].Value))',
        fundingContribution: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Funding Contribution"].Value))',
        percentage: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Percentage:"].Value))',
        amount: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Amount:"].Value))',
        errorExceeds100: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Error: Exceeds 100%"].Value))',
        fullyFunded: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Fully funded"].Value))',
        partiallyFunded: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Partially funded"].Value))',
        cannotExceed100: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Cannot exceed 100%"].Value))',
        mustAddLocation: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["You must add at least one location or check the Entire Country option before saving the project."].Value))',
        filesSelected: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["file(s) selected"].Value))',
        clearAll: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Clear All"].Value))',
        remove: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Remove"].Value))',
        pleaseSelectGovernorateFirst: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Please select a governorate first."].Value))',
        governorateChainNotFound: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["No matching locations found for this governorate."].Value))'
    };

    let selections = [];

    // Handle Entire Country checkbox
    $("#entireCountryCheckbox").change(function() {
        const isChecked = $(this).is(':checked');

        if (isChecked) {
            // Disable location selectors
            $("#location-selector select").prop('disabled', true).val('');
            $("#add-location, #add-governorate-chain, #reset-dropdowns").prop('disabled', true);

            // Clear any selected locations
            selections = [];
            $("#selected-locations").empty();
            $("#location-data").val('');

            // Show info message
            if ($("#entire-country-info").length === 0) {
                $("#location-selector").before(
                    '<div id="entire-country-info" class="alert alert-info">' +
                    '<i class="fas fa-info-circle me-2"></i>' + localizedStrings.thisProjectWillCover +
                    '</div>'
                );
            }
        } else {
            // Enable location selectors
            $("#location-selector select").prop('disabled', false);
            $("#add-location, #add-governorate-chain, #reset-dropdowns").prop('disabled', false);

            // Remove info message
            $("#entire-country-info").remove();
        }
    });

    // Cascading dropdowns
    $("#governorate").change(function () {
        $.get("/Projects/GetDistricts", { governorateCode: $(this).val() }, function (data) {
            fillSelect("#district", data);
            resetSelect("#subdistrict");
            resetSelect("#community");
        });
    });

    $("#district").change(function () {
        $.get("/Projects/GetSubDistricts", { districtCode: $(this).val() }, function (data) {
            fillSelect("#subdistrict", data);
            resetSelect("#community");
        });
    });

    $("#subdistrict").change(function () {
        $.get("/Projects/GetCommunities", { subDistrictCode: $(this).val() }, function (data) {
            fillSelect("#community", data);
        });
    });

    // Add location
    $("#add-location").click(function () {
        const govCode = $("#governorate").val();
        const govName = $("#governorate option:selected").text();

        const distCode = $("#district").val();
        const distName = $("#district option:selected").text();

        const subCode = $("#subdistrict").val();
        const subName = $("#subdistrict option:selected").text();

        const commCode = $("#community").val();
        const commName = $("#community option:selected").text();

        if (!govCode || !distCode || !subCode || !commCode) {
            showValidationMessage(localizedStrings.pleaseSelectAllLocationLevels);
            return;
        }

        const item = {
            GovernorateCode: govCode,
            DistrictCode: distCode,
            SubDistrictCode: subCode,
            CommunityCode: commCode
        };

        if (addSelection(item, govName + ' > ' + distName + ' > ' + subName + ' > ' + commName)) {
            resetDropdowns();
        }
    });

    // Adds a location item (4 code fields, as this view's selections shape) + display label; returns false on duplicate
    function addSelection(item, displayLabel) {
        const exists = selections.some(x =>
            x.GovernorateCode === item.GovernorateCode &&
            x.DistrictCode === item.DistrictCode &&
            x.SubDistrictCode === item.SubDistrictCode &&
            x.CommunityCode === item.CommunityCode
        );

        if (exists) {
            showValidationMessage(localizedStrings.locationAlreadyAdded);
            return false;
        }

        selections.push(item);

        // Create list item with "Clear" button
        const $li = $(
            '<li class="list-group-item">' +
                '<span>' + displayLabel + '</span>' +
                '<button type="button" class="btn btn-sm btn-outline-danger btn-clear">' +
                    '<i class="fas fa-times"></i> ' + localizedStrings.clear +
                '</button>' +
            '</li>'
        );

        // Attach remove handler
        $li.find(".btn-clear").click(function () {
            selections = selections.filter(x =>
                !(x.GovernorateCode === item.GovernorateCode &&
                  x.DistrictCode === item.DistrictCode &&
                  x.SubDistrictCode === item.SubDistrictCode &&
                  x.CommunityCode === item.CommunityCode)
            );
            $li.remove();
            $("#location-data").val(JSON.stringify(selections));
        });

        $("#selected-locations").append($li);
        $("#location-data").val(JSON.stringify(selections));
        return true;
    }

    // Add the whole governorate as a location (same-named chain at all four levels)
    $("#add-governorate-chain").click(function () {
        const govCode = $("#governorate").val();
        if (!govCode) {
            showValidationMessage(localizedStrings.pleaseSelectGovernorateFirst);
            return;
        }
        $.get("/Projects/GetGovernorateChain", { governorateCode: govCode }, function (data) {
            if (!data || !data.found) {
                showValidationMessage(localizedStrings.governorateChainNotFound);
                return;
            }
            const ok = addSelection({
                GovernorateCode: data.governorate.code,
                DistrictCode: data.district.code,
                SubDistrictCode: data.subDistrict.code,
                CommunityCode: data.community.code
            }, data.governorate.name + ' > ' + data.district.name + ' > ' + data.subDistrict.name + ' > ' + data.community.name);
            if (ok) resetDropdowns();
        });
    });

    // Reset handler
    $("#reset-dropdowns").click(resetDropdowns);

    // Utility functions
    function fillSelect(selector, data) {
        let select = $(selector);
        select.empty().append('<option value="">-- ' + localizedStrings.select + ' --</option>');
        data.forEach(function(x) { select.append('<option value="' + x.code + '">' + x.name + '</option>'); });
    }

    function resetSelect(selector) {
        $(selector).empty().append('<option value="">-- ' + localizedStrings.select + ' --</option>');
    }

    function resetDropdowns() {
        $("#governorate").val("");
        resetSelect("#district");
        resetSelect("#subdistrict");
        resetSelect("#community");
    }

    // Validation message display
    function showValidationMessage(message) {
        const alertBox = $("#location-validation-alert");

        if (alertBox.length === 0) {
            $("#location-selector").after(`
                <div id="location-validation-alert" class="alert alert-warning mt-3">${message}</div>
            `);
        } else {
            alertBox.text(message).fadeIn();
        }

        setTimeout(() => $("#location-validation-alert").fadeOut(), 3000);
    }

    // ── Public Sector Type dependent dropdown ──
    // Shown (and required) only while the Public sector is selected in the Sectors multiselect.
    const publicSectorCode = @Html.Raw(Json.Serialize(ViewBag.PublicSectorCode));

    function isPublicSectorSelected() {
        const selectedSectors = $('select[name="SelectedSectorCodes"]').val() || [];
        return publicSectorCode != null && selectedSectors.includes(String(publicSectorCode));
    }

    function togglePublicSectorType() {
        if (isPublicSectorSelected()) {
            $('#public-sector-type-container').show();
        } else {
            $('#public-sector-type-container').hide();
            $('select[name="PublicSectorTypeCode"]').val('');
        }
    }

    $('select[name="SelectedSectorCodes"]').on('change', togglePublicSectorType);
    $(togglePublicSectorType); // initial state on document ready (existing Public project shows its saved type)

    // Prevent submitting if no locations have been added (unless entire country is checked)
    $('form.needs-validation').on('submit', function (e) {
        let isValid = true;
        let errorMessages = [];

        // Check locations
        const isEntireCountry = $("#entireCountryCheckbox").is(':checked');
        if (!isEntireCountry && selections.length === 0) {
            errorMessages.push(localizedStrings.mustAddLocation);
            isValid = false;
        }

        if (!isValid) {
            e.preventDefault();
            alert(errorMessages.join("\n"));
            return false;
        }
    });

    // =================
    // DONOR MANAGEMENT
    // =================

    let selectedDonors = [];
    let donorFundingData = {};

    // Currency symbols mapping
    const currencySymbols = {
        'USD': '$',
        'EUR': '\u20AC',
        'SYP': 'SYP '
    };

    // Get current currency symbol
    function getCurrencySymbol() {
        const currency = $('#currencySelect').val() || 'USD';
        return currencySymbols[currency] || '$';
    }

    // Update all currency symbol displays
    function updateCurrencySymbols() {
        const symbol = getCurrencySymbol();
        $('.currency-symbol').text(symbol);
        calculateDonorTotals();
    }

    // Handle currency selection change
    $('#currencySelect').on('change', function() {
        updateCurrencySymbols();
        toggleExchangeRateSection($(this).val());
    });

    // ========== EXCHANGE RATE SECTION ==========

    function toggleExchangeRateSection(currency) {
        if (currency === 'SYP') {
            $('#exchangeRateSection').show();
            // Auto-fetch only if no rate is already saved
            if (!$('#exchangeRateInput').val()) {
                fetchExchangeRate();
            }
        } else {
            $('#exchangeRateSection').hide();
        }
    }

    function fetchExchangeRate() {
        const btn = $('#fetchRateBtn');
        const errorDiv = $('#fetchRateError');
        errorDiv.hide();
        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>@Localizer["Fetching..."]');

        fetch('https://open.er-api.com/v6/latest/USD')
            .then(response => response.json())
            .then(data => {
                if (data && data.rates && data.rates.SYP) {
                    const rate = Math.round(data.rates.SYP * 100) / 100;
                    const today = new Date().toISOString().split('T')[0];
                    $('#exchangeRateInput').val(rate);
                    $('#exchangeRateDateInput').val(today);
                    $('#exchangeRateDateDisplay').text(today);
                    $('#exchangeRateMeta').show();
                } else {
                    setManualRateDate();
                    errorDiv.text('@Localizer["Could not fetch live rate. Please enter manually."]').show();
                }
            })
            .catch(() => {
                setManualRateDate();
                errorDiv.text('@Localizer["Could not fetch live rate. Please enter manually."]').show();
            })
            .finally(() => {
                btn.prop('disabled', false).html('<i class="fas fa-sync-alt me-1"></i>@Localizer["Fetch Rate"]');
            });
    }

    function setManualRateDate() {
        const today = new Date().toISOString().split('T')[0];
        $('#exchangeRateDateInput').val(today);
        $('#exchangeRateDateDisplay').text(today);
        $('#exchangeRateMeta').show();
    }

    // When user manually edits the rate, record today as the date
    $('#exchangeRateInput').on('input', function() {
        if ($(this).val()) {
            setManualRateDate();
        }
        updateUsdEquivalent();
    });

    $('#fetchRateBtn').on('click', function() {
        fetchExchangeRate();
    });

    // ===== Thousand-separator formatting for Estimated Budget =====
    // Budget is entered in a chosen unit; parseBudget returns the FULL monetary value
    // so every downstream calc (USD equivalent, Arabic words, donor totals) stays correct.
    const BUDGET_UNIT_MULT = { Ones: 1, Thousands: 1000, Millions: 1000000, Billions: 1000000000 };
    function currentBudgetUnitMult() {
        return BUDGET_UNIT_MULT[$('#budgetUnitSelect').val()] || 1;
    }
    function parseBudget($el) {
        const v = $el.val();
        if (!v) return NaN;
        const n = parseFloat(v.replace(/,/g, ''));
        if (isNaN(n)) return NaN;
        return n * currentBudgetUnitMult();
    }

    function formatBudgetInput(input) {
        const oldValue = input.value;
        const cursorPos = input.selectionStart || 0;
        const charsBeforeCursor = oldValue.substring(0, cursorPos);
        const digitsBeforeCursor = (charsBeforeCursor.match(/[\d.]/g) || []).length;

        let cleaned = oldValue.replace(/[^\d.]/g, '');
        const firstDot = cleaned.indexOf('.');
        if (firstDot !== -1) {
            cleaned = cleaned.substring(0, firstDot + 1) +
                      cleaned.substring(firstDot + 1).replace(/\./g, '');
        }

        let formatted;
        if (cleaned === '' || cleaned === '.') {
            formatted = cleaned;
        } else {
            const parts = cleaned.split('.');
            const intStr = parts[0];
            const intFormatted = intStr ? Number(intStr).toLocaleString('en-US') : '';
            formatted = parts.length > 1 ? intFormatted + '.' + parts[1] : intFormatted;
        }

        input.value = formatted;

        let newPos = 0;
        let count = 0;
        for (let i = 0; i < formatted.length; i++) {
            if (count >= digitsBeforeCursor) break;
            if (/[\d.]/.test(formatted[i])) count++;
            newPos = i + 1;
        }
        if (input.setSelectionRange) {
            try { input.setSelectionRange(newPos, newPos); } catch (e) { /* ignore */ }
        }
    }

    // Override jQuery validate's number/range to accept comma-separated digits
    if (window.jQuery && jQuery.validator) {
        const _origNumber = jQuery.validator.methods.number;
        jQuery.validator.methods.number = function (value, element) {
            return _origNumber.call(this, (value || '').replace(/,/g, ''), element);
        };
        const _origRange = jQuery.validator.methods.range;
        jQuery.validator.methods.range = function (value, element, param) {
            return _origRange.call(this, (value || '').replace(/,/g, ''), element, param);
        };
    }

    // Format on input
    $('[name="EstimatedBudget"]').on('input', function () {
        formatBudgetInput(this);
    });

    // Changing the budget unit rescales the full value; re-run all budget-dependent calcs.
    $('#budgetUnitSelect').on('change', function () {
        $('[name="EstimatedBudget"]').trigger('change');
    });

    // Strip commas before form submission so the model binder gets a clean number
    $('[name="EstimatedBudget"]').closest('form').each(function () {
        this.addEventListener('submit', function () {
            const el = this.querySelector('[name="EstimatedBudget"]');
            if (el) el.value = (el.value || '').replace(/,/g, '');
        }, true);
    });
    // ================================================================

    // Recalculate when budget changes
    $('[name="EstimatedBudget"]').on('input change', updateUsdEquivalent);

    // Arabic words conversion for the estimated budget
    function convertNumberToArabicWords(num) {
        if (!isFinite(num) || num < 1000) {
            return '';
        }
        num = Math.floor(num);
        const billions = Math.floor(num / 1000000000);
        const afterBillions = num % 1000000000;
        const millions = Math.floor(afterBillions / 1000000);
        const afterMillions = afterBillions % 1000000;
        const thousands = Math.floor(afterMillions / 1000);
        const remainder = afterMillions % 1000;

        const parts = [];
        if (billions > 0) {
            parts.push(billions === 1 ? 'مليار' : billions + ' مليار');
        }
        if (millions > 0) {
            parts.push(millions === 1 ? 'مليون' : millions + ' مليون');
        }
        if (thousands > 0) {
            if (thousands === 1) {
                parts.push('ألف');
            } else if (thousands === 10) {
                parts.push('عشرة آلاف');
            } else {
                parts.push(thousands + ' ألف');
            }
        }
        if (remainder > 0) {
            parts.push(remainder.toString());
        }
        return parts.join(' و');
    }

    function updateBudgetArabicWords() {
        const value = parseBudget($('[name="EstimatedBudget"]'));
        const $box = $('#estimatedBudgetArabicWords');
        const $val = $('#estimatedBudgetArabicWordsValue');
        if (isNaN(value) || value < 1000) {
            $box.hide();
            $val.text('');
            return;
        }
        $val.text(convertNumberToArabicWords(value));
        $box.show();
    }

    $('[name="EstimatedBudget"]').on('input change', updateBudgetArabicWords);
    updateBudgetArabicWords();

    function updateUsdEquivalent() {
        const budget = parseBudget($('[name="EstimatedBudget"]'));
        const rate = parseFloat($('#exchangeRateInput').val());
        if (budget > 0 && rate > 0) {
            const usd = budget / rate;
            const formatted = usd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const budgetFormatted = budget.toLocaleString('en-US');
            const rateFormatted = rate.toLocaleString('en-US');
            $('#usdEquivalentValue').text(formatted);
            $('#usdEquivalentFormula').text(budgetFormatted + ' SYP ÷ ' + rateFormatted + ' = ' + formatted + ' USD');
            $('#usdEquivalentBox').show();
        } else {
            $('#usdEquivalentBox').hide();
        }
    }

    // Initialize exchange rate section on page load
    toggleExchangeRateSection($('#currencySelect').val());
    // ===========================================

    // Initialize donor management on page load
    $(document).ready(function() {
        initializeSelectedDonors();

        // Trigger the entire country checkbox change event if it's already checked
        if ($("#entireCountryCheckbox").is(':checked')) {
            $("#entireCountryCheckbox").trigger('change');
        }

        // Handle ministry dropdown selection
        $('.ministry-item').click(function(e) {
            e.preventDefault();
            const ministryCode = $(this).data('ministry-code');
            const ministryName = $(this).data('ministry-name');
            const ministryLogo = $(this).data('ministry-logo');

            // Update hidden input
            $('#ministrySelect').val(ministryCode);

            // Update display button
            $('#selectedMinistryDisplay').html('').removeClass('text-muted');
            if (ministryLogo && ministryLogo.trim() !== '') {
                $('#selectedMinistryDisplay').append('<span class="me-2" style="font-size: 1.5rem;">' + ministryLogo + '</span>');
            } else {
                $('#selectedMinistryDisplay').append('<span class="me-2 bg-light border rounded d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; display: inline-flex;"><i class="fas fa-building text-muted" style="font-size: 0.7rem;"></i></span>');
            }
            $('#selectedMinistryDisplay').append('<span>' + ministryName + '</span>');

            // Close dropdown
            $('#ministryDropdown').dropdown('hide');
        });

        // Ministry search — prevent dropdown from closing while typing
        $(document).on('click', '#ministrySearch', function(e) {
            e.stopPropagation();
        });

        $(document).on('input', '#ministrySearch', function() {
            const query = $(this).val().toLowerCase().trim();
            let visibleCount = 0;

            $('.ministry-item').each(function() {
                const name = ($(this).data('ministry-name') || '').toLowerCase();
                const match = !query || name.includes(query);
                $(this).closest('li').toggle(match);
                if (match) visibleCount++;
            });

            $('#ministryNoResults').toggle(visibleCount === 0);
        });

        // Clear search when dropdown closes
        $('#ministryDropdown').closest('.dropdown').on('hidden.bs.dropdown', function() {
            $('#ministrySearch').val('');
            $('.ministry-item').closest('li').show();
            $('#ministryNoResults').hide();
        });

        // Set initial ministry display if already selected
        var selectedMinistryCode = $('#ministrySelect').val();
        if (selectedMinistryCode) {
            var selectedItem = $('.ministry-item[data-ministry-code="' + selectedMinistryCode + '"]');
            if (selectedItem.length > 0) {
                const ministryName = selectedItem.data('ministry-name');
                const ministryLogo = selectedItem.data('ministry-logo');
                $('#selectedMinistryDisplay').html('').removeClass('text-muted');
                if (ministryLogo && ministryLogo.trim() !== '') {
                    $('#selectedMinistryDisplay').append('<span class="me-2" style="font-size: 1.5rem;">' + ministryLogo + '</span>');
                } else {
                    $('#selectedMinistryDisplay').append('<span class="me-2 bg-light border rounded d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; display: inline-flex;"><i class="fas fa-building text-muted" style="font-size: 0.7rem;"></i></span>');
                }
                $('#selectedMinistryDisplay').append('<span>' + ministryName + '</span>');
            }
        }

        // Disable ministry dropdown for ministry users
        var isMinistryUser = @Html.Raw(Json.Serialize(ViewBag.IsMinistryUser ?? false));
        if (isMinistryUser) {
            $('#ministryDropdown').prop('disabled', true);
            $('#ministryDropdown').css({
                'background-color': '#e9ecef',
                'cursor': 'not-allowed',
                'pointer-events': 'none'
            });
        }
    });

    // Initialize donors from the existing project data
    function initializeSelectedDonors() {
        // Get selected donor codes from the MultiSelectList
        @if (ViewBag.DonorList != null)
        {
            var donorList = ViewBag.DonorList as MultiSelectList;
            if (donorList != null && donorList.Count() > 0)
            {
                <text>
                var initialDonors = [
                    @foreach (var item in donorList)
                    {
                        if (item.Selected)
                        {
                            <text>{ value: '@item.Value', text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.Text))' },</text>
                        }
                    }
                ];

                // Get existing funding percentages from the controller
                var existingFundingData = {};
                @if (ViewBag.DonorFundingData != null)
                {
                    <text>
                    try {
                        existingFundingData = JSON.parse('@Html.Raw(ViewBag.DonorFundingData)');
                    } catch (e) {
                        console.error('Error parsing donor funding data:', e);
                        existingFundingData = {};
                    }
                    </text>
                }

                // Add existing donors to the management system
                initialDonors.forEach(function(donor) {
                    if (donor.value && donor.text) {
                        selectedDonors.push(donor);
                        // Use existing funding percentage or default to 0
                        donorFundingData[donor.value] = existingFundingData[donor.value] || 0;
                    }
                });

                updateDonorFundingSection();
                updateSelectedDonorsInput();
                </text>
            }
        }
    }

    // Add donor button click handler
    $('#addDonorBtn').click(function() {
        const donorValue = $('#availableDonorSelect').val();
        const donorText = $('#availableDonorSelect option:selected').text();

        if (!donorValue || donorValue === '') {
            alert(localizedStrings.pleaseSelectDonorFirst);
            return;
        }

        // Check if donor is already added
        if (selectedDonors.some(d => d.value === donorValue)) {
            alert(localizedStrings.donorAlreadyAdded);
            return;
        }

        // Add donor to selected list
        selectedDonors.push({
            value: donorValue,
            text: donorText
        });

        // Initialize percentage
        donorFundingData[donorValue] = 0;

        // Update UI
        updateDonorFundingSection();
        updateSelectedDonorsInput();

        // Reset dropdown
        $('#availableDonorSelect').val('');
    });

    // Update the donor funding section
    function updateDonorFundingSection() {
        const donorFundingSection = $('#donorFundingSection');
        const donorContributionList = $('#donorContributionList');

        if (selectedDonors.length === 0) {
            donorFundingSection.hide();
            return;
        }

        donorFundingSection.show();
        donorContributionList.empty();

        // Create cards with sliders for each selected donor
        selectedDonors.forEach(function(donor) {
            const currentPercentage = donorFundingData[donor.value] || 0;

            const donorHtml =
                '<div class="card mb-3 donor-funding-card" data-donor="' + donor.value + '">' +
                    '<div class="card-body">' +
                        '<div class="row align-items-center">' +
                            '<div class="col-md-4">' +
                                '<h6 class="mb-1">' +
                                    '<i class="fas fa-hand-holding-usd me-2"></i>' + donor.text +
                                '</h6>' +
                                '<small class="text-muted">' + localizedStrings.fundingContribution + '</small>' +
                            '</div>' +
                            '<div class="col-md-4">' +
                                '<label class="form-label small mb-1">' + localizedStrings.percentage + ' <span class="percentage-display" data-donor="' + donor.value + '">' + currentPercentage.toFixed(1) + '%</span></label>' +
                                '<input type="range" class="form-range donor-slider" data-donor="' + donor.value + '" min="0" max="100" step="0.1" value="' + currentPercentage + '">' +
                                '<div class="d-flex justify-content-between small text-muted">' +
                                    '<span>0%</span>' +
                                    '<span>100%</span>' +
                                '</div>' +
                            '</div>' +
                            '<div class="col-md-3">' +
                                '<div class="text-end">' +
                                    '<strong class="donor-amount" data-donor="' + donor.value + '">$0.00</strong>' +
                                    '<br>' +
                                    '<small class="text-muted">' + localizedStrings.amount + '</small>' +
                                '</div>' +
                            '</div>' +
                            '<div class="col-md-1">' +
                                '<button type="button" class="btn btn-outline-danger btn-sm remove-donor-btn" data-donor="' + donor.value + '">' +
                                    '<i class="fas fa-times"></i>' +
                                '</button>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';
            donorContributionList.append(donorHtml);
        });

        calculateDonorTotals();
    }

    // Handle slider changes
    $(document).on('input', '.donor-slider', function() {
        const donorValue = $(this).data('donor');
        const percentage = parseFloat($(this).val()) || 0;

        donorFundingData[donorValue] = percentage;

        // Update percentage display
        $(`.percentage-display[data-donor="${donorValue}"]`).text(percentage.toFixed(1) + '%');

        calculateDonorTotals();
    });

    // Handle remove donor button
    $(document).on('click', '.remove-donor-btn', function() {
        // jQuery .data() coerces numeric-looking values to Number, but selectedDonors[i].value
        // is always a String — compare as strings so the filter actually removes the donor.
        const donorValue = String($(this).data('donor'));

        // Remove from selected donors array
        selectedDonors = selectedDonors.filter(d => String(d.value) !== donorValue);

        // Remove from funding data
        delete donorFundingData[donorValue];

        // Update UI
        updateDonorFundingSection();
        updateSelectedDonorsInput();
    });

    // Update the hidden select input for form submission
    function updateSelectedDonorsInput() {
        const hiddenSelect = $('#selectedDonorsInput');
        hiddenSelect.empty();

        selectedDonors.forEach(donor => {
            hiddenSelect.append(`<option value="${donor.value}" selected>${donor.text}</option>`);
        });
    }

    // Calculate totals and update displays
    function calculateDonorTotals() {
        const budget = parseBudget($('[name="EstimatedBudget"]')) || 0;
        const symbol = getCurrencySymbol();
        let totalPercentage = 0;
        let totalAmount = 0;

        // Update individual donor amounts and calculate totals
        selectedDonors.forEach(donor => {
            const percentage = donorFundingData[donor.value] || 0;
            const amount = (budget * percentage) / 100;

            totalPercentage += percentage;
            totalAmount += amount;

            // Update the display for this donor
            $(`.donor-amount[data-donor="${donor.value}"]`).text(symbol + amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        });

        // Update total displays
        $('#totalPercentage').text(totalPercentage.toFixed(1));
        $('#totalFundingAmount').text(totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        // Update status message
        const statusElement = $('#percentageStatus');
        if (totalPercentage > 100) {
            statusElement.text(localizedStrings.errorExceeds100).removeClass('text-success text-muted text-warning').addClass('text-danger');
        } else if (totalPercentage === 100) {
            statusElement.text(localizedStrings.fullyFunded + ' (100%)').removeClass('text-warning text-danger text-muted').addClass('text-success');
        } else if (totalPercentage > 0) {
            statusElement.text(localizedStrings.partiallyFunded + ' (' + totalPercentage.toFixed(1) + '%)').removeClass('text-success text-danger text-muted').addClass('text-warning');
        } else {
            statusElement.text(localizedStrings.cannotExceed100).removeClass('text-success text-warning text-danger').addClass('text-muted');
        }

        // Update hidden field with funding data
        $('#donorFundingData').val(JSON.stringify(donorFundingData));
    }

    // Update calculations when budget changes
    $('[name="EstimatedBudget"]').on('input change', function() {
        calculateDonorTotals();
    });
</script>
