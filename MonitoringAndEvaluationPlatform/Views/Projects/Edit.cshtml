<!-- Project Phases Management -->
@if (Model.Phases != null && Model.Phases.Any())
{
    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">
                            <i class="fas fa-layer-group me-2"></i>@Localizer["Project Phases"]
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (TempData["PhaseSuccess"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle me-2"></i>@TempData["PhaseSuccess"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        @if (TempData["PhaseError"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-triangle me-2"></i>@TempData["PhaseError"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @{
                            var isArabicCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
                            var phaseArNames = new[]
                            {
                                "اراضي",
                                "مباني وانشاءات ومرافق",
                                "الات ومعدات",
                                "وسائل نقل وانتقال",
                                "عدد وادوات وقوالب",
                                "اثاث ومعدات مكاتب",
                                "ثروة حيوانية",
                                "نفقات تاسيس",
                                "رواتب واجور وتعويضات"
                            };
                            var phaseEnNames = new[]
                            {
                                "Land",
                                "Buildings, Constructions & Facilities",
                                "Machinery & Equipment",
                                "Transportation Means",
                                "Tools, Instruments & Molds",
                                "Furniture & Office Equipment",
                                "Livestock",
                                "Establishment Expenses",
                                "Salaries, Wages & Compensations"
                            };
                            var existingNames = new HashSet<string>(Model.Phases.Select(p => p.Name));
                        }

                        <form asp-controller="ProjectPhases" asp-action="SyncPhases" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="projectId" value="@Model.ProjectID" />
                            <input type="hidden" name="returnTo" value="edit" />

                            <div class="form-text mb-2">
                                @Localizer["Check the phases to include in this project. Unchecking a phase will remove it along with its measures and action plan."]
                            </div>

                            <div class="mb-2">
                                <button type="button" id="selectAllPhasesEdit" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-check-double me-1"></i>@Localizer["Select All"]
                                </button>
                                <button type="button" id="deselectAllPhasesEdit" class="btn btn-sm btn-outline-secondary ms-2">
                                    <i class="fas fa-times me-1"></i>@Localizer["Deselect All"]
                                </button>
                            </div>

                            <div class="row g-2 p-3 border rounded bg-light mb-3">
                                @for (int pi = 0; pi < phaseArNames.Length; pi++)
                                {
                                    var arName = phaseArNames[pi];
                                    var isChecked = existingNames.Contains(arName);
                                    <div class="col-md-4 col-6">
                                        <label class="d-flex align-items-center gap-2 mb-0"
                                               style="cursor:pointer; width:fit-content;"
                                               for="phase_edit_@pi">
                                            <input class="phase-checkbox-edit flex-shrink-0"
                                                   type="checkbox"
                                                   name="SelectedPhases"
                                                   value="@arName"
                                                   id="phase_edit_@pi"
                                                   @(isChecked ? "checked" : "")
                                                   style="width:1.1em; height:1.1em; cursor:pointer;" />
                                            <span class="small">@(isArabicCulture ? arName : phaseEnNames[pi])</span>
                                        </label>
                                    </div>
                                }
                            </div>

                            <div class="alert alert-info small mb-3">
                                <i class="fas fa-info-circle me-1"></i>
                                @Localizer["Saving will redistribute weights equally across the selected phases."]
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-warning"
                                        onclick="return confirm('@Localizer["Save phase selection? Unchecked phases will be deleted along with their measures and action plans."]');">
                                    <i class="fas fa-save me-1"></i>@Localizer["Save Phases"]
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('selectAllPhasesEdit')?.addEventListener('click', function () {
            document.querySelectorAll('.phase-checkbox-edit').forEach(cb => cb.checked = true);
        });
        document.getElementById('deselectAllPhasesEdit')?.addEventListener('click', function () {
            document.querySelectorAll('.phase-checkbox-edit').forEach(cb => cb.checked = false);
        });
    </script>
}


