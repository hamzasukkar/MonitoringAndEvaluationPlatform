@model IEnumerable<Governorate>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Governorates";
}

<h2>Governorates</h2>

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<a asp-action="CreateGovernorate" class="btn btn-primary mb-2">Add New Governorate</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var gov in Model)
        {
            <tr>
                <td>@gov.EN_Name</td>
                <td>
                    <a asp-action="EditGovernorate" asp-route-id="@gov.Code" class="btn btn-sm btn-warning">Edit</a>
                    @* A POST form, not a link: a plain GET link could be triggered from anywhere. *@
                    <form asp-action="DeleteGovernorate" asp-route-id="@gov.Code" method="post" class="d-inline"
                          onsubmit="return confirm('@Localizer["Are you sure you want to delete this governorate?"]');">
                        <button type="submit" class="btn btn-sm btn-danger">@Localizer["Delete"]</button>
                    </form>
                </td>

            </tr>
        }
    </tbody>
</table>
