@model List<MonitoringAndEvaluationPlatform.Models.FrameworkImpact>
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@using MonitoringAndEvaluationPlatform.Models
@inject IViewLocalizer Localizer
@inject IAuthorizationService Auth
@{
    ViewData["Title"] = "Impact Indicators Measurement";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var framework = ViewBag.Framework as Framework;

    var canAdd = (await Auth.AuthorizeAsync(User, Permissions.AddStrategy)).Succeeded;
    var canModify = (await Auth.AuthorizeAsync(User, Permissions.ModifyStrategy)).Succeeded;
    var canDelete = (await Auth.AuthorizeAsync(User, Permissions.DeleteStrategy)).Succeeded;
}

<div class="dashboard-header">
    <div class="header-content">
        <div class="page-title-section">
            <div class="page-breadcrumb">
                <span class="current-page">@framework?.Name</span>
            </div>
            <h1 class="dashboard-title">@Localizer["Impact Indicators Measurement"]</h1>
        </div>
        @if (canAdd && framework != null)
        {
            <div class="header-actions">
                <a href="@Url.Action("Create", new { frameworkCode = framework.Code })" class="impact-btn primary">
                    <i class="fas fa-plus me-2"></i>@Localizer["New Impact Target"]
                </a>
            </div>
        }
    </div>
</div>

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="chart-card mb-4">
        <h3 class="chart-title">
            <i class="fas fa-chart-pie me-2"></i>@Localizer["Impact Targets"]
        </h3>
        <div class="chart-content">
            <p class="text-muted small">
                @Localizer["Each impact target is driven by a weighted set of project impact indicators. The weighted rate updates on its own as achievements are recorded."]
            </p>

            @if (Model.Any())
            {
                <div class="modern-table-container">
                    <table class="modern-table">
                        <thead class="table-header">
                            <tr>
                                <th>#</th>
                                <th><i class="fas fa-tag me-1"></i>@Localizer["Name"]</th>
                                <th class="text-center"><i class="fas fa-flag me-1"></i>@Localizer["Baseline"]</th>
                                <th class="text-center"><i class="fas fa-bullseye me-1"></i>@Localizer["Target"]</th>
                                <th class="text-center"><i class="fas fa-link me-1"></i>@Localizer["Indicators"]</th>
                                <th style="min-width:170px"><i class="fas fa-percent me-1"></i>@Localizer["Weighted Achievement Rate"]</th>
                                <th class="text-center"><i class="fas fa-cogs me-1"></i>@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 0; }
                            @foreach (var impact in Model)
                            {
                                idx++;
                                var unit = string.IsNullOrWhiteSpace(impact.Unit) ? "" : " " + impact.Unit;
                                <tr class="table-row">
                                    <td>@idx</td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = impact.Id })"
                                           class="fw-bold text-decoration-none">@impact.Name</a>
                                    </td>
                                    <td class="text-center">
                                        @impact.BaselineValue.ToString("N0")@unit
                                        <div class="text-muted small">@impact.BaselineYear</div>
                                    </td>
                                    <td class="text-center">
                                        @impact.TargetValue.ToString("N0")@unit
                                        <div class="text-muted small">@impact.TargetYear</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="modern-badge badge-info">@impact.Indicators.Count</span>
                                    </td>
                                    <td><partial name="_WeightedRate" model="impact" /></td>
                                    <td class="text-center">
                                        <div class="btn-group action-buttons" role="group">
                                            <a href="@Url.Action("Details", new { id = impact.Id })"
                                               class="btn btn-outline-info btn-sm action-btn" title="@Localizer["Details"]">
                                                <i class="fas fa-list-check"></i>
                                            </a>
                                            @if (canModify)
                                            {
                                                <a href="@Url.Action("Edit", new { id = impact.Id })"
                                                   class="btn btn-outline-primary btn-sm action-btn" title="@Localizer["Edit"]">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }
                                            @if (canDelete)
                                            {
                                                <form asp-action="Delete" asp-route-id="@impact.Id" method="post"
                                                      style="display:inline"
                                                      onsubmit="return confirm('@Localizer["Delete this impact target? Its indicator links are removed; the indicators themselves are kept."]')">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger btn-sm action-btn"
                                                            title="@Localizer["Delete"]">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="fas fa-chart-pie"></i></div>
                    <h5 class="empty-title">@Localizer["No Impact Targets Yet"]</h5>
                    <p class="empty-text">@Localizer["Add an impact target to start measuring this strategy's effect."]</p>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/project-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/impact-indicators.css" asp-append-version="true" />
}
