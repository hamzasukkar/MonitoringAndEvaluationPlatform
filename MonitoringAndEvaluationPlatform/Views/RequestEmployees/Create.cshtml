@model MonitoringAndEvaluationPlatform.Models.RequestEmployee
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["NewEmployee"];
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="dashboard-header mb-4">
        <h1 class="display-5 mb-2">
            <i class="fas fa-user-plus me-3"></i>@Localizer["NewEmployee"]
        </h1>
        <p class="text-muted mb-0">@Localizer["NewEmployeeHint"]</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <partial name="_EmployeeFields" model="Model" />

                <hr class="my-4" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save me-2"></i>@Localizer["Save"]
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">@Localizer["Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
