@model MonitoringAndEvaluationPlatform.Models.RequestEmployee
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label">@Localizer["Name"] <span class="text-danger">*</span></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="JobTitle" class="form-label">@Localizer["JobTitle"]</label>
        <input asp-for="JobTitle" class="form-control" />
        <span asp-validation-for="JobTitle" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="PhoneNumber" class="form-label">@Localizer["PhoneNumber"]</label>
        <input asp-for="PhoneNumber" class="form-control" dir="ltr" />
        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Email" class="form-label">@Localizer["Email"]</label>
        <input asp-for="Email" class="form-control" dir="ltr" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
</div>
