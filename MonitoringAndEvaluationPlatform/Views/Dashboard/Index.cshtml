				.then(list => {
					let foundCurrentMinistry = false;
					list.forEach(item => {
						const opt = document.createElement('option');
						opt.value = item.id;
						opt.textContent = item.name;
						ministryDropdown.appendChild(opt);

						// Check if current selection exists in new data
						if (currentMinistryCode && item.id == currentMinistryCode) {
							foundCurrentMinistry = true;
						}
					});

					// Restore selection if it exists in new data
					if (foundCurrentMinistry) {
						ministryDropdown.value = currentMinistryCode;
					}

					document.getElementById('totalMinistries').textContent = list.length;
				})
				.catch(e => console.error(e));

			// Fetch Projects for the selected communities
			fetch(`/Dashboard/GetProjectsByCommunities?communityCodes=${communityCodeString}`)
				.then(r => r.json())
				.then(list => {
					let foundCurrentProject = false;
					list.forEach(item => {
						const opt = document.createElement('option');
						opt.value = item.id;
						opt.textContent = item.name;
						projectDropdown.appendChild(opt);

						// Check if current selection exists in new data
						if (currentProjectCode && item.id == currentProjectCode) {
							foundCurrentProject = true;
						}
					});

					// Restore selection if it exists in new data
					if (foundCurrentProject) {
						projectDropdown.value = currentProjectCode;
					}

					document.getElementById('totalProjects').textContent = list.length;
				})
				.catch(e => console.error(e));
		}
	});




