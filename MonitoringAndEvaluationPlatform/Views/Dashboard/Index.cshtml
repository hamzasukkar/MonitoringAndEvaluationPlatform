	document.getElementById('clearFiltersBtn').addEventListener('click', function () {
		location.reload();
	});

	// Export functionality
	document.getElementById('exportExcelBtn').addEventListener('click', function () {
		exportDashboard('excel');
	});

	document.getElementById('exportPdfBtn').addEventListener('click', function () {
		exportDashboard('pdf');
	});

	async function captureCharts() {
		const charts = [];
		const container = document.getElementById('gaugesContainer');
		const canvases = container.querySelectorAll('canvas');

		for (const canvas of canvases) {
			const card = canvas.closest('.card');
			const frameworkName = card ? card.querySelector('h5')?.textContent || 'Chart' : 'Chart';
			const performanceText = card ? card.querySelector('.fw-bold.mt-2')?.textContent || '' : '';

			// Get the chart image as base64
			const imageData = canvas.toDataURL('image/png');
			charts.push({
				name: frameworkName.trim(),
				performance: performanceText.trim(),
				image: imageData
			});
		}
		return charts;
	}

	async function exportDashboard(format) {
		const filters = getFilters();

		// Show loading state
		const btn = format === 'excel'
			? document.getElementById('exportExcelBtn')
			: document.getElementById('exportPdfBtn');
		const originalHtml = btn.innerHTML;
		btn.disabled = true;
		btn.innerHTML = `<i class="fas fa-spinner fa-spin me-2"></i>@Localizer["Exporting..."]`;

		try {
			// Capture charts as images
			const chartImages = await captureCharts();

			// Prepare request data - convert empty strings to null
			const requestData = {
				frameworkCode: filters.frameworkCode ? parseInt(filters.frameworkCode) : null,
				ministryCode: filters.ministryCode ? parseInt(filters.ministryCode) : null,
				projectCode: filters.projectCode ? parseInt(filters.projectCode) : null,
				governorateCode: filters.governorateCode || null,
				districtCode: filters.districtCode || null,
				subDistrictCode: filters.subDistrictCode || null,
				communityCode: filters.communityCode || null,
				chartImages: chartImages
			};

			console.log('Export request data:', requestData);

			const exportUrl = format === 'excel' ? '/Dashboard/ExportExcel' : '/Dashboard/ExportPdf';

			const response = await fetch(exportUrl, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify(requestData)
			});

			if (!response.ok) throw new Error('Export failed');

			const blob = await response.blob();
			const url = window.URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = format === 'excel'
				? `Dashboard_Export_${new Date().toISOString().split('T')[0]}.xlsx`
				: `Dashboard_Export_${new Date().toISOString().split('T')[0]}.pdf`;
			document.body.appendChild(a);
			a.click();
			window.URL.revokeObjectURL(url);
			a.remove();
		} catch (error) {
			console.error('Export error:', error);
			alert('@Localizer["Export failed. Please try again."]');
		} finally {
			btn.disabled = false;
			btn.innerHTML = originalHtml;
		}
	}
	// Helpers
	function resetDropdown(id) {
		const dd = $(`#${id}`);
		dd.empty().append('<option disabled selected value="">-- Select --</option>');
		dd.val(null).trigger('change');
		dd.prop('disabled', true);
	}

	function populateDropdown(id, items, preserveSelection = false) {
		const dd = $(`#${id}`);
		const currentValues = preserveSelection ? dd.val() : null;

		// Clear existing options except the placeholder
		dd.empty().append('<option disabled selected value="">-- Select --</option>');

		// Add new options
		items.forEach(i => {
			const opt = document.createElement('option');
			opt.value = i.code;
			opt.textContent = i.aR_Name || i.name;
			dd.append(opt);
		});

		// Restore selection if preserving
		if (preserveSelection && currentValues) {
			dd.val(currentValues);
		}

		// Enable dropdown and refresh Select2
		dd.prop('disabled', false);
		dd.trigger('change.select2');
	}

	function getFilters() {
		return {
			frameworkCode: document.getElementById('frameworkFilter').value,
			ministryCode: document.getElementById('ministryFilter').value,
			projectCode: document.getElementById('projectFilter').value,
			governorateCode: $('#governorateFilter').val() ? $('#governorateFilter').val().join(',') : '',
			districtCode: $('#districtFilter').val() ? $('#districtFilter').val().join(',') : '',
			subDistrictCode: $('#subDistrictFilter').val() ? $('#subDistrictFilter').val().join(',') : '',
			communityCode: $('#communityFilter').val() ? $('#communityFilter').val().join(',') : ''
		};
	}

	// Print: set timestamp before printing
	window.addEventListener('beforeprint', function () {
		const header = document.querySelector('.dashboard-header');
		if (header) {
			const now = new Date();
			header.setAttribute('data-print-date', now.toLocaleDateString() + ' ' + now.toLocaleTimeString());
		}
	});

	// Initialize the page
	loadGauges();

}); // End document.ready
</script>
