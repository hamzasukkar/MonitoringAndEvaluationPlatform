@model MonitoringAndEvaluationPlatform.ViewModels.UserManagementViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["UserManagement"];
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="dashboard-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-4 mb-2">
                    <i class="fas fa-users-cog me-3"></i>@Localizer["UserManagement"]
                </h1>
                <p class="text-muted">@Localizer["ManageSystemUsers"]</p>
            </div>
            <div>
                <a asp-action="Roles" class="btn btn-secondary btn-lg me-2">
                    <i class="fas fa-user-tag me-2"></i>@Localizer["ManageRoles"]
                </a>
                <a asp-action="CreateUser" class="btn btn-primary btn-lg">
                    <i class="fas fa-user-plus me-2"></i>@Localizer["CreateNewUser"]
                </a>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-primary">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-content">
                    <h3>@Model.TotalUsers</h3>
                    <p>@Localizer["TotalUsers"]</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-success">
                    <i class="fas fa-user-check"></i>
                </div>
                <div class="stat-content">
                    <h3>@Model.Users.Count(u => u.EmailConfirmed)</h3>
                    <p>@Localizer["VerifiedUsers"]</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-danger">
                    <i class="fas fa-user-lock"></i>
                </div>
                <div class="stat-content">
                    <h3>@Model.Users.Count(u => u.IsLocked)</h3>
                    <p>@Localizer["LockedUsers"]</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-info">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div class="stat-content">
                    <h3>@Model.AvailableRoles.Count</h3>
                    <p>@Localizer["Roles"]</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Users" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@Localizer["Search"]</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="@Localizer["SearchPlaceholder"]">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localizer["FilterByRole"]</label>
                    <select name="roleFilter" class="form-select">
                        <option value="">@Localizer["AllRoles"]</option>
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <option value="@role" selected="@(role == Model.RoleFilter)">@role</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Localizer["PageSize"]</label>
                    <select name="pageSize" class="form-select">
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-filter me-1"></i>@Localizer["Filter"]
                    </button>
                    <a asp-action="Users" class="btn btn-secondary">
                        <i class="fas fa-redo me-1"></i>@Localizer["Reset"]
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>@Localizer["Username"]</th>
                            <th>@Localizer["Email"]</th>
                            <th>@Localizer["Ministry"]</th>
                            <th>@Localizer["Roles"]</th>
                            <th>@Localizer["Status"]</th>
                            <th class="text-center">@Localizer["TwoFactor"]</th>
                            <th class="text-center">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <strong>@user.UserName</strong>
                                </td>
                                <td>
                                    @user.Email
                                    @if (user.EmailConfirmed)
                                    {
                                        <i class="fas fa-check-circle text-success ms-1" title="@Localizer["EmailVerified"]"></i>
                                    }
                                </td>
                                <td>@(isArabic ? (user.MinistryNameAr ?? "-") : (user.MinistryName ?? "-"))</td>
                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-primary me-1">@role</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-lock me-1"></i>@Localizer["Locked"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-lock-open me-1"></i>@Localizer["Active"]
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (user.TwoFactorEnabled)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-shield-alt me-1"></i>@Localizer["Enabled"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-shield-alt me-1"></i>@Localizer["Disabled"]
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-sm btn-info" title="@Localizer["ViewDetails"]">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-warning" title="@Localizer["Edit"]">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-secondary" onclick="resetPassword('@user.Id', '@user.UserName')" title="@Localizer["ResetPassword"]">
                                            <i class="fas fa-key"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm @(user.IsLocked ? "btn-success" : "btn-warning")" onclick="toggleLockout('@user.Id', '@user.UserName', @user.IsLocked.ToString().ToLower())" title="@Localizer["ToggleLockout"]">
                                            <i class="fas fa-@(user.IsLocked ? "unlock" : "lock")"></i>
                                        </button>
                                        @* Only offered when there is a factor to clear - an administrator cannot enrol one on the user's behalf. *@
                                        @if (user.TwoFactorEnabled)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="resetTwoFactor('@user.Id', '@user.UserName')" title="@Localizer["ResetTwoFactor"]">
                                                <i class="fas fa-shield-alt"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-danger" onclick="deleteUser('@user.Id', '@user.UserName')" title="@Localizer["Delete"]">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Users", new { searchTerm = Model.SearchTerm, roleFilter = Model.RoleFilter, page = Model.CurrentPage - 1, pageSize = Model.PageSize })">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Users", new { searchTerm = Model.SearchTerm, roleFilter = Model.RoleFilter, page = i, pageSize = Model.PageSize })">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Users", new { searchTerm = Model.SearchTerm, roleFilter = Model.RoleFilter, page = Model.CurrentPage + 1, pageSize = Model.PageSize })">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<style>
    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
    }

    .stat-content h3 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        color: #2d3748;
    }

    .stat-content p {
        margin: 0;
        font-size: 0.9rem;
        color: #718096;
    }

    .card {
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
        border-bottom: 2px solid #dee2e6;
    }

    .btn-group .btn {
        margin: 0 2px;
    }
</style>

@* Anti-forgery token for AJAX requests - placed before scripts *@
<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<script>
    const _strConfirmDeleteUser = @Json.Serialize(Localizer.GetString("ConfirmDeleteUser").Value);
    const _strEnterNewPassword = @Json.Serialize(Localizer.GetString("EnterNewPassword").Value);
    const _strConfirmResetTwoFactor = @Json.Serialize(Localizer.GetString("ConfirmResetTwoFactor").Value);
    const _strConfirmToggleLockout = @Json.Serialize(Localizer.GetString("ConfirmToggleLockout").Value);
    const _strUnlock = @Json.Serialize(Localizer.GetString("Unlock").Value);
    const _strLock = @Json.Serialize(Localizer.GetString("Lock").Value);
    const _strSecurityToken = '@Localizer["Security token not found. Please refresh the page."]';
    const _strAnErrorOccurred = '@Localizer["An error occurred. Please try again."]';

    function deleteUser(userId, userName) {
        if (confirm(_strConfirmDeleteUser.replace('{0}', userName))) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!token) {
                alert(_strSecurityToken);
                return;
            }
            fetch('@Url.Action("DeleteUser", "Admin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token.value
                },
                body: new URLSearchParams({ id: userId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert(_strAnErrorOccurred);
            });
        }
    }

    function resetPassword(userId, userName) {
        const newPassword = prompt(_strEnterNewPassword.replace('{0}', userName));
        if (newPassword) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!token) {
                alert(_strSecurityToken);
                return;
            }
            fetch('@Url.Action("ResetPassword", "Admin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token.value
                },
                body: new URLSearchParams({ id: userId, newPassword: newPassword })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    location.reload();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert(_strAnErrorOccurred);
            });
        }
    }

    function resetTwoFactor(userId, userName) {
        // Deliberately a sterner confirmation than the other actions: this strips a user's
        // second factor, and the account is protected by password alone until they enrol again.
        if (confirm(_strConfirmResetTwoFactor.replace('{0}', userName))) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!token) {
                alert(_strSecurityToken);
                return;
            }
            fetch('@Url.Action("ResetTwoFactor", "Admin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token.value
                },
                body: new URLSearchParams({ id: userId })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    location.reload();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert(_strAnErrorOccurred);
            });
        }
    }

    function toggleLockout(userId, userName, isLocked) {
        const action = isLocked ? _strUnlock : _strLock;
        if (confirm(_strConfirmToggleLockout.replace('{0}', action).replace('{1}', userName))) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!token) {
                alert(_strSecurityToken);
                return;
            }
            fetch('@Url.Action("ToggleLockout", "Admin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token.value
                },
                body: new URLSearchParams({ id: userId })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    location.reload();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert(_strAnErrorOccurred);
            });
        }
    }
</script>
