@model MonitoringAndEvaluationPlatform.ViewModels.EditUserViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EditUser"];
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}

<div class="container-fluid py-4">
    <div class="dashboard-header mb-4">
        <h1 class="display-4">
            <i class="fas fa-user-edit me-3"></i>@Localizer["EditUser"]
        </h1>
        <p class="text-muted">@Localizer["UpdateUserInformation"]</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="EditUser" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label">@Localizer["Username"]</label>
                                <input asp-for="UserName" class="form-control" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">@Localizer["Email"]</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MinistryCode" class="form-label">@Localizer["Ministry"]</label>
                            <select asp-for="MinistryCode" class="form-select">
                                <option value="">-- @Localizer["SelectMinistry"] --</option>
                                @foreach (var ministry in Model.Ministries)
                                {
                                    var displayName = isArabic ? ministry.MinistryDisplayName_AR : ministry.MinistryDisplayName_EN;
                                    <option value="@ministry.Code" selected="@(ministry.Code == Model.MinistryCode)">
                                        @displayName
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="MinistryCode" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["Roles"]</label>
                            <div class="roles-checkboxes">
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    var roleLocked = Model.AdminRoleLocked && role == MonitoringAndEvaluationPlatform.Models.UserRoles.SystemAdministrator;
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role" id="role_@role"
                                               checked="@(Model.SelectedRoles != null && Model.SelectedRoles.Contains(role))"
                                               disabled="@roleLocked" />
                                        @if (roleLocked)
                                        {
                                            @* A disabled checkbox is not posted; this keeps the role in the submitted list. *@
                                            <input type="hidden" name="SelectedRoles" value="@role" />
                                        }
                                        <label class="form-check-label" for="role_@role">
                                            @Localizer[role]
                                        </label>
                                    </div>
                                }
                            </div>
                            @if (Model.AdminRoleLocked)
                            {
                                <small class="text-muted d-block mt-2">
                                    <i class="fas fa-shield-alt me-1"></i>@Localizer["AdminRoleLocked"]
                                </small>
                            }
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input asp-for="EmailConfirmed" class="form-check-input" />
                                    <label asp-for="EmailConfirmed" class="form-check-label">@Localizer["EmailConfirmed"]</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input asp-for="LockoutEnabled" class="form-check-input" />
                                    <label asp-for="LockoutEnabled" class="form-check-label">@Localizer["LockoutEnabled"]</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>@Localizer["BackToList"]
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>@Localizer["SaveChanges"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
    }

    .roles-checkboxes {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.5rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 8px;
    }

    .form-check {
        margin-bottom: 0.5rem;
    }

    /* The layout loads Bootstrap's LTR stylesheet, which floats each checkbox to the LEFT edge of
       its own cell. In Arabic the label sits at the right edge, so the box ended up beside the
       neighbouring label. Mirror Bootstrap's spacing so the box sits right next to its own label. */
    [dir="rtl"] .form-check {
        padding-left: 0;
        padding-right: 1.5em;
    }

    [dir="rtl"] .form-check .form-check-input {
        float: right;
        margin-left: 0;
        margin-right: -1.5em;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
