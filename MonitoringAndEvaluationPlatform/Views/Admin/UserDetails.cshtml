@model MonitoringAndEvaluationPlatform.ViewModels.UserViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["UserDetails"];
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="dashboard-header mb-4">
        <h1 class="display-4">
            <i class="fas fa-user-circle me-3"></i>@Localizer["UserDetails"]
        </h1>
        <p class="text-muted">@Localizer["ViewDetailedUserInformation"]</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-user me-2"></i>@Model.UserName
                    </h3>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="info-item">
                                <label class="info-label">@Localizer["UserId"]</label>
                                <p class="info-value">@Model.Id</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-item">
                                <label class="info-label">@Localizer["Username"]</label>
                                <p class="info-value">@Model.UserName</p>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="info-item">
                                <label class="info-label">@Localizer["Email"]</label>
                                <p class="info-value">
                                    @Model.Email
                                    @if (Model.EmailConfirmed)
                                    {
                                        <span class="badge bg-success ms-2">
                                            <i class="fas fa-check-circle"></i> @Localizer["Verified"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning ms-2">
                                            <i class="fas fa-exclamation-triangle"></i> @Localizer["NotVerified"]
                                        </span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-item">
                                <label class="info-label">@Localizer["Ministry"]</label>
                                <p class="info-value">@(Model.MinistryName ?? "-")</p>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="info-item">
                                <label class="info-label">@Localizer["AccountStatus"]</label>
                                <p class="info-value">
                                    @if (Model.IsLocked)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-lock"></i> @Localizer["Locked"]
                                        </span>
                                        <br />
                                        <small class="text-muted">@Localizer["LockedUntil"]: @Model.LockoutEnd?.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-lock-open"></i> @Localizer["Active"]
                                        </span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-item">
                                <label class="info-label">@Localizer["LockoutEnabled"]</label>
                                <p class="info-value">
                                    @if (Model.LockoutEnabled)
                                    {
                                        <span class="badge bg-info">@Localizer["Yes"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Localizer["No"]</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="info-item">
                            <label class="info-label">@Localizer["Roles"]</label>
                            <p class="info-value">
                                @if (Model.Roles.Any())
                                {
                                    foreach (var role in Model.Roles)
                                    {
                                        <span class="badge bg-primary me-1 mb-1">
                                            <i class="fas fa-user-shield me-1"></i>@role
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">@Localizer["NoRolesAssigned"]</span>
                                }
                            </p>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>@Localizer["BackToList"]
                        </a>
                        <a asp-action="EditUser" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-edit me-2"></i>@Localizer["EditUser"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
    }

    .info-item {
        margin-bottom: 1rem;
    }

    .info-label {
        font-weight: 600;
        color: #718096;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.25rem;
        display: block;
    }

    .info-value {
        font-size: 1.125rem;
        color: #2d3748;
        margin: 0;
    }

    .badge {
        font-size: 0.875rem;
        padding: 0.4rem 0.8rem;
    }
</style>
