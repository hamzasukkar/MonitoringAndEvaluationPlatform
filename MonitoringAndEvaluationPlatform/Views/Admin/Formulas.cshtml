@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["FormulasAndCalculations"];
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="dashboard-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-4 mb-2">
                    <i class="fas fa-calculator me-3"></i>@Localizer["FormulasAndCalculations"]
                </h1>
                <p class="text-muted">@Localizer["FormulasDescription"]</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left me-2"></i>@Localizer["BackToAdmin"]
                </a>
            </div>
        </div>
    </div>

    <!-- Table of Contents -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                <i class="fas fa-list-ol me-2"></i>@Localizer["TableOfContents"]
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <ul class="list-unstyled">
                        <li><a href="#hierarchy" class="text-decoration-none"><i class="fas fa-sitemap me-2"></i>@Localizer["DataHierarchy"]</a></li>
                        <li><a href="#plan-performance" class="text-decoration-none"><i class="fas fa-tasks me-2"></i>@Localizer["PlanPerformance"]</a></li>
                        <li><a href="#project-performance" class="text-decoration-none"><i class="fas fa-project-diagram me-2"></i>@Localizer["ProjectPerformance"]</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <ul class="list-unstyled">
                        <li><a href="#indicator-performance" class="text-decoration-none"><i class="fas fa-bullseye me-2"></i>@Localizer["IndicatorPerformance"]</a></li>
                        <li><a href="#hierarchy-propagation" class="text-decoration-none"><i class="fas fa-arrow-up me-2"></i>@Localizer["HierarchyPropagation"]</a></li>
                        <li><a href="#weighted-average" class="text-decoration-none"><i class="fas fa-balance-scale me-2"></i>@Localizer["WeightedAverage"]</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <ul class="list-unstyled">
                        <li><a href="#cross-cutting" class="text-decoration-none"><i class="fas fa-exchange-alt me-2"></i>@Localizer["CrossCuttingEntities"]</a></li>
                        <li><a href="#measure-calculations" class="text-decoration-none"><i class="fas fa-chart-line me-2"></i>@Localizer["MeasureCalculations"]</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Hierarchy Section -->
    <div class="card mb-4" id="hierarchy">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-sitemap me-2"></i>@Localizer["DataHierarchy"]
            </h5>
        </div>
        <div class="card-body">
            <p class="lead">@Localizer["HierarchyIntro"]</p>

            <div class="hierarchy-diagram text-center my-4 p-4 bg-light rounded">
                <div class="hierarchy-level level-1">
                    <span class="badge bg-dark fs-5 py-2 px-4"><i class="fas fa-sitemap me-2"></i>@Localizer["StrategicGoals"]</span>
                </div>
                <div class="hierarchy-arrow"><i class="fas fa-chevron-down text-muted"></i></div>
                <div class="hierarchy-level level-2">
                    <span class="badge bg-primary fs-6 py-2 px-3"><i class="fas fa-bullseye me-2"></i>@Localizer["Outcome"]</span>
                </div>
                <div class="hierarchy-arrow"><i class="fas fa-chevron-down text-muted"></i></div>
                <div class="hierarchy-level level-3">
                    <span class="badge bg-info fs-6 py-2 px-3"><i class="fas fa-layer-group me-2"></i>@Localizer["Output"]</span>
                </div>
                <div class="hierarchy-arrow"><i class="fas fa-chevron-down text-muted"></i></div>
                <div class="hierarchy-level level-4">
                    <span class="badge bg-success fs-6 py-2 px-3"><i class="fas fa-list-ul me-2"></i>@Localizer["SubOutput"]</span>
                </div>
                <div class="hierarchy-arrow"><i class="fas fa-chevron-down text-muted"></i></div>
                <div class="hierarchy-level level-6">
                    <span class="badge bg-secondary fs-6 py-2 px-3"><i class="fas fa-project-diagram me-2"></i>@Localizer["Project"]</span>
                </div>
                <div class="hierarchy-arrow"><i class="fas fa-chevron-down text-muted"></i></div>
                <div class="hierarchy-level level-7">
                    <span class="badge bg-danger fs-6 py-2 px-3"><i class="fas fa-tasks me-2"></i>@Localizer["ActionPlan"] / @Localizer["Plan"]</span>
                </div>
            </div>

            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                @Localizer["HierarchyNote"]
            </div>
        </div>
    </div>

    <!-- Plan & Phase Performance Section -->
    <div class="card mb-4" id="plan-performance">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">
                <i class="fas fa-tasks me-2"></i>@Localizer["PlanPerformance"]
            </h5>
        </div>
        <div class="card-body">
            <p>@Localizer["PlanPerformanceIntro"]</p>

            <h6 class="fw-bold mt-3">@Localizer["PhasePerformanceTitle"]</h6>
            <p class="small text-muted">@Localizer["PhasePerformanceDescText"]</p>
            <div class="formula-box bg-dark text-light p-4 rounded my-3">
                <h6 class="text-warning mb-3"><i class="fas fa-function me-2"></i>@Localizer["Formula"]:</h6>
                <code class="fs-6 d-block text-center py-2">
                    PhasePerformance = Σ(Measure.Value)
                </code>
            </div>

            <h6 class="fw-bold mt-4">@Localizer["DisbursementPerformance"]</h6>
            <p class="small text-muted">@Localizer["DisbursementPerformanceDesc"]</p>
            <div class="formula-box bg-dark text-light p-4 rounded my-3">
                <h6 class="text-warning mb-3"><i class="fas fa-function me-2"></i>@Localizer["Formula"]:</h6>
                <code class="fs-6 d-block text-center py-2">
                    DisbursementPerformance = (Σ Plans.Realised / Project.EstimatedBudget) × 100
                </code>
            </div>

            <div class="alert alert-info mt-3">
                <i class="fas fa-info-circle me-2"></i>
                @Localizer["PlanPerformanceNote"]
            </div>
        </div>
    </div>

    <!-- Project Performance Section -->
    <div class="card mb-4" id="project-performance">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">
                <i class="fas fa-project-diagram me-2"></i>@Localizer["ProjectPerformance"]
            </h5>
        </div>
        <div class="card-body">
            <p>@Localizer["ProjectPerformanceIntro"]</p>

            <h6 class="fw-bold mt-3">1. @Localizer["ProjectOverallPerformance"]</h6>
            <div class="formula-box bg-dark text-light p-4 rounded my-3">
                <h6 class="text-warning mb-3"><i class="fas fa-function me-2"></i>@Localizer["Formula"]:</h6>
                <code class="fs-5 d-block text-center py-3">
                    Project.Performance = Σ(PhasePerformance<sub>i</sub> × Weight<sub>i</sub>) / Σ(Weight<sub>i</sub>)
                </code>
                <hr class="border-secondary">
                <p class="mb-0 small text-muted">
                    <strong>@Localizer["Where"]:</strong><br>
                    • <code>PhasePerformance<sub>i</sub></code> = @Localizer["PhasePerformanceDesc"]<br>
                    • <code>Weight<sub>i</sub></code> = @Localizer["PhaseWeightDesc"]
                </p>
            </div>

            <h6 class="fw-bold mt-4">2. @Localizer["DisbursementPerformance"]</h6>
            <div class="formula-box bg-dark text-light p-4 rounded my-3">
                <h6 class="text-warning mb-3"><i class="fas fa-function me-2"></i>@Localizer["Formula"]:</h6>
                <code class="fs-5 d-block text-center py-3">
                    Project.DisbursementPerformance = (totalRealised / estimatedBudget) × 100
                </code>
                <hr class="border-secondary">
                <p class="mb-0 small text-muted">
                    <strong>@Localizer["Where"]:</strong><br>
                    • <code>totalRealised</code> = @Localizer["SumOfRealisedValues"]<br>
                    • <code>estimatedBudget</code> = @Localizer["EstimatedBudget"]
                </p>
            </div>

            <h6 class="fw-bold mt-4">@Localizer["CalculationProcess"]:</h6>
            <ol class="mt-3">
                <li class="mb-2">@Localizer["ProjectCalcStep1"]</li>
                <li class="mb-2">@Localizer["ProjectCalcStep2"]</li>
                <li class="mb-2">@Localizer["ProjectCalcStep3"]</li>
                <li class="mb-2">@Localizer["ProjectCalcStep4"]</li>
            </ol>

            <div class="alert alert-warning mt-4">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>@Localizer["Important"]:</strong> @Localizer["ProjectCalcNote"]
            </div>
        </div>
    </div>

    <!-- Indicator Performance Section -->
    <div class="card mb-4" id="indicator-performance">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                <i class="fas fa-chart-bar me-2"></i>@Localizer["IndicatorPerformance"]
            </h5>
        </div>
        <div class="card-body">
            <p>@Localizer["IndicatorPerformanceIntro"]</p>

            <div class="formula-box bg-dark text-light p-4 rounded my-4">
                <h6 class="text-warning mb-3"><i class="fas fa-function me-2"></i>@Localizer["Formula"]:</h6>
                <code class="fs-5 d-block text-center py-3">
                    Indicator.Performance = Project.Performance
                </code>
                <hr class="border-secondary">
                <p class="mb-0 small text-muted">
                    <strong>@Localizer["Where"]:</strong><br>
                    • <code>Project.Performance</code> = @Localizer["ProjectPerformanceWeightedDesc"]<br>
                    • @Localizer["IndicatorPassthroughNote"]
                </p>
            </div>

            <h6 class="fw-bold mt-4">@Localizer["CalculationDetails"]:</h6>
            <ul class="mt-3">
                <li class="mb-2">@Localizer["IndicatorCalcDetail1"]</li>
                <li class="mb-2">@Localizer["IndicatorCalcDetail2"]</li>
                <li class="mb-2">@Localizer["IndicatorCalcDetail3"]</li>
            </ul>
        </div>
    </div>

    <!-- Hierarchy Propagation Section -->
    <div class="card mb-4" id="hierarchy-propagation">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">
                <i class="fas fa-arrow-up me-2"></i>@Localizer["HierarchyPropagation"]
            </h5>
        </div>
        <div class="card-body">
            <p>@Localizer["HierarchyPropagationIntro"]</p>

            <div class="propagation-flow my-4">
                <div class="row text-center">
                    <div class="col">
                        <div class="p-3 bg-danger text-white rounded mb-2"><i class="fas fa-tasks me-2"></i>@Localizer["Plan"]</div>
                        <i class="fas fa-arrow-down fa-2x text-muted"></i>
                    </div>
                </div>
                <div class="row text-center mt-2">
                    <div class="col">
                        <div class="p-3 bg-secondary text-white rounded mb-2"><i class="fas fa-project-diagram me-2"></i>@Localizer["Project"]</div>
                        <i class="fas fa-arrow-down fa-2x text-muted"></i>
                    </div>
                </div>
                <div class="row text-center mt-2">
                    <div class="col">
                        <div class="p-3 bg-warning text-dark rounded mb-2"><i class="fas fa-chart-bar me-2"></i>@Localizer["Indicator"]</div>
                        <i class="fas fa-arrow-down fa-2x text-muted"></i>
                    </div>
                </div>
                <div class="row text-center mt-2">
                    <div class="col">
                        <div class="p-3 bg-success text-white rounded mb-2"><i class="fas fa-list-ul me-2"></i>@Localizer["SubOutput"]</div>
                        <i class="fas fa-arrow-down fa-2x text-muted"></i>
                    </div>
                </div>
                <div class="row text-center mt-2">
                    <div class="col">
                        <div class="p-3 bg-info text-white rounded mb-2"><i class="fas fa-layer-group me-2"></i>@Localizer["Output"]</div>
                        <i class="fas fa-arrow-down fa-2x text-muted"></i>
                    </div>
                </div>
                <div class="row text-center mt-2">
                    <div class="col">
                        <div class="p-3 bg-primary text-white rounded mb-2"><i class="fas fa-bullseye me-2"></i>@Localizer["Outcome"]</div>
                        <i class="fas fa-arrow-down fa-2x text-muted"></i>
                    </div>
                </div>
                <div class="row text-center mt-2">
                    <div class="col">
                        <div class="p-3 bg-dark text-white rounded"><i class="fas fa-sitemap me-2"></i>@Localizer["Framework"]</div>
                    </div>
                </div>
            </div>

            <div class="table-responsive mt-4">
                <table class="table table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>@Localizer["Level"]</th>
                            <th>@Localizer["CalculatedFrom"]</th>
                            <th>@Localizer["Method"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="badge bg-secondary"><i class="fas fa-project-diagram me-1"></i>@Localizer["Project"]</span></td>
                            <td>@Localizer["Phases"] / @Localizer["Plans"]</td>
                            <td><code>Σ(PhasePerformance × Weight) / Σ(Weight)</code></td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-warning text-dark"><i class="fas fa-chart-bar me-1"></i>@Localizer["Indicator"]</span></td>
                            <td>@Localizer["Project"]</td>
                            <td><code>Indicator.Performance = Project.Performance</code></td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-success"><i class="fas fa-list-ul me-1"></i>@Localizer["SubOutput"]</span></td>
                            <td>@Localizer["Indicators"]</td>
                            <td>@Localizer["WeightedAverageMethod"]</td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-info"><i class="fas fa-layer-group me-1"></i>@Localizer["Output"]</span></td>
                            <td>@Localizer["SubOutputs"]</td>
                            <td>@Localizer["WeightedAverageMethod"]</td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-primary"><i class="fas fa-bullseye me-1"></i>@Localizer["Outcome"]</span></td>
                            <td>@Localizer["Outputs"]</td>
                            <td>@Localizer["WeightedAverageMethod"]</td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-dark"><i class="fas fa-sitemap me-1"></i>@Localizer["Framework"]</span></td>
                            <td>@Localizer["Outcomes"]</td>
                            <td>@Localizer["WeightedAverageMethod"]</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Weighted Average Section -->
    <div class="card mb-4" id="weighted-average">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">
                <i class="fas fa-balance-scale me-2"></i>@Localizer["WeightedAverage"]
            </h5>
        </div>
        <div class="card-body">
            <p>@Localizer["WeightedAverageIntro"]</p>

            <div class="formula-box bg-dark text-light p-4 rounded my-4">
                <h6 class="text-warning mb-3"><i class="fas fa-function me-2"></i>@Localizer["Formula"]:</h6>
                <code class="fs-5 d-block text-center py-3">
                    WeightedPerformance = Σ(Performance<sub>i</sub> × Weight<sub>i</sub>) / Σ(Weight<sub>i</sub>)
                </code>
                <hr class="border-secondary">
                <p class="mb-0 small text-muted">
                    <strong>@Localizer["Where"]:</strong><br>
                    • <code>Performance<sub>i</sub></code> = @Localizer["PerformanceOfItem"]<br>
                    • <code>Weight<sub>i</sub></code> = @Localizer["WeightOfItem"]<br>
                    • <code>Σ(Weight<sub>i</sub>)</code> = @Localizer["TotalWeight"]
                </p>
            </div>

            <h6 class="fw-bold mt-4">@Localizer["Example"]:</h6>
            <div class="example-box bg-light p-4 rounded mt-3">
                <p><strong>@Localizer["ExampleScenario"]:</strong> @Localizer["WeightedExampleScenario"]</p>
                <table class="table table-sm table-bordered mt-3">
                    <thead class="table-secondary">
                        <tr>
                            <th>@Localizer["Project"]</th>
                            <th>@Localizer["Performance"] (%)</th>
                            <th>@Localizer["Weight"]</th>
                            <th>@Localizer["Contribution"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@Localizer["ProjectA"]</td>
                            <td>80%</td>
                            <td>2</td>
                            <td>160</td>
                        </tr>
                        <tr>
                            <td>@Localizer["ProjectB"]</td>
                            <td>60%</td>
                            <td>3</td>
                            <td>180</td>
                        </tr>
                        <tr>
                            <td>@Localizer["ProjectC"]</td>
                            <td>90%</td>
                            <td>1</td>
                            <td>90</td>
                        </tr>
                        <tr class="table-info">
                            <td><strong>@Localizer["Total"]</strong></td>
                            <td>-</td>
                            <td><strong>6</strong></td>
                            <td><strong>430</strong></td>
                        </tr>
                    </tbody>
                </table>
                <p class="mt-3 mb-0">
                    <strong>@Localizer["Result"]:</strong>
                    <code class="bg-dark text-light px-2 py-1 rounded">430 / 6 = 71.67%</code>
                </p>
            </div>

            <div class="alert alert-info mt-4">
                <i class="fas fa-info-circle me-2"></i>
                <strong>@Localizer["Note"]:</strong> @Localizer["WeightFallbackNote"]
            </div>
        </div>
    </div>

    <!-- Cross-Cutting Entities Section -->
    <div class="card mb-4" id="cross-cutting">
        <div class="card-header" style="background-color: #6f42c1; color: white;">
            <h5 class="mb-0">
                <i class="fas fa-exchange-alt me-2"></i>@Localizer["CrossCuttingEntities"]
            </h5>
        </div>
        <div class="card-body">
            <p>@Localizer["CrossCuttingIntro"]</p>

            <div class="row mt-4">
                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="fas fa-building fa-3x text-primary mb-3"></i>
                            <h6 class="fw-bold">@Localizer["Ministries"]</h6>
                            <p class="small text-muted">@Localizer["MinistriesCalcDesc"]</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="fas fa-wallet fa-3x text-success mb-3"></i>
                            <h6 class="fw-bold">@Localizer["Donors"]</h6>
                            <p class="small text-muted">@Localizer["DonorsCalcDesc"]</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="fas fa-layer-group fa-3x text-info mb-3"></i>
                            <h6 class="fw-bold">@Localizer["Sectors"]</h6>
                            <p class="small text-muted">@Localizer["SectorsCalcDesc"]</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="formula-box bg-dark text-light p-4 rounded my-4">
                <h6 class="text-warning mb-3"><i class="fas fa-function me-2"></i>@Localizer["Formula"]:</h6>
                <code class="fs-6 d-block text-center py-3">
                    Entity.Performance = Average(LinkedProjects.Performance)
                </code>
            </div>
        </div>
    </div>

    <!-- Measure Calculations Section -->
    <div class="card mb-4" id="measure-calculations">
        <div class="card-header" style="background-color: #20c997; color: white;">
            <h5 class="mb-0">
                <i class="fas fa-chart-line me-2"></i>@Localizer["MeasureCalculations"]
            </h5>
        </div>
        <div class="card-body">
            <p>@Localizer["MeasureCalcIntro"]</p>

            <h6 class="fw-bold mt-4">@Localizer["CurrentAchievement"]:</h6>
            <div class="formula-box bg-dark text-light p-4 rounded my-3">
                <code class="fs-6 d-block text-center py-2">
                    CurrentAchievement = Σ(Measure.Value)
                </code>
            </div>

            <h6 class="fw-bold mt-4">@Localizer["RemainingToTarget"]:</h6>
            <div class="formula-box bg-dark text-light p-4 rounded my-3">
                <code class="fs-6 d-block text-center py-2">
                    RemainingToTarget = Indicator.Target - CurrentAchievement
                </code>
            </div>

            <h6 class="fw-bold mt-4">@Localizer["ProgressPercentage"]:</h6>
            <div class="formula-box bg-dark text-light p-4 rounded my-3">
                <code class="fs-6 d-block text-center py-2">
                    ProgressPercentage = (CurrentAchievement / Indicator.Target) × 100
                </code>
            </div>

            <h6 class="fw-bold mt-4">@Localizer["CumulativePerformance"]:</h6>
            <div class="formula-box bg-dark text-light p-4 rounded my-3">
                <code class="fs-6 d-block text-center py-2">
                    CumulativeValue[n] = Σ(Measure.Value[1..n])
                </code>
                <p class="small text-muted mt-2 mb-0 text-center">
                    @Localizer["CumulativeDesc"]
                </p>
            </div>
        </div>
    </div>

    <!-- Summary Table -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                <i class="fas fa-clipboard-list me-2"></i>@Localizer["FormulaSummary"]
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>@Localizer["Calculation"]</th>
                            <th>@Localizer["Formula"]</th>
                            <th>@Localizer["UsedIn"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@Localizer["PlanPerformance"]</td>
                            <td><code>(realised / planned) × 100</code></td>
                            <td>@Localizer["ProjectCalculation"]</td>
                        </tr>
                        <tr>
                            <td>@Localizer["WeightedAverage"]</td>
                            <td><code>Σ(P × W) / Σ(W)</code></td>
                            <td>@Localizer["HierarchyLevels"]</td>
                        </tr>
                        <tr>
                            <td>@Localizer["SimpleAverage"]</td>
                            <td><code>Σ(P) / count</code></td>
                            <td>@Localizer["CrossCuttingEntities"]</td>
                        </tr>
                        <tr>
                            <td>@Localizer["ProgressPercentage"]</td>
                            <td><code>(achieved / target) × 100</code></td>
                            <td>@Localizer["IndicatorDetails"]</td>
                        </tr>
                        <tr>
                            <td>@Localizer["CumulativeSum"]</td>
                            <td><code>Σ(values[1..n])</code></td>
                            <td>@Localizer["ChartDisplay"]</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
