@model MonitoringAndEvaluationPlatform.ViewModels.RoleViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using MonitoringAndEvaluationPlatform.Services
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["RoleDetails"];
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var badgeColor = RolePermissionService.GetRoleBadgeColor(Model.Name);
    var icon = RolePermissionService.GetRoleIcon(Model.Name);
    var description = RolePermissionService.GetRoleDescription(Model.Name);
    var groupedPermissions = RolePermissionService.GetPermissionsGroupedByCategory(Model.Name);
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="dashboard-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-4 mb-2">
                    <i class="fas @icon me-3"></i>@Localizer[Model.Name]
                </h1>
                <p class="text-muted">@Localizer[Model.Name + "Description"]</p>
            </div>
            <div>
                <a asp-action="Roles" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left me-2"></i>@Localizer["BackToRoles"]
                </a>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon bg-@badgeColor">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-content">
                    <h3>@Model.UserCount</h3>
                    <p>@Localizer["UsersWithThisRole"]</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon bg-success">
                    <i class="fas fa-key"></i>
                </div>
                <div class="stat-content">
                    <h3>@Model.Permissions.Count</h3>
                    <p>@Localizer["Permissions"]</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon bg-info">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div class="stat-content">
                    <h3>@groupedPermissions.Count</h3>
                    <p>@Localizer["PermissionCategories"]</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Permissions Section -->
        <div class="col-lg-7 mb-4">
            <div class="card h-100">
                <div class="card-header bg-@badgeColor text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-key me-2"></i>@Localizer["Permissions"]
                    </h5>
                </div>
                <div class="card-body">
                    @if (groupedPermissions.Any())
                    {
                        <div class="accordion" id="permissionsAccordion">
                            @{
                                var index = 0;
                            }
                            @foreach (var category in groupedPermissions)
                            {
                                var collapseId = $"collapse{index}";
                                var headingId = $"heading{index}";
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="@headingId">
                                        <button class="accordion-button @(index > 0 ? "collapsed" : "")" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                                aria-expanded="@(index == 0 ? "true" : "false")" aria-controls="@collapseId">
                                            <span class="me-auto">
                                                <strong>@Localizer[category.Key]</strong>
                                            </span>
                                            <span class="badge bg-@badgeColor me-2">@category.Value.Count</span>
                                        </button>
                                    </h2>
                                    <div id="@collapseId" class="accordion-collapse collapse @(index == 0 ? "show" : "")"
                                         aria-labelledby="@headingId" data-bs-parent="#permissionsAccordion">
                                        <div class="accordion-body">
                                            <div class="row">
                                                @foreach (var permission in category.Value)
                                                {
                                                    <div class="col-md-6 mb-2">
                                                        <div class="permission-item">
                                                            <i class="fas fa-check-circle text-success me-2"></i>
                                                            <span>@Localizer[permission]</span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                index++;
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-ban fa-3x mb-3"></i>
                            <p>@Localizer["NoPermissionsAssigned"]</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Users Section -->
        <div class="col-lg-5 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-users me-2"></i>@Localizer["UsersInRole"] (@Model.UserCount)
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Users.Any())
                    {
                        <div class="user-list">
                            @foreach (var user in Model.Users)
                            {
                                <div class="user-item d-flex align-items-center justify-content-between p-2 mb-2">
                                    <div class="d-flex align-items-center">
                                        <div class="user-avatar me-3">
                                            @user.UserName?.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <strong>@user.UserName</strong>
                                            <br />
                                            <small class="text-muted">@user.Email</small>
                                            @if (!string.IsNullOrEmpty(user.MinistryName))
                                            {
                                                <br />
                                                <small class="text-muted">
                                                    <i class="fas fa-building me-1"></i>@user.MinistryName
                                                </small>
                                            }
                                        </div>
                                    </div>
                                    <div>
                                        <a asp-action="UserDetails" asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary" title="@Localizer["ViewUser"]">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-user-slash fa-3x mb-3"></i>
                            <p>@Localizer["NoUsersInRole"]</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- All Permissions Matrix -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-th me-2"></i>@Localizer["PermissionMatrix"]
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>@Localizer["Category"]</th>
                            <th>@Localizer["Permission"]</th>
                            <th class="text-center">@Localizer["Granted"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in RolePermissionService.GetPermissionCategories())
                        {
                            var isFirst = true;
                            @foreach (var permission in category.Value)
                            {
                                var hasPermission = Model.Permissions.Contains(permission);
                                <tr class="@(hasPermission ? "" : "text-muted")">
                                    @if (isFirst)
                                    {
                                        <td rowspan="@category.Value.Count" class="align-middle">
                                            <strong>@Localizer[category.Key]</strong>
                                        </td>
                                        isFirst = false;
                                    }
                                    <td>@Localizer[permission]</td>
                                    <td class="text-center">
                                        @if (hasPermission)
                                        {
                                            <i class="fas fa-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-times-circle text-danger"></i>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    string FormatPermissionName(string permission)
    {
        // Convert camelCase/PascalCase to readable format
        var result = System.Text.RegularExpressions.Regex.Replace(permission, "([a-z])([A-Z])", "$1 $2");
        return result;
    }
}

<style>
    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
    }

    .stat-content h3 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        color: #2d3748;
    }

    .stat-content p {
        margin: 0;
        font-size: 0.9rem;
        color: #718096;
    }

    .card {
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .card-header {
        background-color: #f8f9fa;
        border-radius: 12px 12px 0 0 !important;
    }

    .permission-item {
        padding: 0.5rem;
        background-color: #f8f9fa;
        border-radius: 6px;
        font-size: 0.875rem;
    }

    .user-item {
        background-color: #f8f9fa;
        border-radius: 8px;
        transition: background-color 0.2s;
    }

    .user-item:hover {
        background-color: #e9ecef;
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 1rem;
    }

    .user-list {
        max-height: 400px;
        overflow-y: auto;
    }

    .accordion-button:not(.collapsed) {
        background-color: #f8f9fa;
        color: inherit;
    }

    .accordion-button:focus {
        box-shadow: none;
    }

    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
    }
</style>
