@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model MonitoringAndEvaluationPlatform.ViewModel.BudgetMatrixViewModel
@{
    ViewData["Title"] = Localizer["Projects Budget Matrix"];
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var inv = CultureInfo.InvariantCulture;
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="header-content">
        <div class="page-title-section">
            <div class="page-breadcrumb">
                <a href="@Url.Action("Index", "Home")" class="breadcrumb-link">
                    <i class="fas fa-home"></i>
                    @Localizer["Home"]
                </a>
                <i class="fas fa-chevron-right breadcrumb-separator"></i>
                <a href="@Url.Action("Index", "Ministries")" class="breadcrumb-link">@Localizer["Ministries"]</a>
                <i class="fas fa-chevron-right breadcrumb-separator"></i>
                <span class="current-page">@Localizer["Budget Matrix"]</span>
            </div>
            <h1 class="page-title">
                @Localizer["Projects Budget & Disbursement Matrix by Category"]
                @if (!string.IsNullOrEmpty(ViewBag.MinistryName as string))
                {
                    <span class="text-primary">— @ViewBag.MinistryName</span>
                }
            </h1>
            <p class="page-description">@Localizer["View each project's budget and disbursement distributed across categories"]</p>
        </div>
    </div>
</div>

<!-- Summary Cards -->
@if (Model.Projects.Any())
{
    var totalBudgetAll = Model.Projects.SelectMany(p => p.Budget.Values).Sum();
    var totalDisbursementAll = Model.Projects.SelectMany(p => p.Disbursement.Values).Sum();
    var overallPerformance = totalBudgetAll != 0 ? (totalDisbursementAll / totalBudgetAll) * 100 : 0;

    <div class="row g-3 mb-4" dir="rtl">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-wallet"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">@Localizer["Total Budget"]</div>
                    <div class="stat-value">@totalBudgetAll.ToString("N0", inv)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-coins"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">@Localizer["Total Disbursement"]</div>
                    <div class="stat-value">@totalDisbursementAll.ToString("N0", inv)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-chart-pie"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">@Localizer["Overall Performance"]</div>
                    <div class="stat-value">@overallPerformance.ToString("0.##", inv)%</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="chart-card" dir="rtl">
    <div class="chart-title">
        <i class="fas fa-table"></i>
        @Localizer["Budget & Disbursement Matrix"] (@Model.Projects.Count)
    </div>

    @if (!Model.Projects.Any())
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-inbox me-2"></i>@Localizer["No projects to display."]
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle text-center budget-matrix">
                <thead class="table-light">
                    <tr>
                        <th rowspan="2" class="align-middle project-name-col">@Localizer["Project Name"]</th>
                        <th rowspan="2" class="align-middle"></th>
                        <th colspan="@Model.Categories.Count">@Localizer["Categories"]</th>
                    </tr>
                    <tr>
                        @foreach (var category in Model.Categories)
                        {
                            <th class="category-col">@category</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in Model.Projects)
                    {
                        <tr>
                            <td rowspan="2" class="align-middle fw-bold project-name-col">@project.ProjectName</td>
                            <td class="row-label">@Localizer["Budget"]</td>
                            @foreach (var category in Model.Categories)
                            {
                                <td>@project.Budget[category].ToString("N0", inv)</td>
                            }
                        </tr>
                        <tr>
                            <td class="row-label">@Localizer["Disbursement"]</td>
                            @foreach (var category in Model.Categories)
                            {
                                <td>@project.Disbursement[category].ToString("N0", inv)</td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="2" class="row-label">@Localizer["Total Budget"]</td>
                        @foreach (var category in Model.Categories)
                        {
                            <td>@Model.Projects.Sum(p => p.Budget[category]).ToString("N0", inv)</td>
                        }
                    </tr>
                    <tr>
                        <td colspan="2" class="row-label">@Localizer["Total Disbursement"]</td>
                        @foreach (var category in Model.Categories)
                        {
                            <td>@Model.Projects.Sum(p => p.Disbursement[category]).ToString("N0", inv)</td>
                        }
                    </tr>
                    <tr>
                        <td colspan="2" class="row-label">@Localizer["Disbursement Performance by Category"]</td>
                        @foreach (var category in Model.Categories)
                        {
                            var totalBudget = Model.Projects.Sum(p => p.Budget[category]);
                            var totalDisb = Model.Projects.Sum(p => p.Disbursement[category]);
                            var performance = totalBudget != 0 ? (totalDisb / totalBudget) * 100 : 0;
                            <td>@performance.ToString("0.##", inv)%</td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

<style>
    .budget-matrix th,
    .budget-matrix td {
        white-space: nowrap;
        vertical-align: middle;
    }

    .budget-matrix thead th {
        background-color: #f1f3f5;
        font-weight: 600;
    }

    .budget-matrix .project-name-col {
        background-color: #fafafa;
        text-align: right;
        min-width: 140px;
    }

    .budget-matrix .row-label {
        background-color: #fafafa;
        font-weight: 600;
        text-align: right;
    }

    .budget-matrix .category-col {
        min-width: 90px;
    }

    /* Stat Cards */
    .stat-card {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .stat-card:nth-child(1) .stat-icon {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .stat-card:nth-child(2) .stat-icon {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }

    .stat-card:nth-child(3) .stat-icon {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
    }

    .stat-content {
        flex: 1;
    }

    .stat-label {
        font-size: 0.875rem;
        color: #666;
        margin-bottom: 4px;
        font-weight: 500;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #333;
    }
</style>
