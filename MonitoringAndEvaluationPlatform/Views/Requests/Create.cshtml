@model MonitoringAndEvaluationPlatform.Models.Request
@using MonitoringAndEvaluationPlatform.Enums
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["SubmitRequest"];
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="dashboard-header mb-4">
        <h1 class="display-5 mb-2">
            <i class="fas fa-paper-plane me-3"></i>@Localizer["SubmitRequest"]
        </h1>
        <p class="text-muted mb-0">@Localizer["SubmitRequestHint"]</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label">@Localizer["Title"] <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RequestDate" class="form-label">@Localizer["RequestDate"] <span class="text-danger">*</span></label>
                        <input asp-for="RequestDate" type="date" class="form-control" />
                        <span asp-validation-for="RequestDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">@Localizer["Description"]</label>
                        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Category" class="form-label">@Localizer["Category"]</label>
                        <select asp-for="Category" class="form-select">
                            @foreach (RequestCategory c in Enum.GetValues(typeof(RequestCategory)))
                            {
                                <option value="@((int)c)">@Localizer["Category" + c.ToString()]</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Priority" class="form-label">@Localizer["Priority"]</label>
                        <select asp-for="Priority" class="form-select">
                            @foreach (RequestPriority p in Enum.GetValues(typeof(RequestPriority)))
                            {
                                <option value="@((int)p)">@Localizer["Priority" + p.ToString()]</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RequestingParty" class="form-label">@Localizer["RequestingParty"]</label>
                        <input asp-for="RequestingParty" class="form-control" />
                        <span asp-validation-for="RequestingParty" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MeetingDate" class="form-label">@Localizer["MeetingDate"]</label>
                        <input asp-for="MeetingDate" type="date" class="form-control" />
                        <span asp-validation-for="MeetingDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MinistryCode" class="form-label">@Localizer["Ministry"]</label>
                        <select asp-for="MinistryCode" asp-items="ViewBag.Ministries" class="form-select">
                            <option value="">@Localizer["None"]</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label for="UploadedFiles" class="form-label">@Localizer["Attachments"]</label>
                        <input type="file" id="UploadedFiles" name="UploadedFiles" class="form-control" multiple />
                        <div class="form-text">@Localizer["AttachmentsHint"]</div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">@Localizer["Notes"]</label>
                        <textarea asp-for="Notes" rows="2" class="form-control"></textarea>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-paper-plane me-2"></i>@Localizer["Submit"]
                    </button>
                    <a asp-action="MyRequests" class="btn btn-outline-secondary btn-lg">
                        @Localizer["Cancel"]
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
