    .budget-bar-labels {
        font-size: 0.82rem;
        color: #6c757d;
    }

    .text-success { color: #28a745 !important; }
    .text-danger  { color: #dc3545 !important; }

    /* Validation Alert */
    .validation-alert {
        background: rgba(220, 53, 69, 0.08);
        border: 1px solid rgba(220, 53, 69, 0.3);
