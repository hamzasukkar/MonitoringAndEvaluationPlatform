    }

    .banner-icon.budget-icon {
        background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%);
    }

    .banner-icon.phases-icon {
        background: linear-gradient(135deg, #fd7e14 0%, #e96700 100%);
    }

    .banner-label {
