</style>

<script>
    const remainingBudget = @remainingBudget.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    function updateBudgetPreview() {
        const input = document.getElementById('budgetInput');
        const val = parseFloat(input.value) || 0;
        const pct = remainingBudget > 0 ? Math.min(100, (val / remainingBudget) * 100) : 0;
        document.getElementById('budgetBarFill').style.width = pct + '%';
        document.getElementById('budgetUsedLabel').textContent = val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('budgetBarFill').style.background =
            pct > 100 ? 'linear-gradient(90deg,#dc3545,#c82333)' :
            pct > 80  ? 'linear-gradient(90deg,#fd7e14,#e96700)' :
                        'linear-gradient(90deg,#28a745,#20c997)';
    }

    function updateWeightBar() {
        const val = parseFloat(document.getElementById('weightInput').value) || 0;
        const pct = Math.min(100, Math.max(0, val));
        document.getElementById('weightBarFill').style.width = pct + '%';
        document.getElementById('weightBarFill').style.background =
            val > 100 ? 'linear-gradient(90deg,#dc3545,#c82333)' :
            val < 5   ? 'linear-gradient(90deg,#6c757d,#495057)' :
                        'linear-gradient(90deg,#fd7e14,#e96700)';
        const hintEl = document.getElementById('weightHintSum');
        if (hintEl) {
            hintEl.textContent = val.toFixed(2) + '%';
        }
    }

    document.getElementById('phaseForm').addEventListener('submit', function () {
        if ($(this).valid()) {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>@Localizer["Saving..."]';
        }
    });

    (function () {
        document.querySelectorAll('.month-year-picker').forEach(function (picker) {
            var hidden = picker.querySelector('input[type="hidden"]');
            var monthSel = picker.querySelector('.mypicker-month');
            var yearInput = picker.querySelector('.mypicker-year');
            if (hidden.value) {
                var parts = hidden.value.split('-');
                if (parts.length >= 2) {
                    yearInput.value = parseInt(parts[0], 10);
                    monthSel.value = parseInt(parts[1], 10);
                }
            }
            function sync() {
                var m = monthSel.value, y = yearInput.value;
                if (m && y) hidden.value = String(parseInt(y)).padStart(4, '0') + '-' + String(parseInt(m)).padStart(2, '0');
            }
            monthSel.addEventListener('change', sync);
            yearInput.addEventListener('change', sync);
            yearInput.addEventListener('input', sync);
        });
    })();

    // Initialize bars on page load
    updateWeightBar();
    updateBudgetPreview();
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
