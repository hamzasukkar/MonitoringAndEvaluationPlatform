@model MonitoringAndEvaluationPlatform.Models.ProjectPhase
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "Edit Phase";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var project = ViewBag.Project as MonitoringAndEvaluationPlatform.Models.Project;
    int totalPhases = ViewBag.TotalPhases ?? 1;
    double remainingBudget = ViewBag.RemainingBudget ?? (project?.EstimatedBudget ?? 0);
    double otherBudgetSum = ViewBag.OtherBudgetSum ?? 0;
    // A phase belongs to a single project, so amounts here stay in that project's currency.
    var currencySymbol = project?.CurrencySymbol ?? "";
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="header-content">
        <div class="page-title-section">
            <div class="page-breadcrumb">
                <a href="@Url.Action("Index", "Projects")" class="breadcrumb-link">
                    <i class="fas fa-project-diagram"></i>
                    @Localizer["Projects"]
                </a>
                <i class="fas fa-chevron-right breadcrumb-separator"></i>
                @if (project != null)
                {
                    <a href="@Url.Action("Details", "Projects", new { id = project.ProjectID, tab = "phases" })" class="breadcrumb-link">
                        @project.ProjectName
                    </a>
                    <i class="fas fa-chevron-right breadcrumb-separator"></i>
                }
                <span class="current-page">@Localizer["Edit Phase"]</span>
            </div>
            <h1 class="page-title">@Localizer["Edit Phase"]</h1>
            <p class="page-description">@Localizer["Update the phase details and weight"]</p>
        </div>

        <div class="header-actions">
            @if (project != null)
            {
                <a href="@Url.Action("Details", "Projects", new { id = project.ProjectID, tab = "phases" })" class="action-btn secondary">
                    <i class="fas fa-arrow-left"></i>
                    @Localizer["Back to Project"]
                </a>
            }
        </div>
    </div>
</div>

@if (project != null)
{
    <!-- Project Info Banner -->
    <div class="project-info-banner">
        <div class="banner-item">
            <div class="banner-icon">
                <i class="fas fa-project-diagram"></i>
            </div>
            <div class="banner-content">
                <div class="banner-label">@Localizer["Project"]</div>
                <div class="banner-value">@project.ProjectName</div>
            </div>
        </div>
        <div class="banner-item">
            <div class="banner-icon date-icon">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="banner-content">
                <div class="banner-label">@Localizer["Project Dates"]</div>
                <div class="banner-value">@project.StartDate.ToString("MMM yyyy") – @project.EndDate.ToString("MMM yyyy")</div>
            </div>
        </div>
        <div class="banner-item">
            <div class="banner-icon budget-icon">
                <i class="fas fa-coins"></i>
            </div>
            <div class="banner-content">
                <div class="banner-label">@Localizer["Remaining Budget"]</div>
                <div class="banner-value @(remainingBudget <= 0 ? "text-danger" : "text-success")">
                    @currencySymbol@remainingBudget.ToString("N2")
                </div>
            </div>
        </div>
        <div class="banner-item">
            <div class="banner-icon phases-icon">
                <i class="fas fa-layer-group"></i>
            </div>
            <div class="banner-content">
                <div class="banner-label">@Localizer["Total Phases"]</div>
                <div class="banner-value">@totalPhases.ToString("N0")</div>
            </div>
        </div>
    </div>
}

<!-- Current Performance Card -->
<div class="perf-summary">
    <div class="perf-card">
        <div class="perf-icon">
            <i class="fas fa-chart-pie"></i>
        </div>
        <div class="perf-content">
            <div class="perf-label">@Localizer["Current Performance"]</div>
            <div class="perf-value">@Model.PhasePerformance.ToString("N1")%</div>
        </div>
    </div>
    <div class="perf-card">
        <div class="perf-icon weight-icon">
            <i class="fas fa-balance-scale"></i>
        </div>
        <div class="perf-content">
            <div class="perf-label">@Localizer["Current Weight"]</div>
            <div class="perf-value">@Model.Weight.ToString("N2")%</div>
        </div>
    </div>
    <div class="perf-card">
        <div class="perf-icon measures-icon">
            <i class="fas fa-ruler"></i>
        </div>
        <div class="perf-content">
            <div class="perf-label">@Localizer["Measures Count"]</div>
            <div class="perf-value">@((Model.Measures?.Count ?? 0).ToString("N0"))</div>
        </div>
    </div>
</div>

<!-- Main Form -->
<div class="form-section">
    <div class="form-card">
        <div class="form-card-header">
            <div class="form-card-icon">
                <i class="fas fa-edit"></i>
            </div>
            <div>
                <h3 class="form-card-title">@Localizer["Phase Details"]</h3>
                <p class="form-card-subtitle">@Localizer["Editing:"] @Model.Name</p>
            </div>
        </div>

        <div class="form-card-body">
            <form asp-action="Edit" method="post" id="phaseForm">
                <div asp-validation-summary="All" class="validation-alert"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ProjectID" />
                <input type="hidden" asp-for="PhasePerformance" />

                <div class="form-grid">
                    <!-- Phase Name -->
                    <div class="form-group full-width">
                        <label asp-for="Name" class="modern-label">
                            <i class="fas fa-tag me-2"></i>@Localizer["Phase Name"] *
                        </label>
                        <input asp-for="Name" class="modern-input" autofocus />
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>

                    <!-- Start Date -->
                    <div class="form-group">
                        <label asp-for="StartDate" class="modern-label">
                            <i class="fas fa-calendar-plus me-2"></i>@Localizer["Start Date"] *
                        </label>
                        @{ var _editPhaseStartVal = Model.StartDate.ToString("yyyy-MM"); }
                        <div class="month-year-picker">
                            <input type="hidden" name="StartDate" id="StartDate" value="@_editPhaseStartVal" />
                            <div class="d-flex align-items-center gap-1">
                                <select class="modern-input mypicker-month" style="max-width:80px">
                                    @for (int _m = 1; _m <= 12; _m++) { <option value="@_m">@_m</option> }
                                </select>
                                <span class="text-muted px-1 fw-bold">/</span>
                                <input type="number" class="modern-input mypicker-year" min="2000" max="2100" style="max-width:100px" placeholder="YYYY" />
                            </div>
                        </div>
                        <span asp-validation-for="StartDate" class="field-error"></span>
                        @if (project != null)
                        {
                            <div class="field-hint">@Localizer["Must be on or after"] @project.StartDate.ToString("MMM yyyy")</div>
                        }
                    </div>

                    <!-- End Date -->
                    <div class="form-group">
                        <label asp-for="EndDate" class="modern-label">
                            <i class="fas fa-calendar-minus me-2"></i>@Localizer["End Date"] *
                        </label>
                        @{ var _editPhaseEndVal = Model.EndDate.ToString("yyyy-MM"); }
                        <div class="month-year-picker">
                            <input type="hidden" name="EndDate" id="EndDate" value="@_editPhaseEndVal" />
                            <div class="d-flex align-items-center gap-1">
                                <select class="modern-input mypicker-month" style="max-width:80px">
                                    @for (int _m = 1; _m <= 12; _m++) { <option value="@_m">@_m</option> }
                                </select>
                                <span class="text-muted px-1 fw-bold">/</span>
                                <input type="number" class="modern-input mypicker-year" min="2000" max="2100" style="max-width:100px" placeholder="YYYY" />
                            </div>
                        </div>
                        <span asp-validation-for="EndDate" class="field-error"></span>
                        @if (project != null)
                        {
                            <div class="field-hint">@Localizer["Must be on or before"] @project.EndDate.ToString("MMM yyyy")</div>
                        }
                    </div>

                    <!-- Budget -->
                    <div class="form-group full-width">
                        <label asp-for="Budget" class="modern-label">
                            <i class="fas fa-coins me-2"></i>@Localizer["Budget Allocation"] *
                        </label>
                        <div class="input-with-suffix">
                            <input asp-for="Budget" type="number" step="0.01" min="0"
                                   max="@remainingBudget"
                                   class="modern-input"
                                   placeholder="0.00" id="budgetInput"
                                   oninput="updateBudgetPreview()" />
                            <span class="input-suffix">@Localizer["units"]</span>
                        </div>
                        <span asp-validation-for="Budget" class="field-error"></span>
                        <div class="budget-preview" id="budgetPreview">
                            <div class="budget-bar-wrap">
                                <div class="budget-bar-fill" id="budgetBarFill" style="width:0%"></div>
                            </div>
                            <div class="budget-bar-labels">
                                @currencySymbol<span id="budgetUsedLabel">@Model.Budget.ToString("N2")</span> / @currencySymbol@remainingBudget.ToString("N2") @Localizer["available"]
                            </div>
                        </div>
                    </div>

                    <!-- Target Quantity -->
                    <div class="form-group full-width">
                        <label asp-for="TargetQuantity" class="modern-label">
                            <i class="fas fa-bullseye me-2"></i>@Localizer["Target Quantity"]
                        </label>
                        <input asp-for="TargetQuantity" type="number" step="0.01" min="0" class="modern-input" placeholder="@Localizer["e.g. 100"]" />
                        <span asp-validation-for="TargetQuantity" class="field-error"></span>
                        <div class="field-hint">@Localizer["Optional: set a quantity target so that measure achievements are auto-calculated (e.g. plant 100 trees)"]</div>
                    </div>

                    <!-- Weight -->
                    <div class="form-group full-width">
                        <label asp-for="Weight" class="modern-label">
                            <i class="fas fa-balance-scale me-2"></i>@Localizer["Phase Weight (%)"] *
                        </label>
                        <div class="weight-input-wrap">
                            <input asp-for="Weight" type="number" step="0.01" min="0" max="100"
                                   class="modern-input" id="weightInput" oninput="updateWeightBar()" />
                            <span class="weight-suffix">%</span>
                        </div>
                        <span asp-validation-for="Weight" class="field-error"></span>
                        <div class="weight-bar-wrap" id="weightBarWrap">
                            <div class="weight-bar-fill" id="weightBarFill" style="width: @(Model.Weight)%"></div>
                        </div>
                        <div class="field-hint weight-hint">
                            <i class="fas fa-info-circle me-1"></i>
                            @if (totalPhases > 1)
                            {
                                @Localizer["All @totalPhases phase weights must sum to exactly 100%. Current: "]
                                <strong id="weightHintSum">@Model.Weight.ToString("N2")%</strong>
                            }
                            else
                            {
                                @Localizer["Single phase: weight must be 100%."]
                            }
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="form-actions">
                    @if (project != null)
                    {
                        <a href="@Url.Action("Details", "Projects", new { id = project.ProjectID, tab = "phases" })" class="btn-cancel">
                            <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                        </a>
                    }
                    <button type="submit" class="btn-submit" id="submitBtn">
                        <i class="fas fa-save me-2"></i>@Localizer["Save Changes"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

