        background: #f8f9fa;
        border-left: 1px solid #e9ecef;
        padding: 0.75rem 1rem;
        color: #6c757d;
        font-size: 0.9rem;
        font-weight: 600;
        display: flex;
        align-items: center;
    }

    .weight-bar-wrap {
