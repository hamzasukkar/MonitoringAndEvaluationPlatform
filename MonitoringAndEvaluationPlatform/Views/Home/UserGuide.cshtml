                <h2>@Localizer["Performance Calculations"]</h2>
            </div>
            <div class="section-content">
                <p>@Localizer["Performance metrics flow upward through the hierarchy, from plans to framework level."]</p>

                <h3>@Localizer["18.1 Calculation Flow"]</h3>
                <div class="hierarchy-diagram">
                    <div class="hierarchy-level level-5">
                        <div class="hierarchy-item">@Localizer["Plans (Planned vs Realized Values)"]</div>
                    </div>
                    <div class="hierarchy-arrow"><i class="fas fa-arrow-up"></i></div>
                    <div class="hierarchy-level level-4">
                        <div class="hierarchy-item">@Localizer["Project Performance"]</div>
                    </div>
                    <div class="hierarchy-arrow"><i class="fas fa-arrow-up"></i></div>
                    <div class="hierarchy-level level-3">
                        <div class="hierarchy-item">@Localizer["Indicator Performance"]</div>
                    </div>
                    <div class="hierarchy-arrow"><i class="fas fa-arrow-up"></i></div>
                    <div class="hierarchy-level level-2">
                        <div class="hierarchy-item">@Localizer["SubOutput → Output → Outcome"]</div>
                    </div>
                    <div class="hierarchy-arrow"><i class="fas fa-arrow-up"></i></div>
                    <div class="hierarchy-level level-1">
                        <div class="hierarchy-item">@Localizer["Framework Performance"]</div>
                    </div>
                </div>

                <h3>@Localizer["18.2 Performance Types"]</h3>
                <ul>
                    <li><strong>@Localizer["Financial Performance"]</strong>: @Localizer["Realized budget / Planned budget x 100"]</li>
                    <li><strong>@Localizer["Physical Performance"]</strong>: @Localizer["Realized physical progress / Planned physical progress x 100"]</li>
                    <li><strong>@Localizer["Disbursement Performance"]</strong>: @Localizer["Actual disbursement / Planned disbursement x 100"]</li>
                    <li><strong>@Localizer["Field Monitoring"]</strong>: @Localizer["Field verification score"]</li>
                    <li><strong>@Localizer["Impact Assessment"]</strong>: @Localizer["Outcome impact evaluation score"]</li>
                </ul>

                <h3>@Localizer["18.3 Weighted Averages"]</h3>
                <p>@Localizer["Performance at each hierarchy level is calculated as a weighted average of its children. Weights can be adjusted at every level (Outcomes, Outputs, SubOutputs, Indicators)."]</p>

                <div class="info-box">
                    <div class="info-icon"><i class="fas fa-calculator"></i></div>
                    <div class="info-content">
                        <h4>@Localizer["Formula"]</h4>
                        <p>@Localizer["Parent Performance = Sum of (Child Performance x Child Weight) / Sum of Weights"]</p>
                    </div>
                </div>
            </div>
        </section>

