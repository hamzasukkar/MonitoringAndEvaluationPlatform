                            <h4>@Localizer["Select Phase & Type"]</h4>
                            <p>@Localizer["Open the Measures page for the project phase, click Add Measure, and select 'Qualitative'."]</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h4>@Localizer["Enter Achievement Value"]</h4>
                            <p>@Localizer["Enter the achievement percentage directly (e.g., 70 for 70%). This value is stored and displayed as-is."]</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">3</div>
                        <div class="step-content">
                            <h4>@Localizer["View Phase Total"]</h4>
                            <p>@Localizer["The Selected Phase Total sums all qualitative values entered for the phase, capped at 100%."]</p>
                        </div>
                    </div>
                </div>

                <h3>@Localizer["7.6.2 Quantitative Measures"]</h3>
                <p>@Localizer["Use Quantitative when achievement is measured by counting physical units against a fixed phase target."]</p>
                <div class="step-list">
                    <div class="step">
                        <div class="step-number">1</div>
                        <div class="step-content">
                            <h4>@Localizer["Select Phase & Type"]</h4>
                            <p>@Localizer["Open the Measures page for the project phase, click Add Measure, and select 'Quantitative'."]</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h4>@Localizer["Enter Phase Target (First Measure Only)"]</h4>
                            <p>@Localizer["On your first Quantitative measure, enter the total target quantity for the phase (e.g., 1000 beneficiaries). This target is stored at the phase level and used to calculate all future measure percentages automatically. Choose carefully — it cannot easily be changed once measures are recorded."]</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">3</div>
                        <div class="step-content">
                            <h4>@Localizer["Enter Quantity Achieved"]</h4>
                            <p>@Localizer["Enter the number of units achieved in this period (e.g., 300 beneficiaries). The system calculates: Achievement % = (300 ÷ 1000) × 100 = 30%."]</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">4</div>
                        <div class="step-content">
                            <h4>@Localizer["View Performance"]</h4>
                            <p>@Localizer["Performance recalculates automatically. The Measures list shows the Quantity and Achievement % separately. The phase total accumulates across all measure entries."]</p>
                        </div>
                    </div>
                </div>
            </div>
