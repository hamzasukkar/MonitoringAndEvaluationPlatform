@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = Localizer["User Guide"];
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var guideToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var guideCanEdit = (ViewBag.CanEditGuide as bool?) ?? false;
    var guideOverridesJson = (ViewBag.GuideOverridesJson as string) ?? "{}";
}

<link rel="stylesheet" href="~/css/user-guide.css" />
<link rel="stylesheet" href="~/css/guide-editor.css" />

<!-- User Guide Header -->
<div class="guide-header">
    <div class="guide-header-content">
        <div class="guide-icon">
            <i class="fas fa-book-open"></i>
        </div>
        <div>
            <h1 class="guide-title">@Localizer["User Guide"]</h1>
            <p class="guide-subtitle">@Localizer["Complete documentation for the National Monitoring & Evaluation Platform"]</p>
        </div>
    </div>
    <div class="guide-actions">
        <button class="btn btn-outline-light" onclick="window.print()">
            <i class="fas fa-print me-2"></i>@Localizer["Print Guide"]
        </button>
        <a href="@Url.Content("~/docs/Platform-Features-EN.doc")" class="btn btn-light" download>
            <i class="fas fa-download me-2"></i>@Localizer["Download PDF"]
        </a>
    </div>
</div>

<div class="guide-container">
    <!-- Table of Contents -->
    <div class="guide-toc">
        <div class="toc-header">
            <i class="fas fa-list me-2"></i>@Localizer["Table of Contents"]
        </div>
        <nav class="toc-nav">
            <a href="#introduction" class="toc-link">1. @Localizer["Introduction"]</a>
            <a href="#getting-started" class="toc-link">2. @Localizer["Getting Started"]</a>
            <a href="#dashboard" class="toc-link">3. @Localizer["Dashboard"]</a>
            <a href="#frameworks" class="toc-link">4. @Localizer["Results Framework"]</a>
            <a href="#outcomes" class="toc-link">5. @Localizer["Outcomes"]</a>
            <a href="#outputs" class="toc-link">6. @Localizer["Outputs & SubOutputs"]</a>
            <a href="#indicators" class="toc-link">7. @Localizer["Indicators"] <span class="toc-new-badge">@Localizer["NEW"]</span></a>
            <a href="#framework-goals" class="toc-link">8. @Localizer["Framework Goals"]</a>
            <a href="#setup" class="toc-link">9. @Localizer["Set Up"]</a>
            <a href="#projects" class="toc-link">10. @Localizer["Projects"] <span class="toc-new-badge">@Localizer["NEW"]</span></a>
            <a href="#plans" class="toc-link">11. @Localizer["Plans"]</a>
            <a href="#monitoring" class="toc-link">12. @Localizer["Monitoring"]</a>
            <a href="#reports" class="toc-link">13. @Localizer["Reports & Export"]</a>
            <a href="#admin" class="toc-link">14. @Localizer["Administration"]</a>
            <a href="#data-management" class="toc-link">15. @Localizer["Data Management"]</a>
            <a href="#audit" class="toc-link">16. @Localizer["Audit Logs"]</a>
            <a href="#roles" class="toc-link">17. @Localizer["User Roles & Permissions"]</a>
            <a href="#performance" class="toc-link">18. @Localizer["Performance Calculations"]</a>
            <a href="#settings" class="toc-link">19. @Localizer["Settings & Themes"]</a>
            <a href="#requests" class="toc-link">20. @Localizer["Requests & Support"] <span class="toc-new-badge">@Localizer["NEW"]</span></a>
            <a href="#platform-versions" class="toc-link">21. @Localizer["Platform Versions & What's New"] <span class="toc-new-badge">@Localizer["NEW"]</span></a>
            <a href="#help" class="toc-link">22. @Localizer["Getting Help"]</a>
        </nav>
    </div>

    <!-- Guide Content -->
    <div class="guide-content">

        <!-- ==================== Section 1: Introduction ==================== -->
        <section id="introduction" class="guide-section">
            <div class="section-header">
                <span class="section-number">1</span>
                <h2>@Localizer["Introduction"]</h2>
            </div>
            <div class="section-content">
                <p>@Localizer["Welcome to the National Monitoring & Evaluation Platform. This comprehensive system helps you track development projects, measure performance indicators, and generate reports across multiple strategic frameworks."]</p>

                <div class="info-box">
                    <div class="info-icon"><i class="fas fa-info-circle"></i></div>
                    <div class="info-content">
                        <h4>@Localizer["What You Can Do"]</h4>
                        <ul>
                            <li>@Localizer["Manage strategic frameworks and goals (e.g., SDGs, National Development Strategy)"]</li>
                            <li>@Localizer["Track project progress and performance across hierarchies"]</li>
                            <li>@Localizer["Monitor indicators with real-time calculations"]</li>
                            <li>@Localizer["Coordinate with ministries, donors, and partners"]</li>
                            <li>@Localizer["Generate and export comprehensive reports (Excel & PDF)"]</li>
                            <li>@Localizer["Manage locations, sectors, and organizational structures"]</li>
                            <li>@Localizer["Audit and track all system activities"]</li>
                        </ul>
                    </div>
                </div>

                <h3>@Localizer["1.1 Platform Structure"]</h3>
                <p>@Localizer["The platform is organized into five main sections accessible from the sidebar:"]</p>

                <div class="feature-grid">
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-sitemap"></i></div>
                        <h4>@Localizer["Results Framework"]</h4>
                        <p>@Localizer["Manage frameworks, outcomes, outputs, sub-outputs, and indicators."]</p>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-cogs"></i></div>
                        <h4>@Localizer["Set Up"]</h4>
                        <p>@Localizer["Configure ministries, donors, sectors, project managers, supervisors, and locations."]</p>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-project-diagram"></i></div>
                        <h4>@Localizer["Projects"]</h4>
                        <p>@Localizer["Create and manage projects, action plans, activities, and plans."]</p>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-chart-line"></i></div>
                        <h4>@Localizer["Monitoring"]</h4>
                        <p>@Localizer["Track performance at all levels of the hierarchy in real-time."]</p>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-tachometer-alt"></i></div>
                        <h4>@Localizer["Dashboard"]</h4>
                        <p>@Localizer["View analytics, charts, gauges, and summary statistics."]</p>
                    </div>
                </div>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/home-page.png" alt="@Localizer["Home Page Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Home Page Overview"]</span>
                            <small>home-page.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 1.1: Platform Home Page"]</p>
                </div>
            </div>
        </section>

        <!-- ==================== Section 2: Getting Started ==================== -->
        <section id="getting-started" class="guide-section">
            <div class="section-header">
                <span class="section-number">2</span>
                <h2>@Localizer["Getting Started"]</h2>
            </div>
            <div class="section-content">
                <h3>@Localizer["2.1 Logging In"]</h3>
                <p>@Localizer["To access the platform, navigate to the login page and enter your credentials."]</p>

                <div class="step-list">
                    <div class="step">
                        <div class="step-number">1</div>
                        <div class="step-content">
                            <h4>@Localizer["Open the Platform"]</h4>
                            <p>@Localizer["Navigate to the platform URL in your web browser."]</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h4>@Localizer["Enter Credentials"]</h4>
                            <p>@Localizer["Enter your email address and password in the login form."]</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">3</div>
                        <div class="step-content">
                            <h4>@Localizer["Access Dashboard"]</h4>
                            <p>@Localizer["After successful login, you will be redirected to the main dashboard."]</p>
                        </div>
                    </div>
                </div>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/login-page.png" alt="@Localizer["Login Page Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Login Page"]</span>
                            <small>login-page.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 2.1: Login Page"]</p>
                </div>

                <h3>@Localizer["2.2 Changing Language"]</h3>
                <p>@Localizer["The platform supports Arabic (default), English, and French. To change the language:"]</p>

                <div class="step-list">
                    <div class="step">
                        <div class="step-number">1</div>
                        <div class="step-content">
                            <h4>@Localizer["Find Language Selector"]</h4>
                            <p>@Localizer["Look for the language dropdown in the top navigation bar."]</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h4>@Localizer["Select Language"]</h4>
                            <p>@Localizer["Choose your preferred language. The page will reload in the selected language."]</p>
                        </div>
                    </div>
                </div>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/language-selector.png" alt="@Localizer["Language Selector Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Language Selector"]</span>
                            <small>language-selector.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 2.2: Language Selection"]</p>
                </div>

                <h3>@Localizer["2.3 Navigation"]</h3>
                <p>@Localizer["The platform uses a sidebar menu on the left (or right in Arabic) for main navigation. The top bar contains:"]</p>
                <ul>
                    <li>@Localizer["Framework dropdown menus for quick access to specific frameworks"]</li>
                    <li>@Localizer["Ministries dropdown for quick ministry navigation"]</li>
                    <li>@Localizer["Sectors dropdown organized by category"]</li>
                    <li>@Localizer["Donors dropdown organized by type"]</li>
                    <li>@Localizer["SDGs dropdown with all 17 Sustainable Development Goals"]</li>
                    <li>@Localizer["Language selector and user menu"]</li>
                </ul>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/navigation-sidebar.png" alt="@Localizer["Sidebar Navigation Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Sidebar Navigation"]</span>
                            <small>navigation-sidebar.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 2.3: Sidebar Navigation Menu"]</p>
                </div>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/navigation-topbar.png" alt="@Localizer["Top Navigation Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Top Navigation Bar with Dropdowns"]</span>
                            <small>navigation-topbar.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 2.4: Top Navigation Bar"]</p>
                </div>
            </div>
        </section>

        <!-- ==================== Section 3: Dashboard ==================== -->
        <section id="dashboard" class="guide-section">
            <div class="section-header">
                <span class="section-number">3</span>
                <h2>@Localizer["Dashboard"]</h2>
            </div>
            <div class="section-content">
                <p>@Localizer["The Dashboard provides a comprehensive overview of all platform activities and performance metrics at a glance."]</p>

                <h3>@Localizer["3.1 Home Dashboard"]</h3>
                <p>@Localizer["The main dashboard displays summary statistics including total frameworks, projects, ministries, budget, and monthly performance trends."]</p>

                <div class="feature-grid">
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-chart-bar"></i></div>
                        <h4>@Localizer["Statistics Cards"]</h4>
                        <p>@Localizer["Quick view of total projects, frameworks, ministries, and budget."]</p>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-chart-line"></i></div>
                        <h4>@Localizer["Performance Charts"]</h4>
                        <p>@Localizer["Visual representation of performance trends over time."]</p>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-map"></i></div>
                        <h4>@Localizer["Geographic Map"]</h4>
                        <p>@Localizer["Interactive map showing project distribution by governorate."]</p>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-bell"></i></div>
                        <h4>@Localizer["Recent Activities"]</h4>
                        <p>@Localizer["Latest updates and activities across the platform."]</p>
                    </div>
                </div>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/dashboard-overview.png" alt="@Localizer["Dashboard Overview Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Dashboard Overview"]</span>
                            <small>dashboard-overview.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 3.1: Dashboard Overview"]</p>
                </div>

                <h3>@Localizer["3.2 Framework Performance Gauges"]</h3>
                <p>@Localizer["View performance gauges for each framework. Gauges show the achievement rate as a percentage with color-coded indicators:"]</p>
                <ul>
                    <li><strong style="color:#38a169;">@Localizer["Green (80-100%)"]</strong>: @Localizer["On track or exceeding targets"]</li>
                    <li><strong style="color:#d69e2e;">@Localizer["Yellow (50-79%)"]</strong>: @Localizer["Needs attention"]</li>
                    <li><strong style="color:#e53e3e;">@Localizer["Red (0-49%)"]</strong>: @Localizer["Below target, requires intervention"]</li>
                </ul>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/dashboard-gauges.png" alt="@Localizer["Performance Gauges Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Framework Performance Gauges"]</span>
                            <small>dashboard-gauges.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 3.2: Framework Performance Gauges"]</p>
                </div>

                <h3>@Localizer["3.3 Dashboard Filters"]</h3>
                <p>@Localizer["The dashboard supports advanced filtering by:"]</p>
                <ul>
                    <li>@Localizer["Framework - Select specific frameworks to view"]</li>
                    <li>@Localizer["Ministry - Filter by responsible ministry"]</li>
                    <li>@Localizer["Location - Filter by Governorate, District, Sub-District, or Community"]</li>
                    <li>@Localizer["Project - Focus on specific projects"]</li>
                </ul>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/dashboard-filters.png" alt="@Localizer["Dashboard Filters Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Dashboard Filter Panel"]</span>
                            <small>dashboard-filters.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 3.3: Dashboard Filter Options"]</p>
                </div>

                <h3>@Localizer["3.4 Indicator Trends"]</h3>
                <p>@Localizer["View trend charts showing how indicators change over time. Click on any indicator to see its detailed trend line."]</p>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/dashboard-indicator-trend.png" alt="@Localizer["Indicator Trend Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Indicator Trend Chart"]</span>
                            <small>dashboard-indicator-trend.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 3.4: Indicator Trend Over Time"]</p>
                </div>

                <h3>@Localizer["3.5 Outcome Progress"]</h3>
                <p>@Localizer["Track progress of outcomes within each framework using bar charts and progress indicators."]</p>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/dashboard-outcome-progress.png" alt="@Localizer["Outcome Progress Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Outcome Progress View"]</span>
                            <small>dashboard-outcome-progress.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 3.5: Outcome Progress Visualization"]</p>
                </div>

                <h3>@Localizer["3.6 Project Progress"]</h3>
                <p>@Localizer["View project progress filtered by region, sector, or donor. This view shows disbursement and physical performance for each project."]</p>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/dashboard-project-progress.png" alt="@Localizer["Project Progress Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Project Progress View"]</span>
                            <small>dashboard-project-progress.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 3.6: Project Progress by Region"]</p>
                </div>

                <h3>@Localizer["3.7 Exporting Dashboard"]</h3>
                <p>@Localizer["Export the dashboard view to Excel or PDF for sharing and offline analysis."]</p>
                <div class="step-list">
                    <div class="step">
                        <div class="step-number">1</div>
                        <div class="step-content">
                            <h4>@Localizer["Apply Filters"]</h4>
                            <p>@Localizer["Set the desired filters for the data you want to export."]</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h4>@Localizer["Click Export"]</h4>
                            <p>@Localizer["Click the Export Excel or Export PDF button in the dashboard toolbar."]</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== Section 4: Results Framework ==================== -->
        <section id="frameworks" class="guide-section">
            <div class="section-header">
                <span class="section-number">4</span>
                <h2>@Localizer["Results Framework"]</h2>
            </div>
            <div class="section-content">
                <p>@Localizer["Frameworks represent strategic initiatives like the National Development Strategy or SDG alignment. They form the top level of the results hierarchy."]</p>

                <h3>@Localizer["4.1 Framework Hierarchy"]</h3>
                <div class="hierarchy-diagram">
                    <div class="hierarchy-level level-1">
                        <div class="hierarchy-item"><i class="fas fa-sitemap me-2"></i>@Localizer["Framework"]</div>
                    </div>
                    <div class="hierarchy-arrow"><i class="fas fa-arrow-down"></i></div>
                    <div class="hierarchy-level level-2">
                        <div class="hierarchy-item"><i class="fas fa-bullseye me-2"></i>@Localizer["Outcomes"]</div>
                    </div>
                    <div class="hierarchy-arrow"><i class="fas fa-arrow-down"></i></div>
                    <div class="hierarchy-level level-3">
                        <div class="hierarchy-item"><i class="fas fa-layer-group me-2"></i>@Localizer["Outputs"]</div>
                    </div>
                    <div class="hierarchy-arrow"><i class="fas fa-arrow-down"></i></div>
                    <div class="hierarchy-level level-4">
                        <div class="hierarchy-item"><i class="fas fa-list-ul me-2"></i>@Localizer["SubOutputs"]</div>
                    </div>
                    <div class="hierarchy-arrow"><i class="fas fa-arrow-down"></i></div>
                    <div class="hierarchy-level level-5">
                        <div class="hierarchy-item"><i class="fas fa-chart-bar me-2"></i>@Localizer["Indicators"]</div>
                    </div>
                    <div class="hierarchy-arrow"><i class="fas fa-arrow-down"></i></div>
                    <div class="hierarchy-level level-6">
                        <div class="hierarchy-item"><i class="fas fa-project-diagram me-2"></i>@Localizer["Projects"]</div>
                    </div>
                </div>

                <h3>@Localizer["4.2 Viewing Frameworks"]</h3>
                <p>@Localizer["Navigate to Results Framework from the sidebar. The list shows all frameworks with their performance rates, search, and sort options."]</p>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/frameworks-list.png" alt="@Localizer["Frameworks List Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Frameworks List"]</span>
                            <small>frameworks-list.png</small>
                        </div>
                    </div>
                    <p class="screenshot-caption">@Localizer["Figure 4.1: Frameworks List View"]</p>
                </div>

                <h3>@Localizer["4.3 Creating a Framework"]</h3>
                <p>@Localizer["System administrators can create new frameworks using two methods:"]</p>

                <h4>@Localizer["Method 1: Inline Creation"]</h4>
                <div class="step-list">
                    <div class="step">
                        <div class="step-number">1</div>
                        <div class="step-content">
                            <h4>@Localizer["Click Add New"]</h4>
                            <p>@Localizer["Click the 'Add New Framework' button on the frameworks list page."]</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h4>@Localizer["Enter Name"]</h4>
                            <p>@Localizer["Type the framework name in the inline form that appears."]</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">3</div>
                        <div class="step-content">
                            <h4>@Localizer["Save"]</h4>
                            <p>@Localizer["Click Save to create the framework."]</p>
                        </div>
                    </div>
                </div>

                <h4>@Localizer["Method 2: Comprehensive Creation"]</h4>
                <p>@Localizer["Use the comprehensive creation form to build an entire framework hierarchy at once, including outcomes, outputs, sub-outputs, and indicators."]</p>

                <div class="screenshot-placeholder">
                    <div class="screenshot-frame">
                        <img src="~/images/guide/framework-comprehensive.png" alt="@Localizer["Comprehensive Framework Creation Screenshot"]" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="screenshot-missing">
                            <i class="fas fa-image"></i>
                            <span>@Localizer["Screenshot: Comprehensive Framework Creation"]</span>
