@model List<MonitoringAndEvaluationPlatform.Models.AuditLog>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EntityHistory"];
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var entityName = ViewBag.EntityName as string;
    var entityId = ViewBag.EntityId as string;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="dashboard-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-4 mb-2">
                    <i class="fas fa-history me-3"></i>@Localizer["EntityHistory"]
                </h1>
                <p class="text-muted">
                    @Localizer["AllChangesFor"] <strong>@entityName</strong> (ID: @entityId)
                </p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left me-2"></i>@Localizer["BackToList"]
                </a>
            </div>
        </div>
    </div>

    <!-- Timeline -->
    <div class="card">
        <div class="card-header">
            <strong>@Model.Count @Localizer["changes"]</strong>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="timeline">
                    @foreach (var log in Model)
                    {
                        var actionClass = log.Action switch
                        {
                            "Create" => "success",
                            "Update" => "warning",
                            "Delete" => "danger",
                            _ => "secondary"
                        };
                        var actionIcon = log.Action switch
                        {
                            "Create" => "fa-plus",
                            "Update" => "fa-edit",
                            "Delete" => "fa-trash",
                            _ => "fa-question"
                        };

                        <div class="timeline-item">
                            <div class="timeline-marker bg-@actionClass">
                                <i class="fas @actionIcon"></i>
                            </div>
                            <div class="timeline-content">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge bg-@actionClass me-2">@log.Action</span>
                                        <small class="text-muted">
                                            @log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                        </small>
                                    </div>
                                    <a asp-action="Details" asp-route-id="@log.Id" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye me-1"></i>@Localizer["Details"]
                                    </a>
                                </div>
                                <p class="mb-1">
                                    <strong>@Localizer["By"]:</strong>
                                    @(log.UserName ?? "System")
                                </p>
                                @if (!string.IsNullOrEmpty(log.ChangedColumns))
                                {
                                    <p class="mb-0">
                                        <strong>@Localizer["ChangedFields"]:</strong>
                                        @foreach (var col in log.ChangedColumns.Split(','))
                                        {
                                            <span class="badge bg-light text-dark me-1">@col.Trim()</span>
                                        }
                                    </p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">@Localizer["NoHistoryFound"]</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e2e8f0;
    }

    .timeline-item {
        position: relative;
        padding-bottom: 1.5rem;
    }

    .timeline-marker {
        position: absolute;
        left: -23px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.75rem;
    }

    .timeline-content {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 8px;
        margin-left: 15px;
    }
</style>
