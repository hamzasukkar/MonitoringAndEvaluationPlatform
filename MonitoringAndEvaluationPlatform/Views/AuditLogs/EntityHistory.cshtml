@model List<MonitoringAndEvaluationPlatform.Models.AuditLog>
@using Microsoft.AspNetCore.Mvc.Localization
@using MonitoringAndEvaluationPlatform.Helpers
@using MonitoringAndEvaluationPlatform.ViewModels
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EntityHistory"];
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var entityName = ViewBag.EntityName as string;
    var entityId = ViewBag.EntityId as string;
    var entityDisplayName = Model
        .Select(AuditLogDisplayHelper.ExtractDisplayName)
        .FirstOrDefault(n => !string.IsNullOrEmpty(n));
}

<link rel="stylesheet" href="~/css/audit-logs.css" asp-append-version="true" />

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="dashboard-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-4 mb-2">
                    <i class="fas fa-history me-3"></i>@Localizer["EntityHistory"]
                </h1>
                <p class="text-muted">
                    @Localizer["AllChangesFor"] <span class="badge bg-light text-dark border">@Localizer[entityName ?? ""]</span>
                    @if (!string.IsNullOrEmpty(entityDisplayName))
                    {
                        <strong>@entityDisplayName</strong>
                    }
                    <small>(#@entityId)</small>
                </p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left me-2"></i>@Localizer["BackToList"]
                </a>
            </div>
        </div>
    </div>

    <!-- Timeline -->
    <div class="card">
        <div class="card-header">
            <strong>@Model.Count @Localizer["changes"]</strong>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="timeline">
                    @foreach (var log in Model)
                    {
                        var actionClass = log.Action switch
                        {
                            "Create" => "success",
                            "Update" => "warning",
                            "Delete" => "danger",
                            _ => "secondary"
                        };
                        var actionIcon = log.Action switch
                        {
                            "Create" => "fa-plus",
                            "Update" => "fa-edit",
                            "Delete" => "fa-trash",
                            _ => "fa-question"
                        };

                        <div class="timeline-item">
                            <div class="timeline-marker bg-@actionClass">
                                <i class="fas @actionIcon"></i>
                            </div>
                            <div class="timeline-content">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge bg-@actionClass me-2">@log.Action</span>
                                        @{
                                            var relative = AuditLogDisplayHelper.GetRelativeTime(log.Timestamp);
                                        }
                                        <small class="text-muted">
                                            @log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                            @if (relative.Key != "TimeOnly")
                                            {
                                                <span>(@Localizer[relative.Key, relative.Value])</span>
                                            }
                                        </small>
                                    </div>
                                    <a asp-action="Details" asp-route-id="@log.Id" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye me-1"></i>@Localizer["Details"]
                                    </a>
                                </div>
                                <p class="mb-1">
                                    <strong>@Localizer["By"]:</strong>
                                    @(log.UserName ?? "System")
                                </p>
                                <partial name="_AuditChangeSummary" model="new AuditChangeSummaryViewModel { Log = log, MaxShown = 5, TruncateLength = 60 }" />
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">@Localizer["NoHistoryFound"]</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

</style>
