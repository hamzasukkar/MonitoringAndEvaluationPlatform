@model IEnumerable<MonitoringAndEvaluationPlatform.Models.Indicator>
@using MonitoringAndEvaluationPlatform.Helpers
@using MonitoringAndEvaluationPlatform.Models
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "Indicators";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    ViewData["HelpFeature"] = "INDICATORS";
    var culture = Context.Features.Get<IRequestCultureFeature>().RequestCulture.Culture.Name;
}

@{
    ViewData["breadcrumbLevel"] = "indicators";
}
@await Html.PartialAsync("_HierarchyBreadcrumb")

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="dashboard-title">
                <i class="fas fa-chart-bar me-3"></i>
                @Localizer["Indicators Management"]
            </h1>
            <p class="dashboard-subtitle">
                @Localizer["View and manage all indicator performance metrics across development frameworks"]
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @await Html.PartialAsync("_HelpButton")
@if (@ViewData["subOutputCode"] != null && (User.IsInRole(UserRoles.SystemAdministrator) || User.IsInRole(UserRoles.MinistriesUser) || User.IsInRole(UserRoles.DataEntry)))
            {
                <a asp-action="AdjustWeights" asp-route-frameworkCode="@ViewData["frameworkCode"]"
                   asp-route-subOutputCode="@ViewData["subOutputCode"]"
                   class="btn btn-warning btn-lg shadow-sm">
                    <i class="fas fa-balance-scale me-2"></i>@Localizer["Adjust Weights"]
                </a>
            }
        </div>
    </div>
</div>

@if (ViewBag.SubOutputName != null)
{
    <!-- SubOutput Context Banner -->
    <div class="framework-context-banner">
        <div class="context-content">
            <div class="context-icon">
                <i class="fas fa-list-ul"></i>
            </div>
            <div class="context-text">
                <span class="context-label">@Localizer["SubOutput"]:</span>
                <span class="context-name">@ViewBag.SubOutputName</span>
            </div>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (@ViewData["subOutputCode"] != null && (User.IsInRole(UserRoles.SystemAdministrator) || User.IsInRole(UserRoles.MinistriesUser) || User.IsInRole(UserRoles.DataEntry)))
{
    <!-- Inline Create Form -->
    <div class="chart-card mb-4">
        <div class="chart-title">
            <i class="fas fa-plus"></i>
            @Localizer["Add New Indicator"]
        </div>
        <form method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SubOutputCode" value="@ViewData["subOutputCode"]" />
            <input type="hidden" name="Target" value="100" />

            <div class="col-md-9">
                <label for="Name" class="form-label fw-bold">
                    <i class="fas fa-tag me-2"></i>@Localizer["Name"]
                </label>
                <input type="text" name="Name" class="form-control form-control-lg" required
                       placeholder="@Localizer["Enter indicator name"]" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-lg w-100" asp-action="CreateAndRedirectToProject">
                    <i class="fas fa-arrow-circle-right me-1"></i>@Localizer["Add & Create Project"]
                </button>
            </div>
        </form>
    </div>
}

<!-- Search Form -->
<div class="chart-card mb-4">
    <div class="chart-title">
        <i class="fas fa-search"></i>
        @Localizer["Search Indicators"]
    </div>
    <form asp-action="Index" method="get" class="row g-3" id="searchForm">
        <input type="hidden" name="frameworkCode" value="@ViewData["frameworkCode"]" />
        <input type="hidden" name="subOutputCode" value="@ViewData["subOutputCode"]" />
        <div class="col-md-3">
            <label class="form-label fw-bold">
                <i class="fas fa-project-diagram me-2"></i>@Localizer["Filter by Project"]
            </label>
            @Html.DropDownList("projectId", ViewData["Projects"] as SelectList,
                Localizer["-- All Projects --"].Value, new { @class = "form-select form-select-lg", id = "projectFilter" })
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">
                <i class="fas fa-search me-2"></i>@Localizer["Search"]
            </label>
            <div class="input-group">
                <input type="text" name="searchString" id="searchInput" class="form-control form-control-lg"
                       placeholder="@Localizer["Search by indicator name, suboutput or project..."]"
                       value="@ViewData["CurrentFilter"]">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-search me-1"></i> @Localizer["Search"]
                </button>
            </div>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <a asp-action="Index" asp-route-frameworkCode="@ViewData["frameworkCode"]"
               asp-route-subOutputCode="@ViewData["subOutputCode"]"
               class="btn btn-outline-secondary btn-lg w-100">
                <i class="fas fa-sync-alt me-2"></i>@Localizer["Reset"]
            </a>
        </div>
    </form>
</div>

<!-- Indicators Table -->
<div class="chart-card">
    <div class="chart-title d-flex justify-content-between align-items-center">
        <span>
            <i class="fas fa-chart-bar"></i>
            @Localizer["Indicators"] (@Model.Count())
        </span>
        <div class="d-flex gap-2">
            <a asp-action="ExportExcel" asp-route-frameworkCode="@ViewData["frameworkCode"]" asp-route-subOutputCode="@ViewData["subOutputCode"]"
               class="btn btn-sm btn-success" title="@Localizer["Export Excel"]" data-bs-toggle="tooltip">
                <i class="fas fa-file-excel"></i>
            </a>
            <a asp-action="ExportPdf" asp-route-frameworkCode="@ViewData["frameworkCode"]" asp-route-subOutputCode="@ViewData["subOutputCode"]"
               class="btn btn-sm btn-danger" title="@Localizer["Export PDF"]" data-bs-toggle="tooltip">
                <i class="fas fa-file-pdf"></i>
            </a>
        </div>
    </div>
    
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover modern-table">
                <thead class="table-header">
                    <tr>
                        <th class="sortable-header">
                            <div class="header-link">
                                <i class="fas fa-chart-bar me-2"></i>@Localizer["Indicator Name"]
                            </div>
                        </th>
                        <th class="text-center">
                            <div class="header-link">
                                <i class="fas fa-weight me-2"></i>@Localizer["Weight"]
                            </div>
                        </th>
                        <th class="text-center">
                            <div class="header-link">
                                <i class="fas fa-chart-line me-2"></i>@Localizer["Indicators Performance"]
                            </div>
                        </th>
                        <th class="text-center">
                            <div class="header-link">
                                <i class="fas fa-money-bill-wave me-2"></i>@Localizer["Disbursement Performance"]
                            </div>
                        </th>
                        <th class="text-center">
                            <div class="header-link">
                                <i class="fas fa-list-ul me-2"></i>@Localizer["SubOutput"]
                            </div>
                        </th>
                        <th class="text-center">
                            <div class="header-link">
                                <i class="fas fa-project-diagram me-2"></i>@Localizer["Related Project"]
                            </div>
                        </th>
                        <th class="text-center">
                            <div class="header-link">
                                <i class="fas fa-cogs me-2"></i>@Localizer["Actions"]
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string indicatorsClass = ProgressBarHelper.GetProgressBarClass(item.IndicatorsPerformance);
                        string disbursementClass = ProgressBarHelper.GetProgressBarClass(item.DisbursementPerformance);
                        double IndicatorsPerformance = Math.Round(item.IndicatorsPerformance, 2);
                        double DisbursementPerformance = Math.Round(item.DisbursementPerformance, 2);
                        
                        <tr id="indicator-row-@item.IndicatorCode" class="table-row">
                            <td class="indicator-name-cell">
                                <div class="d-flex align-items-center">
                                    <div class="indicator-icon me-3">
                                        <i class="fas fa-chart-bar"></i>
                                    </div>
                                    <div>
                                        <span id="name-display-@item.IndicatorCode" class="indicator-name-link">
                                            @item.Name
                                        </span>
                                        <input type="text" class="form-control d-none" id="name-input-@item.IndicatorCode" 
                                               value="@item.Name" />
                                        <small class="text-muted d-block">
                                            <i class="fas fa-hashtag me-1"></i>ID: @item.IndicatorCode
                                        </small>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="weight-badge">
                                    <span class="badge bg-info fs-6">@item.Weight%</span>
                                </div>
                            </td>
                            <td class="text-center">
                                @await Html.PartialAsync("_ProgressBar", Tuple.Create(IndicatorsPerformance, indicatorsClass))
                            </td>
                            <td class="text-center">
                                @await Html.PartialAsync("_ProgressBar", Tuple.Create(DisbursementPerformance, disbursementClass))
                            </td>
                            <td class="text-center">
                                <div class="suboutput-badge">
                                    <a asp-action="Index" asp-controller="SubOutputs" asp-route-outputCode="@item.SubOutput.OutputCode"
                                       class="badge bg-secondary fs-6 text-decoration-none">
                                        @item.SubOutput?.Name
                                    </a>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="projects-column">
                                    @if (item.Project != null)
                                    {
                                        <button class="btn expand-projects-btn btn-sm" type="button"
                                                onclick="toggleProjects(@item.IndicatorCode)">
                                            <i class="fas fa-layer-group me-1"></i>
                                            @(item.Project.ProjectName.Length > 18 ? item.Project.ProjectName.Substring(0, 18) + "…" : item.Project.ProjectName)
                                            <span class="phase-count-pill ms-1">@item.Project.Phases.Count</span>
                                            <i class="fas fa-chevron-down ms-1 chevron-icon" id="chevron-@item.IndicatorCode"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            <i class="fas fa-folder-open opacity-50 me-1"></i>@Localizer["No Project"]
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group action-buttons" role="group">
                                    <a asp-action="Details" asp-route-id="@item.IndicatorCode"
                                       class="btn btn-outline-info btn-sm action-btn" title="@Localizer["View Details"]">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (User.IsInRole(UserRoles.SystemAdministrator) || User.IsInRole(UserRoles.MinistriesUser) || User.IsInRole(UserRoles.DataEntry))
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm action-btn" title="Edit Name"
                                                onclick="toggleEdit('@item.IndicatorCode')"
                                                id="edit-btn-@item.IndicatorCode">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm action-btn" title="Delete"
                                                onclick="confirmDelete(@item.IndicatorCode)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>

                        @* Expandable Phases Row *@
                        @if (item.Project != null)
                        {
                            var proj = item.Project;
                            <tr class="expandable-row" id="projects-row-@item.IndicatorCode" style="display:none;">
                                <td colspan="7">
                                    <div class="phases-expanded-content">
                                        <!-- Project header bar -->
                                        <div class="phases-expanded-header">
                                            <i class="fas fa-folder-open me-2"></i>
                                            <strong>@proj.ProjectName</strong>
                                            <a asp-action="Details" asp-controller="Projects" asp-route-id="@proj.ProjectID"
                                               class="btn btn-sm btn-outline-primary ms-3">
                                                <i class="fas fa-eye me-1"></i>@Localizer["View Project"]
                                            </a>
                                        </div>

                                        @if (proj.Phases != null && proj.Phases.Any())
                                        {
                                            <div class="phases-grid">
                                                @foreach (var phase in proj.Phases.OrderBy(p => p.StartDate))
                                                {
                                                    double phasePerf = Math.Round(phase.PhasePerformance, 1);
                                                    string perfColor = phasePerf >= 75 ? "#28a745" : phasePerf >= 50 ? "#ffc107" : "#dc3545";
                                                    <div class="phase-card">
                                                        <div class="phase-card-header">
                                                            <span class="phase-name"><i class="fas fa-tasks me-1"></i>@phase.Name</span>
                                                            <span class="phase-weight-badge">@phase.Weight%</span>
                                                        </div>
                                                        <div class="phase-card-body">
                                                            <div class="mini-info">
                                                                <i class="fas fa-calendar text-primary"></i>
                                                                <span>@phase.StartDate.ToString("MMM yyyy") – @phase.EndDate.ToString("MMM yyyy")</span>
                                                            </div>
                                                            <div class="mini-info">
                                                                <i class="fas fa-coins text-success"></i>
                                                                <span>@proj.CurrencySymbol@phase.Budget.ToString("N0")</span>
                                                            </div>
                                                            <div class="mini-info phase-perf-row">
                                                                <i class="fas fa-chart-line text-info"></i>
                                                                <div class="phase-progress-wrap">
                                                                    <div class="phase-progress-bar" style="width:@phasePerf%; background:@perfColor;"></div>
                                                                </div>
                                                                <span class="phase-perf-text">@phasePerf%</span>
                                                            </div>
                                                        </div>
                                                        <div class="phase-card-footer">
                                                            <a asp-action="ActionPlan" asp-controller="ActionPlans" asp-route-phaseId="@phase.Id"
                                                               class="btn btn-sm btn-primary flex-fill">
                                                                <i class="fas fa-list me-1"></i>@Localizer["Action Plan"]
                                                            </a>
                                                            <a asp-action="Edit" asp-controller="ProjectPhases" asp-route-id="@phase.Id"
                                                               class="btn btn-sm btn-warning flex-fill">
                                                                <i class="fas fa-edit me-1"></i>@Localizer["Edit"]
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                                <!-- Add Phase dashed card — toggles inline form below -->
                                                <div class="phase-card phase-add-card" id="add-phase-card-@proj.ProjectID">
                                                    <button type="button" class="add-phase-link"
                                                            onclick="showAddPhaseForm(@proj.ProjectID, @item.IndicatorCode)">
                                                        <i class="fas fa-plus-circle fa-2x mb-2"></i>
                                                        <span>@Localizer["Add Phase"]</span>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="phases-empty">
                                                <i class="fas fa-layer-group fa-2x mb-2 opacity-50"></i>
                                                <p class="mb-3">@Localizer["No phases yet for this project."]</p>
                                                <button type="button" class="btn btn-success btn-sm"
                                                        onclick="showAddPhaseForm(@proj.ProjectID, @item.IndicatorCode)">
                                                    <i class="fas fa-plus me-1"></i>@Localizer["Add First Phase"]
                                                </button>
                                            </div>
                                        }

                                        <!-- ── Inline Add Phase Form (hidden by default) ── -->
                                        <div class="add-phase-form-wrap mt-3" id="add-phase-form-@proj.ProjectID" style="display:none;">
                                            <div class="add-phase-form-card">
                                                <div class="add-phase-form-header">
                                                    <i class="fas fa-plus-circle me-2"></i>@Localizer["New Phase"] — @proj.ProjectName
                                                    <button type="button" class="btn-close-form ms-auto"
                                                            onclick="hideAddPhaseForm(@proj.ProjectID)">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </div>
                                                <div class="add-phase-form-body">
                                                    <form id="phase-form-@proj.ProjectID"
                                                          onsubmit="submitPhaseForm(event, @proj.ProjectID, @item.IndicatorCode)">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="ProjectID" value="@proj.ProjectID" />
                                                        <div class="row g-2 align-items-end">
                                                            <div class="col-md-4">
                                                                <label class="form-label fw-semibold small mb-1">@Localizer["Phase Name"]</label>
                                                                <input type="text" name="Name" class="form-control form-control-sm"
                                                                       required placeholder="@Localizer["Enter phase name..."]" />
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label class="form-label fw-semibold small mb-1">@Localizer["Start Date"]</label>
                                                                <input type="date" name="StartDate" class="form-control form-control-sm"
                                                                       required
                                                                       value="@proj.StartDate.ToString("yyyy-MM-dd")"
                                                                       min="@proj.StartDate.ToString("yyyy-MM-dd")"
                                                                       max="@proj.EndDate.ToString("yyyy-MM-dd")" />
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label class="form-label fw-semibold small mb-1">@Localizer["End Date"]</label>
                                                                <input type="date" name="EndDate" class="form-control form-control-sm"
                                                                       required
                                                                       value="@proj.EndDate.ToString("yyyy-MM-dd")"
                                                                       min="@proj.StartDate.ToString("yyyy-MM-dd")"
                                                                       max="@proj.EndDate.ToString("yyyy-MM-dd")" />
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label class="form-label fw-semibold small mb-1">@Localizer["Budget"]</label>
                                                                <input type="number" name="Budget" class="form-control form-control-sm"
                                                                       required min="0" step="0.01" placeholder="0.00" />
                                                            </div>
                                                            <div class="col-md-2 d-flex gap-1">
                                                                <button type="submit" class="btn btn-success btn-sm flex-fill">
                                                                    <i class="fas fa-save me-1"></i>@Localizer["Save"]
                                                                </button>
                                                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                                                        onclick="hideAddPhaseForm(@proj.ProjectID)">
                                                                    <i class="fas fa-times"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <div id="phase-error-@proj.ProjectID" class="mt-2" style="display:none;"></div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="stat-icon warning mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                <i class="fas fa-chart-bar"></i>
            </div>
            <h4 class="text-muted">@Localizer["No indicators found"]</h4>
            <p class="text-muted">@Localizer["Create your first indicator to get started"]</p>
        </div>
    }
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Auto-submit form when project filter dropdown changes
        document.getElementById('projectFilter')?.addEventListener('change', function () {
            this.form.submit();
        });

        function toggleProjects(indicatorCode) {
            const row = document.getElementById(`projects-row-${indicatorCode}`);
            const chevron = document.getElementById(`chevron-${indicatorCode}`);
            if (row.style.display === 'none') {
                row.style.display = 'table-row';
                setTimeout(() => row.classList.add('expanded'), 10);
                chevron.style.transform = 'rotate(180deg)';
            } else {
                row.classList.remove('expanded');
                setTimeout(() => row.style.display = 'none', 300);
                chevron.style.transform = 'rotate(0deg)';
            }
        }

        // Real-time search functionality
        const searchInput = document.getElementById('searchInput');
        const searchForm = document.getElementById('searchForm');
        let searchTimeout;

        if (searchInput && searchForm) {
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function() {
                    searchForm.submit();
                }, 500); // Wait 500ms after user stops typing
            });
        }

        function toggleEdit(id) {
            const nameDisplay = document.getElementById(`name-display-${id}`);
            const nameInput = document.getElementById(`name-input-${id}`);
            const editBtn = document.getElementById(`edit-btn-${id}`);

            if (editBtn.innerHTML.includes("fa-save")) {
                // Save action
                const newName = nameInput.value;

                fetch(`/Indicators/InlineEditName/${id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: JSON.stringify({ name: newName })
                })
                .then(response => {
                    if (response.ok) {
                        nameDisplay.textContent = newName;
                        nameDisplay.classList.remove("d-none");
                        nameInput.classList.add("d-none");
                        editBtn.innerHTML = `<i class="fas fa-edit"></i>`;

                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Updated!"]',
                            text: '@Localizer["Indicator name updated successfully"]',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: '@Localizer["Could not save changes"]'
                        });
                    }
                });
            } else {
                // Edit mode
                nameDisplay.classList.add("d-none");
                nameInput.classList.remove("d-none");
                nameInput.focus();
                editBtn.innerHTML = `<i class="fas fa-save"></i>`;
            }
        }

        function confirmDelete(indicatorCode) {
            Swal.fire({
                title: '@Localizer["Are you sure?"]',
                text: "@Localizer["You won't be able to revert this!"]",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '@Localizer["Yes, delete it!"]',
                cancelButtonText: '@Localizer["Cancel"]',
                customClass: {
                    popup: 'swal2-modern',
                    confirmButton: 'btn btn-danger',
                    cancelButton: 'btn btn-secondary'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/Indicators/DeleteConfirmed/${indicatorCode}`,
                        type: 'POST',
                        success: function () {
                            $(`#indicator-row-${indicatorCode}`).fadeOut(400, function() {
                                $(this).remove();
                            });
                            Swal.fire({
                                title: '@Localizer["Deleted!"]',
                                text: '@Localizer["Indicator has been deleted."]',
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            });
                            setTimeout(function(){
                                window.location.reload();
                            }, 2000);
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: '@Localizer["Failed to delete the indicator."]'
                            });
                        }
                    });
                }
            });
        }
        
        // ── Inline Add Phase form ──────────────────────────────────────────
        function showAddPhaseForm(projectId, indicatorCode) {
            const formWrap = document.getElementById(`add-phase-form-${projectId}`);
            if (formWrap.style.display !== 'none') {
                formWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                return;
            }
            formWrap.style.display = 'block';
            setTimeout(() => formWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 50);
        }

        function hideAddPhaseForm(projectId) {
            const formWrap = document.getElementById(`add-phase-form-${projectId}`);
            formWrap.style.display = 'none';
            const errorDiv = document.getElementById(`phase-error-${projectId}`);
            if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.innerHTML = ''; }
            // Reset the form
            const form = document.getElementById(`phase-form-${projectId}`);
            if (form) form.reset();
        }

        async function submitPhaseForm(event, projectId, indicatorCode) {
            event.preventDefault();
            const form = document.getElementById(`phase-form-${projectId}`);
            const errorDiv = document.getElementById(`phase-error-${projectId}`);
            const submitBtn = form.querySelector('[type="submit"]');
            const originalHtml = submitBtn.innerHTML;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>@Localizer["Saving..."]';
            errorDiv.style.display = 'none';

            try {
                const response = await fetch('/ProjectPhases/CreateAjax', {
                    method: 'POST',
                    body: new FormData(form)
                });
                const result = await response.json();

                if (result.success) {
                    // Remember which row to re-expand after the page reloads
                    sessionStorage.setItem('expandPhaseRow', indicatorCode);
                    window.location.reload();
                } else {
                    errorDiv.style.display = 'block';
                    errorDiv.innerHTML = `<div class="alert alert-danger py-1 mb-0 small"><i class="fas fa-exclamation-circle me-1"></i>${result.message}</div>`;
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalHtml;
                }
            } catch (e) {
                errorDiv.style.display = 'block';
                errorDiv.innerHTML = `<div class="alert alert-danger py-1 mb-0 small"><i class="fas fa-exclamation-circle me-1"></i>An error occurred. Please try again.</div>`;
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalHtml;
            }
        }
        // ──────────────────────────────────────────────────────────────────

        // Initialize page animations
        document.addEventListener('DOMContentLoaded', function() {
            // Re-expand the phases row after adding a phase (page reload)
            const expandCode = sessionStorage.getItem('expandPhaseRow');
            if (expandCode) {
                sessionStorage.removeItem('expandPhaseRow');
                const row = document.getElementById(`projects-row-${expandCode}`);
                const chevron = document.getElementById(`chevron-${expandCode}`);
                if (row) {
                    row.style.display = 'table-row';
                    row.classList.add('expanded');
                    if (chevron) chevron.style.transform = 'rotate(180deg)';
                    setTimeout(() => row.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 200);
                }
            }

            // Animate table rows on load
            const tableRows = document.querySelectorAll('.table-row');
            tableRows.forEach((row, index) => {
                row.style.opacity = '0';
                row.style.transform = 'translateX(-20px)';
                setTimeout(() => {
                    row.style.transition = 'all 0.6s ease';
                    row.style.opacity = '1';
                    row.style.transform = 'translateX(0)';
                }, index * 100);
            });
            
            // Progress bar animation
            const progressBars = document.querySelectorAll('.progress-fill-modern');
            progressBars.forEach((bar, index) => {
                setTimeout(() => {
                    const width = bar.style.width;
                    bar.style.width = '0%';
                    setTimeout(() => {
                        bar.style.transition = 'width 1.5s ease-out';
                        bar.style.width = width;
                    }, 200);
                }, index * 100);
            });
        });
    </script>

