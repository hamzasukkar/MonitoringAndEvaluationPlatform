        // Initialize sparklines for all goals
        async function initializeSparklines() {
            const sparklines = document.querySelectorAll('.sparkline-canvas');

            for (const canvas of sparklines) {
                const goalId = canvas.getAttribute('data-goal-id');

                try {
                    // Fetch yearly values for this goal
                    const response = await fetch(`@Url.Action("GetYearlyValues", "FrameworkGoals")?goalId=${goalId}`);
                    const result = await response.json();

                    if (result.success) {
                        drawSparkline(canvas, result);
                    }
                } catch (error) {
                    console.error('Error loading sparkline data:', error);
                }
            }
        }

        // Draw sparkline on canvas
        function drawSparkline(canvas, data) {
            const ctx = canvas.getContext('2d');
            const width = canvas.width;
            const height = canvas.height;
            const padding = 5;

            // Clear canvas
            ctx.clearRect(0, 0, width, height);

            // Get data from canvas attributes
            const startingYear = parseInt(canvas.getAttribute('data-starting-year'));
            const currentYear = parseInt(canvas.getAttribute('data-current-year'));
            const targetYear = parseInt(canvas.getAttribute('data-target-year'));
            const startingValue = parseFloat(canvas.getAttribute('data-starting-value'));
            const currentValue = parseFloat(canvas.getAttribute('data-current-value'));
            const targetValue = parseFloat(canvas.getAttribute('data-target-value'));
            const isIncrease = canvas.getAttribute('data-is-increase') === 'true';

            // Build data points array from starting year to current year
            const dataPoints = [];

            // Add starting year
            dataPoints.push({ year: startingYear, value: startingValue });

            // Add yearly values (if any exist between starting and current year)
            if (data.yearlyValues && data.yearlyValues.length > 0) {
                data.yearlyValues.forEach(yv => {
                    if (yv.year > startingYear && yv.year < currentYear) {
                        dataPoints.push({ year: yv.year, value: yv.value });
                    }
                });
            }

            // Add current year
            dataPoints.push({ year: currentYear, value: currentValue });

            // Sort by year
            dataPoints.sort((a, b) => a.year - b.year);

            // If we only have 2 points, we can still draw a line
            if (dataPoints.length < 2) {
                return; // Not enough data to draw
            }

            // Find min and max values for scaling
            const values = dataPoints.map(d => d.value);
            const minValue = Math.min(...values, targetValue);
            const maxValue = Math.max(...values, targetValue);
            const valueRange = maxValue - minValue || 1; // Avoid division by zero

            // Calculate expected trajectory (linear from starting to target)
            const expectedSlope = (targetValue - startingValue) / (targetYear - startingYear);
            const expectedCurrentValue = startingValue + (expectedSlope * (currentYear - startingYear));

            // Determine trend: improving, declining, or stagnant
            let trendColor;
            const actualChange = currentValue - startingValue;
            const expectedChange = expectedCurrentValue - startingValue;

            if (isIncrease) {
                // For increase goals: green if actual >= expected, red if below
                if (actualChange >= expectedChange * 0.95) {
                    trendColor = '#198754'; // Green - improving/on track
                } else if (actualChange >= expectedChange * 0.7) {
                    trendColor = '#ffc107'; // Yellow - at risk
                } else {
                    trendColor = '#dc3545'; // Red - declining/off track
                }
            } else {
                // For decrease goals: green if actual reduction >= expected, red if below
                const actualReduction = startingValue - currentValue;
                const expectedReduction = startingValue - expectedCurrentValue;

                if (actualReduction >= expectedReduction * 0.95) {
                    trendColor = '#198754'; // Green
                } else if (actualReduction >= expectedReduction * 0.7) {
                    trendColor = '#ffc107'; // Yellow
                } else {
                    trendColor = '#dc3545'; // Red
                }
            }

            // Draw background expected line (dashed, light gray)
            ctx.beginPath();
            ctx.setLineDash([3, 3]);
            ctx.strokeStyle = '#dee2e6';
            ctx.lineWidth = 1;

            const startX = padding;
            const startY = height - padding - ((startingValue - minValue) / valueRange) * (height - 2 * padding);
            const endX = width - padding;
            const endY = height - padding - ((targetValue - minValue) / valueRange) * (height - 2 * padding);

            ctx.moveTo(startX, startY);
            ctx.lineTo(endX, endY);
            ctx.stroke();
            ctx.setLineDash([]);

            // Draw actual progress line
            ctx.beginPath();
            ctx.strokeStyle = trendColor;
            ctx.lineWidth = 2;

            dataPoints.forEach((point, index) => {
                const x = padding + ((point.year - startingYear) / (targetYear - startingYear)) * (width - 2 * padding);
                const y = height - padding - ((point.value - minValue) / valueRange) * (height - 2 * padding);

                if (index === 0) {
                    ctx.moveTo(x, y);
                } else {
                    ctx.lineTo(x, y);
                }
            });

            ctx.stroke();

            // Draw dots at data points
            dataPoints.forEach(point => {
                const x = padding + ((point.year - startingYear) / (targetYear - startingYear)) * (width - 2 * padding);
                const y = height - padding - ((point.value - minValue) / valueRange) * (height - 2 * padding);

                ctx.beginPath();
                ctx.arc(x, y, 3, 0, 2 * Math.PI);
                ctx.fillStyle = trendColor;
                ctx.fill();
            });

            // Add tooltip on hover
            canvas.title = `Trend: ${dataPoints[0].value.toFixed(2)} → ${dataPoints[dataPoints.length - 1].value.toFixed(2)}`;
        }

        // =============================================
        // SORTING AND PAGINATION FUNCTIONALITY
        // =============================================

        // Pagination state
        let currentPage = 1;
        let pageSize = 25;
        let currentSortColumn = null;
        let currentSortDirection = 'asc';
        let allRows = [];
        let filteredRows = [];

        // Initialize sorting and pagination on page load
        document.addEventListener('DOMContentLoaded', function() {
            initializeSortingAndPagination();
        });

        function initializeSortingAndPagination() {
            // Store all original rows
            allRows = Array.from(document.querySelectorAll('.goal-row'));
            filteredRows = [...allRows];

            // Apply initial pagination
            applyPagination();
        }

        // Sorting function
        function sortTable(column) {
            // Determine sort direction
            if (currentSortColumn === column) {
                currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortColumn = column;
                currentSortDirection = 'asc';
            }

            // Update sort icons
            updateSortIcons(column, currentSortDirection);

            // Get visible (filtered) rows
            const visibleRows = filteredRows.filter(row => row.style.display !== 'none');

            // Sort the rows
            visibleRows.sort((a, b) => {
                let aValue, bValue;

                switch (column) {
                    case 'name':
                        aValue = a.getAttribute('data-goal-name-display') || '';
                        bValue = b.getAttribute('data-goal-name-display') || '';
                        break;
                    case 'framework':
                        aValue = a.getAttribute('data-framework-name') || '';
                        bValue = b.getAttribute('data-framework-name') || '';
                        break;
                    case 'discountRate':
                        aValue = parseFloat(a.getAttribute('data-discount-rate')) || 0;
                        bValue = parseFloat(b.getAttribute('data-discount-rate')) || 0;
                        return currentSortDirection === 'asc' ? aValue - bValue : bValue - aValue;
                    case 'progressRate':
                        aValue = parseFloat(a.getAttribute('data-progress-rate')) || 0;
                        bValue = parseFloat(b.getAttribute('data-progress-rate')) || 0;
                        return currentSortDirection === 'asc' ? aValue - bValue : bValue - aValue;
                    default:
                        aValue = '';
                        bValue = '';
                }

                // String comparison for text columns
                if (typeof aValue === 'string') {
                    const comparison = aValue.localeCompare(bValue, undefined, { sensitivity: 'base' });
                    return currentSortDirection === 'asc' ? comparison : -comparison;
                }

                return 0;
            });

            // Reorder rows in the DOM
            const tbody = document.querySelector('#goalsTable tbody');
            visibleRows.forEach(row => tbody.appendChild(row));

            // Update filteredRows to match the new order
            filteredRows = Array.from(document.querySelectorAll('.goal-row'));

            // Reset to page 1 after sorting
            currentPage = 1;
            applyPagination();
        }

        // Update sort icons in headers
        function updateSortIcons(activeColumn, direction) {
            // Reset all sort icons
            document.querySelectorAll('.sortable-header .sort-icon i').forEach(icon => {
                icon.className = 'fas fa-sort';
            });

            // Set active sort icon
            const activeHeader = document.querySelector(`.sortable-header[data-sort="${activeColumn}"] .sort-icon i`);
            if (activeHeader) {
                activeHeader.className = direction === 'asc' ? 'fas fa-sort-up' : 'fas fa-sort-down';
            }

            // Update header styles
            document.querySelectorAll('.sortable-header').forEach(header => {
                header.classList.remove('sorted-asc', 'sorted-desc');
            });
            const activeHeaderElement = document.querySelector(`.sortable-header[data-sort="${activeColumn}"]`);
            if (activeHeaderElement) {
                activeHeaderElement.classList.add(direction === 'asc' ? 'sorted-asc' : 'sorted-desc');
            }
        }

        // Pagination function
        function applyPagination() {
            // Get visible rows (respecting filters)
            const visibleRows = filteredRows.filter(row => {
                // Check if row passes current filters
                const searchTerm = document.getElementById('searchGoal')?.value.toLowerCase().trim() || '';
                const frameworkFilter = document.getElementById('frameworkFilter')?.value || '';
                const statusFilter = document.getElementById('statusFilter')?.value || '';
                const progressRangeFilter = document.getElementById('progressRangeFilter')?.value || '';

                let shouldShow = true;

                if (searchTerm && !row.getAttribute('data-goal-name').includes(searchTerm)) {
                    shouldShow = false;
                }
                if (frameworkFilter && row.getAttribute('data-framework-code') !== frameworkFilter) {
                    shouldShow = false;
                }
                if (statusFilter && row.getAttribute('data-status') !== statusFilter) {
                    shouldShow = false;
                }
                if (progressRangeFilter) {
                    const progressRate = parseFloat(row.getAttribute('data-progress-rate'));
                    const [min, max] = progressRangeFilter.split('-').map(v => v === '' ? Infinity : parseFloat(v.replace('+', '')));
                    if (max === undefined || max === Infinity) {
                        if (progressRate < min) shouldShow = false;
                    } else {
                        if (progressRate < min || progressRate > max) shouldShow = false;
                    }
                }

                return shouldShow;
            });

            const totalRows = visibleRows.length;
            const totalPages = pageSize === -1 ? 1 : Math.ceil(totalRows / pageSize);

            // Ensure current page is valid
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            // Calculate start and end indices
            const startIndex = pageSize === -1 ? 0 : (currentPage - 1) * pageSize;
            const endIndex = pageSize === -1 ? totalRows : Math.min(startIndex + pageSize, totalRows);

            // Hide all rows first
            filteredRows.forEach(row => row.style.display = 'none');

            // Show only rows for current page
            visibleRows.forEach((row, index) => {
                if (index >= startIndex && index < endIndex) {
                    row.style.display = '';
                }
            });

            // Update pagination info
            updatePaginationInfo(startIndex + 1, endIndex, totalRows);

            // Update pagination controls
            updatePaginationControls(totalPages);
        }

        // Update pagination info text
        function updatePaginationInfo(start, end, total) {
            const infoElement = document.getElementById('paginationInfo');
            if (infoElement) {
                if (total === 0) {
                    infoElement.textContent = '@Localizer["No goals to display"]';
                } else {
                    infoElement.textContent = `@Localizer["Showing"] ${start}-${end} @Localizer["of"] ${total} @Localizer["goals"]`;
                }
            }
        }

        // Update pagination controls
        function updatePaginationControls(totalPages) {
            const paginationList = document.getElementById('paginationControls');
            if (!paginationList) return;

            // Clear existing page numbers (keep prev/next)
            const pageItems = paginationList.querySelectorAll('.page-item:not(#prevPageItem):not(#nextPageItem)');
            pageItems.forEach(item => item.remove());

            // Get prev and next buttons
            const prevItem = document.getElementById('prevPageItem');
            const nextItem = document.getElementById('nextPageItem');

            // Update prev button state
            if (currentPage === 1) {
                prevItem.classList.add('disabled');
                prevItem.querySelector('a').setAttribute('tabindex', '-1');
            } else {
                prevItem.classList.remove('disabled');
                prevItem.querySelector('a').removeAttribute('tabindex');
            }

            // Update next button state
            if (currentPage === totalPages || totalPages === 0) {
                nextItem.classList.add('disabled');
                nextItem.querySelector('a').setAttribute('tabindex', '-1');
            } else {
                nextItem.classList.remove('disabled');
                nextItem.querySelector('a').removeAttribute('tabindex');
            }

            // Generate page numbers
            const maxVisiblePages = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
            let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

            if (endPage - startPage + 1 < maxVisiblePages) {
                startPage = Math.max(1, endPage - maxVisiblePages + 1);
            }

            // Add first page and ellipsis if needed
            if (startPage > 1) {
                insertPageItem(1, paginationList, nextItem);
                if (startPage > 2) {
                    insertEllipsis(paginationList, nextItem);
                }
            }

            // Add page numbers
            for (let i = startPage; i <= endPage; i++) {
                insertPageItem(i, paginationList, nextItem);
            }

            // Add last page and ellipsis if needed
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    insertEllipsis(paginationList, nextItem);
                }
                insertPageItem(totalPages, paginationList, nextItem);
            }
        }

        // Insert a page number item
        function insertPageItem(pageNum, container, beforeElement) {
            const li = document.createElement('li');
            li.className = `page-item ${pageNum === currentPage ? 'active' : ''}`;
            li.innerHTML = `<a class="page-link" href="#" onclick="goToPage(${pageNum}); return false;">${pageNum}</a>`;
            container.insertBefore(li, beforeElement);
        }

        // Insert ellipsis
        function insertEllipsis(container, beforeElement) {
            const li = document.createElement('li');
            li.className = 'page-item disabled';
            li.innerHTML = '<span class="page-link">...</span>';
            container.insertBefore(li, beforeElement);
        }

        // Go to specific page
        function goToPage(page) {
            const visibleRows = filteredRows.filter(row => row.style.display !== 'none' || true); // Get all that pass filter
            const totalPages = pageSize === -1 ? 1 : Math.ceil(getFilteredRowCount() / pageSize);

            if (page === 'prev') {
                currentPage = Math.max(1, currentPage - 1);
            } else if (page === 'next') {
                currentPage = Math.min(totalPages, currentPage + 1);
            } else {
                currentPage = parseInt(page);
            }

            applyPagination();
        }

        // Get count of rows that pass current filters
        function getFilteredRowCount() {
            const searchTerm = document.getElementById('searchGoal')?.value.toLowerCase().trim() || '';
            const frameworkFilter = document.getElementById('frameworkFilter')?.value || '';
            const statusFilter = document.getElementById('statusFilter')?.value || '';
            const progressRangeFilter = document.getElementById('progressRangeFilter')?.value || '';

            return filteredRows.filter(row => {
                let shouldShow = true;
                if (searchTerm && !row.getAttribute('data-goal-name').includes(searchTerm)) {
                    shouldShow = false;
                }
                if (frameworkFilter && row.getAttribute('data-framework-code') !== frameworkFilter) {
                    shouldShow = false;
                }
                if (statusFilter && row.getAttribute('data-status') !== statusFilter) {
                    shouldShow = false;
                }
                if (progressRangeFilter) {
                    const progressRate = parseFloat(row.getAttribute('data-progress-rate'));
                    const [min, max] = progressRangeFilter.split('-').map(v => v === '' ? Infinity : parseFloat(v.replace('+', '')));
                    if (max === undefined || max === Infinity) {
                        if (progressRate < min) shouldShow = false;
                    } else {
                        if (progressRate < min || progressRate > max) shouldShow = false;
                    }
                }
                return shouldShow;
            }).length;
        }

        // Change page size
        function changePageSize() {
            const select = document.getElementById('pageSizeSelect');
            pageSize = parseInt(select.value);
            currentPage = 1;
            applyPagination();
        }

        // =============================================
        // END SORTING AND PAGINATION
        // =============================================

        // =============================================
        // EXPORT FUNCTIONALITY
        // =============================================

        // Get export data from filtered/visible rows
        function getExportData() {
            const data = [];
            const rows = document.querySelectorAll('.goal-row');

            rows.forEach(row => {
                // Check if row passes current filters (regardless of pagination)
                const searchTerm = document.getElementById('searchGoal')?.value.toLowerCase().trim() || '';
                const frameworkFilter = document.getElementById('frameworkFilter')?.value || '';
                const statusFilter = document.getElementById('statusFilter')?.value || '';
                const progressRangeFilter = document.getElementById('progressRangeFilter')?.value || '';

                let shouldInclude = true;

                if (searchTerm && !row.getAttribute('data-goal-name').includes(searchTerm)) {
                    shouldInclude = false;
                }
                if (frameworkFilter && row.getAttribute('data-framework-code') !== frameworkFilter) {
                    shouldInclude = false;
                }
                if (statusFilter && row.getAttribute('data-status') !== statusFilter) {
                    shouldInclude = false;
                }
                if (progressRangeFilter) {
                    const progressRate = parseFloat(row.getAttribute('data-progress-rate'));
                    const [min, max] = progressRangeFilter.split('-').map(v => v === '' ? Infinity : parseFloat(v.replace('+', '')));
                    if (max === undefined || max === Infinity) {
                        if (progressRate < min) shouldInclude = false;
                    } else {
                        if (progressRate < min || progressRate > max) shouldInclude = false;
                    }
                }

                if (shouldInclude) {
                    const goalName = row.getAttribute('data-goal-name-display');
                    const frameworkName = row.getAttribute('data-framework-name');
                    const progressRate = parseFloat(row.getAttribute('data-progress-rate')).toFixed(2);
                    const discountRate = parseFloat(row.getAttribute('data-discount-rate')).toFixed(2);
                    const status = row.getAttribute('data-status');
                    const startingYear = row.getAttribute('data-starting-year');
                    const targetYear = row.getAttribute('data-target-year');

                    data.push({
                        goalName,
                        frameworkName,
                        startingYear,
                        targetYear,
                        discountRate: discountRate + '%',
                        progressRate: progressRate + '%',
                        status: status.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())
                    });
                }
            });

            return data;
        }

        // Export to CSV
        function exportToCSV() {
            const data = getExportData();

            if (data.length === 0) {
                showErrorMessage('@Localizer["No data to export"]');
                return;
            }

            // CSV headers
            const headers = [
                '@Localizer["Goal Name"]',
                '@Localizer["Framework"]',
                '@Localizer["Starting Year"]',
                '@Localizer["Target Year"]',
                '@Localizer["Annual Discount Rate"]',
                '@Localizer["Progress Rate"]',
                '@Localizer["Status"]'
            ];

            // Build CSV content with proper encoding
            let csvContent = '';
            csvContent += headers.join('\t') + '\n'; // Use tab separator for better Excel compatibility

            data.forEach(row => {
                const values = [
                    row.goalName,
                    row.frameworkName,
                    row.startingYear,
                    row.targetYear,
                    row.discountRate,
                    row.progressRate,
                    row.status
                ];
                csvContent += values.join('\t') + '\n';
            });

            // Download file with UTF-8 BOM for proper Arabic support
            downloadFileWithBOM(csvContent, 'FrameworkGoals_' + getDateString() + '.csv');
            showSuccessMessage('@Localizer["CSV exported successfully!"]');
        }

        // Export to Excel
        function exportToExcel() {
            const data = getExportData();

            if (data.length === 0) {
                showErrorMessage('@Localizer["No data to export"]');
                return;
            }

            // Check if SheetJS is loaded
            if (typeof XLSX === 'undefined') {
                showErrorMessage('@Localizer["Excel export library not loaded. Please refresh the page."]');
                return;
            }

            // Prepare worksheet data
            const wsData = [
                [
                    '@Localizer["Goal Name"]',
                    '@Localizer["Framework"]',
                    '@Localizer["Starting Year"]',
                    '@Localizer["Target Year"]',
                    '@Localizer["Annual Discount Rate"]',
                    '@Localizer["Progress Rate"]',
                    '@Localizer["Status"]'
                ]
            ];

            data.forEach(row => {
                wsData.push([
                    row.goalName,
                    row.frameworkName,
                    parseInt(row.startingYear),
                    parseInt(row.targetYear),
                    row.discountRate,
                    row.progressRate,
                    row.status
                ]);
            });

            // Create workbook and worksheet
            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.aoa_to_sheet(wsData);

            // Set column widths
            ws['!cols'] = [
                { wch: 40 }, // Goal Name
                { wch: 25 }, // Framework
                { wch: 15 }, // Starting Year
                { wch: 15 }, // Target Year
                { wch: 20 }, // Discount Rate
                { wch: 15 }, // Progress Rate
                { wch: 15 }  // Status
            ];

            // Set RTL for the worksheet (for Arabic)
            ws['!dir'] = 'rtl';

            // Add worksheet to workbook
            XLSX.utils.book_append_sheet(wb, ws, 'Framework Goals');

            // Generate and download file with proper encoding
            XLSX.writeFile(wb, 'FrameworkGoals_' + getDateString() + '.xlsx', {
                bookType: 'xlsx',
                type: 'binary',
                cellStyles: true
            });
            showSuccessMessage('@Localizer["Excel exported successfully!"]');
        }

        // Export to PDF using html2canvas for proper Arabic support
        function exportToPDF() {
            const data = getExportData();

            if (data.length === 0) {
                showErrorMessage('@Localizer["No data to export"]');
                return;
            }

            // Check if libraries are loaded
            if (typeof html2canvas === 'undefined') {
                showErrorMessage('@Localizer["PDF export library not loaded. Please refresh the page."]');
                return;
            }

            if (typeof jspdf === 'undefined' || typeof jspdf.jsPDF === 'undefined') {
                showErrorMessage('@Localizer["PDF export library not loaded. Please refresh the page."]');
                return;
            }

            // Show loading message
            const loadingAlert = document.createElement('div');
            loadingAlert.className = 'alert alert-info alert-dismissible fade show position-fixed';
            loadingAlert.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            loadingAlert.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>@Localizer["Generating PDF..."]';
            document.body.appendChild(loadingAlert);

            // Create a temporary container for PDF content
            const pdfContainer = document.createElement('div');
            pdfContainer.id = 'pdf-export-container';
            pdfContainer.style.cssText = 'position: absolute; left: -9999px; top: 0; background: white; padding: 20px; width: 1100px; direction: rtl;';

            // Build HTML content with Arabic support
            const activeFilters = getActiveFiltersText();
            let htmlContent = `
                <div style="font-family: 'Segoe UI', Tahoma, Arial, sans-serif; direction: rtl; text-align: right;">
                    <h2 style="color: #2c3e50; margin-bottom: 10px; font-size: 24px;">@Localizer["Framework Goals Report"]</h2>
                    <p style="color: #6c757d; font-size: 12px; margin-bottom: 5px;">
                        @Localizer["Generated on"]: ${new Date().toLocaleDateString('ar-SA')} ${new Date().toLocaleTimeString('ar-SA')}
                    </p>
                    ${activeFilters ? `<p style="color: #6c757d; font-size: 12px; margin-bottom: 15px;">@Localizer["Filters"]: ${activeFilters}</p>` : ''}
                    <table style="width: 100%; border-collapse: collapse; font-size: 11px; direction: rtl;">
                        <thead>
                            <tr style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                                <th style="border: 1px solid #dee2e6; padding: 10px; color: white; text-align: center;">@Localizer["Goal Name"]</th>
                                <th style="border: 1px solid #dee2e6; padding: 10px; color: white; text-align: center;">@Localizer["Framework"]</th>
                                <th style="border: 1px solid #dee2e6; padding: 10px; color: white; text-align: center;">@Localizer["Starting Year"]</th>
                                <th style="border: 1px solid #dee2e6; padding: 10px; color: white; text-align: center;">@Localizer["Target Year"]</th>
                                <th style="border: 1px solid #dee2e6; padding: 10px; color: white; text-align: center;">@Localizer["Annual Discount Rate"]</th>
                                <th style="border: 1px solid #dee2e6; padding: 10px; color: white; text-align: center;">@Localizer["Progress Rate"]</th>
                                <th style="border: 1px solid #dee2e6; padding: 10px; color: white; text-align: center;">@Localizer["Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            data.forEach((row, index) => {
                const bgColor = index % 2 === 0 ? '#ffffff' : '#f8f9fa';
                let statusColor = '#495057';
                if (row.status.toLowerCase().includes('on track') || row.status.toLowerCase().includes('on-track')) {
                    statusColor = '#198754';
                } else if (row.status.toLowerCase().includes('at risk') || row.status.toLowerCase().includes('at-risk')) {
                    statusColor = '#ffc107';
                } else if (row.status.toLowerCase().includes('off track') || row.status.toLowerCase().includes('off-track')) {
                    statusColor = '#dc3545';
                }

                htmlContent += `
                    <tr style="background-color: ${bgColor};">
                        <td style="border: 1px solid #dee2e6; padding: 8px; text-align: right;">${row.goalName}</td>
                        <td style="border: 1px solid #dee2e6; padding: 8px; text-align: center;">${row.frameworkName}</td>
                        <td style="border: 1px solid #dee2e6; padding: 8px; text-align: center;">${row.startingYear}</td>
                        <td style="border: 1px solid #dee2e6; padding: 8px; text-align: center;">${row.targetYear}</td>
                        <td style="border: 1px solid #dee2e6; padding: 8px; text-align: center;">${row.discountRate}</td>
                        <td style="border: 1px solid #dee2e6; padding: 8px; text-align: center;">${row.progressRate}</td>
                        <td style="border: 1px solid #dee2e6; padding: 8px; text-align: center; color: ${statusColor}; font-weight: bold;">${row.status}</td>
                    </tr>
                `;
            });

            htmlContent += `
                        </tbody>
                    </table>
                    <p style="color: #6c757d; font-size: 10px; margin-top: 15px; text-align: center;">
                        @Localizer["Total"]: ${data.length} @Localizer["goals"]
                    </p>
                </div>
            `;

            pdfContainer.innerHTML = htmlContent;
            document.body.appendChild(pdfContainer);

            // Use html2canvas to capture the content
            setTimeout(() => {
                html2canvas(pdfContainer, {
                    scale: 2,
                    useCORS: true,
                    logging: false,
                    backgroundColor: '#ffffff'
                }).then(canvas => {
                    const { jsPDF } = jspdf;
                    const imgData = canvas.toDataURL('image/png');
                    const imgWidth = 287; // A4 landscape width in mm (297 - margins)
                    const pageHeight = 200; // A4 landscape height in mm (210 - margins)
                    const imgHeight = (canvas.height * imgWidth) / canvas.width;
                    let heightLeft = imgHeight;
                    let position = 5;

                    const pdf = new jsPDF('l', 'mm', 'a4');
                    pdf.addImage(imgData, 'PNG', 5, position, imgWidth, imgHeight);
                    heightLeft -= pageHeight;

                    // Add more pages if content is long
                    while (heightLeft > 0) {
                        position = heightLeft - imgHeight + 5;
                        pdf.addPage();
                        pdf.addImage(imgData, 'PNG', 5, position, imgWidth, imgHeight);
                        heightLeft -= pageHeight;
                    }

                    // Save PDF
                    pdf.save('FrameworkGoals_' + getDateString() + '.pdf');

                    // Cleanup
                    document.body.removeChild(pdfContainer);
                    document.body.removeChild(loadingAlert);
                    showSuccessMessage('@Localizer["PDF exported successfully!"]');
                }).catch(error => {
                    console.error('PDF export error:', error);
                    document.body.removeChild(pdfContainer);
                    document.body.removeChild(loadingAlert);
                    showErrorMessage('@Localizer["Error generating PDF. Please try again."]');
                });
            }, 100);
        }

        // Get active filters as text
        function getActiveFiltersText() {
            const filters = [];

            const searchTerm = document.getElementById('searchGoal')?.value.trim();
            if (searchTerm) {
                filters.push('@Localizer["Search"]: "' + searchTerm + '"');
            }

            const frameworkSelect = document.getElementById('frameworkFilter');
            if (frameworkSelect?.value) {
                filters.push('@Localizer["Framework"]: ' + frameworkSelect.options[frameworkSelect.selectedIndex].text);
            }

            const statusSelect = document.getElementById('statusFilter');
            if (statusSelect?.value) {
                filters.push('@Localizer["Status"]: ' + statusSelect.options[statusSelect.selectedIndex].text);
            }

            const progressSelect = document.getElementById('progressRangeFilter');
            if (progressSelect?.value) {
                filters.push('@Localizer["Progress"]: ' + progressSelect.options[progressSelect.selectedIndex].text);
            }

            return filters.join(', ');
        }

        // Helper function to download file
        function downloadFile(content, filename, mimeType) {
            const blob = new Blob([content], { type: mimeType });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

        // Helper function to download file with UTF-8 BOM for proper Arabic encoding
        function downloadFileWithBOM(content, filename) {
            // Create UTF-8 BOM + content as Uint8Array
            const BOM = new Uint8Array([0xEF, 0xBB, 0xBF]);
            const encoder = new TextEncoder();
            const contentArray = encoder.encode(content);

            // Combine BOM and content
            const combined = new Uint8Array(BOM.length + contentArray.length);
            combined.set(BOM, 0);
            combined.set(contentArray, BOM.length);

            // Create blob and download
            const blob = new Blob([combined], { type: 'text/csv;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

        // Helper function to get formatted date string
        function getDateString() {
            const now = new Date();
            return now.getFullYear() +
                String(now.getMonth() + 1).padStart(2, '0') +
                String(now.getDate()).padStart(2, '0') + '_' +
                String(now.getHours()).padStart(2, '0') +
                String(now.getMinutes()).padStart(2, '0');
        }

        // =============================================
        // END EXPORT FUNCTIONALITY
        // =============================================

        // Advanced Filtering Functions
        function applyFilters() {
            // Reset to page 1 when filters change
            currentPage = 1;

            // Apply pagination which handles filtering internally
            applyPagination();

            // Update filter results counter
            const totalCount = filteredRows.length;
            const visibleCount = getFilteredRowCount();
            updateFilterResults(visibleCount, totalCount);
        }

        function updateFilterResults(visibleCount, totalCount) {
            const filterResults = document.getElementById('filterResults');
            const filterResultsText = document.getElementById('filterResultsText');

            if (visibleCount < totalCount) {
                filterResults.style.display = 'block';
                filterResultsText.textContent = `@Localizer["Showing"]` + ' ' + visibleCount + ' ' + `@Localizer["of"]` + ' ' + totalCount + ' ' + `@Localizer["goals"]`;
            } else {
                filterResults.style.display = 'none';
            }
        }

        function resetFilters() {
            // Clear all filter inputs
            document.getElementById('searchGoal').value = '';
            document.getElementById('frameworkFilter').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('progressRangeFilter').value = '';

            // Reapply filters (which will show all rows)
            applyFilters();
        }

        // Toggle Smart Alerts Section
        function toggleSmartAlerts() {
            const alertsBody = document.getElementById('smartAlertsBody');
            const chevron = document.getElementById('alertsChevron');

            if (alertsBody.style.display === 'none') {
                alertsBody.style.display = 'block';
                chevron.classList.remove('fa-chevron-down');
                chevron.classList.add('fa-chevron-up');
            } else {
                alertsBody.style.display = 'none';
                chevron.classList.remove('fa-chevron-up');
                chevron.classList.add('fa-chevron-down');
            }
        }
    </script>
}

