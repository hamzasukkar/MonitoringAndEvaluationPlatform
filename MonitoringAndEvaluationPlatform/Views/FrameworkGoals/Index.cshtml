        // Initialize sparklines for all goals
        async function initializeSparklines() {
            const sparklines = document.querySelectorAll('.sparkline-canvas');

            for (const canvas of sparklines) {
                const goalId = canvas.getAttribute('data-goal-id');

                try {
                    // Fetch yearly values for this goal
                    const response = await fetch(`@Url.Action("GetYearlyValues", "FrameworkGoals")?goalId=${goalId}`);
                    const result = await response.json();

                    if (result.success) {
                        drawSparkline(canvas, result);
                    }
                } catch (error) {
                    console.error('Error loading sparkline data:', error);
                }
            }
        }

        // Draw sparkline on canvas
        function drawSparkline(canvas, data) {
            const ctx = canvas.getContext('2d');
            const width = canvas.width;
            const height = canvas.height;
            const padding = 5;

            // Clear canvas
            ctx.clearRect(0, 0, width, height);

            // Get data from canvas attributes
            const startingYear = parseInt(canvas.getAttribute('data-starting-year'));
            const currentYear = parseInt(canvas.getAttribute('data-current-year'));
            const targetYear = parseInt(canvas.getAttribute('data-target-year'));
            const startingValue = parseFloat(canvas.getAttribute('data-starting-value'));
            const currentValue = parseFloat(canvas.getAttribute('data-current-value'));
            const targetValue = parseFloat(canvas.getAttribute('data-target-value'));
            const isIncrease = canvas.getAttribute('data-is-increase') === 'true';

            // Build data points array from starting year to current year
            const dataPoints = [];

            // Add starting year
            dataPoints.push({ year: startingYear, value: startingValue });

            // Add yearly values (if any exist between starting and current year)
            if (data.yearlyValues && data.yearlyValues.length > 0) {
                data.yearlyValues.forEach(yv => {
                    if (yv.year > startingYear && yv.year < currentYear) {
                        dataPoints.push({ year: yv.year, value: yv.value });
                    }
                });
            }

            // Add current year
            dataPoints.push({ year: currentYear, value: currentValue });

            // Sort by year
            dataPoints.sort((a, b) => a.year - b.year);

            // If we only have 2 points, we can still draw a line
            if (dataPoints.length < 2) {
                return; // Not enough data to draw
            }

            // Find min and max values for scaling
            const values = dataPoints.map(d => d.value);
            const minValue = Math.min(...values, targetValue);
            const maxValue = Math.max(...values, targetValue);
            const valueRange = maxValue - minValue || 1; // Avoid division by zero

            // Calculate expected trajectory (linear from starting to target)
            const expectedSlope = (targetValue - startingValue) / (targetYear - startingYear);
            const expectedCurrentValue = startingValue + (expectedSlope * (currentYear - startingYear));

            // Determine trend: improving, declining, or stagnant
            let trendColor;
            const actualChange = currentValue - startingValue;
            const expectedChange = expectedCurrentValue - startingValue;

            if (isIncrease) {
                // For increase goals: green if actual >= expected, red if below
                if (actualChange >= expectedChange * 0.95) {
                    trendColor = '#198754'; // Green - improving/on track
                } else if (actualChange >= expectedChange * 0.7) {
                    trendColor = '#ffc107'; // Yellow - at risk
                } else {
                    trendColor = '#dc3545'; // Red - declining/off track
                }
            } else {
                // For decrease goals: green if actual reduction >= expected, red if below
                const actualReduction = startingValue - currentValue;
                const expectedReduction = startingValue - expectedCurrentValue;

                if (actualReduction >= expectedReduction * 0.95) {
                    trendColor = '#198754'; // Green
                } else if (actualReduction >= expectedReduction * 0.7) {
                    trendColor = '#ffc107'; // Yellow
                } else {
                    trendColor = '#dc3545'; // Red
                }
            }

            // Draw background expected line (dashed, light gray)
            ctx.beginPath();
            ctx.setLineDash([3, 3]);
            ctx.strokeStyle = '#dee2e6';
            ctx.lineWidth = 1;

            const startX = padding;
            const startY = height - padding - ((startingValue - minValue) / valueRange) * (height - 2 * padding);
            const endX = width - padding;
            const endY = height - padding - ((targetValue - minValue) / valueRange) * (height - 2 * padding);

            ctx.moveTo(startX, startY);
            ctx.lineTo(endX, endY);
            ctx.stroke();
            ctx.setLineDash([]);

            // Draw actual progress line
            ctx.beginPath();
            ctx.strokeStyle = trendColor;
            ctx.lineWidth = 2;

            dataPoints.forEach((point, index) => {
                const x = padding + ((point.year - startingYear) / (targetYear - startingYear)) * (width - 2 * padding);
                const y = height - padding - ((point.value - minValue) / valueRange) * (height - 2 * padding);

                if (index === 0) {
                    ctx.moveTo(x, y);
                } else {
                    ctx.lineTo(x, y);
                }
            });

            ctx.stroke();

            // Draw dots at data points
            dataPoints.forEach(point => {
                const x = padding + ((point.year - startingYear) / (targetYear - startingYear)) * (width - 2 * padding);
                const y = height - padding - ((point.value - minValue) / valueRange) * (height - 2 * padding);

                ctx.beginPath();
                ctx.arc(x, y, 3, 0, 2 * Math.PI);
                ctx.fillStyle = trendColor;
                ctx.fill();
            });

            // Add tooltip on hover
            canvas.title = `@Localizer["Trend"]: ${dataPoints[0].value.toFixed(2)} → ${dataPoints[dataPoints.length - 1].value.toFixed(2)}`;
        }

        // =============================================
        // SORTING AND PAGINATION FUNCTIONALITY
        // =============================================

        // Pagination state
        let currentPage = 1;
        let pageSize = 25;
        let currentSortColumn = null;
        let currentSortDirection = 'asc';
        let allRows = [];
        let filteredRows = [];

        // Initialize sorting and pagination on page load
        document.addEventListener('DOMContentLoaded', function() {
            initializeSortingAndPagination();
        });

        function initializeSortingAndPagination() {
            // Store all original rows
            allRows = Array.from(document.querySelectorAll('.goal-row'));
            filteredRows = [...allRows];

            // Apply initial pagination
            applyPagination();
        }

        // Sorting function
        function sortTable(column) {
            // Determine sort direction
            if (currentSortColumn === column) {
                currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortColumn = column;
                currentSortDirection = 'asc';
            }

            // Update sort icons
            updateSortIcons(column, currentSortDirection);

            // Get visible (filtered) rows
            const visibleRows = filteredRows.filter(row => row.style.display !== 'none');

            // Sort the rows
            visibleRows.sort((a, b) => {
                let aValue, bValue;

                switch (column) {
                    case 'name':
                        aValue = a.getAttribute('data-goal-name-display') || '';
                        bValue = b.getAttribute('data-goal-name-display') || '';
                        break;
                    case 'framework':
                        aValue = a.getAttribute('data-framework-name') || '';
                        bValue = b.getAttribute('data-framework-name') || '';
                        break;
                    case 'discountRate':
                        aValue = parseFloat(a.getAttribute('data-discount-rate')) || 0;
                        bValue = parseFloat(b.getAttribute('data-discount-rate')) || 0;
                        return currentSortDirection === 'asc' ? aValue - bValue : bValue - aValue;
                    case 'progressRate':
                        aValue = parseFloat(a.getAttribute('data-progress-rate')) || 0;
                        bValue = parseFloat(b.getAttribute('data-progress-rate')) || 0;
                        return currentSortDirection === 'asc' ? aValue - bValue : bValue - aValue;
                    default:
                        aValue = '';
                        bValue = '';
                }

                // String comparison for text columns
                if (typeof aValue === 'string') {
                    const comparison = aValue.localeCompare(bValue, undefined, { sensitivity: 'base' });
                    return currentSortDirection === 'asc' ? comparison : -comparison;
                }

                return 0;
            });

            // Reorder rows in the DOM
            const tbody = document.querySelector('#goalsTable tbody');
            visibleRows.forEach(row => tbody.appendChild(row));

            // Update filteredRows to match the new order
            filteredRows = Array.from(document.querySelectorAll('.goal-row'));

            // Reset to page 1 after sorting
            currentPage = 1;
            applyPagination();
        }

        // Update sort icons in headers
        function updateSortIcons(activeColumn, direction) {
            // Reset all sort icons
            document.querySelectorAll('.sortable-header .sort-icon i').forEach(icon => {
                icon.className = 'fas fa-sort';
            });

            // Set active sort icon
            const activeHeader = document.querySelector(`.sortable-header[data-sort="${activeColumn}"] .sort-icon i`);
            if (activeHeader) {
                activeHeader.className = direction === 'asc' ? 'fas fa-sort-up' : 'fas fa-sort-down';
            }

            // Update header styles
            document.querySelectorAll('.sortable-header').forEach(header => {
                header.classList.remove('sorted-asc', 'sorted-desc');
            });
            const activeHeaderElement = document.querySelector(`.sortable-header[data-sort="${activeColumn}"]`);
            if (activeHeaderElement) {
                activeHeaderElement.classList.add(direction === 'asc' ? 'sorted-asc' : 'sorted-desc');
            }
        }

        // Client-side mirror of FrameworkGoal.FormatValue: appends the goal's unit to a raw
        // value. Ratios (progress rate) must NOT use this — they are always percentages.
        function formatWithUnit(value, displayUnit) {
            const unit = displayUnit || '%';
            return unit === '%' ? value.toFixed(2) + '%' : value.toFixed(2) + ' ' + unit;
        }

        // Reads the goal's unit off a table row, falling back to "%" for older markup
        function unitOfRow(row) {
            return (row && row.getAttribute('data-display-unit')) || '%';
        }

        // Single source of truth for the advanced filters, shared by pagination, the
        // results counter and the client-side exports.
        function rowPassesFilters(row) {
            const searchTerm = document.getElementById('searchGoal')?.value.toLowerCase().trim() || '';
            const frameworkFilter = document.getElementById('frameworkFilter')?.value || '';
            const statusFilter = document.getElementById('statusFilter')?.value || '';
            const progressRangeFilter = document.getElementById('progressRangeFilter')?.value || '';
            const goalTypeFilter = document.getElementById('goalTypeFilter')?.value || '';

            if (searchTerm && !row.getAttribute('data-goal-name').includes(searchTerm)) {
                return false;
            }
            if (frameworkFilter && row.getAttribute('data-framework-code') !== frameworkFilter) {
                return false;
            }
            if (statusFilter && row.getAttribute('data-status') !== statusFilter) {
                return false;
            }
            if (goalTypeFilter && row.getAttribute('data-goal-type') !== goalTypeFilter) {
                return false;
            }
            if (progressRangeFilter) {
                const progressRate = parseFloat(row.getAttribute('data-progress-rate'));
                const [min, max] = progressRangeFilter.split('-').map(v => v === '' ? Infinity : parseFloat(v.replace('+', '')));
                if (max === undefined || max === Infinity) {
                    if (progressRate < min) return false;
                } else {
                    if (progressRate < min || progressRate > max) return false;
                }
            }

            return true;
        }

        // Pagination function
        function applyPagination() {
            // Get visible rows (respecting filters)
            const visibleRows = filteredRows.filter(rowPassesFilters);

            const totalRows = visibleRows.length;
            const totalPages = pageSize === -1 ? 1 : Math.ceil(totalRows / pageSize);

            // Ensure current page is valid
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            // Calculate start and end indices
            const startIndex = pageSize === -1 ? 0 : (currentPage - 1) * pageSize;
            const endIndex = pageSize === -1 ? totalRows : Math.min(startIndex + pageSize, totalRows);

            // Hide all rows first
            filteredRows.forEach(row => row.style.display = 'none');

            // Show only rows for current page
            visibleRows.forEach((row, index) => {
                if (index >= startIndex && index < endIndex) {
                    row.style.display = '';
                }
            });

            // Update pagination info
            updatePaginationInfo(startIndex + 1, endIndex, totalRows);

            // Update pagination controls
            updatePaginationControls(totalPages);
        }

        // Update pagination info text
        function updatePaginationInfo(start, end, total) {
            const infoElement = document.getElementById('paginationInfo');
            if (infoElement) {
                if (total === 0) {
                    infoElement.textContent = '@Localizer["No goals to display"]';
                } else {
                    infoElement.textContent = `@Localizer["Showing"] ${start}-${end} @Localizer["of"] ${total} @Localizer["goals"]`;
                }
            }
        }

        // Update pagination controls
        function updatePaginationControls(totalPages) {
            const paginationList = document.getElementById('paginationControls');
            if (!paginationList) return;

            // Clear existing page numbers (keep prev/next)
            const pageItems = paginationList.querySelectorAll('.page-item:not(#prevPageItem):not(#nextPageItem)');
            pageItems.forEach(item => item.remove());

            // Get prev and next buttons
            const prevItem = document.getElementById('prevPageItem');
            const nextItem = document.getElementById('nextPageItem');

            // Update prev button state
            if (currentPage === 1) {
                prevItem.classList.add('disabled');
                prevItem.querySelector('a').setAttribute('tabindex', '-1');
            } else {
                prevItem.classList.remove('disabled');
                prevItem.querySelector('a').removeAttribute('tabindex');
            }

            // Update next button state
            if (currentPage === totalPages || totalPages === 0) {
                nextItem.classList.add('disabled');
                nextItem.querySelector('a').setAttribute('tabindex', '-1');
            } else {
                nextItem.classList.remove('disabled');
                nextItem.querySelector('a').removeAttribute('tabindex');
            }

            // Generate page numbers
            const maxVisiblePages = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
            let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

            if (endPage - startPage + 1 < maxVisiblePages) {
                startPage = Math.max(1, endPage - maxVisiblePages + 1);
            }

            // Add first page and ellipsis if needed
            if (startPage > 1) {
                insertPageItem(1, paginationList, nextItem);
                if (startPage > 2) {
                    insertEllipsis(paginationList, nextItem);
                }
            }

            // Add page numbers
            for (let i = startPage; i <= endPage; i++) {
                insertPageItem(i, paginationList, nextItem);
            }

            // Add last page and ellipsis if needed
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    insertEllipsis(paginationList, nextItem);
                }
                insertPageItem(totalPages, paginationList, nextItem);
            }
        }

        // Insert a page number item
        function insertPageItem(pageNum, container, beforeElement) {
            const li = document.createElement('li');
            li.className = `page-item ${pageNum === currentPage ? 'active' : ''}`;
            li.innerHTML = `<a class="page-link" href="#" onclick="goToPage(${pageNum}); return false;">${pageNum}</a>`;
            container.insertBefore(li, beforeElement);
        }

        // Insert ellipsis
        function insertEllipsis(container, beforeElement) {
            const li = document.createElement('li');
            li.className = 'page-item disabled';
            li.innerHTML = '<span class="page-link">...</span>';
            container.insertBefore(li, beforeElement);
        }

        // Go to specific page
        function goToPage(page) {
            const visibleRows = filteredRows.filter(row => row.style.display !== 'none' || true); // Get all that pass filter
            const totalPages = pageSize === -1 ? 1 : Math.ceil(getFilteredRowCount() / pageSize);

            if (page === 'prev') {
                currentPage = Math.max(1, currentPage - 1);
            } else if (page === 'next') {
                currentPage = Math.min(totalPages, currentPage + 1);
            } else {
                currentPage = parseInt(page);
            }

            applyPagination();
        }

        // Get count of rows that pass current filters
        function getFilteredRowCount() {
            return filteredRows.filter(rowPassesFilters).length;
        }

        // Change page size
        function changePageSize() {
            const select = document.getElementById('pageSizeSelect');
            pageSize = parseInt(select.value);
            currentPage = 1;
            applyPagination();
        }

