@model IEnumerable<MonitoringAndEvaluationPlatform.Models.FrameworkGoal>

@using MonitoringAndEvaluationPlatform.Helpers
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "Framework Goals";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var culture = Context.Features.Get<IRequestCultureFeature>().RequestCulture.Culture.Name;
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="dashboard-title">
                <i class="fas fa-bullseye me-3"></i>
                @Localizer["Framework Goals"]
            </h1>
            <p class="dashboard-subtitle">
                @Localizer["Manage goals and targets for monitoring frameworks"]
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="ValueProgressView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-primary btn-lg shadow-sm">
                <i class="fas fa-chart-bar me-2"></i>@Localizer["Value Progress"]
            </a>
            <a asp-action="StatusBadgesView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-success btn-lg shadow-sm">
                <i class="fas fa-tags me-2"></i>@Localizer["Status Badges"]
            </a>
            <a asp-action="MetricsGridView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-info btn-lg shadow-sm">
                <i class="fas fa-th me-2"></i>@Localizer["Metrics Grid"]
            </a>
            <a asp-action="TimelineView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-warning btn-lg shadow-sm">
                <i class="fas fa-project-diagram me-2"></i>@Localizer["Timeline View"]
            </a>
            <a asp-action="CircularGaugeView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-secondary btn-lg shadow-sm">
                <i class="fas fa-tachometer-alt me-2"></i>@Localizer["Circular Gauges"]
            </a>
            <a asp-action="ProgressView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-dark btn-lg shadow-sm">
                <i class="fas fa-chart-pie me-2"></i>@Localizer["Cards View"]
            </a>
            <a asp-action="ChartsView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-primary btn-lg shadow-sm">
                <i class="fas fa-chart-area me-2"></i>@Localizer["Performance Charts"]
            </a>
            @if (SignInManager.IsSignedIn(User))
            {
                var user = await UserManager.GetUserAsync(User);
                if (user != null)
                {
                    var roles = await UserManager.GetRolesAsync(user);
                    if (roles.Contains("SystemAdministrator"))
                    {
                        <button onclick="toggleInlineCreate()" class="btn btn-primary btn-lg shadow-sm" id="createGoalBtn">
                            <i class="fas fa-plus me-2"></i>@Localizer["Add New Goal"]
                        </button>
                    }
                }
            }
        </div>
    </div>
</div>

<!-- Advanced Filter Section -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
            <i class="fas fa-filter me-2"></i>@Localizer["Advanced Filters"]
        </h6>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetFilters()">
            <i class="fas fa-redo me-1"></i>@Localizer["Reset Filters"]
        </button>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <!-- Search Bar -->
            <div class="col-md-6 col-lg-3">
                <label class="form-label">
                    <i class="fas fa-search me-1"></i>@Localizer["Search Goal Name"]
                </label>
                <input type="text" id="searchGoal" class="form-control" placeholder="@Localizer["Type to search..."]" oninput="applyFilters()">
            </div>

            <!-- Framework Filter -->
            <div class="col-md-6 col-lg-3">
                <label class="form-label">
                    <i class="fas fa-folder me-1"></i>@Localizer["Framework"]
                </label>
                <select id="frameworkFilter" class="form-select" onchange="applyFilters()">
                    <option value="">@Localizer["All Frameworks"]</option>
                    @foreach (var framework in ViewBag.Frameworks)
                    {
                        <option value="@framework.Code">@framework.Name</option>
                    }
                </select>
            </div>

            <!-- Status Filter -->
            <div class="col-md-6 col-lg-3">
                <label class="form-label">
                    <i class="fas fa-signal me-1"></i>@Localizer["Status"]
                </label>
                <select id="statusFilter" class="form-select" onchange="applyFilters()">
                    <option value="">@Localizer["All Status"]</option>
                    <option value="on-track">@Localizer["On Track"]</option>
                    <option value="at-risk">@Localizer["At Risk"]</option>
                    <option value="off-track">@Localizer["Off Track"]</option>
                </select>
            </div>

            <!-- Progress Range Filter -->
            <div class="col-md-6 col-lg-3">
                <label class="form-label">
                    <i class="fas fa-percentage me-1"></i>@Localizer["Progress Range"]
                </label>
                <select id="progressRangeFilter" class="form-select" onchange="applyFilters()">
                    <option value="">@Localizer["All Progress"]</option>
                    <option value="0-25">0% - 25%</option>
                    <option value="25-50">25% - 50%</option>
                    <option value="50-75">50% - 75%</option>
                    <option value="75-100">75% - 100%</option>
                    <option value="100+">100%+</option>
                </select>
            </div>
        </div>

        <!-- Filter Results Counter -->
        <div class="mt-3">
            <div class="alert alert-info mb-0 py-2" id="filterResults" style="display: none;">
                <i class="fas fa-info-circle me-2"></i>
                <span id="filterResultsText"></span>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard Summary Cards -->
@if (Model.Any())
{
    var currentYear = DateTime.Now.Year;
    var totalGoals = Model.Count();

    // Calculate on-track vs off-track
    var onTrackCount = 0;
    var offTrackCount = 0;
    var totalProgressRate = 0.0;

    foreach (var goal in Model)
    {
        var isIncreaseGoal = goal.TargetValue > goal.BaseValueForStartingYear;
        var actualChange = goal.BaseValueForCurrentYear - goal.BaseValueForStartingYear;

        bool isOnTrack;
        if (isIncreaseGoal)
        {
            isOnTrack = actualChange >= goal.AmountOfReduction;
        }
        else
        {
            var actualReduction = goal.BaseValueForStartingYear - goal.BaseValueForCurrentYear;
            isOnTrack = actualReduction >= goal.AmountOfReduction;
        }

        if (isOnTrack)
        {
            onTrackCount++;
        }
        else
        {
            offTrackCount++;
        }

        totalProgressRate += goal.ProgressRate;
    }

    var onTrackPercentage = totalGoals > 0 ? (onTrackCount * 100.0 / totalGoals) : 0;
    var offTrackPercentage = totalGoals > 0 ? (offTrackCount * 100.0 / totalGoals) : 0;
    var averageProgressRate = totalGoals > 0 ? (totalProgressRate / totalGoals) : 0;

    // Calculate goals expiring soon (within 1 year)
    var goalsExpiringSoon = Model.Count(g => g.TargetYear - currentYear <= 1 && g.TargetYear >= currentYear);

    <div class="row g-3 mb-4">
        <!-- Total Goals Card -->
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-primary">
                <div class="summary-card-icon">
                    <i class="fas fa-bullseye"></i>
                </div>
                <div class="summary-card-content">
                    <h3 class="summary-card-value">@totalGoals</h3>
                    <p class="summary-card-label">@Localizer["Total Goals"]</p>
                </div>
            </div>
        </div>

        <!-- On-Track vs Off-Track Card -->
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-success">
                <div class="summary-card-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="summary-card-content">
                    <h3 class="summary-card-value">@onTrackCount / @offTrackCount</h3>
                    <p class="summary-card-label">@Localizer["On-Track / Off-Track"]</p>
                    <div class="progress mt-2" style="height: 8px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @onTrackPercentage.ToString("F0")%" aria-valuenow="@onTrackPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                        <div class="progress-bar bg-danger" role="progressbar" style="width: @offTrackPercentage.ToString("F0")%" aria-valuenow="@offTrackPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <small class="text-muted">@onTrackPercentage.ToString("F1")% on track</small>
                </div>
            </div>
        </div>

        <!-- Average Progress Rate Card -->
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-info">
                <div class="summary-card-icon">
                    <i class="fas fa-percentage"></i>
                </div>
                <div class="summary-card-content">
                    <h3 class="summary-card-value">@averageProgressRate.ToString("F1")%</h3>
                    <p class="summary-card-label">@Localizer["Average Progress"]</p>
                    <div class="progress mt-2" style="height: 8px;">
                        <div class="progress-bar bg-info" role="progressbar" style="width: @Math.Min(averageProgressRate, 100)%" aria-valuenow="@averageProgressRate" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Goals Expiring Soon Card -->
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-warning">
                <div class="summary-card-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="summary-card-content">
                    <h3 class="summary-card-value">@goalsExpiringSoon</h3>
                    <p class="summary-card-label">@Localizer["Expiring Soon"]</p>
                    <small class="text-muted">@Localizer["Within 1 year"]</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Smart Alerts Section -->
    // Calculate alerts
    var goalsFallingBehind = new List<dynamic>();
    var goalsNeedingUpdate = new List<dynamic>();
    var goalsReachingTarget = new List<dynamic>();

    foreach (var goal in Model)
        {
            var isIncreaseGoal = goal.TargetValue > goal.BaseValueForStartingYear;
            var actualChange = goal.BaseValueForCurrentYear - goal.BaseValueForStartingYear;

            // Calculate expected trajectory
            var expectedSlope = (goal.TargetValue - goal.BaseValueForStartingYear) / (goal.TargetYear - goal.StartingYear);
            var expectedCurrentValue = goal.BaseValueForStartingYear + (expectedSlope * (goal.CurrentYear - goal.StartingYear));

            // Check if falling behind
            bool isFallingBehind;
            if (isIncreaseGoal)
            {
                var expectedChange = expectedCurrentValue - goal.BaseValueForStartingYear;
                isFallingBehind = actualChange < expectedChange * 0.7;
            }
            else
            {
                var actualReduction = goal.BaseValueForStartingYear - goal.BaseValueForCurrentYear;
                var expectedReduction = goal.BaseValueForStartingYear - expectedCurrentValue;
                isFallingBehind = actualReduction < expectedReduction * 0.7;
            }

            if (isFallingBehind)
            {
                goalsFallingBehind.Add(new { Goal = goal, ProgressRate = goal.ProgressRate });
            }

            // Check if current year is outdated (more than 1 year old)
            if (goal.CurrentYear < currentYear)
            {
                goalsNeedingUpdate.Add(new { Goal = goal, YearsOutdated = currentYear - goal.CurrentYear });
            }

            // Check if reaching target soon (within 1 year)
            if (goal.TargetYear - currentYear <= 1 && goal.TargetYear >= currentYear)
            {
                goalsReachingTarget.Add(new { Goal = goal, YearsRemaining = goal.TargetYear - currentYear });
            }
        }

    var totalAlerts = goalsFallingBehind.Count + goalsNeedingUpdate.Count + goalsReachingTarget.Count;

    @if (totalAlerts > 0)
    {
        <div class="card shadow-sm mb-4 alert-card">
            <div class="card-header bg-warning bg-opacity-10 border-warning" style="cursor: pointer;" onclick="toggleSmartAlerts()">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                        @Localizer["Smart Alerts"]
                        <span class="badge bg-warning text-dark ms-2">@totalAlerts</span>
                    </h6>
                    <i class="fas fa-chevron-down" id="alertsChevron"></i>
                </div>
            </div>
            <div class="card-body" id="smartAlertsBody" style="display: none;">
                <div class="row g-3">
                    <!-- Goals Falling Behind -->
                    @if (goalsFallingBehind.Any())
                    {
                        <div class="col-12">
                            <div class="alert alert-danger mb-0">
                                <h6 class="alert-heading">
                                    <i class="fas fa-chart-line-down me-2"></i>
                                    @Localizer["Goals Falling Behind"]
                                    <span class="badge bg-danger ms-2">@goalsFallingBehind.Count</span>
                                </h6>
                                <hr>
                                <ul class="mb-0">
                                    @foreach (var item in goalsFallingBehind)
                                    {
                                        <li>
                                            <strong>@item.Goal.Name</strong>
                                            <span class="text-muted">(@item.Goal.Framework.Name)</span>
                                            - Progress: <span class="badge bg-danger">@item.ProgressRate.ToString("N1")%</span>
                                            <a href="@Url.Action("FrameworkGoalsTimeline", "Dashboard", new { goalId = item.Goal.ID, frameworkCode = item.Goal.FrameworkCode })" class="btn btn-sm btn-outline-danger ms-2">
                                                <i class="fas fa-chart-line"></i> @Localizer["View"]
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    <!-- Goals Needing Update -->
                    @if (goalsNeedingUpdate.Any())
                    {
                        <div class="col-12">
                            <div class="alert alert-warning mb-0">
                                <h6 class="alert-heading">
                                    <i class="fas fa-calendar-exclamation me-2"></i>
                                    @Localizer["Goals Needing Update"]
                                    <span class="badge bg-warning text-dark ms-2">@goalsNeedingUpdate.Count</span>
                                </h6>
                                <hr>
                                <ul class="mb-0">
                                    @foreach (var item in goalsNeedingUpdate)
                                    {
                                        <li>
                                            <strong>@item.Goal.Name</strong>
                                            <span class="text-muted">(@item.Goal.Framework.Name)</span>
                                            - Current Year: <span class="badge bg-warning text-dark">@item.Goal.CurrentYear</span>
                                            <span class="text-danger">(@item.YearsOutdated @Localizer["years outdated"])</span>
                                            @if (SignInManager.IsSignedIn(User))
                                            {
                                                var user = await UserManager.GetUserAsync(User);
                                                if (user != null)
                                                {
                                                    var roles = await UserManager.GetRolesAsync(user);
                                                    if (roles.Contains("SystemAdministrator"))
                                                    {
                                                        <button onclick="showEditModal(@item.Goal.ID, @item.Goal.CurrentYear, @item.Goal.BaseValueForCurrentYear.ToString(System.Globalization.CultureInfo.InvariantCulture), @item.Goal.StartingYear, @item.Goal.TargetYear)" class="btn btn-sm btn-outline-warning ms-2">
                                                            <i class="fas fa-edit"></i> @Localizer["Update"]
                                                        </button>
                                                    }
                                                }
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    <!-- Goals Reaching Target Soon -->
                    @if (goalsReachingTarget.Any())
                    {
                        <div class="col-12">
                            <div class="alert alert-info mb-0">
                                <h6 class="alert-heading">
                                    <i class="fas fa-flag-checkered me-2"></i>
                                    @Localizer["Goals Reaching Target Soon"]
                                    <span class="badge bg-info ms-2">@goalsReachingTarget.Count</span>
                                </h6>
                                <hr>
                                <ul class="mb-0">
                                    @foreach (var item in goalsReachingTarget)
                                    {
                                        <li>
                                            <strong>@item.Goal.Name</strong>
                                            <span class="text-muted">(@item.Goal.Framework.Name)</span>
                                            - Target Year: <span class="badge bg-info">@item.Goal.TargetYear</span>
                                            @if (item.YearsRemaining == 0)
                                            {
                                                <span class="text-danger fw-bold">(@Localizer["This year"]!)</span>
                                            }
                                            else
                                            {
                                                <span class="text-info">(@item.YearsRemaining @Localizer["year remaining"])</span>
                                            }
                                            <a href="@Url.Action("FrameworkGoalsTimeline", "Dashboard", new { goalId = item.Goal.ID, frameworkCode = item.Goal.FrameworkCode })" class="btn btn-sm btn-outline-info ms-2">
                                                <i class="fas fa-chart-line"></i> @Localizer["View"]
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

<!-- Inline Create Form (Initially Hidden) -->
<div id="inlineCreateForm" class="card shadow-sm mb-4" style="display: none;">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="fas fa-plus-circle me-2"></i>@Localizer["Create New Framework Goal"]
        </h5>
    </div>
    <div class="card-body">
        <form id="createGoalForm">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Localizer["Goal Name"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="goalName" name="Name" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Localizer["Framework"] <span class="text-danger">*</span></label>
                    <select class="form-select" id="frameworkCode" name="FrameworkCode" required>
                        <option value="">@Localizer["Select Framework"]</option>
                        @foreach (var framework in ViewBag.Frameworks)
                        {
                            <option value="@framework.Code">@framework.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Starting Year"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control year-picker" id="startingYear" name="StartingYear" required readonly placeholder="@Localizer["Select Year"]" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Base Value (Starting)"] <span class="text-danger">*</span></label>
                    <input type="text" inputmode="decimal" class="form-control decimal-input" id="baseValueStarting" name="BaseValueForStartingYear" required placeholder="0.00" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Current Year"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control year-picker" id="currentYear" name="CurrentYear" required readonly placeholder="@Localizer["Select Year"]" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Base Value (Current)"] <span class="text-danger">*</span></label>
                    <input type="text" inputmode="decimal" class="form-control decimal-input" id="baseValueCurrent" name="BaseValueForCurrentYear" required placeholder="0.00" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Target Year"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control year-picker" id="targetYear" name="TargetYear" required readonly placeholder="@Localizer["Select Year"]" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Target Value"] <span class="text-danger">*</span></label>
                    <input type="text" inputmode="decimal" class="form-control decimal-input" id="targetValue" name="TargetValue" required placeholder="0.00" />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save me-2"></i>@Localizer["Save Goal"]
                </button>
                <button type="button" class="btn btn-secondary" onclick="toggleInlineCreate()">
                    <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Goals Table -->
<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0">@Localizer["Framework Goals List"]</h5>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <!-- Export Buttons -->
            <div class="btn-group export-btn-group" role="group" aria-label="Export options">
                <button type="button" class="btn btn-outline-success btn-sm" onclick="exportToExcel()" title="@Localizer["Export to Excel"]">
                    <i class="fas fa-file-excel me-1"></i>Excel
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="exportToCSV()" title="@Localizer["Export to CSV"]">
                    <i class="fas fa-file-csv me-1"></i>CSV
                </button>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="exportToPDF()" title="@Localizer["Export to PDF"]">
                    <i class="fas fa-file-pdf me-1"></i>PDF
                </button>
            </div>
            <!-- Page Size Selector -->
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 text-muted small">@Localizer["Show"]</label>
                <select id="pageSizeSelect" class="form-select form-select-sm" style="width: auto;" onchange="changePageSize()">
                    <option value="10">10</option>
                    <option value="25" selected>25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="-1">@Localizer["All"]</option>
                </select>
                <label class="form-label mb-0 text-muted small">@Localizer["entries"]</label>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover" id="goalsTable">
                    <thead class="table-primary bg-opacity-25">
                        <tr>
                            <th rowspan="2" class="align-middle sortable-header" data-sort="name" onclick="sortTable('name')">
                                @Localizer["Goal Name"]
                                <span class="sort-icon"><i class="fas fa-sort"></i></span>
                            </th>
                            <th rowspan="2" class="align-middle sortable-header" data-sort="framework" onclick="sortTable('framework')">
                                @Localizer["Framework"]
                                <span class="sort-icon"><i class="fas fa-sort"></i></span>
                            </th>
                            <th rowspan="2" class="align-middle text-center">@Localizer["Trend"]</th>
                            @{
                                // Calculate the full year range across ALL goals
                                int minYear = Model.Any() ? Model.Min(g => g.StartingYear) : DateTime.Now.Year;
                                int maxYear = Model.Any() ? Model.Max(g => g.TargetYear) : DateTime.Now.Year;

                                for (int year = minYear; year <= maxYear; year++)
                                {
                                    <th colspan="2" class="text-center year-header">@year</th>
                                }
                            }
                            <th rowspan="2" class="align-middle sortable-header" data-sort="discountRate" onclick="sortTable('discountRate')">
                                @Localizer["Annual Discount Rate"]
                                <span class="sort-icon"><i class="fas fa-sort"></i></span>
                            </th>
                            <th rowspan="2" class="align-middle sortable-header" data-sort="progressRate" onclick="sortTable('progressRate')">
                                @Localizer["Progress Rate"]
                                <span class="sort-icon"><i class="fas fa-sort"></i></span>
                            </th>
                            <th rowspan="2" class="align-middle text-center">@Localizer["Actions"]</th>
                        </tr>
                        <tr>
                            @{
                                for (int year = minYear; year <= maxYear; year++)
                                {
                                    <th class="text-center sub-header">@Localizer["Base Value"]</th>
                                    <th class="text-center sub-header">@Localizer["Expected Target"]</th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var goal in Model)
                        {
                            // Calculate status for filtering
                            var isIncreaseGoalFilter = goal.TargetValue > goal.BaseValueForStartingYear;
                            var actualChangeFilter = goal.BaseValueForCurrentYear - goal.BaseValueForStartingYear;

                                // Calculate expected trajectory
                                var expectedSlope = (goal.TargetValue - goal.BaseValueForStartingYear) / (goal.TargetYear - goal.StartingYear);
                                var expectedCurrentValue = goal.BaseValueForStartingYear + (expectedSlope * (goal.CurrentYear - goal.StartingYear));

                                string goalStatus;
                                if (isIncreaseGoalFilter)
                                {
                                    var expectedChange = expectedCurrentValue - goal.BaseValueForStartingYear;
                                    if (actualChangeFilter >= expectedChange * 0.95)
                                    {
                                        goalStatus = "on-track";
                                    }
                                    else if (actualChangeFilter >= expectedChange * 0.7)
                                    {
                                        goalStatus = "at-risk";
                                    }
                                    else
                                    {
                                        goalStatus = "off-track";
                                    }
                                }
                                else
                                {
                                    var actualReduction = goal.BaseValueForStartingYear - goal.BaseValueForCurrentYear;
                                    var expectedReduction = goal.BaseValueForStartingYear - expectedCurrentValue;
                                    if (actualReduction >= expectedReduction * 0.95)
                                    {
                                        goalStatus = "on-track";
                                    }
                                    else if (actualReduction >= expectedReduction * 0.7)
                                    {
                                        goalStatus = "at-risk";
                                    }
                                    else
                                    {
                                        goalStatus = "off-track";
                                    }
                                }

                            <tr id="goal-row-@goal.ID"
                                class="goal-row"
                                data-goal-name="@goal.Name.ToLower()"
                                data-goal-name-display="@goal.Name"
                                data-framework-code="@goal.FrameworkCode"
                                data-framework-name="@goal.Framework.Name"
                                data-progress-rate="@goal.ProgressRate"
                                data-discount-rate="@goal.AnnualDiscountRate"
                                data-status="@goalStatus"
                                data-starting-year="@goal.StartingYear"
                                data-target-year="@goal.TargetYear">
                                <td><strong>@goal.Name</strong></td>
                                <td>
                                    <span class="badge bg-info">@goal.Framework.Name</span>
                                </td>
                                <td class="text-center sparkline-cell">
                                    <canvas class="sparkline-canvas"
                                            data-goal-id="@goal.ID"
                                            data-starting-year="@goal.StartingYear"
                                            data-current-year="@goal.CurrentYear"
                                            data-target-year="@goal.TargetYear"
                                            data-starting-value="@goal.BaseValueForStartingYear"
                                            data-current-value="@goal.BaseValueForCurrentYear"
                                            data-target-value="@goal.TargetValue"
                                            data-is-increase="@(goal.TargetValue > goal.BaseValueForStartingYear ? "true" : "false")"
                                            width="120"
                                            height="40">
                                    </canvas>
                                </td>
                                @{
                                    // Generate data cells for each year in the full range
                                    for (int year = minYear; year <= maxYear; year++)
                                    {
                                        // Check if this year is within this goal's range
                                        bool isInGoalRange = year >= goal.StartingYear && year <= goal.TargetYear;

                                        if (isInGoalRange)
                                        {
                                            var baseValue = goal.GetBaseValueForYear(year);
                                            var expectedTarget = goal.GetExpectedTargetValueForYear(year);
                                            var isCurrentYear = year == goal.CurrentYear;
                                            var isStartingYear = year == goal.StartingYear;
                                            var isTargetYear = year == goal.TargetYear;

                                            // Base Value cell
                                            <td class="text-center @(isCurrentYear ? "bg-light-current" : "")">
                                                @if (isStartingYear)
                                                {
                                                    <strong class="text-primary">@(baseValue.ToString("N2"))%</strong>
                                                }
                                                else if (isCurrentYear)
                                                {
                                                    <strong class="text-success">@(baseValue.ToString("N2"))%</strong>
                                                }
                                                else if (baseValue > 0)
                                                {
                                                    <text>@(baseValue.ToString("N2"))%</text>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>

                                            // Expected Target / Target Value cell
                                            <td class="text-center @(isCurrentYear ? "bg-light-current" : "")">
                                                @if (isTargetYear)
                                                {
                                                    <strong class="text-danger">@(goal.TargetValue.ToString("N2"))%</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-info">@(expectedTarget.ToString("N2"))%</span>
                                                }
                                            </td>
                                        }
                                        else
                                        {
                                            // Year is outside this goal's range - show empty cells
                                            <td class="text-center bg-light">
                                                <span class="text-muted">-</span>
                                            </td>
                                            <td class="text-center bg-light">
                                                <span class="text-muted">-</span>
                                            </td>
                                        }
                                    }
                                }
                                <td class="text-center">
                                    <strong class="text-primary">@(goal.AnnualDiscountRate.ToString("N2"))%</strong>
                                </td>
                                <td class="text-center">
                                    @{
                                        // Determine if this is an increase or decrease goal
                                        var isIncreaseGoal = goal.TargetValue > goal.BaseValueForStartingYear;
                                        var actualChange = goal.BaseValueForCurrentYear - goal.BaseValueForStartingYear;

                                        bool isOnTrack;
                                        if (isIncreaseGoal)
                                        {
                                            // For increase goals: green if actual increase >= expected increase
                                            isOnTrack = actualChange >= goal.AmountOfReduction;
                                        }
                                        else
                                        {
                                            // For decrease goals: green if actual reduction >= expected reduction
                                            var actualReduction = goal.BaseValueForStartingYear - goal.BaseValueForCurrentYear;
                                            isOnTrack = actualReduction >= goal.AmountOfReduction;
                                        }

                                        var badgeClass = isOnTrack ? "bg-success" : "bg-danger";
                                    }
                                    <span class="badge @badgeClass fs-6">
                                        @goal.ProgressRate.ToString("N2")%
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("FrameworkGoalsTimeline", "Dashboard", new { goalId = goal.ID, frameworkCode = goal.FrameworkCode })"
                                       class="btn btn-sm btn-info text-white me-2"
                                       title="@Localizer["View Timeline Chart"]">
                                        <i class="fas fa-chart-line"></i>
                                    </a>
                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        var user = await UserManager.GetUserAsync(User);
                                        if (user != null)
                                        {
                                            var roles = await UserManager.GetRolesAsync(user);
                                            if (roles.Contains("SystemAdministrator"))
                                            {
                                                <button onclick="showEditModal(@goal.ID, @goal.CurrentYear, @goal.BaseValueForCurrentYear.ToString(System.Globalization.CultureInfo.InvariantCulture), @goal.StartingYear, @goal.TargetYear)"
                                                        class="btn btn-sm btn-warning me-2"
                                                        title="@Localizer["Update Current Year"]">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button onclick="deleteGoal(@goal.ID)" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-3">
                <div class="pagination-info text-muted">
                    <span id="paginationInfo">@Localizer["Showing"] 1-@Math.Min(25, Model.Count()) @Localizer["of"] @Model.Count() @Localizer["goals"]</span>
                </div>
                <nav aria-label="Goals pagination">
                    <ul class="pagination mb-0" id="paginationControls">
                        <li class="page-item disabled" id="prevPageItem">
                            <a class="page-link" href="#" onclick="goToPage('prev'); return false;" tabindex="-1">
                                <i class="fas fa-chevron-left me-1"></i>@Localizer["Previous"]
                            </a>
                        </li>
                        <li class="page-item active"><a class="page-link" href="#" onclick="goToPage(1); return false;">1</a></li>
                        <li class="page-item" id="nextPageItem">
                            <a class="page-link" href="#" onclick="goToPage('next'); return false;">
                                @Localizer["Next"]<i class="fas fa-chevron-right ms-1"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">@Localizer["No goals found. Create your first goal to get started!"]</p>
            </div>
        }
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editModalLabel">
                    <i class="fas fa-edit me-2"></i>@Localizer["Update Goal Values"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editGoalId" />
                    <input type="hidden" id="editStartingYear" />
                    <input type="hidden" id="editTargetYear" />

                    <div class="mb-3">
                        <label class="form-label">@Localizer["Current Year"] <span class="text-danger">*</span></label>
                        <input type="text" class="form-control year-picker" id="editCurrentYear" required readonly placeholder="@Localizer["Select Year"]" />
                        <small class="form-text text-muted">@Localizer["Update this when the year changes"]</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Localizer["Base Value (Current)"] <span class="text-danger">*</span></label>
                        <input type="text" inputmode="decimal" class="form-control decimal-input" id="editBaseValue" required placeholder="0.00" />
                        <small class="form-text text-muted">@Localizer["Enter the actual achieved value for the current year"]</small>
                    </div>
                </form>

                <!-- Historical Values Section -->
                <div class="mt-4">
                    <h6 class="mb-3">
                        <i class="fas fa-history me-2"></i>@Localizer["Historical Values"]
                    </h6>
                    <div id="historicalValuesContainer">
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-spinner fa-spin me-2"></i>@Localizer["Loading..."]
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                </button>
                <button type="button" class="btn btn-primary" onclick="submitEdit()">
                    <i class="fas fa-save me-2"></i>@Localizer["Update"]
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>@Localizer["Delete"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3">
                    <i class="fas fa-trash-alt text-danger" style="font-size: 3rem;"></i>
                </div>
                <h5 class="mb-3">@Localizer["Are you sure you want to delete this goal?"]</h5>
                <p class="text-muted mb-0">@Localizer["This action cannot be undone."]</p>
                <input type="hidden" id="deleteGoalId" />
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                </button>
                <button type="button" class="btn btn-danger px-4" onclick="confirmDelete()">
                    <i class="fas fa-trash me-2"></i>@Localizer["Delete"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SheetJS for Excel Export -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
    <!-- jsPDF for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <!-- html2canvas for PDF Arabic support -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        // Initialize year pickers with default values
        document.addEventListener('DOMContentLoaded', function() {
            const currentYear = new Date().getFullYear();

            // Set default values
            document.getElementById('startingYear').value = currentYear - 1;
            document.getElementById('currentYear').value = currentYear;
            document.getElementById('targetYear').value = currentYear + 1;

            // Initialize year pickers
            initializeYearPickers();

            // Initialize decimal input handling
            initializeDecimalInputs();

            // Initialize sparklines
            initializeSparklines();
        });

        // Initialize decimal inputs to allow both comma and period as decimal separators
        function initializeDecimalInputs() {
            document.querySelectorAll('.decimal-input').forEach(input => {
                // Allow only numbers, comma, period, and minus sign
                input.addEventListener('input', function(e) {
                    // Replace comma with period for consistent display
                    let value = this.value;
                    // Allow digits, one decimal separator (comma or period), and optional minus at start
                    value = value.replace(/[^0-9.,-]/g, '');
                    this.value = value;
                });
            });
        }

        // Year picker functionality
        function initializeYearPickers() {
            const yearPickers = document.querySelectorAll('.year-picker');

            yearPickers.forEach(picker => {
                picker.addEventListener('click', function() {
                    showYearPicker(this);
                });
            });
        }

        let currentPickerYear = new Date().getFullYear();
        let activeInput = null;

        function showYearPicker(inputElement) {
            activeInput = inputElement;

            // Set initial year based on input value or current year
            if (inputElement.value) {
                currentPickerYear = parseInt(inputElement.value);
            } else {
                currentPickerYear = new Date().getFullYear();
            }

            // Create modal HTML
            const modalHtml = `
                <div class="year-picker-modal" id="yearPickerModal">
                    <div class="year-picker-content">
                        <div class="year-picker-header">
                            <h5>@Localizer["Select Year"]</h5>
                            <button type="button" class="btn-close-year" onclick="closeYearPicker()">&times;</button>
                        </div>
                        <div class="year-picker-navigation">
                            <button type="button" class="nav-btn" onclick="navigateYears(-10)">
                                <i class="fas fa-chevron-left"></i> @Localizer["Previous"]
                            </button>
                            <span class="year-range" id="yearRange"></span>
                            <button type="button" class="nav-btn" onclick="navigateYears(10)">
                                @Localizer["Next"] <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                        <div class="year-picker-body">
                            <div class="years-grid" id="yearsGrid"></div>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            const existingModal = document.getElementById('yearPickerModal');
            if (existingModal) {
                existingModal.remove();
            }

            // Add modal to body
            document.body.insertAdjacentHTML('beforeend', modalHtml);

            // Render years
            renderYears();
        }

        function renderYears() {
            const yearsGrid = document.getElementById('yearsGrid');
            const yearRange = document.getElementById('yearRange');
            const currentYear = new Date().getFullYear();

            // Calculate start year (rounded down to nearest 10)
            const startYear = Math.floor(currentPickerYear / 10) * 10;
            const endYear = startYear + 9;

            // Update range display
            yearRange.textContent = `${startYear} - ${endYear}`;

            // Clear grid
            yearsGrid.innerHTML = '';

            // Populate years grid
            for (let year = startYear; year <= endYear; year++) {
                const yearBtn = document.createElement('button');
                yearBtn.type = 'button';
                yearBtn.className = 'year-item';
                yearBtn.textContent = year;

                if (year == currentYear) {
                    yearBtn.classList.add('current-year');
                }

                if (activeInput && activeInput.value == year) {
                    yearBtn.classList.add('selected-year');
                }

                yearBtn.addEventListener('click', function() {
                    activeInput.value = year;
                    closeYearPicker();
                });

                yearsGrid.appendChild(yearBtn);
            }
        }

        function navigateYears(offset) {
            currentPickerYear += offset;
            renderYears();
        }

        function closeYearPicker() {
            const modal = document.getElementById('yearPickerModal');
            if (modal) {
                modal.remove();
            }
        }

        // Close modal when clicking outside
        document.addEventListener('click', function(e) {
            const modal = document.getElementById('yearPickerModal');
            if (modal && e.target === modal) {
                closeYearPicker();
            }
        });

        // Toggle inline create form
        function toggleInlineCreate() {
            const form = document.getElementById('inlineCreateForm');
            const btn = document.getElementById('createGoalBtn');

            if (form.style.display === 'none') {
                form.style.display = 'block';
                btn.innerHTML = '<i class="fas fa-times me-2"></i>@Localizer["Cancel"]';
                form.scrollIntoView({ behavior: 'smooth' });

                // Reset year values to defaults
                const currentYear = new Date().getFullYear();
                document.getElementById('startingYear').value = currentYear - 1;
                document.getElementById('currentYear').value = currentYear;
                document.getElementById('targetYear').value = currentYear + 1;
            } else {
                form.style.display = 'none';
                btn.innerHTML = '<i class="fas fa-plus me-2"></i>@Localizer["Add New Goal"]';
                document.getElementById('createGoalForm').reset();
            }
        }

        // Helper function to normalize decimal values (convert comma to period)
        function normalizeDecimal(value) {
            if (typeof value === 'string') {
                return value.replace(',', '.');
            }
            return value;
        }

        // Handle form submission
        document.getElementById('createGoalForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Get and normalize values
            const name = document.getElementById('goalName').value.trim();
            const frameworkCode = document.getElementById('frameworkCode').value;
            const startingYear = document.getElementById('startingYear').value;
            const baseValueStarting = normalizeDecimal(document.getElementById('baseValueStarting').value);
            const currentYear = document.getElementById('currentYear').value;
            const baseValueCurrent = normalizeDecimal(document.getElementById('baseValueCurrent').value);
            const targetYear = document.getElementById('targetYear').value;
            const targetValue = normalizeDecimal(document.getElementById('targetValue').value);

            // Client-side validation
            if (!name || !frameworkCode || !startingYear || !baseValueStarting || !currentYear || !baseValueCurrent || !targetYear || !targetValue) {
                showErrorMessage('@Localizer["Please fill in all required fields."]');
                return;
            }

            // Validate decimal values
            if (isNaN(parseFloat(baseValueStarting)) || isNaN(parseFloat(baseValueCurrent)) || isNaN(parseFloat(targetValue))) {
                showErrorMessage('@Localizer["Please enter valid numeric values."]');
                return;
            }

            // Create FormData for form-encoded submission
            const formData = new FormData();
            formData.append('Name', name);
            formData.append('FrameworkCode', frameworkCode);
            formData.append('StartingYear', startingYear);
            formData.append('BaseValueForStartingYear', baseValueStarting);
            formData.append('CurrentYear', currentYear);
            formData.append('BaseValueForCurrentYear', baseValueCurrent);
            formData.append('TargetYear', targetYear);
            formData.append('TargetValue', targetValue);
            formData.append('__RequestVerificationToken', token);

            // Debug logging
            console.log('Submitting form with values:', {
                name, frameworkCode, startingYear, baseValueStarting,
                currentYear, baseValueCurrent, targetYear, targetValue
            });

            try {
                const response = await fetch('@Url.Action("CreateInline", "FrameworkGoals")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                console.log('Server response:', result);

                if (result.success) {
                    // Show success message
                    showSuccessMessage(result.message || '@Localizer["Goal created successfully!"]');

                    // Reload the page to show the new goal
                    setTimeout(() => location.reload(), 1500);
                } else {
                    // Log validation errors if present
                    if (result.validationErrors) {
                        console.log('Validation errors:', result.validationErrors);
                    }

                    // Handle error message
                    let errorMessage = result.message || '@Localizer["An error occurred. Please try again."]';
                    showErrorMessage(errorMessage);
                }
            } catch (error) {
                console.error('Error:', error);
                showErrorMessage('@Localizer["An error occurred. Please try again."]');
            }
        });

        // Show edit modal
        async function showEditModal(goalId, currentYear, baseValue, startingYear, targetYear) {
            // Set hidden fields
            document.getElementById('editGoalId').value = goalId;
            document.getElementById('editStartingYear').value = startingYear;
            document.getElementById('editTargetYear').value = targetYear;

            // Set form values
            document.getElementById('editCurrentYear').value = currentYear;
            document.getElementById('editBaseValue').value = baseValue;

            // Load historical values
            await loadHistoricalValues(goalId);

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }

        // Load historical values for the goal
        async function loadHistoricalValues(goalId) {
            try {
                const response = await fetch(`@Url.Action("GetYearlyValues", "FrameworkGoals")?goalId=${goalId}`);
                const result = await response.json();

                if (result.success) {
                    displayHistoricalValues(result.yearlyValues, result.startingYear, result.baseValueForStartingYear, result.currentYear, result.targetYear, goalId);
                } else {
                    document.getElementById('historicalValuesContainer').innerHTML = `
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>${result.message}
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error loading historical values:', error);
                document.getElementById('historicalValuesContainer').innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fas fa-times-circle me-2"></i>@Localizer["An error occurred while loading historical values."]
                    </div>
                `;
            }
        }

        // Display historical values table with editable fields
        function displayHistoricalValues(yearlyValues, startingYear, baseValueForStartingYear, currentYear, targetYear, goalId) {
            let tableHtml = `
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 30%;">@Localizer["Year"]</th>
                                <th style="width: 50%;">@Localizer["Actual Value"]</th>
                                <th style="width: 20%;" class="text-center">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            // Generate rows for all years between starting and current year (excluding current year which is above)
            for (let year = startingYear; year < currentYear; year++) {
                const isStartingYear = year === startingYear;

                // For starting year, use the baseValueForStartingYear; for others, look in yearlyValues
                let value = '';
                let dateRecorded = '-';

                if (isStartingYear) {
                    value = baseValueForStartingYear ? baseValueForStartingYear.toFixed(2) : '';
                } else {
                    const existingValue = yearlyValues.find(yv => yv.year === year);
                    value = existingValue ? existingValue.value.toFixed(2) : '';
                    dateRecorded = existingValue ? existingValue.dateRecorded : '-';
                }

                tableHtml += `
                    <tr>
                        <td class="align-middle">
                            <strong class="${isStartingYear ? 'text-primary' : ''}">${year}</strong>
                            ${isStartingYear ? '<small class="text-muted d-block">(@Localizer["Starting Year"])</small>' : ''}
                        </td>
                        <td>
                            <input type="text"
                                   inputmode="decimal"
                                   class="form-control form-control-sm historical-value-input decimal-input"
                                   data-year="${year}"
                                   value="${value}"
                                   placeholder="@Localizer["Enter value"]"
                                   ${isStartingYear ? '' : ''}>
                        </td>
                        <td class="text-center align-middle">
                            <small class="text-muted">${dateRecorded}</small>
                        </td>
                    </tr>
                `;
            }

            if (startingYear >= currentYear) {
                tableHtml += `
                    <tr>
                        <td colspan="3" class="text-center text-muted py-3">
                            <i class="fas fa-info-circle me-2"></i>@Localizer["No previous years to update."]
                        </td>
                    </tr>
                `;
            }

            tableHtml += `
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-info mt-3">
                    <i class="fas fa-info-circle me-2"></i>
                    @Localizer["Update historical values to recalculate all associated metrics automatically."]
                </div>
            `;

            document.getElementById('historicalValuesContainer').innerHTML = tableHtml;
        }

        // Submit edit form
        async function submitEdit() {
            const goalId = document.getElementById('editGoalId').value;
            const currentYear = document.getElementById('editCurrentYear').value;
            const baseValue = normalizeDecimal(document.getElementById('editBaseValue').value);

            if (!currentYear || !baseValue) {
                showErrorMessage('@Localizer["Please fill in all required fields."]');
                return;
            }

            const token = document.querySelector('#editForm input[name="__RequestVerificationToken"]').value;

            // Collect all historical values (normalize decimal values)
            const historicalValues = [];
            document.querySelectorAll('.historical-value-input').forEach(input => {
                const year = parseInt(input.getAttribute('data-year'));
                const normalizedValue = normalizeDecimal(input.value);
                const value = parseFloat(normalizedValue);
                if (!isNaN(value) && normalizedValue !== '') {
                    historicalValues.push({ year, value });
                }
            });

            // Prepare data to send
            const data = {
                id: goalId,
                currentYear: parseInt(currentYear),
                baseValueForCurrentYear: parseFloat(baseValue),
                yearlyValues: historicalValues
            };

            try {
                const response = await fetch('@Url.Action("UpdateGoalValues", "FrameworkGoals")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('editModal'));
                    modal.hide();

                    // Show success message
                    showSuccessMessage(result.message);

                    // Reload page to show updated values
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showErrorMessage(result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showErrorMessage('@Localizer["An error occurred. Please try again."]');
            }
        }

