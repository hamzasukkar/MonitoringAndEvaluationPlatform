            const targetValue = parseFloat(row.getAttribute('data-target-value'));
            const amountOfReduction = parseFloat(row.getAttribute('data-amount-of-reduction'));
            const isIncreaseGoal = row.getAttribute('data-is-increase-goal') === 'true';
            const timelineUrl = row.getAttribute('data-timeline-url');

            // Raw values carry the goal's unit; ratios stay percentages
            const displayUnit = unitOfRow(row);
            const isQuantitative = row.getAttribute('data-goal-type') === '1';
            const fmt = v => formatWithUnit(v, displayUnit);

            // Populate header
            document.getElementById('sidebarGoalName').textContent = goalName;
            document.getElementById('sidebarFrameworkBadge').textContent = frameworkName;

            const goalTypeBadge = document.getElementById('sidebarGoalTypeBadge');
            goalTypeBadge.textContent = row.getAttribute('data-goal-type-label')
                + (isQuantitative ? ' · ' + displayUnit : '');
            goalTypeBadge.className = 'badge goal-type-badge '
                + (isQuantitative ? 'goal-type-quantitative' : 'goal-type-qualitative');

            // Status badge
            const statusBadge = document.getElementById('sidebarStatusBadge');
            const statusTextMap = {
                'on-track': '@Localizer["On Track"]',
                'at-risk': '@Localizer["At Risk"]',
                'off-track': '@Localizer["Off Track"]'
            };
            statusBadge.textContent = statusTextMap[status] || status.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase());
            statusBadge.className = 'badge ' + getStatusBadgeClass(status);

            // Progress circle
            const progressValue = Math.min(Math.max(progressRate, 0), 100);
            const circumference = 2 * Math.PI * 45;
            const offset = circumference - (progressValue / 100) * circumference;
            const progressCircleFill = document.getElementById('sidebarProgressCircleFill');
            progressCircleFill.style.strokeDasharray = circumference;
            progressCircleFill.style.strokeDashoffset = offset;
            progressCircleFill.style.stroke = getProgressColor(progressRate, status);
            document.getElementById('sidebarProgressValue').textContent = progressRate.toFixed(1) + '%';

            // Goal type, discount rate, years left
            document.getElementById('sidebarGoalType').textContent = isIncreaseGoal ? '@Localizer["Increase"]' : '@Localizer["Decrease"]';
            document.getElementById('sidebarGoalType').className = isIncreaseGoal ? 'text-success' : 'text-danger';
            document.getElementById('sidebarDiscountRate').textContent = fmt(discountRate) + '@Localizer["/year"]';

            const currentCalendarYear = new Date().getFullYear();
            const yearsLeft = Math.max(0, targetYear - currentCalendarYear);
            document.getElementById('sidebarYearsLeft').textContent = yearsLeft + ' ' + (yearsLeft === 1 ? '@Localizer["year"]' : '@Localizer["years"]');

            // Timeline
            document.getElementById('sidebarStartYear').textContent = startingYear;
            document.getElementById('sidebarCurrentYear').textContent = currentYear;
            document.getElementById('sidebarTargetYear').textContent = targetYear;

            // Calculate timeline progress percentage
            const totalYears = targetYear - startingYear;
            const elapsedYears = currentYear - startingYear;
            const timelineProgressPercent = totalYears > 0 ? (elapsedYears / totalYears) * 100 : 0;
            document.getElementById('sidebarTimelineProgress').style.width = Math.min(timelineProgressPercent, 100) + '%';

            // Position current marker
            const currentMarker = document.getElementById('sidebarTimelineCurrent');
            currentMarker.style.left = Math.min(timelineProgressPercent, 100) + '%';

            // Values
            document.getElementById('sidebarStartingYearLabel').textContent = startingYear;
            document.getElementById('sidebarStartingValue').textContent = fmt(baseValueStarting);
            document.getElementById('sidebarCurrentYearLabel').textContent = currentYear;
            document.getElementById('sidebarCurrentValue').textContent = fmt(baseValueCurrent);
            document.getElementById('sidebarTargetYearLabel').textContent = targetYear;
            document.getElementById('sidebarTargetValue').textContent = fmt(targetValue);

            // Required change
            const totalChange = Math.abs(targetValue - baseValueStarting);
            document.getElementById('sidebarRequiredChange').textContent = (isIncreaseGoal ? '+' : '-') + fmt(totalChange);

            // Analysis
            const actualChange = baseValueCurrent - baseValueStarting;
            const expectedSlope = (targetValue - baseValueStarting) / (targetYear - startingYear);
            const expectedCurrentValue = baseValueStarting + (expectedSlope * (currentYear - startingYear));
            const expectedChange = expectedCurrentValue - baseValueStarting;
            const variance = actualChange - expectedChange;

            document.getElementById('sidebarActualChange').textContent = (actualChange >= 0 ? '+' : '') + fmt(actualChange);
            document.getElementById('sidebarActualChange').className = getChangeClass(actualChange, isIncreaseGoal);

            document.getElementById('sidebarExpectedChange').textContent = (expectedChange >= 0 ? '+' : '') + fmt(expectedChange);

            document.getElementById('sidebarVariance').textContent = (variance >= 0 ? '+' : '') + fmt(variance);
            document.getElementById('sidebarVariance').className = getVarianceClass(variance, isIncreaseGoal);

            // Actions
            document.getElementById('sidebarTimelineLink').href = timelineUrl;

            // Edit button
            const editBtn = document.getElementById('sidebarEditBtn');
            if (editBtn) {
                editBtn.onclick = function() {
                    // Close sidebar first
                    const sidebar = bootstrap.Offcanvas.getInstance(document.getElementById('goalDetailsSidebar'));
                    sidebar.hide();
                    // Show edit modal
                    showEditModal(goalId, currentYear, baseValueCurrent, startingYear, targetYear);
                };
            }

            // Load historical values
            loadSidebarHistoricalValues(goalId);

            // Load notes and attachments
            loadSidebarNotes(goalId);
            loadSidebarAttachments(goalId);

            // Show sidebar
            const sidebar = new bootstrap.Offcanvas(document.getElementById('goalDetailsSidebar'));
            sidebar.show();
        }

        // Get status badge class
        function getStatusBadgeClass(status) {
            switch (status) {
                case 'on-track': return 'bg-success';
                case 'at-risk': return 'bg-warning text-dark';
                case 'off-track': return 'bg-danger';
                default: return 'bg-secondary';
            }
        }

        // Get progress color
        function getProgressColor(progress, status) {
            switch (status) {
                case 'on-track': return '#198754';
                case 'at-risk': return '#ffc107';
                case 'off-track': return '#dc3545';
                default: return '#6c757d';
            }
        }

        // Get change class
        function getChangeClass(change, isIncrease) {
            if (isIncrease) {
                return change >= 0 ? 'text-success' : 'text-danger';
            } else {
                return change <= 0 ? 'text-success' : 'text-danger';
            }
        }

        // Get variance class
        function getVarianceClass(variance, isIncrease) {
            if (isIncrease) {
                return variance >= 0 ? 'text-success' : 'text-danger';
            } else {
                return variance <= 0 ? 'text-success' : 'text-danger';
            }
        }

        // Load historical values for sidebar
        async function loadSidebarHistoricalValues(goalId) {
            const container = document.getElementById('sidebarHistoricalValues');
            container.innerHTML = `
                <div class="text-center text-muted py-3">
                    <i class="fas fa-spinner fa-spin me-2"></i>@Localizer["Loading..."]
                </div>
            `;

            try {
                const response = await fetch(`@Url.Action("GetYearlyValues", "FrameworkGoals")?goalId=${goalId}`);
                const result = await response.json();

                if (result.success) {
                    const unit = unitOfRow(document.getElementById(`goal-row-${goalId}`));
                    let html = '<div class="historical-values-list">';

                    // Add starting year
                    html += `
                        <div class="historical-value-item">
                            <span class="historical-year">${result.startingYear}</span>
                            <span class="historical-badge badge bg-primary">@Localizer["Start"]</span>
                            <span class="historical-val">${formatWithUnit(result.baseValueForStartingYear, unit)}</span>
                        </div>
                    `;

                    // Add yearly values
                    if (result.yearlyValues && result.yearlyValues.length > 0) {
                        result.yearlyValues.forEach(yv => {
                            if (yv.year > result.startingYear && yv.year < result.currentYear) {
                                html += `
                                    <div class="historical-value-item">
                                        <span class="historical-year">${yv.year}</span>
                                        <span class="historical-badge"></span>
                                        <span class="historical-val">${formatWithUnit(yv.value, unit)}</span>
                                    </div>
                                `;
                            }
                        });
                    }

                    // Add current year
                    html += `
                        <div class="historical-value-item">
                            <span class="historical-year">${result.currentYear}</span>
                            <span class="historical-badge badge bg-success">@Localizer["Current"]</span>
                            <span class="historical-val">${formatWithUnit(result.baseValueForCurrentYear, unit)}</span>
                        </div>
                    `;

                    html += '</div>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = `
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-info-circle me-2"></i>@Localizer["No historical data available"]
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error loading historical values:', error);
                container.innerHTML = `
                    <div class="text-center text-danger py-3">
                        <i class="fas fa-exclamation-circle me-2"></i>@Localizer["Error loading data"]
                    </div>
                `;
            }
        }

        // =============================================
        // NOTES & ATTACHMENTS FUNCTIONALITY
        // =============================================

        // Load notes for sidebar
        async function loadSidebarNotes(goalId) {
            const notesText = document.getElementById('sidebarNotesText');
            const notesTextarea = document.getElementById('sidebarNotesTextarea');

            try {
                const response = await fetch(`@Url.Action("GetNotes", "FrameworkGoals")?goalId=${goalId}`);
                const result = await response.json();

                if (result.success) {
                    if (result.notes && result.notes.trim() !== '') {
                        notesText.textContent = result.notes;
                        notesText.className = 'mb-0';
                    } else {
                        notesText.textContent = '@Localizer["No notes available"]';
                        notesText.className = 'text-muted mb-0';
                    }
                    notesTextarea.value = result.notes || '';
                }
            } catch (error) {
                console.error('Error loading notes:', error);
            }
        }

        // Toggle notes edit mode
        function toggleNotesEdit() {
            const displayDiv = document.getElementById('sidebarNotesDisplay');
            const editDiv = document.getElementById('sidebarNotesEdit');
            const editBtn = document.getElementById('editNotesBtn');

            if (editDiv.style.display === 'none') {
                displayDiv.style.display = 'none';
                editDiv.style.display = 'block';
                editBtn.innerHTML = '<i class="fas fa-times"></i>';
            } else {
                cancelNotesEdit();
            }
        }

        // Cancel notes edit
        function cancelNotesEdit() {
            const displayDiv = document.getElementById('sidebarNotesDisplay');
            const editDiv = document.getElementById('sidebarNotesEdit');
            const editBtn = document.getElementById('editNotesBtn');

            displayDiv.style.display = 'block';
            editDiv.style.display = 'none';
            editBtn.innerHTML = '<i class="fas fa-edit"></i>';

            // Reload notes to reset textarea
            if (currentSidebarGoalId) {
                loadSidebarNotes(currentSidebarGoalId);
            }
        }

        // Save notes
        async function saveNotes() {
            if (!currentSidebarGoalId) return;

            const notes = document.getElementById('sidebarNotesTextarea').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                const formData = new FormData();
                formData.append('goalId', currentSidebarGoalId);
                formData.append('notes', notes);
                formData.append('__RequestVerificationToken', token);

                const response = await fetch('@Url.Action("SaveNotes", "FrameworkGoals")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    showSuccessMessage(result.message);
                    cancelNotesEdit();
                    loadSidebarNotes(currentSidebarGoalId);
                } else {
                    showErrorMessage(result.message);
                }
            } catch (error) {
                console.error('Error saving notes:', error);
                showErrorMessage('@Localizer["An error occurred while saving notes."]');
            }
        }

        // Load attachments for sidebar
        async function loadSidebarAttachments(goalId) {
            const container = document.getElementById('sidebarAttachmentsList');

            try {
                const response = await fetch(`@Url.Action("GetAttachments", "FrameworkGoals")?goalId=${goalId}`);
                const result = await response.json();

                if (result.success && result.attachments && result.attachments.length > 0) {
                    let html = '<div class="attachments-list">';
                    result.attachments.forEach(att => {
                        html += `
                            <div class="attachment-item d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div class="attachment-info">
                                    <a href="${att.filePath}" target="_blank" class="text-decoration-none">
                                        <i class="fas fa-file me-2"></i>${att.fileName}
                                    </a>
                                    <small class="text-muted d-block">${att.uploadedDate}</small>
                                </div>
                                <div class="attachment-actions">
                                    <a href="${att.filePath}" download class="btn btn-sm btn-outline-primary me-1" title="@Localizer["Download"]">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteAttachment(${att.id})" title="@Localizer["Delete"]">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        `;
                    });
                    html += '</div>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<p class="text-muted mb-0">@Localizer["No attachments"]</p>';
                }
            } catch (error) {
                console.error('Error loading attachments:', error);
                container.innerHTML = '<p class="text-danger mb-0">@Localizer["Error loading attachments"]</p>';
            }
        }

        // Upload attachment
        async function uploadAttachment(input) {
            if (!currentSidebarGoalId || !input.files || input.files.length === 0) return;

            const file = input.files[0];
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const formData = new FormData();
            formData.append('goalId', currentSidebarGoalId);
            formData.append('file', file);
            formData.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('@Url.Action("UploadAttachment", "FrameworkGoals")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    showSuccessMessage(result.message);
                    loadSidebarAttachments(currentSidebarGoalId);
                } else {
                    showErrorMessage(result.message);
                }
            } catch (error) {
                console.error('Error uploading attachment:', error);
                showErrorMessage('@Localizer["An error occurred while uploading the file."]');
            }

            // Clear the input
            input.value = '';
        }

        // Delete attachment
        async function deleteAttachment(attachmentId) {
            if (!confirm('@Localizer["Are you sure you want to delete this attachment?"]')) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const formData = new FormData();
            formData.append('attachmentId', attachmentId);
            formData.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('@Url.Action("DeleteAttachment", "FrameworkGoals")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    showSuccessMessage(result.message);
                    loadSidebarAttachments(currentSidebarGoalId);
                } else {
                    showErrorMessage(result.message);
                }
            } catch (error) {
                console.error('Error deleting attachment:', error);
                showErrorMessage('@Localizer["An error occurred while deleting the attachment."]');
            }
        }

        // =============================================
        // END NOTES & ATTACHMENTS
        // =============================================

        // =============================================
        // END GOAL DETAILS SIDEBAR
        // =============================================

        // Advanced Filtering Functions
        function applyFilters() {
            // Reset to page 1 when filters change
            currentPage = 1;

            // Apply pagination which handles filtering internally
            applyPagination();

            // Update filter results counter
            const totalCount = filteredRows.length;
            const visibleCount = getFilteredRowCount();
            updateFilterResults(visibleCount, totalCount);
        }

        function updateFilterResults(visibleCount, totalCount) {
            const filterResults = document.getElementById('filterResults');
            const filterResultsText = document.getElementById('filterResultsText');

            if (visibleCount < totalCount) {
                filterResults.style.display = 'block';
                filterResultsText.textContent = `@Localizer["Showing"]` + ' ' + visibleCount + ' ' + `@Localizer["of"]` + ' ' + totalCount + ' ' + `@Localizer["goals"]`;
            } else {
                filterResults.style.display = 'none';
            }
        }

        function resetFilters() {
            // Clear all filter inputs
            document.getElementById('searchGoal').value = '';
            document.getElementById('frameworkFilter').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('progressRangeFilter').value = '';
            document.getElementById('goalTypeFilter').value = '';

            // Reapply filters (which will show all rows)
            applyFilters();
        }

        // Toggle Smart Alerts Section
        function toggleSmartAlerts() {
            const alertsBody = document.getElementById('smartAlertsBody');
            const chevron = document.getElementById('alertsChevron');

            if (alertsBody.style.display === 'none') {
                alertsBody.style.display = 'block';
                chevron.classList.remove('fa-chevron-down');
                chevron.classList.add('fa-chevron-up');
            } else {
                alertsBody.style.display = 'none';
                chevron.classList.remove('fa-chevron-up');
                chevron.classList.add('fa-chevron-down');
            }
        }
    </script>
}

