@model IEnumerable<MonitoringAndEvaluationPlatform.Models.FrameworkGoal>

@using MonitoringAndEvaluationPlatform.Helpers
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "Framework Goals";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var culture = Context.Features.Get<IRequestCultureFeature>().RequestCulture.Culture.Name;
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="dashboard-title">
                <i class="fas fa-bullseye me-3"></i>
                @Localizer["Framework Goals"]
            </h1>
            <p class="dashboard-subtitle">
                @Localizer["Manage goals and targets for monitoring frameworks"]
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="ValueProgressView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-primary btn-lg shadow-sm">
                <i class="fas fa-chart-bar me-2"></i>@Localizer["Value Progress"]
            </a>
            <a asp-action="StatusBadgesView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-success btn-lg shadow-sm">
                <i class="fas fa-tags me-2"></i>@Localizer["Status Badges"]
            </a>
            <a asp-action="MetricsGridView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-info btn-lg shadow-sm">
                <i class="fas fa-th me-2"></i>@Localizer["Metrics Grid"]
            </a>
            <a asp-action="TimelineView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-warning btn-lg shadow-sm">
                <i class="fas fa-project-diagram me-2"></i>@Localizer["Timeline View"]
            </a>
            <a asp-action="CircularGaugeView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-secondary btn-lg shadow-sm">
                <i class="fas fa-tachometer-alt me-2"></i>@Localizer["Circular Gauges"]
            </a>
            <a asp-action="ProgressView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-dark btn-lg shadow-sm">
                <i class="fas fa-chart-pie me-2"></i>@Localizer["Cards View"]
            </a>
            @if (SignInManager.IsSignedIn(User))
            {
                var user = await UserManager.GetUserAsync(User);
                if (user != null)
                {
                    var roles = await UserManager.GetRolesAsync(user);
                    if (roles.Contains("SystemAdministrator"))
                    {
                        <button onclick="toggleInlineCreate()" class="btn btn-primary btn-lg shadow-sm" id="createGoalBtn">
                            <i class="fas fa-plus me-2"></i>@Localizer["Add New Goal"]
                        </button>
                    }
                }
            }
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">@Localizer["Filter by Framework"]</label>
                    <select name="frameworkCode" class="form-select" onchange="this.form.submit()">
                        <option value="">@Localizer["All Frameworks"]</option>
                        @foreach (var framework in ViewBag.Frameworks)
                        {
                            <option value="@framework.Code" selected="@(ViewBag.SelectedFrameworkCode == framework.Code)">
                                @framework.Name
                            </option>
                        }
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Inline Create Form (Initially Hidden) -->
<div id="inlineCreateForm" class="card shadow-sm mb-4" style="display: none;">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="fas fa-plus-circle me-2"></i>@Localizer["Create New Framework Goal"]
        </h5>
    </div>
    <div class="card-body">
        <form id="createGoalForm">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Localizer["Goal Name"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="goalName" name="Name" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Localizer["Framework"] <span class="text-danger">*</span></label>
                    <select class="form-select" id="frameworkCode" name="FrameworkCode" required>
                        <option value="">@Localizer["Select Framework"]</option>
                        @foreach (var framework in ViewBag.Frameworks)
                        {
                            <option value="@framework.Code">@framework.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Starting Year"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control year-picker" id="startingYear" name="StartingYear" required readonly placeholder="@Localizer["Select Year"]" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Base Value (Starting)"] <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" class="form-control" id="baseValueStarting" name="BaseValueForStartingYear" required />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Current Year"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control year-picker" id="currentYear" name="CurrentYear" required readonly placeholder="@Localizer["Select Year"]" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Base Value (Current)"] <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" class="form-control" id="baseValueCurrent" name="BaseValueForCurrentYear" required />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Target Year"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control year-picker" id="targetYear" name="TargetYear" required readonly placeholder="@Localizer["Select Year"]" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Target Value"] <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" class="form-control" id="targetValue" name="TargetValue" required />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save me-2"></i>@Localizer["Save Goal"]
                </button>
                <button type="button" class="btn btn-secondary" onclick="toggleInlineCreate()">
                    <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Goals Table -->
<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0">@Localizer["Framework Goals List"]</h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover" id="goalsTable">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["Goal Name"]</th>
                            <th>@Localizer["Framework"]</th>
                            <th>@Localizer["Starting Year"]</th>
                            <th>@Localizer["Base Value (Starting)"]</th>
                            <th>@Localizer["Current Year"]</th>
                            <th>@Localizer["Base Value (Current)"]</th>
                            <th>@Localizer["Target Year"]</th>
                            <th>@Localizer["Target Value"]</th>
                            <th>@Localizer["Annual Discount Rate"]</th>
                            <th>@Localizer["Amount of Reduction"]</th>
                            <th>@Localizer["Expected Value"]</th>
                            <th>@Localizer["Progress Rate"]</th>
                            <th class="text-center">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var goal in Model)
                        {
                            <tr id="goal-row-@goal.ID">
                                <td><strong>@goal.Name</strong></td>
                                <td>
                                    <span class="badge bg-info">@goal.Framework.Name</span>
                                </td>
                                <td>@goal.StartingYear</td>
                                <td>@goal.BaseValueForStartingYear.ToString("N2")</td>
                                <td>@goal.CurrentYear</td>
                                <td>@goal.BaseValueForCurrentYear.ToString("N2")</td>
                                <td>@goal.TargetYear</td>
                                <td><strong>@goal.TargetValue.ToString("N2")</strong></td>
                                <td class="text-primary"><strong>@goal.AnnualDiscountRate.ToString("N2")</strong></td>
                                <td class="@(goal.AmountOfReduction >= 0 ? "text-success" : "text-danger")">
                                    @goal.AmountOfReduction.ToString("N2")
                                </td>
                                <td class="text-info">@goal.ExpectedValueForCurrentYear.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @(goal.ProgressRate >= 1 ? "bg-success" : "bg-warning") fs-6">
                                        @goal.ProgressRate.ToString("N2")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("FrameworkGoalsTimeline", "Dashboard", new { goalId = goal.ID, frameworkCode = goal.FrameworkCode })"
                                       class="btn btn-sm btn-info text-white me-2"
                                       title="@Localizer["View Timeline Chart"]">
                                        <i class="fas fa-chart-line"></i>
                                    </a>
                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        var user = await UserManager.GetUserAsync(User);
                                        if (user != null)
                                        {
                                            var roles = await UserManager.GetRolesAsync(user);
                                            if (roles.Contains("SystemAdministrator"))
                                            {
                                                <button onclick="showEditModal(@goal.ID, @goal.CurrentYear, @goal.BaseValueForCurrentYear, @goal.StartingYear, @goal.TargetYear)"
                                                        class="btn btn-sm btn-warning me-2"
                                                        title="@Localizer["Update Current Year"]">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button onclick="deleteGoal(@goal.ID)" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">@Localizer["No goals found. Create your first goal to get started!"]</p>
            </div>
        }
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">
                    <i class="fas fa-edit me-2"></i>@Localizer["Update Current Year"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editGoalId" />
                    <input type="hidden" id="editStartingYear" />
                    <input type="hidden" id="editTargetYear" />

                    <div class="mb-3">
                        <label class="form-label">@Localizer["Current Year"] <span class="text-danger">*</span></label>
                        <input type="text" class="form-control year-picker" id="editCurrentYear" required readonly placeholder="@Localizer["Select Year"]" />
                        <small class="form-text text-muted">@Localizer["Update this when the year changes"]</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Localizer["Base Value (Current)"] <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" class="form-control" id="editBaseValue" required />
                        <small class="form-text text-muted">@Localizer["Enter the actual achieved value for the current year"]</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                </button>
                <button type="button" class="btn btn-primary" onclick="submitEdit()">
                    <i class="fas fa-save me-2"></i>@Localizer["Update"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize year pickers with default values
        document.addEventListener('DOMContentLoaded', function() {
            const currentYear = new Date().getFullYear();

            // Set default values
            document.getElementById('startingYear').value = currentYear - 1;
            document.getElementById('currentYear').value = currentYear;
            document.getElementById('targetYear').value = currentYear + 1;

            // Initialize year pickers
            initializeYearPickers();
        });

        // Year picker functionality
        function initializeYearPickers() {
            const yearPickers = document.querySelectorAll('.year-picker');

            yearPickers.forEach(picker => {
                picker.addEventListener('click', function() {
                    showYearPicker(this);
                });
            });
        }

        let currentPickerYear = new Date().getFullYear();
        let activeInput = null;

        function showYearPicker(inputElement) {
            activeInput = inputElement;

            // Set initial year based on input value or current year
            if (inputElement.value) {
                currentPickerYear = parseInt(inputElement.value);
            } else {
                currentPickerYear = new Date().getFullYear();
            }

            // Create modal HTML
            const modalHtml = `
                <div class="year-picker-modal" id="yearPickerModal">
                    <div class="year-picker-content">
                        <div class="year-picker-header">
                            <h5>@Localizer["Select Year"]</h5>
                            <button type="button" class="btn-close-year" onclick="closeYearPicker()">&times;</button>
                        </div>
                        <div class="year-picker-navigation">
                            <button type="button" class="nav-btn" onclick="navigateYears(-10)">
                                <i class="fas fa-chevron-left"></i> @Localizer["Previous"]
                            </button>
                            <span class="year-range" id="yearRange"></span>
                            <button type="button" class="nav-btn" onclick="navigateYears(10)">
                                @Localizer["Next"] <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                        <div class="year-picker-body">
                            <div class="years-grid" id="yearsGrid"></div>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            const existingModal = document.getElementById('yearPickerModal');
            if (existingModal) {
                existingModal.remove();
            }

            // Add modal to body
            document.body.insertAdjacentHTML('beforeend', modalHtml);

            // Render years
            renderYears();
        }

        function renderYears() {
            const yearsGrid = document.getElementById('yearsGrid');
            const yearRange = document.getElementById('yearRange');
            const currentYear = new Date().getFullYear();

            // Calculate start year (rounded down to nearest 10)
            const startYear = Math.floor(currentPickerYear / 10) * 10;
            const endYear = startYear + 9;

            // Update range display
            yearRange.textContent = `${startYear} - ${endYear}`;

            // Clear grid
            yearsGrid.innerHTML = '';

            // Populate years grid
            for (let year = startYear; year <= endYear; year++) {
                const yearBtn = document.createElement('button');
                yearBtn.type = 'button';
                yearBtn.className = 'year-item';
                yearBtn.textContent = year;

                if (year == currentYear) {
                    yearBtn.classList.add('current-year');
                }

                if (activeInput && activeInput.value == year) {
                    yearBtn.classList.add('selected-year');
                }

                yearBtn.addEventListener('click', function() {
                    activeInput.value = year;
                    closeYearPicker();
                });

                yearsGrid.appendChild(yearBtn);
            }
        }

        function navigateYears(offset) {
            currentPickerYear += offset;
            renderYears();
        }

        function closeYearPicker() {
            const modal = document.getElementById('yearPickerModal');
            if (modal) {
                modal.remove();
            }
        }

        // Close modal when clicking outside
        document.addEventListener('click', function(e) {
            const modal = document.getElementById('yearPickerModal');
            if (modal && e.target === modal) {
                closeYearPicker();
            }
        });

        // Toggle inline create form
        function toggleInlineCreate() {
            const form = document.getElementById('inlineCreateForm');
            const btn = document.getElementById('createGoalBtn');

            if (form.style.display === 'none') {
                form.style.display = 'block';
                btn.innerHTML = '<i class="fas fa-times me-2"></i>@Localizer["Cancel"]';
                form.scrollIntoView({ behavior: 'smooth' });

                // Reset year values to defaults
                const currentYear = new Date().getFullYear();
                document.getElementById('startingYear').value = currentYear - 1;
                document.getElementById('currentYear').value = currentYear;
                document.getElementById('targetYear').value = currentYear + 1;
            } else {
                form.style.display = 'none';
                btn.innerHTML = '<i class="fas fa-plus me-2"></i>@Localizer["Add New Goal"]';
                document.getElementById('createGoalForm').reset();
            }
        }

        // Handle form submission
        document.getElementById('createGoalForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Create FormData for form-encoded submission
            const formData = new FormData();
            formData.append('Name', document.getElementById('goalName').value);
            formData.append('FrameworkCode', document.getElementById('frameworkCode').value);
            formData.append('StartingYear', document.getElementById('startingYear').value);
            formData.append('BaseValueForStartingYear', document.getElementById('baseValueStarting').value);
            formData.append('CurrentYear', document.getElementById('currentYear').value);
            formData.append('BaseValueForCurrentYear', document.getElementById('baseValueCurrent').value);
            formData.append('TargetYear', document.getElementById('targetYear').value);
            formData.append('TargetValue', document.getElementById('targetValue').value);
            formData.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('@Url.Action("CreateInline", "FrameworkGoals")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                console.log('Server response:', result);

                if (result.success) {
                    // Show success message
                    if (typeof result.message === 'string') {
                        alert(result.message);
                    } else {
                        alert('@Localizer["Goal created successfully!"]');
                    }

                    // Reload the page to show the new goal
                    location.reload();
                } else {
                    // Handle error message
                    let errorMessage = '@Localizer["An error occurred. Please try again."]';
                    if (typeof result.message === 'string') {
                        errorMessage = result.message;
                    } else if (result.message && typeof result.message === 'object') {
                        errorMessage = JSON.stringify(result.message);
                    }
                    alert(errorMessage);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('@Localizer["An error occurred. Please try again."]');
            }
        });

        // Show edit modal
        function showEditModal(goalId, currentYear, baseValue, startingYear, targetYear) {
            // Set hidden fields
            document.getElementById('editGoalId').value = goalId;
            document.getElementById('editStartingYear').value = startingYear;
            document.getElementById('editTargetYear').value = targetYear;

            // Set form values
            document.getElementById('editCurrentYear').value = currentYear;
            document.getElementById('editBaseValue').value = baseValue;

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }

        // Submit edit form
        async function submitEdit() {
            const goalId = document.getElementById('editGoalId').value;
            const currentYear = document.getElementById('editCurrentYear').value;
            const baseValue = document.getElementById('editBaseValue').value;

            if (!currentYear || !baseValue) {
                alert('@Localizer["Please fill in all required fields."]');
                return;
            }

            const token = document.querySelector('#editForm input[name="__RequestVerificationToken"]').value;

            const formData = new FormData();
            formData.append('id', goalId);
            formData.append('currentYear', currentYear);
            formData.append('baseValueForCurrentYear', baseValue);
            formData.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('@Url.Action("UpdateCurrentYear", "FrameworkGoals")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    alert(result.message);
                    // Close modal
                    bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
                    // Reload page to show updated values
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('@Localizer["An error occurred. Please try again."]');
            }
        }

        // Delete goal
        async function deleteGoal(id) {
            if (!confirm('@Localizer["Are you sure you want to delete this goal?"]')) {
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                const response = await fetch('@Url.Action("Delete", "FrameworkGoals")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });

                const result = await response.json();

                if (result.success) {
                    // Remove the row from the table
                    document.getElementById(`goal-row-${id}`).remove();
                    alert(result.message);

                    // Reload if no more goals
                    if (document.querySelectorAll('#goalsTable tbody tr').length === 0) {
                        location.reload();
                    }
                } else {
                    alert(result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('@Localizer["An error occurred. Please try again."]');
            }
        }
    </script>
}

<style>
    .dashboard-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e9ecef;
    }

    .dashboard-title {
        font-size: 2rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .dashboard-subtitle {
        color: #6c757d;
        font-size: 1rem;
        margin-bottom: 0;
    }

    .card {
        border: none;
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        color: #495057;
    }

    .badge {
        padding: 0.5rem 0.75rem;
        font-weight: 500;
    }

    .btn-lg {
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
    }

    /* Year Picker Styles */
    .year-picker {
        cursor: pointer;
        background-color: white;
    }

    .year-picker:focus {
        background-color: white;
    }

    .year-picker-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .year-picker-content {
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        width: 90%;
        max-width: 500px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
        animation: slideUp 0.3s ease;
    }

    @@keyframes slideUp {
        from {
            transform: translateY(50px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .year-picker-header {
        padding: 1.5rem;
        border-bottom: 2px solid #e9ecef;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .year-picker-header h5 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .btn-close-year {
        background: none;
        border: none;
        font-size: 2rem;
        color: #6c757d;
        cursor: pointer;
        padding: 0;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        transition: all 0.2s ease;
    }

