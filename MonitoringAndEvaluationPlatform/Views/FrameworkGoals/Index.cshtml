        // Get active filters as text
        function getActiveFiltersText() {
            const filters = [];

            const searchTerm = document.getElementById('searchGoal')?.value.trim();
            if (searchTerm) {
                filters.push('@Localizer["Search"]: "' + searchTerm + '"');
            }

            const frameworkSelect = document.getElementById('frameworkFilter');
            if (frameworkSelect?.value) {
                filters.push('@Localizer["Framework"]: ' + frameworkSelect.options[frameworkSelect.selectedIndex].text);
            }

            const statusSelect = document.getElementById('statusFilter');
            if (statusSelect?.value) {
                filters.push('@Localizer["Status"]: ' + statusSelect.options[statusSelect.selectedIndex].text);
            }

            const progressSelect = document.getElementById('progressRangeFilter');
