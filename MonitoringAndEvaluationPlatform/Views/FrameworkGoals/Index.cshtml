        // ==================== END BULK OPERATIONS ====================

        // ==================== COMPARISON VIEW ====================

        let comparisonChart = null;
        const comparisonColors = [
            '#0d6efd', '#198754', '#dc3545', '#ffc107', '#0dcaf0',
            '#6f42c1', '#fd7e14', '#20c997', '#e83e8c', '#6c757d'
        ];

        // Open comparison view
        function openComparisonView() {
            const selectedRows = getSelectedRowsData();
            if (selectedRows.length < 2) {
                showErrorMessage('@Localizer["Select at least 2 goals to compare"]');
                return;
            }

            // Prepare data
            const goalsData = selectedRows.map((row, index) => ({
                id: row.dataset.goalId,
                name: row.dataset.goalNameDisplay || '',
                framework: row.dataset.frameworkName || '',
                frameworkCode: row.dataset.frameworkCode || '',
                status: row.dataset.status || '',
                progressRate: parseFloat(row.dataset.progressRate) || 0,
                discountRate: parseFloat(row.dataset.discountRate) || 0,
                startingYear: parseInt(row.dataset.startingYear) || 0,
                currentYear: parseInt(row.dataset.currentYear) || 0,
                targetYear: parseInt(row.dataset.targetYear) || 0,
                startingValue: parseFloat(row.dataset.baseValueStarting) || 0,
                currentValue: parseFloat(row.dataset.baseValueCurrent) || 0,
                targetValue: parseFloat(row.dataset.targetValue) || 0,
                amountOfReduction: parseFloat(row.dataset.amountOfReduction) || 0,
                isIncreaseGoal: row.dataset.isIncreaseGoal === 'true',
                displayUnit: unitOfRow(row),
                goalTypeLabel: row.dataset.goalTypeLabel || '',
                isQuantitative: row.dataset.goalType === '1',
                color: comparisonColors[index % comparisonColors.length]
            }));

            // Update modal content
            updateComparisonSummary(goalsData);
            updateComparisonTable(goalsData);
            updateComparisonChart(goalsData);
            updateTimelineComparison(goalsData);

            // Update goal count
            document.getElementById('comparisonGoalCount').textContent = `${goalsData.length} @Localizer["goals"]`;

