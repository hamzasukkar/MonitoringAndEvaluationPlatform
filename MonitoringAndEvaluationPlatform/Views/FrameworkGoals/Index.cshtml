        // Get export data from filtered/visible rows
        function getExportData() {
            const data = [];
            const rows = document.querySelectorAll('.goal-row');

            rows.forEach(row => {
                // Check if row passes current filters (regardless of pagination)
                if (rowPassesFilters(row)) {
                    const goalName = row.getAttribute('data-goal-name-display');
                    const frameworkName = row.getAttribute('data-framework-name');
                    const progressRate = parseFloat(row.getAttribute('data-progress-rate')).toFixed(2);
                    const discountRate = parseFloat(row.getAttribute('data-discount-rate')).toFixed(2);
                    const status = row.getAttribute('data-status');
                    const startingYear = row.getAttribute('data-starting-year');
                    const targetYear = row.getAttribute('data-target-year');
                    const goalTypeLabel = row.getAttribute('data-goal-type-label');
                    const displayUnit = row.getAttribute('data-display-unit') || '%';

                    data.push({
                        goalName,
                        frameworkName,
                        goalTypeLabel,
                        displayUnit,
                        startingYear,
                        targetYear,
                        // The annual rate is expressed in the goal's own unit; progress is always a percentage
                        discountRate: formatWithUnit(parseFloat(discountRate), displayUnit),
                        progressRate: progressRate + '%',
                        status: status.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())
                    });
                }
            });

            return data;
        }

        // Export to CSV
        function exportToCSV() {
            const data = getExportData();

            if (data.length === 0) {
                showErrorMessage('@Localizer["No data to export"]');
                return;
            }

            // CSV headers
            const headers = [
                '@Localizer["Goal Name"]',
                '@Localizer["Framework"]',
                '@Localizer["Goal Type"]',
                '@Localizer["Unit of Measure"]',
                '@Localizer["Starting Year"]',
                '@Localizer["Target Year"]',
                '@Localizer["Annual Discount Rate"]',
                '@Localizer["Progress Rate"]',
                '@Localizer["Status"]'
            ];

            // Build CSV content with proper encoding
            let csvContent = '';
            csvContent += headers.join('\t') + '\n'; // Use tab separator for better Excel compatibility

            data.forEach(row => {
                const values = [
                    row.goalName,
                    row.frameworkName,
                    row.goalTypeLabel,
                    row.displayUnit,
                    row.startingYear,
                    row.targetYear,
                    row.discountRate,
                    row.progressRate,
                    row.status
                ];
                csvContent += values.join('\t') + '\n';
            });

            // Download file with UTF-8 BOM for proper Arabic support
            downloadFileWithBOM(csvContent, 'FrameworkGoals_' + getDateString() + '.csv');
            showSuccessMessage('@Localizer["CSV exported successfully!"]');
        }

