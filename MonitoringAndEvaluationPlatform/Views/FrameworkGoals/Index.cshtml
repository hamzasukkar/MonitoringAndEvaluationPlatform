            <div class="d-flex justify-content-between text-center">
                <div class="flex-fill">
                    <div class="text-muted small">@Localizer["Goal Type"]</div>
                    <strong id="sidebarGoalType">-</strong>
                </div>
                <div class="flex-fill border-start border-end">
                    <div class="text-muted small">@Localizer["Discount Rate"]</div>
                    <strong id="sidebarDiscountRate">-</strong>
                </div>
                <div class="flex-fill">
                    <div class="text-muted small">@Localizer["Years Left"]</div>
                    <strong id="sidebarYearsLeft">-</strong>
                </div>
            </div>
        </div>

        <!-- Timeline Section -->
        <div class="p-4 border-bottom">
            <h6 class="text-muted mb-3">
                <i class="fas fa-calendar-alt me-2"></i>@Localizer["Timeline"]
            </h6>
            <div class="timeline-visual">
                <div class="timeline-bar">
                    <div class="timeline-progress" id="sidebarTimelineProgress"></div>
                    <div class="timeline-marker timeline-start" id="sidebarTimelineStart">
                        <span class="timeline-year" id="sidebarStartYear">-</span>
                        <span class="timeline-label">@Localizer["Start"]</span>
                    </div>
                    <div class="timeline-marker timeline-current" id="sidebarTimelineCurrent">
                        <span class="timeline-year" id="sidebarCurrentYear">-</span>
                        <span class="timeline-label">@Localizer["Current"]</span>
                    </div>
                    <div class="timeline-marker timeline-target" id="sidebarTimelineTarget">
                        <span class="timeline-year" id="sidebarTargetYear">-</span>
                        <span class="timeline-label">@Localizer["Target"]</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Values Section -->
        <div class="p-4 border-bottom">
            <h6 class="text-muted mb-3">
                <i class="fas fa-chart-bar me-2"></i>@Localizer["Key Values"]
            </h6>
            <div class="row g-3">
                <div class="col-6">
                    <div class="value-card value-card-start">
                        <div class="value-card-label">@Localizer["Starting Value"]</div>
                        <div class="value-card-year" id="sidebarStartingYearLabel">-</div>
                        <div class="value-card-value" id="sidebarStartingValue">-</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="value-card value-card-current">
                        <div class="value-card-label">@Localizer["Current Value"]</div>
                        <div class="value-card-year" id="sidebarCurrentYearLabel">-</div>
                        <div class="value-card-value" id="sidebarCurrentValue">-</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="value-card value-card-target">
                        <div class="value-card-label">@Localizer["Target Value"]</div>
                        <div class="value-card-year" id="sidebarTargetYearLabel">-</div>
                        <div class="value-card-value" id="sidebarTargetValue">-</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="value-card value-card-change">
                        <div class="value-card-label">@Localizer["Required Change"]</div>
                        <div class="value-card-year">@Localizer["Total"]</div>
                        <div class="value-card-value" id="sidebarRequiredChange">-</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Analysis Section -->
        <div class="p-4 border-bottom">
            <h6 class="text-muted mb-3">
                <i class="fas fa-analytics me-2"></i>@Localizer["Analysis"]
            </h6>
            <div class="analysis-item">
                <div class="d-flex justify-content-between mb-2">
                    <span>@Localizer["Actual Change"]</span>
                    <strong id="sidebarActualChange">-</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>@Localizer["Expected Change"]</span>
                    <strong id="sidebarExpectedChange">-</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>@Localizer["Variance"]</span>
                    <strong id="sidebarVariance">-</strong>
                </div>
            </div>
        </div>

        <!-- Historical Values Section -->
        <div class="p-4 border-bottom">
            <h6 class="text-muted mb-3">
                <i class="fas fa-history me-2"></i>@Localizer["Historical Values"]
            </h6>
            <div id="sidebarHistoricalValues">
                <div class="text-center text-muted py-3">
                    <i class="fas fa-spinner fa-spin me-2"></i>@Localizer["Loading..."]
                </div>
            </div>
        </div>

        <!-- Notes Section -->
        <div class="p-4 border-bottom">
            <h6 class="text-muted mb-3 d-flex justify-content-between align-items-center">
                <span><i class="fas fa-sticky-note me-2"></i>@Localizer["Notes"]</span>
                @if (SignInManager.IsSignedIn(User))
                {
                    var notesUser = await UserManager.GetUserAsync(User);
                    if (notesUser != null)
                    {
                        var notesRoles = await UserManager.GetRolesAsync(notesUser);
                        if (notesRoles.Contains("SystemAdministrator") || notesRoles.Contains("MinistryStrategyManager"))
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" id="editNotesBtn" onclick="toggleNotesEdit()">
                                <i class="fas fa-edit"></i>
                            </button>
                        }
                    }
                }
            </h6>
            <div id="sidebarNotesDisplay">
                <p class="text-muted mb-0" id="sidebarNotesText">@Localizer["No notes available"]</p>
            </div>
            <div id="sidebarNotesEdit" style="display: none;">
                <textarea class="form-control mb-2" id="sidebarNotesTextarea" rows="4" placeholder="@Localizer["Enter notes here..."]"></textarea>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-success" onclick="saveNotes()">
                        <i class="fas fa-save me-1"></i>@Localizer["Save"]
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="cancelNotesEdit()">
                        <i class="fas fa-times me-1"></i>@Localizer["Cancel"]
                    </button>
                </div>
            </div>
        </div>

        <!-- Attachments Section -->
        <div class="p-4 border-bottom">
            <h6 class="text-muted mb-3 d-flex justify-content-between align-items-center">
                <span><i class="fas fa-paperclip me-2"></i>@Localizer["Attachments"]</span>
                @if (SignInManager.IsSignedIn(User))
                {
                    var attachUser = await UserManager.GetUserAsync(User);
                    if (attachUser != null)
                    {
                        var attachRoles = await UserManager.GetRolesAsync(attachUser);
                        if (attachRoles.Contains("SystemAdministrator") || attachRoles.Contains("MinistryStrategyManager"))
                        {
                            <button type="button" class="btn btn-sm btn-outline-success" onclick="document.getElementById('attachmentFileInput').click()">
                                <i class="fas fa-plus"></i>
                            </button>
                        }
                    }
                }
            </h6>
            <input type="file" id="attachmentFileInput" style="display: none;" onchange="uploadAttachment(this)" />
            <div id="sidebarAttachmentsList">
                <p class="text-muted mb-0">@Localizer["No attachments"]</p>
            </div>
        </div>

        <!-- Actions Section -->
        <div class="p-4">
            <h6 class="text-muted mb-3">
                <i class="fas fa-cog me-2"></i>@Localizer["Actions"]
            </h6>
            <div class="d-grid gap-2">
                <a href="#" id="sidebarTimelineLink" class="btn btn-info">
                    <i class="fas fa-chart-line me-2"></i>@Localizer["View Timeline Chart"]
                </a>
                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    if (currentUser != null)
                    {
                        var currentUserRoles = await UserManager.GetRolesAsync(currentUser);
                        if (currentUserRoles.Contains("SystemAdministrator") || currentUserRoles.Contains("MinistryStrategyManager"))
                        {
                            <button type="button" class="btn btn-warning" id="sidebarEditBtn">
                                <i class="fas fa-edit me-2"></i>@Localizer["Edit Goal"]
                            </button>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Calculation Explanation Modal -->
<div class="modal fade" id="calculationModal" tabindex="-1" aria-labelledby="calculationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="calculationModalLabel">
                    <i class="fas fa-calculator me-2"></i>@Localizer["Calculation Explanation"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Goal Name -->
                <div class="alert alert-primary mb-4">
                    <h5 class="mb-0" id="calcGoalName">-</h5>
                </div>

                <!-- Year Selector Section -->
                <div class="card mb-3 border-warning">
                    <div class="card-header bg-warning text-dark">
                        <i class="fas fa-calendar-alt me-2"></i><strong>@Localizer["Select Year for Calculation"]</strong>
                    </div>
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">@Localizer["Calculate for Year"]:</label>
                            </div>
                            <div class="col-md-4">
                                <select class="form-select form-select-lg" id="calcYearSelector" onchange="recalculateForYear()">
                                    <!-- Options will be populated by JavaScript -->
                                </select>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted small" id="calcYearHint">-</span>
                            </div>
                        </div>
                        <div class="mt-2">
                            <span class="text-muted small">
                                <i class="fas fa-info-circle me-1"></i>@Localizer["Select a year to see detailed calculations for that specific year"]
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Goal Type Section -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <i class="fas fa-bullseye me-2"></i><strong>@Localizer["Goal Type"]</strong>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <span class="text-muted">@Localizer["Type"]:</span>
                                <span id="calcGoalType" class="badge fs-6 ms-2">-</span>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted">@Localizer["Direction"]:</span>
                                <span id="calcGoalDirection" class="ms-2">-</span>
                            </div>
                        </div>
                        <div class="mt-2 small text-muted" id="calcGoalTypeExplanation">-</div>
                    </div>
                </div>

                <!-- Input Values Section -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <i class="fas fa-database me-2"></i><strong>@Localizer["Input Values"]</strong>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>@Localizer["Parameter"]</th>
                                        <th class="text-center">@Localizer["Value"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><i class="fas fa-calendar text-primary me-2"></i>@Localizer["Starting Year"]</td>
                                        <td class="text-center fw-bold" id="calcStartingYear">-</td>
                                    </tr>
                                    <tr>
                                        <td><i class="fas fa-calendar-check text-info me-2"></i>@Localizer["Current Year"]</td>
                                        <td class="text-center fw-bold" id="calcCurrentYear">-</td>
                                    </tr>
                                    <tr>
                                        <td><i class="fas fa-calendar-alt text-danger me-2"></i>@Localizer["Target Year"]</td>
                                        <td class="text-center fw-bold" id="calcTargetYear">-</td>
                                    </tr>
                                    <tr>
                                        <td><i class="fas fa-play-circle text-success me-2"></i>@Localizer["Base Value"] (@Localizer["Starting Year"])</td>
                                        <td class="text-center fw-bold" id="calcBaseValue">-</td>
                                    </tr>
                                    <tr>
                                        <td><i class="fas fa-dot-circle text-info me-2"></i>@Localizer["Current Value"] (@Localizer["Current Year"])</td>
                                        <td class="text-center fw-bold" id="calcCurrentValue">-</td>
                                    </tr>
                                    <tr>
                                        <td><i class="fas fa-flag-checkered text-danger me-2"></i>@Localizer["Target Value"] (@Localizer["Target Year"])</td>
                                        <td class="text-center fw-bold" id="calcTargetValue">-</td>
                                    </tr>
                                    <tr class="table-warning">
                                        <td><i class="fas fa-crosshairs text-warning me-2"></i><strong>@Localizer["Value for Selected Year"]</strong> (<span id="calcSelectedYearLabel">-</span>)</td>
                                        <td class="text-center fw-bold fs-5" id="calcSelectedYearValue">-</td>
                                    </tr>
                                    <tr class="table-info">
                                        <td><i class="fas fa-bullseye text-info me-2"></i><strong>@Localizer["Expected Target for Selected Year"]</strong></td>
                                        <td class="text-center fw-bold fs-5" id="calcExpectedTargetValue">-</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Calculations Section -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <i class="fas fa-cogs me-2"></i><strong>@Localizer["Calculations"]</strong>
                    </div>
                    <div class="card-body">
                        <!-- Number of Years -->
                        <div class="calculation-step mb-3 p-3 bg-light rounded">
                            <div class="step-title fw-bold text-primary mb-2">
                                <span class="badge bg-primary me-2">1</span>@Localizer["Number of Years"]
                            </div>
                            <div class="step-formula font-monospace bg-white p-2 rounded border">
                                @Localizer["Years"] = @Localizer["Target Year"] - @Localizer["Starting Year"]
                            </div>
                            <div class="step-calculation mt-2" id="calcYearsFormula">-</div>
                            <div class="step-result mt-2">
                                <strong>@Localizer["Result"]:</strong> <span id="calcYearsResult" class="badge bg-secondary fs-6">-</span>
                            </div>
                        </div>

                        <!-- Total Required Change -->
                        <div class="calculation-step mb-3 p-3 bg-light rounded">
                            <div class="step-title fw-bold text-primary mb-2">
                                <span class="badge bg-primary me-2">2</span>@Localizer["Total Required Change"]
                            </div>
                            <div class="step-formula font-monospace bg-white p-2 rounded border">
                                @Localizer["Required Change"] = |@Localizer["Target Value"] - @Localizer["Base Value"]|
                            </div>
                            <div class="step-calculation mt-2" id="calcRequiredChangeFormula">-</div>
                            <div class="step-result mt-2">
                                <strong>@Localizer["Result"]:</strong> <span id="calcRequiredChangeResult" class="badge bg-secondary fs-6">-</span>
                            </div>
                        </div>

                        <!-- Discount Rate -->
                        <div class="calculation-step mb-3 p-3 bg-light rounded">
                            <div class="step-title fw-bold text-primary mb-2">
                                <span class="badge bg-primary me-2">3</span>@Localizer["Discount Rate"] (@Localizer["Annual Change Rate"])
                            </div>
                            <div class="step-formula font-monospace bg-white p-2 rounded border">
                                @Localizer["Discount Rate"] = @Localizer["Required Change"] ÷ @Localizer["Years"]
                            </div>
                            <div class="step-calculation mt-2" id="calcDiscountRateFormula">-</div>
                            <div class="step-result mt-2">
                                <strong>@Localizer["Result"]:</strong> <span id="calcDiscountRateResult" class="badge bg-info fs-6">-</span>
                            </div>
                        </div>

                        <!-- Years Elapsed -->
                        <div class="calculation-step mb-3 p-3 bg-light rounded">
                            <div class="step-title fw-bold text-primary mb-2">
                                <span class="badge bg-primary me-2">4</span>@Localizer["Years Elapsed"]
                            </div>
                            <div class="step-formula font-monospace bg-white p-2 rounded border">
                                @Localizer["Years Elapsed"] = @Localizer["Current Year"] - @Localizer["Starting Year"]
                            </div>
                            <div class="step-calculation mt-2" id="calcYearsElapsedFormula">-</div>
                            <div class="step-result mt-2">
                                <strong>@Localizer["Result"]:</strong> <span id="calcYearsElapsedResult" class="badge bg-secondary fs-6">-</span>
                            </div>
                        </div>

                        <!-- Progress (Actual Change) -->
                        <div class="calculation-step mb-3 p-3 bg-light rounded">
                            <div class="step-title fw-bold text-primary mb-2">
                                <span class="badge bg-primary me-2">5</span>@Localizer["Progress"] (@Localizer["Actual Change"])
                            </div>
                            <div class="step-formula font-monospace bg-white p-2 rounded border" id="calcProgressFormula">-</div>
                            <div class="step-calculation mt-2" id="calcProgressCalculation">-</div>
                            <div class="step-result mt-2">
                                <strong>@Localizer["Result"]:</strong> <span id="calcProgressResult" class="badge bg-secondary fs-6">-</span>
                            </div>
                        </div>

                        <!-- Expected Change -->
                        <div class="calculation-step mb-3 p-3 bg-light rounded">
                            <div class="step-title fw-bold text-primary mb-2">
                                <span class="badge bg-primary me-2">6</span>@Localizer["Expected Change"]
                            </div>
                            <div class="step-formula font-monospace bg-white p-2 rounded border">
                                @Localizer["Expected Change"] = @Localizer["Discount Rate"] × @Localizer["Years Elapsed"]
                            </div>
                            <div class="step-calculation mt-2" id="calcExpectedChangeFormula">-</div>
                            <div class="step-result mt-2">
                                <strong>@Localizer["Result"]:</strong> <span id="calcExpectedChangeResult" class="badge bg-secondary fs-6">-</span>
                            </div>
                        </div>

                        <!-- Performance Percentage -->
                        <div class="calculation-step mb-3 p-3 border border-success rounded" style="background-color: #f0fff4;">
                            <div class="step-title fw-bold text-success mb-2">
                                <span class="badge bg-success me-2">7</span>@Localizer["Performance Percentage"]
                            </div>
                            <div class="step-formula font-monospace bg-white p-2 rounded border">
                                @Localizer["Performance"] % = (@Localizer["Progress"] ÷ @Localizer["Expected Change"]) × 100
                            </div>
                            <div class="step-calculation mt-2" id="calcPerformanceFormula">-</div>
                            <div class="step-result mt-2">
                                <strong>@Localizer["Result"]:</strong> <span id="calcPerformanceResult" class="badge fs-5">-</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Summary Section -->
                <div class="card border-primary">
                    <div class="card-header bg-primary text-white">
                        <i class="fas fa-chart-pie me-2"></i><strong>@Localizer["Summary"]</strong>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-4 border-end">
                                <div class="text-muted small">@Localizer["Discount Rate"]</div>
                                <div class="fs-4 fw-bold text-info" id="calcSummaryDiscountRate">-</div>
                            </div>
                            <div class="col-md-4 border-end">
                                <div class="text-muted small">@Localizer["Progress"]</div>
                                <div class="fs-4 fw-bold" id="calcSummaryProgress">-</div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted small">@Localizer["Performance"]</div>
                                <div class="fs-4 fw-bold" id="calcSummaryPerformance">-</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>@Localizer["Close"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Yearly Performance Script -->
    <script>
        // Toggle year dropdown visibility when clicking on performance value
        function toggleYearDropdown(valueSpan) {
            const container = valueSpan.closest('.performance-container');
            const select = container.querySelector('.year-select');

            // Hide all other dropdowns first
            document.querySelectorAll('.year-select').forEach(s => {
                if (s !== select) {
                    s.classList.add('d-none');
                }
            });

            // Toggle this dropdown
            select.classList.toggle('d-none');

            if (!select.classList.contains('d-none')) {
                select.focus();
            }
        }

        // Update performance for a single row when its dropdown changes
        function updateRowPerformance(selectElement) {
            const row = selectElement.closest('.goal-row');
            const selectedYear = parseInt(selectElement.value);

            calculatePerformanceForRow(row, selectedYear);

            // Hide the dropdown after selection
            selectElement.classList.add('d-none');
        }

        // Calculate and display performance for a single row
        function calculatePerformanceForRow(row, selectedYear) {
            const discountRate = parseFloat(row.getAttribute('data-discount-rate'));
            const startingYear = parseInt(row.getAttribute('data-starting-year'));
            const isIncreaseGoal = row.getAttribute('data-is-increase-goal') === 'true';
            const cell = row.querySelector('.performance-cell-dynamic');
            if (!cell) return;

            const dataDiv = cell.querySelector('.yearly-data');
            const valueSpan = cell.querySelector('.performance-value');

            if (!dataDiv || !valueSpan) return;

            try {
                const yearlyData = JSON.parse(dataDiv.getAttribute('data-values'));
                const dataForYear = yearlyData[selectedYear];

                if (dataForYear) {
                    const actualValueForYear = dataForYear.baseVal;
                    const expectedTargetForYear = dataForYear.expected;
                    const startingBaseValue = parseFloat(row.getAttribute('data-base-value-starting'));

                    // Calculate actual progress and expected progress using the correct
                    // expected target (respects manual mode — already resolved server-side).
                    const actualChange = isIncreaseGoal
                        ? (actualValueForYear - startingBaseValue)
                        : (startingBaseValue - actualValueForYear);

                    const expectedChange = isIncreaseGoal
                        ? (expectedTargetForYear - startingBaseValue)
                        : (startingBaseValue - expectedTargetForYear);

                    // Special case: Base Year performance is always 0%
                    if (selectedYear === startingYear) {
                        valueSpan.className = 'performance-value fw-bold text-danger';
                        valueSpan.textContent = '0.00%';
                    } else if (actualChange === 0) {
                        // No change from base value
                        valueSpan.className = 'performance-value fw-bold text-danger';
                        valueSpan.textContent = '0.00%';
                    } else if (actualChange < 0) {
                        // Moving in wrong direction (negative progress)
                        valueSpan.className = 'performance-value fw-bold text-danger';
                        valueSpan.textContent = '0.00%';
                    } else if (expectedChange !== 0) {
                        // Progress rate = (actual change from base) / (expected change from base) × 100
                        const percentage = (actualChange / expectedChange) * 100;

                        // Color coding based on performance percentage
                        if (percentage >= 100) {
                            valueSpan.className = 'performance-value fw-bold text-success';
                        } else if (percentage >= 50) {
                            valueSpan.className = 'performance-value fw-bold text-warning';
                        } else {
                            valueSpan.className = 'performance-value fw-bold text-danger';
                        }
                        valueSpan.textContent = `${percentage.toFixed(2)}%`;
                    } else {
                        valueSpan.textContent = 'N/A';
                        valueSpan.className = 'performance-value text-muted';
                    }
                } else {
                    valueSpan.textContent = '-';
                    valueSpan.className = 'performance-value text-muted';
                }
            } catch (e) {
                console.error('Error calculating yearly performance:', e);
            }
        }

        // Initialize all rows with their default selected year
        function initializeYearlyPerformance() {
            const rows = document.querySelectorAll('.goal-row');

            rows.forEach(row => {
                const cell = row.querySelector('.performance-cell-dynamic');
                if (!cell) return;

                const select = cell.querySelector('.year-select');
                if (!select) return;

                const selectedYear = parseInt(select.value);
                calculatePerformanceForRow(row, selectedYear);
            });
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.performance-container')) {
                document.querySelectorAll('.year-select').forEach(s => {
                    s.classList.add('d-none');
                });
            }
        });

        // Initialize on load
        document.addEventListener('DOMContentLoaded', function() {
            // Wait slightly for other scripts
            setTimeout(initializeYearlyPerformance, 100);
        });

        // Global variable to store current goal data for recalculation
        let currentCalcGoalData = null;

        // Show Calculation Explanation Modal
        function showCalculationExplanation(button) {
            // Read data from button attributes
            const goalId = parseInt(button.getAttribute('data-goal-id'));
            const goalName = button.getAttribute('data-goal-name');
            const isUpward = button.getAttribute('data-is-upward') === 'true';
            const baseValue = parseFloat(button.getAttribute('data-base-value'));
            const currentValue = parseFloat(button.getAttribute('data-current-value'));
            const targetValue = parseFloat(button.getAttribute('data-target-value'));
            const startingYear = parseInt(button.getAttribute('data-starting-year'));
            const currentYear = parseInt(button.getAttribute('data-current-year'));
            const targetYear = parseInt(button.getAttribute('data-target-year'));
            const discountRate = parseFloat(button.getAttribute('data-discount-rate'));
            const amountOfReduction = parseFloat(button.getAttribute('data-amount-reduction'));
            const progressRate = parseFloat(button.getAttribute('data-progress-rate'));
            const yearlyData = JSON.parse(button.getAttribute('data-yearly-data'));
            // The unit lives on the owning row rather than being duplicated onto the button
            const displayUnit = unitOfRow(button.closest('tr'));

            // Store goal data globally for recalculation
            currentCalcGoalData = {
                goalId, goalName, isUpward, baseValue, currentValue, targetValue,
                startingYear, currentYear, targetYear, discountRate, amountOfReduction, progressRate, yearlyData,
                displayUnit
            };

            const isRtl = document.documentElement.dir === 'rtl' || document.documentElement.lang === 'ar';

            // Set goal name
            document.getElementById('calcGoalName').textContent = goalName;

            // Set goal type
            const goalTypeEl = document.getElementById('calcGoalType');
            const goalDirectionEl = document.getElementById('calcGoalDirection');
            const goalTypeExplanationEl = document.getElementById('calcGoalTypeExplanation');

            if (isUpward) {
                goalTypeEl.textContent = isRtl ? 'صاعد' : 'Upward';
                goalTypeEl.className = 'badge fs-6 ms-2 bg-success';
                goalDirectionEl.innerHTML = '<i class="fas fa-arrow-up text-success me-1"></i>' + (isRtl ? 'القيمة يجب أن تزيد' : 'Value should INCREASE');
                goalTypeExplanationEl.textContent = isRtl
                    ? 'الهدف الصاعد: القيمة المستهدفة أكبر من القيمة الأساسية، لذلك نريد أن تزيد القيمة الفعلية بمرور الوقت.'
                    : 'Upward Target: Target Value > Base Value, so we want the actual value to increase over time.';
            } else {
                goalTypeEl.textContent = isRtl ? 'هابط' : 'Downward';
                goalTypeEl.className = 'badge fs-6 ms-2 bg-danger';
                goalDirectionEl.innerHTML = '<i class="fas fa-arrow-down text-danger me-1"></i>' + (isRtl ? 'القيمة يجب أن تنخفض' : 'Value should DECREASE');
                goalTypeExplanationEl.textContent = isRtl
                    ? 'الهدف الهابط: القيمة المستهدفة أقل من القيمة الأساسية، لذلك نريد أن تنخفض القيمة الفعلية بمرور الوقت.'
                    : 'Downward Target: Target Value < Base Value, so we want the actual value to decrease over time.';
            }

            // Set static input values
            document.getElementById('calcStartingYear').textContent = startingYear;
            document.getElementById('calcCurrentYear').textContent = currentYear;
            document.getElementById('calcTargetYear').textContent = targetYear;
            document.getElementById('calcBaseValue').textContent = formatWithUnit(baseValue, displayUnit);
            document.getElementById('calcCurrentValue').textContent = formatWithUnit(currentValue, displayUnit);
            document.getElementById('calcTargetValue').textContent = formatWithUnit(targetValue, displayUnit);

            // Populate year selector dropdown
            const yearSelector = document.getElementById('calcYearSelector');
            yearSelector.innerHTML = '';
            for (let y = startingYear; y <= currentYear; y++) {
                const option = document.createElement('option');
                option.value = y;
                option.textContent = y;
                if (y === currentYear) {
                    option.selected = true;
                }
                yearSelector.appendChild(option);
            }

            // Set year hint
            document.getElementById('calcYearHint').textContent = isRtl
                ? `من ${startingYear} إلى ${currentYear}`
                : `From ${startingYear} to ${currentYear}`;

            // Calculate for the current year initially
            calculateForSelectedYear(currentYear);

            // Show the modal
            const modal = new bootstrap.Modal(document.getElementById('calculationModal'));
            modal.show();
        }

        // Recalculate when year dropdown changes
        function recalculateForYear() {
            const selectedYear = parseInt(document.getElementById('calcYearSelector').value);
            calculateForSelectedYear(selectedYear);
        }

        // Calculate and display all values for a specific year
        function calculateForSelectedYear(selectedYear) {
            if (!currentCalcGoalData) return;

            const { goalName, isUpward, baseValue, currentValue, targetValue, startingYear, currentYear, targetYear, yearlyData, displayUnit } = currentCalcGoalData;
            const isRtl = document.documentElement.dir === 'rtl' || document.documentElement.lang === 'ar';
            // Raw amounts carry the goal's unit; the formulas below stay as bare arithmetic
            const fmt = v => formatWithUnit(v, displayUnit);

            // Get values for selected year from yearlyData
            const yearData = yearlyData[selectedYear];
            const selectedYearValue = yearData ? yearData.baseVal : baseValue;
            const expectedTargetForYear = yearData ? yearData.expected : baseValue;

            // Update selected year value display
            document.getElementById('calcSelectedYearLabel').textContent = selectedYear;
            document.getElementById('calcSelectedYearValue').textContent = fmt(selectedYearValue);
            document.getElementById('calcExpectedTargetValue').textContent = fmt(expectedTargetForYear);

            // 1. Number of Years (Total)
            const years = targetYear - startingYear;
            document.getElementById('calcYearsFormula').innerHTML = `<code>${targetYear} - ${startingYear} = <strong>${years}</strong></code>`;
            document.getElementById('calcYearsResult').textContent = years + (isRtl ? ' سنوات' : ' years');

            // 2. Total Required Change
            const requiredChange = Math.abs(targetValue - baseValue);
            document.getElementById('calcRequiredChangeFormula').innerHTML = `<code>|${targetValue.toFixed(2)} - ${baseValue.toFixed(2)}| = <strong>${requiredChange.toFixed(2)}</strong></code>`;
            document.getElementById('calcRequiredChangeResult').textContent = fmt(requiredChange);

            // 3. Discount Rate
            const calculatedDiscountRate = years > 0 ? requiredChange / years : 0;
            document.getElementById('calcDiscountRateFormula').innerHTML = `<code>${requiredChange.toFixed(2)} ÷ ${years} = <strong>${calculatedDiscountRate.toFixed(2)}</strong></code>`;
            document.getElementById('calcDiscountRateResult').textContent = fmt(calculatedDiscountRate) + (isRtl ? ' لكل سنة' : ' per year');

            // 4. Years Elapsed (for selected year)
            const yearsElapsed = selectedYear - startingYear;
            document.getElementById('calcYearsElapsedFormula').innerHTML = `<code>${selectedYear} - ${startingYear} = <strong>${yearsElapsed}</strong></code>`;
            document.getElementById('calcYearsElapsedResult').textContent = yearsElapsed + (isRtl ? ' سنوات' : ' years');

            // 5. Progress (Actual Change for selected year)
            let progress;
            const progressFormulaEl = document.getElementById('calcProgressFormula');
            const progressCalculationEl = document.getElementById('calcProgressCalculation');

            if (isUpward) {
                progress = selectedYearValue - baseValue;
                progressFormulaEl.innerHTML = (isRtl ? 'التقدم' : 'Progress') + ' = ' + (isRtl ? 'قيمة السنة المحددة' : 'Selected Year Value') + ' - ' + (isRtl ? 'القيمة الأساسية' : 'Base Value');
                progressCalculationEl.innerHTML = `<code>${selectedYearValue.toFixed(2)} - ${baseValue.toFixed(2)} = <strong>${progress.toFixed(2)}</strong></code>`;
            } else {
                progress = baseValue - selectedYearValue;
                progressFormulaEl.innerHTML = (isRtl ? 'التقدم' : 'Progress') + ' = ' + (isRtl ? 'القيمة الأساسية' : 'Base Value') + ' - ' + (isRtl ? 'قيمة السنة المحددة' : 'Selected Year Value');
                progressCalculationEl.innerHTML = `<code>${baseValue.toFixed(2)} - ${selectedYearValue.toFixed(2)} = <strong>${progress.toFixed(2)}</strong></code>`;
            }

            const progressResultEl = document.getElementById('calcProgressResult');
            progressResultEl.textContent = fmt(progress);
            if (progress > 0) {
                progressResultEl.className = 'badge bg-success fs-6';
            } else if (progress < 0) {
                progressResultEl.className = 'badge bg-danger fs-6';
            } else {
                progressResultEl.className = 'badge bg-secondary fs-6';
            }

            // 6. Expected Change (for selected year)
            const expectedChange = calculatedDiscountRate * yearsElapsed;
            document.getElementById('calcExpectedChangeFormula').innerHTML = `<code>${calculatedDiscountRate.toFixed(2)} × ${yearsElapsed} = <strong>${expectedChange.toFixed(2)}</strong></code>`;
            document.getElementById('calcExpectedChangeResult').textContent = fmt(expectedChange);

            // 7. Performance Percentage
            let performance = 0;
            if (yearsElapsed === 0) {
                performance = 0;
            } else if (expectedChange === 0) {
                performance = progress === 0 ? 0 : (progress > 0 ? 100 : 0);
            } else if (progress <= 0) {
                performance = 0;
            } else {
                performance = (progress / expectedChange) * 100;
            }

            document.getElementById('calcPerformanceFormula').innerHTML = `<code>(${progress.toFixed(2)} ÷ ${expectedChange.toFixed(2)}) × 100 = <strong>${performance.toFixed(2)}%</strong></code>`;

            const performanceResultEl = document.getElementById('calcPerformanceResult');
            performanceResultEl.textContent = performance.toFixed(2) + '%';
            if (performance >= 100) {
                performanceResultEl.className = 'badge bg-success fs-5';
            } else if (performance >= 50) {
                performanceResultEl.className = 'badge bg-warning fs-5';
            } else {
                performanceResultEl.className = 'badge bg-danger fs-5';
            }

            // Summary section
            document.getElementById('calcSummaryDiscountRate').textContent = fmt(calculatedDiscountRate);

            const summaryProgressEl = document.getElementById('calcSummaryProgress');
            summaryProgressEl.textContent = fmt(progress);
            summaryProgressEl.className = progress >= 0 ? 'fs-4 fw-bold text-success' : 'fs-4 fw-bold text-danger';

            const summaryPerformanceEl = document.getElementById('calcSummaryPerformance');
            summaryPerformanceEl.textContent = performance.toFixed(2) + '%';
            if (performance >= 100) {
                summaryPerformanceEl.className = 'fs-4 fw-bold text-success';
            } else if (performance >= 50) {
                summaryPerformanceEl.className = 'fs-4 fw-bold text-warning';
            } else {
                summaryPerformanceEl.className = 'fs-4 fw-bold text-danger';
            }
        }
    </script>

    <!-- SheetJS for Excel Export -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
    <!-- jsPDF for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <!-- html2canvas for PDF Arabic support -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <!-- Chart.js for Comparison Charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        // Initialize year pickers with default values
        document.addEventListener('DOMContentLoaded', function() {
            const currentYear = new Date().getFullYear();

            // Set default values
            document.getElementById('startingYear').value = currentYear - 1;
            document.getElementById('currentYear').value = currentYear;
            document.getElementById('targetYear').value = currentYear + 1;

            // Initialize year pickers
            initializeYearPickers();

            // Initialize decimal input handling
            initializeDecimalInputs();

            // Initialize sparklines
            initializeSparklines();
        });

        // Initialize decimal inputs to allow both comma and period as decimal separators
        function initializeDecimalInputs() {
            document.querySelectorAll('.decimal-input').forEach(input => {
                // Allow only numbers, comma, period, and minus sign
                input.addEventListener('input', function(e) {
                    // Replace comma with period for consistent display
                    let value = this.value;
                    // Allow digits, one decimal separator (comma or period), and optional minus at start
                    value = value.replace(/[^0-9.,-]/g, '');
                    this.value = value;
                });
            });
        }

        // Year picker functionality
        function initializeYearPickers() {
            const yearPickers = document.querySelectorAll('.year-picker');

            yearPickers.forEach(picker => {
                picker.addEventListener('click', function() {
                    showYearPicker(this);
                });
            });
        }

        let currentPickerYear = new Date().getFullYear();
        let activeInput = null;

        function showYearPicker(inputElement) {
            activeInput = inputElement;

            // Set initial year based on input value or current year
            if (inputElement.value) {
                currentPickerYear = parseInt(inputElement.value);
            } else {
                currentPickerYear = new Date().getFullYear();
            }

            // Create modal HTML
            const modalHtml = `
                <div class="year-picker-modal" id="yearPickerModal">
                    <div class="year-picker-content">
                        <div class="year-picker-header">
                            <h5>@Localizer["Select Year"]</h5>
                            <button type="button" class="btn-close-year" onclick="closeYearPicker()">&times;</button>
                        </div>
                        <div class="year-picker-navigation">
                            <button type="button" class="nav-btn" onclick="navigateYears(-10)">
                                <i class="fas fa-chevron-left"></i> @Localizer["Previous"]
                            </button>
                            <span class="year-range" id="yearRange"></span>
                            <button type="button" class="nav-btn" onclick="navigateYears(10)">
                                @Localizer["Next"] <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                        <div class="year-picker-body">
                            <div class="years-grid" id="yearsGrid"></div>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            const existingModal = document.getElementById('yearPickerModal');
            if (existingModal) {
                existingModal.remove();
            }

            // Add modal to body
            document.body.insertAdjacentHTML('beforeend', modalHtml);

            // Render years
            renderYears();
        }

        function renderYears() {
            const yearsGrid = document.getElementById('yearsGrid');
            const yearRange = document.getElementById('yearRange');
            const currentYear = new Date().getFullYear();

            // Calculate start year (rounded down to nearest 10)
            const startYear = Math.floor(currentPickerYear / 10) * 10;
            const endYear = startYear + 9;

            // Update range display
            yearRange.textContent = `${startYear} - ${endYear}`;

            // Clear grid
            yearsGrid.innerHTML = '';

            // Populate years grid
            for (let year = startYear; year <= endYear; year++) {
                const yearBtn = document.createElement('button');
                yearBtn.type = 'button';
                yearBtn.className = 'year-item';
                yearBtn.textContent = year;

                if (year == currentYear) {
                    yearBtn.classList.add('current-year');
                }

                if (activeInput && activeInput.value == year) {
                    yearBtn.classList.add('selected-year');
                }

                yearBtn.addEventListener('click', function() {
                    activeInput.value = year;
                    closeYearPicker();
                });

                yearsGrid.appendChild(yearBtn);
            }
        }

        function navigateYears(offset) {
            currentPickerYear += offset;
            renderYears();
        }

        function closeYearPicker() {
            const modal = document.getElementById('yearPickerModal');
            if (modal) {
                modal.remove();
            }
        }

        // Close modal when clicking outside
        document.addEventListener('click', function(e) {
            const modal = document.getElementById('yearPickerModal');
            if (modal && e.target === modal) {
                closeYearPicker();
            }
        });

        // Toggle inline create form
        function toggleInlineCreate() {
            const form = document.getElementById('inlineCreateForm');
            const btn = document.getElementById('createGoalBtn');

            if (form.style.display === 'none') {
                form.style.display = 'block';
                btn.innerHTML = '<i class="fas fa-times me-2"></i>@Localizer["Cancel"]';
                form.scrollIntoView({ behavior: 'smooth' });

                // Reset year values to defaults
                const currentYear = new Date().getFullYear();
                document.getElementById('startingYear').value = currentYear - 1;
                document.getElementById('currentYear').value = currentYear;
                document.getElementById('targetYear').value = currentYear + 1;
            } else {
                form.style.display = 'none';
                btn.innerHTML = '<i class="fas fa-plus me-2"></i>@Localizer["Add New Goal"]';
                document.getElementById('createGoalForm').reset();
                document.getElementById('manualTargetsSection').style.display = 'none';
                document.getElementById('manualTargetsInputs').innerHTML = '';
                // form.reset() restores the Qualitative radio; re-sync the dependent fields
                onGoalTypeChange();
            }
        }

        // Switch the create form between qualitative (percentages) and quantitative (quantities + unit)
        function onGoalTypeChange() {
            const isQuantitative = document.getElementById('goalTypeQuantitative').checked;
            const unitWrapper = document.getElementById('unitFieldWrapper');
            const unitInput = document.getElementById('goalUnit');

            unitWrapper.style.display = isQuantitative ? '' : 'none';
            unitInput.required = isQuantitative;
            if (!isQuantitative) {
                unitInput.value = '';
            }

            document.getElementById('cumulativeHint').style.display = isQuantitative ? '' : 'none';

            // Value labels read differently for a quantity than for a percentage
            ['baseValueStartingLabel', 'baseValueCurrentLabel', 'targetValueLabel'].forEach(id => {
                const label = document.getElementById(id);
                label.textContent = isQuantitative
                    ? label.dataset.labelQuantitative
                    : label.dataset.labelQualitative;
            });

            updateCreateFormUnitSuffix();
        }

        // Keep the "%"/unit addon next to each value input in sync with the chosen unit
        function updateCreateFormUnitSuffix() {
            const isQuantitative = document.getElementById('goalTypeQuantitative').checked;
            const unit = document.getElementById('goalUnit').value.trim();
            const suffix = isQuantitative ? (unit || '—') : '%';
            document.querySelectorAll('#createGoalForm .unit-suffix').forEach(el => {
                el.textContent = suffix;
            });
        }

        // Helper function to normalize decimal values (convert comma to period)
        function normalizeDecimal(value) {
            if (typeof value === 'string') {
                return value.replace(',', '.');
            }
            return value;
        }

        // Build manual expected targets inputs based on selected years
        function onManualTargetsToggle() {
            const checkbox = document.getElementById('manualYearlyTargets');
            const section = document.getElementById('manualTargetsSection');
            section.style.display = checkbox.checked ? '' : 'none';
            if (checkbox.checked) {
                buildManualTargetInputs();
            }
        }

        function buildManualTargetInputs() {
            const startingYear = parseInt(document.getElementById('startingYear').value);
            const currentYear = parseInt(document.getElementById('currentYear').value);
            const targetYear = parseInt(document.getElementById('targetYear').value);
            const container = document.getElementById('manualTargetsInputs');

            if (!startingYear || !currentYear || !targetYear || startingYear >= targetYear) {
                container.innerHTML = '<p class="text-muted small">@Localizer["Fill in all year fields above first, then check the checkbox to enter manual targets."]</p>';
                return;
            }

            // Collect intermediate years (exclude startingYear, currentYear, targetYear)
            const intermediateYears = [];
            for (let y = startingYear + 1; y < targetYear; y++) {
                if (y !== currentYear) {
                    intermediateYears.push(y);
                }
            }

            if (intermediateYears.length === 0) {
                container.innerHTML = '<p class="text-muted small">@Localizer["No intermediate years to set. All years between Starting Year and Target Year (excluding Current Year) are already covered."]</p>';
                return;
            }

            let html = '<div class="row">';
            intermediateYears.forEach(function(year, idx) {
                html += `
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-semibold">${year}</label>
                        <input type="hidden" name="ManualTargetYears[${idx}]" value="${year}" />
                        <input type="text" inputmode="decimal" class="form-control decimal-input"
                               name="ManualTargetValues[${idx}]"
                               placeholder="0.00"
                               required />
                    </div>`;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        // Re-build manual targets when year picker values change
        ['startingYear', 'currentYear', 'targetYear'].forEach(function(id) {
            document.getElementById(id).addEventListener('change', function() {
                if (document.getElementById('manualYearlyTargets').checked) {
                    buildManualTargetInputs();
                }
            });
        });

        // Live-update the unit addon next to each value input as the unit is typed
        document.getElementById('goalUnit').addEventListener('input', updateCreateFormUnitSuffix);

        // Handle form submission
        document.getElementById('createGoalForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Get and normalize values
            const name = document.getElementById('goalName').value.trim();
            const frameworkCode = document.getElementById('frameworkCode').value;
            const startingYear = document.getElementById('startingYear').value;
            const baseValueStarting = normalizeDecimal(document.getElementById('baseValueStarting').value);
            const currentYear = document.getElementById('currentYear').value;
            const baseValueCurrent = normalizeDecimal(document.getElementById('baseValueCurrent').value);
            const targetYear = document.getElementById('targetYear').value;
            const targetValue = normalizeDecimal(document.getElementById('targetValue').value);
            const manualYearlyTargets = document.getElementById('manualYearlyTargets').checked;
            const goalType = document.getElementById('goalTypeQuantitative').checked ? '1' : '0';
            const unit = document.getElementById('goalUnit').value.trim();

            // Client-side validation
            if (!name || !frameworkCode || !startingYear || !baseValueStarting || !currentYear || !baseValueCurrent || !targetYear || !targetValue) {
                showErrorMessage('@Localizer["Please fill in all required fields."]');
                return;
            }

            // Validate decimal values
            if (isNaN(parseFloat(baseValueStarting)) || isNaN(parseFloat(baseValueCurrent)) || isNaN(parseFloat(targetValue))) {
                showErrorMessage('@Localizer["Please enter valid numeric values."]');
                return;
            }

            // A quantitative goal is meaningless without a unit of measure
            if (goalType === '1' && !unit) {
                showErrorMessage('@Localizer["Please enter a unit of measure for a quantitative goal."]');
                document.getElementById('goalUnit').focus();
                return;
            }

            // Create FormData for form-encoded submission
            const formData = new FormData();
            formData.append('Name', name);
            formData.append('FrameworkCode', frameworkCode);
            formData.append('StartingYear', startingYear);
            formData.append('BaseValueForStartingYear', baseValueStarting);
            formData.append('CurrentYear', currentYear);
            formData.append('BaseValueForCurrentYear', baseValueCurrent);
            formData.append('TargetYear', targetYear);
            formData.append('TargetValue', targetValue);
            formData.append('ManualYearlyTargets', manualYearlyTargets ? 'true' : 'false');
            formData.append('GoalType', goalType);
            if (goalType === '1') {
                formData.append('Unit', unit);
            }
            formData.append('__RequestVerificationToken', token);

            // Append manual target year/value pairs if enabled
            if (manualYearlyTargets) {
                const yearInputs = document.querySelectorAll('#manualTargetsInputs input[name^="ManualTargetYears"]');
                const valueInputs = document.querySelectorAll('#manualTargetsInputs input[name^="ManualTargetValues"]');
                yearInputs.forEach(function(input, idx) {
                    formData.append(input.name, input.value);
                });
                valueInputs.forEach(function(input, idx) {
                    formData.append(input.name, normalizeDecimal(input.value));
                });
            }

            // Debug logging
            console.log('Submitting form with values:', {
                name, frameworkCode, startingYear, baseValueStarting,
                currentYear, baseValueCurrent, targetYear, targetValue
            });

            try {
                const response = await fetch('@Url.Action("CreateInline", "FrameworkGoals")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                console.log('Server response:', result);

                if (result.success) {
                    // Show success message
                    showSuccessMessage(result.message || '@Localizer["Goal created successfully!"]');

                    // Reload the page to show the new goal
                    setTimeout(() => location.reload(), 1500);
                } else {
                    // Log validation errors if present
                    if (result.validationErrors) {
                        console.log('Validation errors:', result.validationErrors);
                    }

                    // Handle error message
                    let errorMessage = result.message || '@Localizer["An error occurred. Please try again."]';
                    showErrorMessage(errorMessage);
                }
            } catch (error) {
                console.error('Error:', error);
                showErrorMessage('@Localizer["An error occurred. Please try again."]');
            }
        });

        // Show edit modal
        async function showEditModal(goalId, currentYear, baseValue, startingYear, targetYear) {
            // Set hidden fields
            document.getElementById('editGoalId').value = goalId;
            document.getElementById('editStartingYear').value = startingYear;
            document.getElementById('editTargetYear').value = targetYear;

            // Set form values
            document.getElementById('editCurrentYear').value = currentYear;
            document.getElementById('editBaseValue').value = baseValue;

            // Type and unit come from the goal's row — both are fixed at creation, so they are
            // rendered read-only here and never posted back by submitEdit().
            const row = document.getElementById(`goal-row-${goalId}`);
            const displayUnit = unitOfRow(row);
            const isQuantitative = row && row.getAttribute('data-goal-type') === '1';
            document.getElementById('editDisplayUnit').value = displayUnit;
            document.getElementById('editBaseValueUnit').textContent = displayUnit;
            document.getElementById('editBaseValueLabel').textContent = isQuantitative
                ? '@Localizer["Cumulative Quantity Achieved"]'
                : '@Localizer["Base Value (Current)"]';
            document.getElementById('editBaseValueHint').textContent = isQuantitative
                ? '@Localizer["Enter the cumulative quantity achieved, not the annual increment."]'
                : '@Localizer["Enter the actual achieved value for the current year"]';

            const editTypeBadge = document.getElementById('editGoalTypeBadge');
            editTypeBadge.textContent = (row ? row.getAttribute('data-goal-type-label') : '')
                + (isQuantitative ? ' · ' + displayUnit : '');
            editTypeBadge.className = 'badge goal-type-badge '
                + (isQuantitative ? 'goal-type-quantitative' : 'goal-type-qualitative');

            // Load historical values
            await loadHistoricalValues(goalId);

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }

        // Load historical values for the goal
        async function loadHistoricalValues(goalId) {
            try {
                const response = await fetch(`@Url.Action("GetYearlyValues", "FrameworkGoals")?goalId=${goalId}`);
                const result = await response.json();

                if (result.success) {
                    displayHistoricalValues(result.yearlyValues, result.startingYear, result.baseValueForStartingYear, result.currentYear, result.targetYear, goalId);
                } else {
                    document.getElementById('historicalValuesContainer').innerHTML = `
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>${result.message}
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error loading historical values:', error);
                document.getElementById('historicalValuesContainer').innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fas fa-times-circle me-2"></i>@Localizer["An error occurred while loading historical values."]
                    </div>
                `;
            }
        }

        // Display historical values table with editable fields
        function displayHistoricalValues(yearlyValues, startingYear, baseValueForStartingYear, currentYear, targetYear, goalId) {
            const displayUnit = document.getElementById('editDisplayUnit').value || '%';
            let tableHtml = `
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 30%;">@Localizer["Year"]</th>
                                <th style="width: 50%;">@Localizer["Actual Value"]</th>
                                <th style="width: 20%;" class="text-center">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            // Generate rows for all years between starting and current year (excluding current year which is above)
            for (let year = startingYear; year < currentYear; year++) {
                const isStartingYear = year === startingYear;

                // For starting year, use the baseValueForStartingYear; for others, look in yearlyValues
                let value = '';
                let dateRecorded = '-';

                if (isStartingYear) {
                    value = baseValueForStartingYear ? baseValueForStartingYear.toFixed(2) : '';
                } else {
                    const existingValue = yearlyValues.find(yv => yv.year === year);
                    value = existingValue ? existingValue.value.toFixed(2) : '';
                    dateRecorded = existingValue ? existingValue.dateRecorded : '-';
                }

                tableHtml += `
                    <tr>
                        <td class="align-middle">
                            <strong class="${isStartingYear ? 'text-primary' : ''}">${year}</strong>
                            ${isStartingYear ? '<small class="text-muted d-block">(@Localizer["Starting Year"])</small>' : ''}
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <input type="text"
                                       inputmode="decimal"
                                       class="form-control form-control-sm historical-value-input decimal-input"
                                       data-year="${year}"
                                       value="${value}"
                                       placeholder="@Localizer["Enter value"]">
                                <span class="input-group-text">${displayUnit}</span>
                            </div>
                        </td>
                        <td class="text-center align-middle">
                            <small class="text-muted">${dateRecorded}</small>
                        </td>
                    </tr>
                `;
            }

            if (startingYear >= currentYear) {
                tableHtml += `
                    <tr>
                        <td colspan="3" class="text-center text-muted py-3">
                            <i class="fas fa-info-circle me-2"></i>@Localizer["No previous years to update."]
                        </td>
                    </tr>
                `;
            }

            tableHtml += `
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-info mt-3">
                    <i class="fas fa-info-circle me-2"></i>
                    @Localizer["Update historical values to recalculate all associated metrics automatically."]
                </div>
            `;

            document.getElementById('historicalValuesContainer').innerHTML = tableHtml;
        }

        // Submit edit form
        async function submitEdit() {
            const goalId = document.getElementById('editGoalId').value;
            const currentYear = document.getElementById('editCurrentYear').value;
            const baseValue = normalizeDecimal(document.getElementById('editBaseValue').value);

            if (!currentYear || !baseValue) {
                showErrorMessage('@Localizer["Please fill in all required fields."]');
                return;
            }

            const token = document.querySelector('#editForm input[name="__RequestVerificationToken"]').value;

            // Collect all historical values (normalize decimal values)
            const historicalValues = [];
            document.querySelectorAll('.historical-value-input').forEach(input => {
                const year = parseInt(input.getAttribute('data-year'));
                const normalizedValue = normalizeDecimal(input.value);
                const value = parseFloat(normalizedValue);
                if (!isNaN(value) && normalizedValue !== '') {
                    historicalValues.push({ year, value });
                }
            });

            // Prepare data to send
            const data = {
                id: goalId,
                currentYear: parseInt(currentYear),
                baseValueForCurrentYear: parseFloat(baseValue),
                yearlyValues: historicalValues
            };

            try {
                const response = await fetch('@Url.Action("UpdateGoalValues", "FrameworkGoals")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('editModal'));
                    modal.hide();

                    // Show success message
                    showSuccessMessage(result.message);

                    // Reload page to show updated values
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showErrorMessage(result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showErrorMessage('@Localizer["An error occurred. Please try again."]');
            }
        }

        // Show delete confirmation modal
        function deleteGoal(id) {
            document.getElementById('deleteGoalId').value = id;
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        // Confirm and execute delete
        async function confirmDelete() {
            const id = document.getElementById('deleteGoalId').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Close the modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
            modal.hide();

            try {
                const response = await fetch('@Url.Action("Delete", "FrameworkGoals")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });

                const result = await response.json();

                if (result.success) {
                    // Remove the row from the table with animation
                    const row = document.getElementById(`goal-row-${id}`);
                    row.style.transition = 'opacity 0.3s';
                    row.style.opacity = '0';

                    setTimeout(() => {
                        row.remove();

                        // Show success message
                        showSuccessMessage(result.message);

                        // Reload if no more goals
                        if (document.querySelectorAll('#goalsTable tbody tr').length === 0) {
                            setTimeout(() => location.reload(), 1500);
                        }
                    }, 300);
                } else {
                    showErrorMessage(result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showErrorMessage('@Localizer["An error occurred. Please try again."]');
            }
        }

        // ==================== BULK OPERATIONS ====================

        // Toggle select all checkboxes
        function toggleSelectAll(checkbox) {
            const visibleRows = document.querySelectorAll('#goalsTable tbody tr.goal-row:not([style*="display: none"])');
            visibleRows.forEach(row => {
                const rowCheckbox = row.querySelector('.row-checkbox');
                if (rowCheckbox) {
                    rowCheckbox.checked = checkbox.checked;
                }
            });
            updateSelection();
        }

        // Update selection count and show/hide bulk toolbar
        function updateSelection() {
            const checkboxes = document.querySelectorAll('.row-checkbox:checked');
            const count = checkboxes.length;
            const toolbar = document.getElementById('bulkActionsToolbar');
            const countBadge = document.getElementById('selectedCount');
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const compareBtn = document.getElementById('compareBtn');
            const compareBtnCount = document.getElementById('compareBtnCount');

            countBadge.textContent = count;

            if (count > 0) {
                toolbar.style.display = 'block';
                toolbar.classList.add('slide-in');
            } else {
                toolbar.style.display = 'none';
                toolbar.classList.remove('slide-in');
            }

            // Update compare button state (requires 2+ selections)
            if (compareBtn) {
                compareBtnCount.textContent = count;
                if (count >= 2) {
                    compareBtn.disabled = false;
                    compareBtn.classList.add('btn-purple-active');
                } else {
                    compareBtn.disabled = true;
                    compareBtn.classList.remove('btn-purple-active');
                }
            }

            // Update select all checkbox state
            const visibleRows = document.querySelectorAll('#goalsTable tbody tr.goal-row:not([style*="display: none"])');
            const visibleCheckboxes = Array.from(visibleRows).map(row => row.querySelector('.row-checkbox')).filter(cb => cb);
            const checkedVisibleCheckboxes = visibleCheckboxes.filter(cb => cb.checked);

            if (visibleCheckboxes.length > 0 && checkedVisibleCheckboxes.length === visibleCheckboxes.length) {
                selectAllCheckbox.checked = true;
                selectAllCheckbox.indeterminate = false;
            } else if (checkedVisibleCheckboxes.length > 0) {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.indeterminate = true;
            } else {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.indeterminate = false;
            }
        }

        // Clear all selections
        function clearSelection() {
            document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = false);
            document.getElementById('selectAllCheckbox').checked = false;
            document.getElementById('selectAllCheckbox').indeterminate = false;
            updateSelection();
        }

        // Get selected goal IDs
        function getSelectedGoalIds() {
            return Array.from(document.querySelectorAll('.row-checkbox:checked')).map(cb => cb.value);
        }

        // Get selected rows data
        function getSelectedRowsData() {
            const selectedIds = getSelectedGoalIds();
            const rows = [];
            selectedIds.forEach(id => {
                const row = document.getElementById(`goal-row-${id}`);
                if (row) {
                    rows.push(row);
                }
            });
            return rows;
        }

        // Bulk delete function
        function bulkDelete() {
            const selectedIds = getSelectedGoalIds();
            if (selectedIds.length === 0) {
                showErrorMessage('@Localizer["No goals selected"]');
                return;
            }

            document.getElementById('bulkDeleteCount').innerHTML =
                `${selectedIds.length} @Localizer["goals will be deleted"]`;

            const modal = new bootstrap.Modal(document.getElementById('bulkDeleteModal'));
            modal.show();
        }

        // Confirm and execute bulk delete
        async function confirmBulkDelete() {
            const selectedIds = getSelectedGoalIds();
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Close the modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('bulkDeleteModal'));
            modal.hide();

            let successCount = 0;
            let errorCount = 0;

            for (const id of selectedIds) {
                try {
                    const response = await fetch('@Url.Action("Delete", "FrameworkGoals")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
                    });

                    const result = await response.json();

                    if (result.success) {
                        const row = document.getElementById(`goal-row-${id}`);
                        if (row) {
                            row.style.transition = 'opacity 0.3s';
                            row.style.opacity = '0';
                            setTimeout(() => row.remove(), 300);
                        }
                        successCount++;
                    } else {
                        errorCount++;
                    }
                } catch (error) {
                    console.error('Error deleting goal:', error);
                    errorCount++;
                }
            }

            // Clear selection
            clearSelection();

            // Show results
            if (successCount > 0) {
                showSuccessMessage(`${successCount} @Localizer["goals deleted successfully"]`);
            }
            if (errorCount > 0) {
                showErrorMessage(`${errorCount} @Localizer["goals failed to delete"]`);
            }

            // Reload if no more goals
            setTimeout(() => {
                if (document.querySelectorAll('#goalsTable tbody tr.goal-row').length === 0) {
                    location.reload();
                }
            }, 500);
        }

        // Export selected to Excel
        function exportSelectedToExcel() {
            const selectedRows = getSelectedRowsData();
            if (selectedRows.length === 0) {
                showErrorMessage('@Localizer["No goals selected"]');
                return;
            }

            const data = [];
            // Headers
            data.push(['@Localizer["Goal Name"]', '@Localizer["Framework"]', '@Localizer["Goal Type"]', '@Localizer["Unit of Measure"]', '@Localizer["Starting Year"]', '@Localizer["Current Year"]', '@Localizer["Target Year"]', '@Localizer["Starting Value"]', '@Localizer["Current Value"]', '@Localizer["Target Value"]', '@Localizer["Progress Rate"]', '@Localizer["Discount Rate"]', '@Localizer["Status"]']);

            selectedRows.forEach(row => {
                const unit = unitOfRow(row);
                data.push([
                    row.dataset.goalNameDisplay || '',
                    row.dataset.frameworkName || '',
                    row.dataset.goalTypeLabel || '',
                    unit,
                    row.dataset.startingYear || '',
                    row.dataset.currentYear || '',
                    row.dataset.targetYear || '',
                    formatWithUnit(parseFloat(row.dataset.baseValueStarting || 0), unit),
                    formatWithUnit(parseFloat(row.dataset.baseValueCurrent || 0), unit),
                    formatWithUnit(parseFloat(row.dataset.targetValue || 0), unit),
                    // Progress is a ratio and stays a percentage; the annual rate is in the goal's unit
                    parseFloat(row.dataset.progressRate || 0).toFixed(2) + '%',
                    formatWithUnit(parseFloat(row.dataset.discountRate || 0), unit),
                    row.dataset.status || ''
                ]);
            });

            const ws = XLSX.utils.aoa_to_sheet(data);
            ws['!dir'] = 'rtl';
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, '@Localizer["Framework Goals"]');
            XLSX.writeFile(wb, 'FrameworkGoals_Selected_' + new Date().toISOString().slice(0, 10) + '.xlsx');
            showSuccessMessage('@Localizer["Excel exported successfully!"]');
        }

        // Export selected to CSV
        function exportSelectedToCSV() {
            const selectedRows = getSelectedRowsData();
            if (selectedRows.length === 0) {
                showErrorMessage('@Localizer["No goals selected"]');
                return;
            }

            const headers = ['@Localizer["Goal Name"]', '@Localizer["Framework"]', '@Localizer["Goal Type"]', '@Localizer["Unit of Measure"]', '@Localizer["Starting Year"]', '@Localizer["Current Year"]', '@Localizer["Target Year"]', '@Localizer["Starting Value"]', '@Localizer["Current Value"]', '@Localizer["Target Value"]', '@Localizer["Progress Rate"]', '@Localizer["Discount Rate"]', '@Localizer["Status"]'];

            let csv = headers.join('\t') + '\n';

            selectedRows.forEach(row => {
                const unit = unitOfRow(row);
                const rowData = [
                    row.dataset.goalNameDisplay || '',
                    row.dataset.frameworkName || '',
                    row.dataset.goalTypeLabel || '',
                    unit,
                    row.dataset.startingYear || '',
                    row.dataset.currentYear || '',
                    row.dataset.targetYear || '',
                    formatWithUnit(parseFloat(row.dataset.baseValueStarting || 0), unit),
                    formatWithUnit(parseFloat(row.dataset.baseValueCurrent || 0), unit),
                    formatWithUnit(parseFloat(row.dataset.targetValue || 0), unit),
                    // Progress is a ratio and stays a percentage; the annual rate is in the goal's unit
                    parseFloat(row.dataset.progressRate || 0).toFixed(2) + '%',
                    formatWithUnit(parseFloat(row.dataset.discountRate || 0), unit),
                    row.dataset.status || ''
                ];
                csv += rowData.join('\t') + '\n';
            });

            downloadFileWithBOM(csv, 'FrameworkGoals_Selected_' + new Date().toISOString().slice(0, 10) + '.csv');
            showSuccessMessage('@Localizer["CSV exported successfully!"]');
        }

