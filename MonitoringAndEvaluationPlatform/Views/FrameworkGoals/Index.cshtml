@model IEnumerable<MonitoringAndEvaluationPlatform.Models.FrameworkGoal>

@using MonitoringAndEvaluationPlatform.Enums
@using MonitoringAndEvaluationPlatform.Helpers
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "Framework Goals";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    ViewData["HelpFeature"] = "FrameworkGoals";
    var culture = Context.Features.Get<IRequestCultureFeature>().RequestCulture.Culture.Name;

    // Resolve the selected framework's name once (used by the header label and the create-goal badge)
    string selectedFrameworkName = "";
    if (ViewBag.SelectedFrameworkCode != null)
    {
        foreach (var fw in ViewBag.Frameworks)
        {
            if (fw.Code == ViewBag.SelectedFrameworkCode) { selectedFrameworkName = fw.Name; }
        }
    }
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="dashboard-title">
                <i class="fas fa-bullseye me-3"></i>
                @Localizer["Framework Goals"]
            </h1>
            <p class="dashboard-subtitle">
                @Localizer["Manage goals and targets for monitoring frameworks"]
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            @await Html.PartialAsync("_HelpButton")
            <a asp-action="ValueProgressView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-primary btn-lg shadow-sm">
                <i class="fas fa-chart-bar me-2"></i>@Localizer["Value Progress"]
            </a>
            <a asp-action="StatusBadgesView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-success btn-lg shadow-sm">
                <i class="fas fa-tags me-2"></i>@Localizer["Status Badges"]
            </a>
            <a asp-action="MetricsGridView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-info btn-lg shadow-sm">
                <i class="fas fa-th me-2"></i>@Localizer["Metrics Grid"]
            </a>
            <a asp-action="TimelineView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-warning btn-lg shadow-sm">
                <i class="fas fa-project-diagram me-2"></i>@Localizer["Timeline View"]
            </a>
            <a asp-action="CircularGaugeView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-secondary btn-lg shadow-sm">
                <i class="fas fa-tachometer-alt me-2"></i>@Localizer["Circular Gauges"]
            </a>
            <a asp-action="ProgressView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-dark btn-lg shadow-sm">
                <i class="fas fa-chart-pie me-2"></i>@Localizer["Cards View"]
            </a>
            <a asp-action="ChartsView" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" class="btn btn-primary btn-lg shadow-sm">
                <i class="fas fa-chart-area me-2"></i>@Localizer["Performance Charts"]
            </a>
            @if (SignInManager.IsSignedIn(User))
            {
                var user = await UserManager.GetUserAsync(User);
                if (user != null)
                {
                    var roles = await UserManager.GetRolesAsync(user);
                    if (roles.Contains("SystemAdministrator") || roles.Contains("MinistryStrategyManager"))
                    {
                        <button onclick="toggleInlineCreate()" class="btn btn-primary btn-lg shadow-sm" id="createGoalBtn">
                            <i class="fas fa-plus me-2"></i>@Localizer["Add New Goal"]
                        </button>
                    }
                }
            }
        </div>
    </div>
</div>

@if (ViewBag.SelectedFrameworkCode != null)
{
    <div class="d-flex align-items-center mb-3">
        <i class="fas fa-sitemap me-2 text-info fs-4"></i>
        <span class="fw-bold me-2">@Localizer["Framework"]:</span>
        <span class="badge bg-info fs-6">@selectedFrameworkName</span>
    </div>
}

<!-- Advanced Filter Section -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
            <i class="fas fa-filter me-2"></i>@Localizer["Advanced Filters"]
        </h6>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetFilters()">
            <i class="fas fa-redo me-1"></i>@Localizer["Reset Filters"]
        </button>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <!-- Search Bar -->
            <div class="col-md-6 col-lg-3">
                <label class="form-label">
                    <i class="fas fa-search me-1"></i>@Localizer["Search Goal Name"]
                </label>
                <input type="text" id="searchGoal" class="form-control" placeholder="@Localizer["Type to search..."]" oninput="applyFilters()">
            </div>

            <!-- Framework Filter (hidden when a specific framework is already selected via the URL) -->
            <div class="col-md-6 col-lg-3@(ViewBag.SelectedFrameworkCode != null ? " d-none" : "")">
                <label class="form-label">
                    <i class="fas fa-sitemap me-1"></i>@Localizer["Framework"]
                </label>
                <select id="frameworkFilter" class="form-select" onchange="applyFilters()">
                    <option value="">@Localizer["All Frameworks"]</option>
                    @foreach (var framework in ViewBag.Frameworks)
                    {
                        <option value="@framework.Code">@framework.Name</option>
                    }
                </select>
            </div>

            <!-- Status Filter -->
            <div class="col-md-6 col-lg-3">
                <label class="form-label">
                    <i class="fas fa-signal me-1"></i>@Localizer["Status"]
                </label>
                <select id="statusFilter" class="form-select" onchange="applyFilters()">
                    <option value="">@Localizer["All Status"]</option>
                    <option value="on-track">@Localizer["On Track"]</option>
                    <option value="at-risk">@Localizer["At Risk"]</option>
                    <option value="off-track">@Localizer["Off Track"]</option>
                </select>
            </div>

            <!-- Progress Range Filter -->
            <div class="col-md-6 col-lg-3">
                <label class="form-label">
                    <i class="fas fa-percentage me-1"></i>@Localizer["Progress Range"]
                </label>
                <select id="progressRangeFilter" class="form-select" onchange="applyFilters()">
                    <option value="">@Localizer["All Progress"]</option>
                    <option value="0-25">0% - 25%</option>
                    <option value="25-50">25% - 50%</option>
                    <option value="50-75">50% - 75%</option>
                    <option value="75-100">75% - 100%</option>
                    <option value="100+">100%+</option>
                </select>
            </div>

            <!-- Goal Type Filter -->
            <div class="col-md-6 col-lg-3">
                <label class="form-label">
                    <i class="fas fa-shapes me-1"></i>@Localizer["Goal Type"]
                </label>
                <select id="goalTypeFilter" class="form-select" onchange="applyFilters()">
                    <option value="">@Localizer["All Types"]</option>
                    <option value="0">@Localizer["Qualitative"]</option>
                    <option value="1">@Localizer["Quantitative"]</option>
                </select>
            </div>
        </div>

        <!-- Filter Results Counter -->
        <div class="mt-3">
            <div class="alert alert-info mb-0 py-2" id="filterResults" style="display: none;">
                <i class="fas fa-info-circle me-2"></i>
                <span id="filterResultsText"></span>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard Summary Cards -->
@if (Model.Any())
{
    var currentYear = DateTime.Now.Year;
    var totalGoals = Model.Count();

    // On-track vs off-track, from the single canonical FrameworkGoal.TrackingStatus (at-risk
    // folds into "off-track" here since this card only has two buckets; the row-level status
    // below and the #statusFilter dropdown surface the at-risk tier separately).
    var onTrackCount = 0;
    var offTrackCount = 0;
    var totalProgressRate = 0.0;

    foreach (var goal in Model)
    {
        if (goal.TrackingStatus == FrameworkGoalTrackingStatus.OnTrack)
        {
            onTrackCount++;
        }
        else
        {
            offTrackCount++;
        }

        totalProgressRate += goal.ProgressRate;
    }

    var onTrackPercentage = totalGoals > 0 ? (onTrackCount * 100.0 / totalGoals) : 0;
    var offTrackPercentage = totalGoals > 0 ? (offTrackCount * 100.0 / totalGoals) : 0;
    var averageProgressRate = totalGoals > 0 ? (totalProgressRate / totalGoals) : 0;

    // Calculate goals expiring soon (within 1 year)
    var goalsExpiringSoon = Model.Count(g => g.TargetYear - currentYear <= 1 && g.TargetYear >= currentYear);

    <div class="row g-3 mb-4">
        <!-- Total Goals Card -->
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-primary">
                <div class="summary-card-icon">
                    <i class="fas fa-bullseye"></i>
                </div>
                <div class="summary-card-content">
                    <h3 class="summary-card-value">@totalGoals</h3>
                    <p class="summary-card-label">@Localizer["Total Goals"]</p>
                </div>
            </div>
        </div>

        <!-- On-Track vs Off-Track Card -->
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-success">
                <div class="summary-card-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="summary-card-content">
                    <h3 class="summary-card-value">@onTrackCount / @offTrackCount</h3>
                    <p class="summary-card-label">@Localizer["On-Track / Off-Track"]</p>
                    <div class="progress mt-2" style="height: 8px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @onTrackPercentage.ToString("F0")%" aria-valuenow="@onTrackPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                        <div class="progress-bar bg-danger" role="progressbar" style="width: @offTrackPercentage.ToString("F0")%" aria-valuenow="@offTrackPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <small class="text-muted">@onTrackPercentage.ToString("F1")% @Localizer["On Track"]</small>
                </div>
            </div>
        </div>

        <!-- Average Progress Rate Card -->
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-info">
                <div class="summary-card-icon">
                    <i class="fas fa-percentage"></i>
                </div>
                <div class="summary-card-content">
                    <h3 class="summary-card-value">@averageProgressRate.ToString("F1")%</h3>
                    <p class="summary-card-label">@Localizer["Average Progress"]</p>
                    <div class="progress mt-2" style="height: 8px;">
                        <div class="progress-bar bg-info" role="progressbar" style="width: @Math.Min(averageProgressRate, 100)%" aria-valuenow="@averageProgressRate" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Goals Expiring Soon Card -->
        <div class="col-md-3 col-sm-6">
            <div class="summary-card summary-card-warning">
                <div class="summary-card-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="summary-card-content">
                    <h3 class="summary-card-value">@goalsExpiringSoon</h3>
                    <p class="summary-card-label">@Localizer["Expiring Soon"]</p>
                    <small class="text-muted">@Localizer["Within 1 year"]</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Smart Alerts Section -->
    // Calculate alerts
    var goalsFallingBehind = new List<dynamic>();
    var goalsNeedingUpdate = new List<dynamic>();
    var goalsReachingTarget = new List<dynamic>();

    foreach (var goal in Model)
        {
            // Derived from the single canonical FrameworkGoal.TrackingStatus, so this alert never
            // disagrees with the row's off-track badge for the same goal
            var isFallingBehind = goal.TrackingStatus == FrameworkGoalTrackingStatus.OffTrack;

            if (isFallingBehind)
            {
                goalsFallingBehind.Add(new { Goal = goal, ProgressRate = goal.ProgressRate });
            }

            // Check if current year is outdated (more than 1 year old)
            if (goal.CurrentYear < currentYear)
            {
                goalsNeedingUpdate.Add(new { Goal = goal, YearsOutdated = currentYear - goal.CurrentYear });
            }

            // Check if reaching target soon (within 1 year)
            if (goal.TargetYear - currentYear <= 1 && goal.TargetYear >= currentYear)
            {
                goalsReachingTarget.Add(new { Goal = goal, YearsRemaining = goal.TargetYear - currentYear });
            }
        }

    var totalAlerts = goalsFallingBehind.Count + goalsNeedingUpdate.Count + goalsReachingTarget.Count;

    @if (totalAlerts > 0)
    {
        <div class="card shadow-sm mb-4 alert-card">
            <div class="card-header bg-warning bg-opacity-10 border-warning" style="cursor: pointer;" onclick="toggleSmartAlerts()">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                        @Localizer["Smart Alerts"]
                        <span class="badge bg-warning text-dark ms-2">@totalAlerts</span>
                    </h6>
                    <i class="fas fa-chevron-down" id="alertsChevron"></i>
                </div>
            </div>
            <div class="card-body" id="smartAlertsBody" style="display: none;">
                <div class="row g-3">
                    <!-- Goals Falling Behind -->
                    @if (goalsFallingBehind.Any())
                    {
                        <div class="col-12">
                            <div class="alert alert-danger mb-0">
                                <h6 class="alert-heading">
                                    <i class="fas fa-chart-line-down me-2"></i>
                                    @Localizer["Goals Falling Behind"]
                                    <span class="badge bg-danger ms-2">@goalsFallingBehind.Count</span>
                                </h6>
                                <hr>
                                <ul class="mb-0">
                                    @foreach (var item in goalsFallingBehind)
                                    {
                                        <li>
                                            <strong>@item.Goal.Name</strong>
                                            <span class="text-muted">(@item.Goal.Framework.Name)</span>
                                            - Progress: <span class="badge bg-danger">@item.ProgressRate.ToString("N1")%</span>
                                            <a href="@Url.Action("FrameworkGoalsTimeline", "Dashboard", new { goalId = item.Goal.ID, frameworkCode = item.Goal.FrameworkCode })" class="btn btn-sm btn-outline-danger ms-2">
                                                <i class="fas fa-chart-line"></i> @Localizer["View"]
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    <!-- Goals Needing Update -->
                    @if (goalsNeedingUpdate.Any())
                    {
                        <div class="col-12">
                            <div class="alert alert-warning mb-0">
                                <h6 class="alert-heading">
                                    <i class="fas fa-calendar-exclamation me-2"></i>
                                    @Localizer["Goals Needing Update"]
                                    <span class="badge bg-warning text-dark ms-2">@goalsNeedingUpdate.Count</span>
                                </h6>
                                <hr>
                                <ul class="mb-0">
                                    @foreach (var item in goalsNeedingUpdate)
                                    {
                                        <li>
                                            <strong>@item.Goal.Name</strong>
                                            <span class="text-muted">(@item.Goal.Framework.Name)</span>
                                            - Current Year: <span class="badge bg-warning text-dark">@item.Goal.CurrentYear</span>
                                            <span class="text-danger">(@item.YearsOutdated @Localizer["years outdated"])</span>
                                            @if (SignInManager.IsSignedIn(User))
                                            {
                                                var user = await UserManager.GetUserAsync(User);
                                                if (user != null)
                                                {
                                                    var roles = await UserManager.GetRolesAsync(user);
                                                    if (roles.Contains("SystemAdministrator") || roles.Contains("MinistryStrategyManager"))
                                                    {
                                                        <button onclick="showEditModal(@item.Goal.ID, @item.Goal.CurrentYear, @item.Goal.BaseValueForCurrentYear.ToString(System.Globalization.CultureInfo.InvariantCulture), @item.Goal.StartingYear, @item.Goal.TargetYear)" class="btn btn-sm btn-outline-warning ms-2">
                                                            <i class="fas fa-edit"></i> @Localizer["Update"]
                                                        </button>
                                                    }
                                                }
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    <!-- Goals Reaching Target Soon -->
                    @if (goalsReachingTarget.Any())
                    {
                        <div class="col-12">
                            <div class="alert alert-info mb-0">
                                <h6 class="alert-heading">
                                    <i class="fas fa-flag-checkered me-2"></i>
                                    @Localizer["Goals Reaching Target Soon"]
                                    <span class="badge bg-info ms-2">@goalsReachingTarget.Count</span>
                                </h6>
                                <hr>
                                <ul class="mb-0">
                                    @foreach (var item in goalsReachingTarget)
                                    {
                                        <li>
                                            <strong>@item.Goal.Name</strong>
                                            <span class="text-muted">(@item.Goal.Framework.Name)</span>
                                            - Target Year: <span class="badge bg-info">@item.Goal.TargetYear</span>
                                            @if (item.YearsRemaining == 0)
                                            {
                                                <span class="text-danger fw-bold">(@Localizer["This year"]!)</span>
                                            }
                                            else
                                            {
                                                <span class="text-info">(@item.YearsRemaining @Localizer["year remaining"])</span>
                                            }
                                            <a href="@Url.Action("FrameworkGoalsTimeline", "Dashboard", new { goalId = item.Goal.ID, frameworkCode = item.Goal.FrameworkCode })" class="btn btn-sm btn-outline-info ms-2">
                                                <i class="fas fa-chart-line"></i> @Localizer["View"]
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

<!-- Inline Create Form (Initially Hidden) -->
<div id="inlineCreateForm" class="card shadow-sm mb-4" style="display: none;">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="fas fa-plus-circle me-2"></i>@Localizer["Create New Framework Goal"]
        </h5>
    </div>
    <div class="card-body">
        <form id="createGoalForm">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Localizer["Goal Name"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="goalName" name="Name" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Localizer["Framework"] <span class="text-danger">*</span></label>
                    @if (ViewBag.SelectedFrameworkCode != null)
                    {
                        <input type="hidden" id="frameworkCode" name="FrameworkCode" value="@ViewBag.SelectedFrameworkCode" />
                        <div class="form-control-plaintext">
                            <span class="badge bg-info fs-6"><i class="fas fa-sitemap me-1"></i>@selectedFrameworkName</span>
                        </div>
                    }
                    else
                    {
                        <select class="form-select" id="frameworkCode" name="FrameworkCode" required>
                            <option value="">@Localizer["Select Framework"]</option>
                            @foreach (var framework in ViewBag.Frameworks)
                            {
                                <option value="@framework.Code">@framework.Name</option>
                            }
                        </select>
                    }
                </div>
            </div>
            <!-- Goal Type (permanent, set at creation only) -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">@Localizer["Goal Type"] <span class="text-danger">*</span></label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="GoalType" id="goalTypeQualitative" value="0" checked onchange="onGoalTypeChange()" />
                        <label class="form-check-label" for="goalTypeQualitative">
                            <strong>@Localizer["Qualitative"]</strong>
                            <span class="text-muted small">&mdash; @Localizer["values are percentages"]</span>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="GoalType" id="goalTypeQuantitative" value="1" onchange="onGoalTypeChange()" />
                        <label class="form-check-label" for="goalTypeQuantitative">
                            <strong>@Localizer["Quantitative"]</strong>
                            <span class="text-muted small">&mdash; @Localizer["values are quantities with a unit of measure"]</span>
                        </label>
                    </div>
                    <div class="form-text text-muted">
                        <i class="fas fa-lock me-1"></i>@Localizer["The goal type cannot be changed after creation."]
                    </div>
                </div>
                <div class="col-md-6" id="unitFieldWrapper" style="display:none;">
                    <label class="form-label">@Localizer["Unit of Measure"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="goalUnit" name="Unit" list="unitSuggestions" maxlength="100" placeholder="@Localizer["e.g. km, housing unit, school"]" />
                    <datalist id="unitSuggestions">
                        <option value="@Localizer["km"]"></option>
                        <option value="@Localizer["m2"]"></option>
                        <option value="@Localizer["housing unit"]"></option>
                        <option value="@Localizer["school"]"></option>
                        <option value="@Localizer["beneficiary"]"></option>
                        <option value="@Localizer["ton"]"></option>
                        <option value="@Localizer["megawatt"]"></option>
                    </datalist>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Starting Year"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control year-picker" id="startingYear" name="StartingYear" required readonly placeholder="@Localizer["Select Year"]" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label" id="baseValueStartingLabel" data-label-qualitative="@Localizer["Base Value (Starting)"]" data-label-quantitative="@Localizer["Quantity Achieved in Base Year"]">@Localizer["Base Value (Starting)"]</label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <input type="text" inputmode="decimal" class="form-control decimal-input" id="baseValueStarting" name="BaseValueForStartingYear" required placeholder="0.00" />
                        <span class="input-group-text unit-suffix">%</span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Current Year"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control year-picker" id="currentYear" name="CurrentYear" required readonly placeholder="@Localizer["Select Year"]" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label" id="baseValueCurrentLabel" data-label-qualitative="@Localizer["Base Value (Current)"]" data-label-quantitative="@Localizer["Cumulative Quantity Achieved"]">@Localizer["Base Value (Current)"]</label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <input type="text" inputmode="decimal" class="form-control decimal-input" id="baseValueCurrent" name="BaseValueForCurrentYear" required placeholder="0.00" />
                        <span class="input-group-text unit-suffix">%</span>
                    </div>
                    <div class="form-text text-muted" id="cumulativeHint" style="display:none;">
                        <i class="fas fa-info-circle me-1"></i>@Localizer["Enter the cumulative quantity achieved, not the annual increment."]
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">@Localizer["Target Year"] <span class="text-danger">*</span></label>
                    <input type="text" class="form-control year-picker" id="targetYear" name="TargetYear" required readonly placeholder="@Localizer["Select Year"]" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label" id="targetValueLabel" data-label-qualitative="@Localizer["Target Value"]" data-label-quantitative="@Localizer["Total Target Quantity"]">@Localizer["Target Value"]</label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <input type="text" inputmode="decimal" class="form-control decimal-input" id="targetValue" name="TargetValue" required placeholder="0.00" />
                        <span class="input-group-text unit-suffix">%</span>
                    </div>
                </div>
            </div>
            <!-- Manual Yearly Targets Option -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="manualYearlyTargets" name="ManualYearlyTargets" value="true" onchange="onManualTargetsToggle()" />
                        <input type="hidden" name="ManualYearlyTargets" value="false" />
                        <label class="form-check-label fw-semibold" for="manualYearlyTargets">
                            <i class="fas fa-edit me-1 text-warning"></i>@Localizer["Set Expected Targets Manually"]
                        </label>
                        <div class="form-text text-muted">
                            @Localizer["When enabled, you can set the expected target values for each intermediate year manually instead of using the auto-calculated linear values. This setting cannot be changed after creation."]
                        </div>
                    </div>
                </div>
            </div>

            <!-- Manual Expected Targets Section (shown only when checkbox is checked) -->
            <div id="manualTargetsSection" style="display:none;" class="mb-3">
                <div class="card border-warning">
                    <div class="card-header bg-warning bg-opacity-10">
                        <h6 class="mb-0 text-warning">
                            <i class="fas fa-sliders-h me-2"></i>@Localizer["Manual Expected Targets for Intermediate Years"]
                        </h6>
                        <small class="text-muted">@Localizer["Set the expected target value for each year between Starting Year and Target Year (excluding Starting Year, Current Year, and Target Year)."]</small>
                    </div>
                    <div class="card-body" id="manualTargetsInputs">
                        <p class="text-muted small">@Localizer["Fill in all year and value fields above first, then check the checkbox to enter manual targets."]</p>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save me-2"></i>@Localizer["Save Goal"]
                </button>
                <button type="button" class="btn btn-secondary" onclick="toggleInlineCreate()">
                    <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Bulk Actions Toolbar (Initially Hidden) -->
<div id="bulkActionsToolbar" class="card shadow-sm mb-3 bulk-toolbar" style="display: none;">
    <div class="card-body py-2">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary fs-6" id="selectedCount">0</span>
                <span class="text-muted">@Localizer["selected"]</span>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="clearSelection()">
                    <i class="fas fa-times me-1"></i>@Localizer["Clear Selection"]
                </button>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-purple" id="compareBtn" onclick="openComparisonView()" title="@Localizer["Compare Selected Goals"]" disabled>
                    <i class="fas fa-columns me-1"></i>@Localizer["Compare"]
                    <span class="badge bg-light text-dark ms-1" id="compareBtnCount">0</span>
                </button>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="exportSelectedToExcel()" title="@Localizer["Export Selected to Excel"]">
                        <i class="fas fa-file-excel me-1"></i>Excel
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="exportSelectedToCSV()" title="@Localizer["Export Selected to CSV"]">
                        <i class="fas fa-file-csv me-1"></i>CSV
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info" onclick="exportSelectedToPDF()" title="@Localizer["Export Selected to PDF"]">
                        <i class="fas fa-file-pdf me-1"></i>PDF
                    </button>
                </div>
                @if (SignInManager.IsSignedIn(User))
                {
                    var bulkUser = await UserManager.GetUserAsync(User);
                    if (bulkUser != null)
                    {
                        var bulkRoles = await UserManager.GetRolesAsync(bulkUser);
                        if (bulkRoles.Contains("SystemAdministrator") || bulkRoles.Contains("MinistryStrategyManager"))
                        {
                            <button type="button" class="btn btn-sm btn-danger" onclick="bulkDelete()">
                                <i class="fas fa-trash me-1"></i>@Localizer["Delete Selected"]
                            </button>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Goals Table -->
<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0">@Localizer["Framework Goals List"]</h5>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <!-- Export Buttons -->
            <div class="btn-group export-btn-group" role="group" aria-label="Export options">
                <button type="button" class="btn btn-outline-success btn-sm" onclick="exportToExcel()" title="@Localizer["Export to Excel"]">
                    <i class="fas fa-file-excel me-1"></i>Excel
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="exportToCSV()" title="@Localizer["Export to CSV"]">
                    <i class="fas fa-file-csv me-1"></i>CSV
                </button>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="exportToPDF()" title="@Localizer["Export to PDF"]">
                    <i class="fas fa-file-pdf me-1"></i>PDF
                </button>
            </div>
            <!-- Page Size Selector -->
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 text-muted small">@Localizer["Show"]</label>
                <select id="pageSizeSelect" class="form-select form-select-sm" style="width: auto;" onchange="changePageSize()">
                    <option value="10">10</option>
                    <option value="25" selected>25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="-1">@Localizer["All"]</option>
                </select>
                <label class="form-label mb-0 text-muted small">@Localizer["entries"]</label>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover" id="goalsTable">
                    <thead class="table-primary bg-opacity-25">
                        <tr>
                            <th rowspan="2" class="align-middle text-center checkbox-column" style="width: 50px;">
                                <div class="form-check d-flex justify-content-center">
                                    <input class="form-check-input" type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll(this)">
                                </div>
                            </th>
                            <th rowspan="2" class="align-middle sortable-header" data-sort="name" onclick="sortTable('name')">
                                @Localizer["Goal Name"]
                                <span class="sort-icon"><i class="fas fa-sort"></i></span>
                            </th>
                            <th rowspan="2" class="align-middle sortable-header" data-sort="framework" onclick="sortTable('framework')">
                                @Localizer["Framework"]
                                <span class="sort-icon"><i class="fas fa-sort"></i></span>
                            </th>
                            <th rowspan="2" class="align-middle text-center">@Localizer["Trend"]</th>
                            @{
                                // Calculate the full year range across ALL goals
                                int minYear = Model.Any() ? Model.Min(g => g.StartingYear) : DateTime.Now.Year;
                                int maxYear = Model.Any() ? Model.Max(g => g.TargetYear) : DateTime.Now.Year;

                                for (int year = minYear; year <= maxYear; year++)
                                {
                                    <th colspan="2" class="text-center year-header">@year</th>
                                }
                            }
                            <th rowspan="2" class="align-middle sortable-header" data-sort="discountRate" onclick="sortTable('discountRate')">
                                @Localizer["Annual Discount Rate"]
                                <span class="sort-icon"><i class="fas fa-sort"></i></span>
                            </th>
                            <th rowspan="2" class="align-middle sortable-header" data-sort="progressRate" onclick="sortTable('progressRate')">
                                @Localizer["Progress Rate"]
                                <span class="sort-icon"><i class="fas fa-sort"></i></span>
                            </th>
                            <th rowspan="2" class="align-middle text-center" style="min-width: 150px;">
                                <div>@Localizer["progress Rate by Year"]</div>
                            </th>
                            <th rowspan="2" class="align-middle text-center">@Localizer["Actions"]</th>
                        </tr>
                        <tr>
                            @{
                                for (int year = minYear; year <= maxYear; year++)
                                {
                                    <th class="text-center sub-header">@Localizer["Base Value"]</th>
                                    <th class="text-center sub-header">@Localizer["Expected Target"]</th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var goal in Model)
                        {
                            // Derived from the single canonical FrameworkGoal.TrackingStatus
                            var goalStatus = goal.TrackingStatus switch
                            {
                                FrameworkGoalTrackingStatus.OnTrack => "on-track",
                                FrameworkGoalTrackingStatus.AtRisk => "at-risk",
                                _ => "off-track"
                            };

                            <tr id="goal-row-@goal.ID"
                                class="goal-row"
                                data-goal-id="@goal.ID"
                                data-goal-name="@goal.Name.ToLower()"
                                data-goal-name-display="@goal.Name"
                                data-framework-code="@goal.FrameworkCode"
                                data-framework-name="@goal.Framework.Name"
                                data-progress-rate="@goal.ProgressRate"
                                data-discount-rate="@goal.AnnualDiscountRate"
                                data-status="@goalStatus"
                                data-starting-year="@goal.StartingYear"
                                data-current-year="@goal.CurrentYear"
                                data-target-year="@goal.TargetYear"
                                data-base-value-starting="@goal.BaseValueForStartingYear.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-base-value-current="@goal.BaseValueForCurrentYear.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-target-value="@goal.TargetValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-amount-of-reduction="@goal.AmountOfReduction.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-is-increase-goal="@(goal.TargetValue > goal.BaseValueForStartingYear ? "true" : "false")"
                                data-goal-type="@((int)goal.GoalType)"
                                data-goal-type-label="@(goal.IsQuantitative ? Localizer["Quantitative"].Value : Localizer["Qualitative"].Value)"
                                data-display-unit="@goal.DisplayUnit"
                                data-timeline-url="@Url.Action("FrameworkGoalsTimeline", "Dashboard", new { goalId = goal.ID, frameworkCode = goal.FrameworkCode })">
                                <td class="text-center checkbox-cell">
                                    <div class="form-check d-flex justify-content-center">
                                        <input class="form-check-input row-checkbox" type="checkbox" value="@goal.ID" onchange="updateSelection()">
                                    </div>
                                </td>
                                <td>
                                    <strong>@goal.Name</strong>
                                    @if (goal.IsQuantitative)
                                    {
                                        <span class="badge goal-type-badge goal-type-quantitative ms-2">
                                            <i class="fas fa-ruler-combined me-1"></i>@Localizer["Quantitative"] &middot; @goal.Unit
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge goal-type-badge goal-type-qualitative ms-2">
                                            <i class="fas fa-percent me-1"></i>@Localizer["Qualitative"]
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info">@goal.Framework.Name</span>
                                </td>
                                <td class="text-center sparkline-cell">
                                    <canvas class="sparkline-canvas"
                                            data-goal-id="@goal.ID"
                                            data-starting-year="@goal.StartingYear"
                                            data-current-year="@goal.CurrentYear"
                                            data-target-year="@goal.TargetYear"
                                            data-starting-value="@goal.BaseValueForStartingYear"
                                            data-current-value="@goal.BaseValueForCurrentYear"
                                            data-target-value="@goal.TargetValue"
                                            data-is-increase="@(goal.TargetValue > goal.BaseValueForStartingYear ? "true" : "false")"
                                            width="120"
                                            height="40">
                                    </canvas>
                                </td>
                                @{
                                    // Generate data cells for each year in the full range
                                    for (int year = minYear; year <= maxYear; year++)
                                    {
                                        // Check if this year is within this goal's range
                                        bool isInGoalRange = year >= goal.StartingYear && year <= goal.TargetYear;

                                        if (isInGoalRange)
                                        {
                                            var baseValue = goal.GetBaseValueForYear(year);
                                            var expectedTarget = goal.GetExpectedTargetValueForYear(year);
                                            var isCurrentYear = year == goal.CurrentYear;
                                            var isStartingYear = year == goal.StartingYear;
                                            var isTargetYear = year == goal.TargetYear;

                                            // Base Value cell
                                            <td class="text-center @(isCurrentYear ? "bg-light-current" : "")">
                                                @if (isStartingYear)
                                                {
                                                    <strong class="text-primary">@goal.FormatValue(baseValue)</strong>
                                                }
                                                else if (isCurrentYear)
                                                {
                                                    <strong class="text-success">@goal.FormatValue(baseValue)</strong>
                                                }
                                                else if (baseValue > 0)
                                                {
                                                    <text>@goal.FormatValue(baseValue)</text>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>

                                            // Expected Target / Target Value cell
                                            <td class="text-center @(isCurrentYear ? "bg-light-current" : "")">
                                                @if (isTargetYear)
                                                {
                                                    <strong class="text-danger">@goal.FormatValue(goal.TargetValue)</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-info">@goal.FormatValue(expectedTarget)</span>
                                                }
                                            </td>
                                        }
                                        else
                                        {
                                            // Year is outside this goal's range - show empty cells
                                            <td class="text-center bg-light">
                                                <span class="text-muted">-</span>
                                            </td>
                                            <td class="text-center bg-light">
                                                <span class="text-muted">-</span>
                                            </td>
                                        }
                                    }
                                }
                                <td class="text-center">
                                    <strong class="text-primary">@goal.FormatValue(goal.AnnualDiscountRate)@Localizer["/year"]</strong>
                                </td>
                                <td class="text-center">
                                    @{
                                        // Derived from the single canonical FrameworkGoal.TrackingStatus
                                        var badgeClass = goal.TrackingStatus switch
                                        {
                                            FrameworkGoalTrackingStatus.OnTrack => "bg-success",
                                            FrameworkGoalTrackingStatus.AtRisk => "bg-warning text-dark",
                                            _ => "bg-danger"
                                        };
                                    }
                                    <span class="badge @badgeClass fs-6">
                                        @goal.ProgressRate.ToString("N2")%
                                    </span>
                                </td>
                                <td class="text-center performance-cell-dynamic">
                                    @{
                                        var pMinY = Model.Any() ? Model.Min(g => g.StartingYear) : DateTime.Now.Year;
                                        var pMaxY = Model.Any() ? Model.Max(g => g.TargetYear) : DateTime.Now.Year;
                                        var yearlyData = new Dictionary<int, object>();
                                        for (int y = pMinY; y <= pMaxY; y++)
                                        {
                                            // Only include years within the goal's range
                                            if (y >= goal.StartingYear && y <= goal.TargetYear)
                                            {
                                                yearlyData[y] = new {
                                                    baseVal = goal.GetBaseValueForYear(y),
                                                    expected = goal.GetExpectedTargetValueForYear(y)
                                                };
                                            }
                                        }
                                        var maxYearForDropdown = goal.CurrentYear;
                                    }
                                    <div class="d-none yearly-data" data-values='@Html.Raw(Json.Serialize(yearlyData))'></div>
                                    <div class="performance-container" style="cursor: pointer;">
                                        <span class="performance-value fw-bold" onclick="toggleYearDropdown(this)">-</span>
                                        <select class="form-select form-select-sm year-select d-none mt-1"
                                                style="width: auto; margin: 0 auto;"
                                                onchange="updateRowPerformance(this)"
                                                onclick="event.stopPropagation()">
                                            @for (int y = goal.StartingYear; y <= maxYearForDropdown; y++)
                                            {
                                                if (y == goal.CurrentYear)
                                                {
                                                    <option value="@y" selected>@y</option>
                                                }
                                                else
                                                {
                                                    <option value="@y">@y</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button onclick="showCalculationExplanation(this)"
                                            class="btn btn-sm btn-outline-success me-2"
                                            title="@Localizer["Calculation Explanation"]"
                                            data-goal-id="@goal.ID"
                                            data-goal-name="@goal.Name"
                                            data-is-upward="@(goal.TargetValue > goal.BaseValueForStartingYear ? "true" : "false")"
                                            data-base-value="@goal.BaseValueForStartingYear.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-current-value="@goal.BaseValueForCurrentYear.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-target-value="@goal.TargetValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-starting-year="@goal.StartingYear"
                                            data-current-year="@goal.CurrentYear"
                                            data-target-year="@goal.TargetYear"
                                            data-discount-rate="@goal.AnnualDiscountRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-amount-reduction="@goal.AmountOfReduction.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-progress-rate="@goal.ProgressRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-yearly-data='@Html.Raw(Json.Serialize(yearlyData))'>
                                        <i class="fas fa-calculator"></i>
                                    </button>
                                    <button onclick="showGoalDetails(@goal.ID)"
                                            class="btn btn-sm btn-outline-primary me-2"
                                            title="@Localizer["View Details"]">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <a href="@Url.Action("FrameworkGoalsTimeline", "Dashboard", new { goalId = goal.ID, frameworkCode = goal.FrameworkCode })"
                                       class="btn btn-sm btn-info text-white me-2"
                                       title="@Localizer["View Timeline Chart"]">
                                        <i class="fas fa-chart-line"></i>
                                    </a>
                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        var user = await UserManager.GetUserAsync(User);
                                        if (user != null)
                                        {
                                            var roles = await UserManager.GetRolesAsync(user);
                                            if (roles.Contains("SystemAdministrator") || roles.Contains("MinistryStrategyManager"))
                                            {
                                                <button onclick="showEditModal(@goal.ID, @goal.CurrentYear, @goal.BaseValueForCurrentYear.ToString(System.Globalization.CultureInfo.InvariantCulture), @goal.StartingYear, @goal.TargetYear)"
                                                        class="btn btn-sm btn-warning me-2"
                                                        title="@Localizer["Update Current Year"]">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button onclick="deleteGoal(@goal.ID)" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-3">
                <div class="pagination-info text-muted">
                    <span id="paginationInfo">@Localizer["Showing"] 1-@Math.Min(25, Model.Count()) @Localizer["of"] @Model.Count() @Localizer["goals"]</span>
                </div>
                <nav aria-label="Goals pagination">
                    <ul class="pagination mb-0" id="paginationControls">
                        <li class="page-item disabled" id="prevPageItem">
                            <a class="page-link" href="#" onclick="goToPage('prev'); return false;" tabindex="-1">
                                <i class="fas fa-chevron-left me-1"></i>@Localizer["Previous"]
                            </a>
                        </li>
                        <li class="page-item active"><a class="page-link" href="#" onclick="goToPage(1); return false;">1</a></li>
                        <li class="page-item" id="nextPageItem">
                            <a class="page-link" href="#" onclick="goToPage('next'); return false;">
                                @Localizer["Next"]<i class="fas fa-chevron-right ms-1"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">@Localizer["No goals found. Create your first goal to get started!"]</p>
            </div>
        }
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editModalLabel">
                    <i class="fas fa-edit me-2"></i>@Localizer["Update Goal Values"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editGoalId" />
                    <input type="hidden" id="editStartingYear" />
                    <input type="hidden" id="editTargetYear" />
                    <input type="hidden" id="editDisplayUnit" />

                    <!-- Type and unit are fixed at creation and shown here read-only -->
                    <div class="mb-3">
                        <span class="badge goal-type-badge" id="editGoalTypeBadge">-</span>
                        <small class="text-muted ms-2">@Localizer["The goal type cannot be changed after creation."]</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Localizer["Current Year"] <span class="text-danger">*</span></label>
                        <input type="text" class="form-control year-picker" id="editCurrentYear" required readonly placeholder="@Localizer["Select Year"]" />
                        <small class="form-text text-muted">@Localizer["Update this when the year changes"]</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" id="editBaseValueLabel">@Localizer["Base Value (Current)"]</label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" class="form-control decimal-input" id="editBaseValue" required placeholder="0.00" />
                            <span class="input-group-text" id="editBaseValueUnit">%</span>
                        </div>
                        <small class="form-text text-muted" id="editBaseValueHint">@Localizer["Enter the actual achieved value for the current year"]</small>
                    </div>
                </form>

                <!-- Historical Values Section -->
                <div class="mt-4">
                    <h6 class="mb-3">
                        <i class="fas fa-history me-2"></i>@Localizer["Historical Values"]
                    </h6>
                    <div id="historicalValuesContainer">
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-spinner fa-spin me-2"></i>@Localizer["Loading..."]
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                </button>
                <button type="button" class="btn btn-primary" onclick="submitEdit()">
                    <i class="fas fa-save me-2"></i>@Localizer["Update"]
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>@Localizer["Delete"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3">
                    <i class="fas fa-trash-alt text-danger" style="font-size: 3rem;"></i>
                </div>
                <h5 class="mb-3">@Localizer["Are you sure you want to delete this goal?"]</h5>
                <p class="text-muted mb-0">@Localizer["This action cannot be undone."]</p>
                <input type="hidden" id="deleteGoalId" />
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                </button>
                <button type="button" class="btn btn-danger px-4" onclick="confirmDelete()">
                    <i class="fas fa-trash me-2"></i>@Localizer["Delete"]
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Delete Confirmation Modal -->
<div class="modal fade" id="bulkDeleteModal" tabindex="-1" aria-labelledby="bulkDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="bulkDeleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>@Localizer["Delete Selected Goals"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3">
                    <i class="fas fa-trash-alt text-danger" style="font-size: 3rem;"></i>
                </div>
                <h5 class="mb-3">@Localizer["Are you sure you want to delete the selected goals?"]</h5>
                <p class="text-muted mb-2">@Localizer["This action cannot be undone."]</p>
                <p class="fw-bold text-danger" id="bulkDeleteCount">0 @Localizer["goals will be deleted"]</p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                </button>
                <button type="button" class="btn btn-danger px-4" onclick="confirmBulkDelete()">
                    <i class="fas fa-trash me-2"></i>@Localizer["Delete All Selected"]
                </button>
            </div>
        </div>
    </div>
