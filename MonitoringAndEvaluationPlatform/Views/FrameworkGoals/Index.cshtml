            <i class="fas fa-bullseye me-2"></i>@Localizer["Goal Details"]
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <!-- Goal Header -->
        <div class="goal-sidebar-header p-4 bg-light border-bottom">
            <h4 class="goal-sidebar-name mb-2" id="sidebarGoalName">-</h4>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-info" id="sidebarFrameworkBadge">-</span>
                <span class="badge goal-type-badge" id="sidebarGoalTypeBadge">-</span>
                <span class="badge" id="sidebarStatusBadge">-</span>
            </div>
        </div>

        <!-- Progress Section -->
        <div class="p-4 border-bottom">
            <h6 class="text-muted mb-3">
                <i class="fas fa-chart-line me-2"></i>@Localizer["Progress Overview"]
            </h6>
            <div class="progress-circle-container text-center mb-3">
                <div class="progress-circle" id="sidebarProgressCircle">
                    <svg viewBox="0 0 100 100">
                        <circle class="progress-circle-bg" cx="50" cy="50" r="45"></circle>
                        <circle class="progress-circle-fill" cx="50" cy="50" r="45" id="sidebarProgressCircleFill"></circle>
                    </svg>
                    <div class="progress-circle-text">
                        <span class="progress-value" id="sidebarProgressValue">0%</span>
                        <span class="progress-label">@Localizer["Progress"]</span>
                    </div>
