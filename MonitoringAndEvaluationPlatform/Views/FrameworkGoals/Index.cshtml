        // Update comparison summary statistics
        function updateComparisonSummary(goalsData) {
            const avgProgress = goalsData.reduce((sum, g) => sum + g.progressRate, 0) / goalsData.length;
            const sortedByProgress = [...goalsData].sort((a, b) => b.progressRate - a.progressRate);
            const bestPerformer = sortedByProgress[0];
            const worstPerformer = sortedByProgress[sortedByProgress.length - 1];
            const onTrackCount = goalsData.filter(g => g.status === 'on-track').length;

            document.getElementById('compAvgProgress').textContent = avgProgress.toFixed(1) + '%';
            document.getElementById('compBestPerformer').innerHTML = `
                <span class="text-truncate d-block" style="max-width: 150px;" title="${bestPerformer.name}">
                    ${bestPerformer.name.substring(0, 20)}${bestPerformer.name.length > 20 ? '...' : ''}
                </span>
                <small class="text-success">${bestPerformer.progressRate.toFixed(1)}%</small>
            `;
            document.getElementById('compWorstPerformer').innerHTML = `
                <span class="text-truncate d-block" style="max-width: 150px;" title="${worstPerformer.name}">
                    ${worstPerformer.name.substring(0, 20)}${worstPerformer.name.length > 20 ? '...' : ''}
                </span>
                <small class="text-danger">${worstPerformer.progressRate.toFixed(1)}%</small>
            `;
            document.getElementById('compOnTrackCount').textContent = `${onTrackCount} / ${goalsData.length}`;
        }

        // Update comparison table with goal columns
        function updateComparisonTable(goalsData) {
            const table = document.getElementById('comparisonTable');
            const headerRow = table.querySelector('thead tr');
            const rows = table.querySelectorAll('tbody tr');

            // Clear existing goal columns
            while (headerRow.children.length > 1) {
                headerRow.removeChild(headerRow.lastChild);
            }
            rows.forEach(row => {
                while (row.children.length > 1) {
                    row.removeChild(row.lastChild);
                }
            });

            // Add goal header columns
            goalsData.forEach((goal, index) => {
                const th = document.createElement('th');
                th.className = 'text-center';
                th.style.borderTop = `3px solid ${goal.color}`;
                th.innerHTML = `
                    <div class="goal-header-cell">
                        <span class="goal-color-dot" style="background-color: ${goal.color};"></span>
                        <span class="text-truncate d-block" style="max-width: 150px;" title="${goal.name}">${goal.name}</span>
                    </div>
                `;
                headerRow.appendChild(th);
            });

            // Calculate values for each goal
            goalsData.forEach((goal, goalIndex) => {
                const currentYear = new Date().getFullYear();
                const yearsLeft = Math.max(0, goal.targetYear - currentYear);
                const totalChange = Math.abs(goal.targetValue - goal.startingValue);
                const actualChange = goal.currentValue - goal.startingValue;
                const expectedSlope = (goal.targetValue - goal.startingValue) / Math.max(1, goal.targetYear - goal.startingYear);
                const expectedChange = expectedSlope * (goal.currentYear - goal.startingYear);
                const variance = actualChange - expectedChange;

                // Raw amounts carry each goal's own unit — comparing "km" against "housing unit"
                // is only meaningful once the unit is visible. Progress rate stays a percentage.
                const u = goal.displayUnit;
                const fmt = v => formatWithUnit(v, u);

                const values = [
                    `<span class="badge bg-info">${goal.framework}</span>`,
                    `<span class="badge goal-type-badge ${goal.isQuantitative ? 'goal-type-quantitative' : 'goal-type-qualitative'}">${goal.goalTypeLabel}${goal.isQuantitative ? ' · ' + u : ''}</span>`,
                    getStatusBadgeHtml(goal.status),
                    `<span class="fw-bold" style="color: ${goal.progressRate >= 70 ? '#198754' : goal.progressRate >= 40 ? '#ffc107' : '#dc3545'}">${goal.progressRate.toFixed(2)}%</span>`,
                    fmt(goal.discountRate),
                    '', // Section header
                    goal.startingYear,
                    goal.currentYear,
                    goal.targetYear,
                    `<span class="${yearsLeft <= 1 ? 'text-danger fw-bold' : ''}">${yearsLeft} @Localizer["year"]</span>`,
                    '', // Section header
                    fmt(goal.startingValue),
                    fmt(goal.currentValue),
                    fmt(goal.targetValue),
                    fmt(totalChange),
                    '', // Section header
                    `<span class="${actualChange >= 0 ? 'text-success' : 'text-danger'}">${actualChange >= 0 ? '+' : ''}${fmt(actualChange)}</span>`,
                    fmt(expectedChange),
                    `<span class="${variance >= 0 ? 'text-success' : 'text-danger'}">${variance >= 0 ? '+' : ''}${fmt(variance)}</span>`,
                    goal.isIncreaseGoal ? '<span class="badge bg-success">@Localizer["Increase"]</span>' : '<span class="badge bg-warning text-dark">@Localizer["Decrease"]</span>'
                ];

                rows.forEach((row, rowIndex) => {
                    const td = document.createElement('td');
                    td.className = 'text-center';
                    if (row.classList.contains('comparison-section-header')) {
                        td.className = 'bg-light';
                    }
                    td.innerHTML = values[rowIndex];
                    row.appendChild(td);
                });
            });
        }

        // Get status badge HTML
        function getStatusBadgeHtml(status) {
            const statusMap = {
                'on-track': { class: 'bg-success', text: '@Localizer["On Track"]' },
                'at-risk': { class: 'bg-warning text-dark', text: '@Localizer["At Risk"]' },
                'off-track': { class: 'bg-danger', text: '@Localizer["Off Track"]' }
            };
            const statusInfo = statusMap[status] || { class: 'bg-secondary', text: status };
            return `<span class="badge ${statusInfo.class}">${statusInfo.text}</span>`;
        }

        // Update comparison chart
        function updateComparisonChart(goalsData) {
            const ctx = document.getElementById('comparisonChart').getContext('2d');

            // Destroy existing chart
            if (comparisonChart) {
                comparisonChart.destroy();
            }

            // Prepare data
            const labels = goalsData.map(g => g.name.length > 25 ? g.name.substring(0, 25) + '...' : g.name);
            const progressData = goalsData.map(g => g.progressRate);
            const targetLine = goalsData.map(() => 100);

            comparisonChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: '@Localizer["Progress Rate"]',
                            data: progressData,
                            backgroundColor: goalsData.map(g => g.color + '99'),
                            borderColor: goalsData.map(g => g.color),
                            borderWidth: 2,
                            borderRadius: 8
                        },
                        {
                            label: '@Localizer["Target"] (100%)',
                            data: targetLine,
                            type: 'line',
                            borderColor: '#dc3545',
                            borderDash: [5, 5],
                            borderWidth: 2,
                            pointRadius: 0,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + context.raw.toFixed(2) + '%';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: Math.max(120, Math.max(...progressData) + 10),
                            ticks: {
                                callback: function(value) {
                                    return value + '%';
                                }
                            }
                        }
                    }
                }
            });
        }

        // Update timeline comparison
        function updateTimelineComparison(goalsData) {
            const container = document.getElementById('timelineComparisonContainer');
            container.innerHTML = '';

            // Find min and max years across all goals
            const allYears = goalsData.flatMap(g => [g.startingYear, g.targetYear]);
            const minYear = Math.min(...allYears);
            const maxYear = Math.max(...allYears);
            const totalYears = maxYear - minYear;

            goalsData.forEach((goal, index) => {
                const startOffset = ((goal.startingYear - minYear) / totalYears) * 100;
                const width = ((goal.targetYear - goal.startingYear) / totalYears) * 100;
                const currentOffset = ((goal.currentYear - goal.startingYear) / (goal.targetYear - goal.startingYear)) * 100;

                const row = document.createElement('div');
                row.className = 'timeline-comparison-row';
                row.innerHTML = `
                    <div class="timeline-comparison-label">
                        <span class="goal-color-dot" style="background-color: ${goal.color};"></span>
                        <span class="text-truncate" style="max-width: 200px;" title="${goal.name}">${goal.name}</span>
                    </div>
                    <div class="timeline-comparison-bar-container">
                        <div class="timeline-comparison-bar" style="left: ${startOffset}%; width: ${width}%; background-color: ${goal.color}20; border: 2px solid ${goal.color};">
                            <div class="timeline-comparison-progress" style="width: ${currentOffset}%; background-color: ${goal.color};"></div>
                            <span class="timeline-year-label timeline-start-label">${goal.startingYear}</span>
                            <span class="timeline-year-label timeline-current-label" style="left: ${currentOffset}%;">${goal.currentYear}</span>
                            <span class="timeline-year-label timeline-end-label">${goal.targetYear}</span>
                        </div>
                    </div>
                    <div class="timeline-comparison-progress-text">
                        <span style="color: ${goal.color};">${goal.progressRate.toFixed(1)}%</span>
                    </div>
                `;
                container.appendChild(row);
            });

            // Add year axis
            const axisRow = document.createElement('div');
            axisRow.className = 'timeline-comparison-axis';
            axisRow.innerHTML = `
                <div class="timeline-comparison-label"></div>
                <div class="timeline-comparison-bar-container">
                    <div class="timeline-axis-line">
                        ${Array.from({ length: totalYears + 1 }, (_, i) => {
                            const year = minYear + i;
                            const position = (i / totalYears) * 100;
                            return `<span class="timeline-axis-year" style="left: ${position}%;">${year}</span>`;
                        }).join('')}
                    </div>
                </div>
                <div class="timeline-comparison-progress-text"></div>
            `;
            container.appendChild(axisRow);
        }

        // Export comparison to PDF
        async function exportComparisonToPDF() {
            const modalBody = document.querySelector('.comparison-modal-body');
            if (!modalBody) return;

            try {
                showSuccessMessage('@Localizer["Generating PDF..."]');
                const canvas = await html2canvas(modalBody, {
                    scale: 2,
                    useCORS: true,
                    logging: false,
                    backgroundColor: '#ffffff'
                });

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('l', 'mm', 'a4');
                const imgData = canvas.toDataURL('image/png');
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = (canvas.height * pdfWidth) / canvas.width;

                // Add multiple pages if needed
                let heightLeft = pdfHeight;
                let position = 0;
                const pageHeight = pdf.internal.pageSize.getHeight();

                pdf.addImage(imgData, 'PNG', 0, position, pdfWidth, pdfHeight);
                heightLeft -= pageHeight;

                while (heightLeft >= 0) {
                    position = heightLeft - pdfHeight;
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', 0, position, pdfWidth, pdfHeight);
                    heightLeft -= pageHeight;
                }

                pdf.save('GoalComparison_' + new Date().toISOString().slice(0, 10) + '.pdf');
                showSuccessMessage('@Localizer["PDF exported successfully!"]');
            } catch (error) {
                console.error('Error generating comparison PDF:', error);
                showErrorMessage('@Localizer["Error generating PDF"]');
            }
        }

