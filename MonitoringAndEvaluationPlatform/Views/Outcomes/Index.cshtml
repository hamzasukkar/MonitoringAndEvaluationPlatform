@model IEnumerable<MonitoringAndEvaluationPlatform.Models.Outcome>
@using MonitoringAndEvaluationPlatform.Helpers
@using MonitoringAndEvaluationPlatform.Models
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "Outcomes";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var culture = Context.Features.Get<IRequestCultureFeature>().RequestCulture.Culture.Name;
}

<!-- Hidden Anti-Forgery Token for AJAX requests -->
<form id="__AjaxAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="dashboard-title">
                <i class="fas fa-bullseye me-3"></i>
                @Localizer["Outcomes Management"]
            </h1>
            <p class="dashboard-subtitle">
                @Localizer["Manage and monitor development outcomes and their performance indicators"]
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (ViewBag.SelectedFrameworkCode != null && User.IsInRole(UserRoles.SystemAdministrator))
            {
                <button class="btn btn-success btn-lg shadow-sm" type="button" id="toggleCreateForm">
                    <i class="fas fa-plus me-2"></i>@Localizer["Create New Outcome"]
                </button>
                <a asp-action="AdjustWeights" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
                   class="btn btn-warning btn-lg shadow-sm">
                    <i class="fas fa-balance-scale me-2"></i>@Localizer["Adjust Weights"]
                </a>
            }
        </div>
    </div>
</div>

@if (ViewBag.FrameworkName != null)
{
    <!-- Framework Context Banner -->
    <div class="framework-context-banner">
        <div class="context-content">
            <div class="context-icon">
                <i class="fas fa-sitemap"></i>
            </div>
            <div class="context-text">
                <span class="context-label">@Localizer["Framework"]:</span>
                <span class="context-name">@ViewBag.FrameworkName</span>
            </div>
        </div>
    </div>
}

<!-- Collapsible Outcome Creation Form -->
<div id="createOutcomeForm" class="chart-card mb-4" style="display:none;">
    <div class="chart-title">
        <i class="fas fa-plus"></i>
        @Localizer["Create New Outcome"]
    </div>
    <form id="outcomeForm">
        @Html.AntiForgeryToken()
        <input type="hidden" id="frameworkCode" value="@ViewBag.SelectedFrameworkCode" />
        <div class="row">
            <div class="col-md-8">
                <div class="mb-3">
                    <label for="outcomeName" class="form-label fw-bold">
                        <i class="fas fa-tag me-2"></i>@Localizer["Outcome Name"]
                    </label>
                    <input type="text" class="form-control form-control-lg" id="outcomeName" required
                           placeholder="@Localizer["Enter outcome name"]" />
                </div>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="d-grid w-100">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save me-2"></i>@Localizer["Save Outcome"]
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Outcomes Table -->
<div class="chart-card">
    <div class="chart-title d-flex justify-content-between align-items-center">
        <span>
            <i class="fas fa-bullseye"></i>
            @Localizer["Outcomes"] (@Model.Count())
        </span>
        <div class="d-flex gap-2">
            <a asp-action="ExportExcel" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
               class="btn btn-sm btn-success" title="@Localizer["Export Excel"]" data-bs-toggle="tooltip">
                <i class="fas fa-file-excel"></i>
            </a>
            <a asp-action="ExportPdf" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
               class="btn btn-sm btn-danger" title="@Localizer["Export PDF"]" data-bs-toggle="tooltip">
                <i class="fas fa-file-pdf"></i>
            </a>
        </div>
    </div>
    
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover modern-table">
                <thead class="table-header">
                    <tr>
                        <th class="sortable-header">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewBag.NameSortParm"
                               asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
                               class="header-link">
                                <i class="fas fa-bullseye me-2"></i>@Localizer["Outcome Name"]
                                @if (ViewBag.CurrentSort == "name")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "name_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1 text-white-50"></i>
                                }
                            </a>
                        </th>
                        <th class="text-center sortable-header">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewBag.WeightSortParm"
                               asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
                               class="header-link justify-content-center">
                                <i class="fas fa-weight me-2"></i>@Localizer["Weight"]
                                @if (ViewBag.CurrentSort == "weight")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "weight_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1 text-white-50"></i>
                                }
                            </a>
                        </th>
                        <th class="text-center sortable-header">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewBag.IndicatorsSortParm"
                               asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
                               class="header-link justify-content-center">
                                <i class="fas fa-chart-line me-2"></i>@Localizer["Indicators Performance"]
                                @if (ViewBag.CurrentSort == null || ViewBag.CurrentSort == "")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "indicators")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "indicators_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1 text-white-50"></i>
                                }
                            </a>
                        </th>
                        <th class="text-center sortable-header">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewBag.DisbursementSortParm"
                               asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
                               class="header-link justify-content-center">
                                <i class="fas fa-money-bill-wave me-2"></i>@Localizer["Disbursement Performance"]
                                @if (ViewBag.CurrentSort == "disbursement")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "disbursement_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1 text-white-50"></i>
                                }
                            </a>
                        </th>
                        <th class="text-center sortable-header">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewBag.FrameworkSortParm"
                               asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
                               class="header-link justify-content-center">
                                <i class="fas fa-sitemap me-2"></i>@Localizer["Framework"]
                                @if (ViewBag.CurrentSort == "framework")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "framework_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1 text-white-50"></i>
                                }
                            </a>
                        </th>
                        <th class="text-center">
                            <div class="header-link justify-content-center">
                                <i class="fas fa-cogs me-2"></i>@Localizer["Actions"]
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string indicatorsClass = ProgressBarHelper.GetProgressBarClass(item.IndicatorsPerformance);
                        string disbursementClass = ProgressBarHelper.GetProgressBarClass(item.DisbursementPerformance);
                        double IndicatorsPerformance = Math.Round(item.IndicatorsPerformance, 2);
                        double DisbursementPerformance = Math.Round(item.DisbursementPerformance, 2);
                        var outcomeProjects = item.Outputs
                            .SelectMany(op => op.SubOutputs)
                            .SelectMany(so => so.Indicators)
                            .SelectMany(i => i.ProjectIndicators)
                            .Select(pi => pi.Project)
                            .Where(p => p != null)
                            .Distinct()
                            .ToList();
                        
                        <tr id="outcome-row-@item.Code" class="table-row">
                            <td class="outcome-name-cell">
                                <div class="d-flex align-items-center">
                                    <div class="outcome-icon me-3">
                                        <i class="fas fa-bullseye"></i>
                                    </div>
                                    <div>
                                        <span id="outcome-name-@item.Code" class="outcome-name-view">
                                            <a asp-controller="Outputs" asp-action="Index" asp-route-outcomeCode="@item.Code"
                                               class="outcome-name-link">
                                                @item.Name
                                            </a>
                                        </span>
                                        <div id="outcome-name-edit-container-@item.Code" class="d-none">
                                            <div class="d-flex align-items-center gap-2">
                                                <input type="text" id="outcome-name-input-@item.Code"
                                                       class="form-control form-control-sm" value="@item.Name" />
                                                <button type="button" class="btn btn-success btn-sm" onclick="saveOutcomeName(@item.Code)" title="@Localizer["Save"]">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cancelOutcomeEdit(@item.Code)" title="@Localizer["Cancel"]">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="weight-badge">
                                    <span class="badge bg-info fs-6">@item.Weight%</span>
                                </div>
                            </td>
                            <td class="text-center">
                                @await Html.PartialAsync("_ProgressBar", Tuple.Create(IndicatorsPerformance, indicatorsClass))
                            </td>
                            <td class="text-center">
                                @await Html.PartialAsync("_ProgressBar", Tuple.Create(DisbursementPerformance, disbursementClass))
                            </td>
                            <td class="text-center">
                                <div class="framework-badge">
                                    <a href="/Frameworks/Index/@item.FrameworkCode" class="badge bg-secondary fs-6 text-decoration-none">
                                        @item.Framework.Name
                                    </a>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group action-buttons" role="group">
                                    <button class="btn btn-outline-info btn-sm action-btn"
                                            onclick="toggleOutputs(@item.Code)" title="@Localizer["Show Outputs"]">
                                        <i class="fas fa-chevron-down" id="chevron-@item.Code"></i>
                                    </button>
                                    <button class="btn btn-outline-success btn-sm action-btn"
                                            onclick="toggleProjects(@item.Code)" title="@Localizer["Show Projects"]">
                                        <i class="fas fa-project-diagram" id="projects-chevron-@item.Code"></i>
                                    </button>
                                    @if (User.IsInRole(UserRoles.SystemAdministrator))
                                    {
                                        <button class="btn btn-outline-primary btn-sm action-btn"
                                                onclick="toggleOutcomeEdit(@item.Code)" title="Edit Name">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm action-btn"
                                                onclick="confirmOutcomeDelete(@item.Code)" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                        <!-- Expandable Outputs Row -->
                        <tr id="outputs-row-@item.Code" class="outputs-row" style="display: none;">
                            <td colspan="6" class="p-0">
                                <div class="outputs-container">
                                    <div class="outputs-header d-flex justify-content-between align-items-center">
                                        <span>
                                            <i class="fas fa-layer-group me-2"></i>
                                            @Localizer["Outputs"] (<span id="outputs-count-@item.Code">@item.Outputs.Count</span>)
                                        </span>
                                        @if (User.IsInRole(UserRoles.SystemAdministrator))
                                        {
                                            <button class="btn btn-success btn-sm" onclick="toggleInlineOutputForm(@item.Code)">
                                                <i class="fas fa-plus me-1"></i>@Localizer["Add Output"]
                                            </button>
                                        }
                                    </div>

                                    <!-- Inline Create Output Form -->
                                    @if (User.IsInRole(UserRoles.SystemAdministrator))
                                    {
                                        <div id="inline-output-form-@item.Code" class="inline-create-output-form" style="display: none;">
                                            <div class="row g-2 align-items-center">
                                                <div class="col">
                                                    <input type="text" class="form-control" id="new-output-name-@item.Code"
                                                           placeholder="@Localizer["Enter output name"]" />
                                                </div>
                                                <div class="col-auto">
                                                    <button type="button" class="btn btn-primary btn-sm" onclick="createInlineOutput(@item.Code)">
                                                        <i class="fas fa-save me-1"></i>@Localizer["Save"]
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleInlineOutputForm(@item.Code)">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (item.Outputs.Any())
                                    {
                                        <table class="table table-sm outputs-table mb-0" id="outputs-table-@item.Code">
                                            <thead>
                                                <tr>
                                                    <th>@Localizer["Output Name"]</th>
                                                    <th class="text-center">@Localizer["Weight"]</th>
                                                    <th class="text-center">@Localizer["Indicators Performance"]</th>
                                                    <th class="text-center">@Localizer["Disbursement Performance"]</th>
                                                </tr>
                                            </thead>
                                            <tbody id="outputs-tbody-@item.Code">
                                                @foreach (var output in item.Outputs)
                                                {
                                                    string outputIndicatorsClass = ProgressBarHelper.GetProgressBarClass(output.IndicatorsPerformance);
                                                    string outputDisbursementClass = ProgressBarHelper.GetProgressBarClass(output.DisbursementPerformance);
                                                    <tr>
                                                        <td>
                                                            <a asp-controller="SubOutputs" asp-action="Index" asp-route-outputCode="@output.Code" class="output-name-link">
                                                                @output.Name
                                                            </a>
                                                        </td>
                                                        <td class="text-center">
                                                            <span class="badge bg-info">@Math.Round(output.Weight, 1)%</span>
                                                        </td>
                                                        <td class="text-center">
                                                            @await Html.PartialAsync("_ProgressBar", Tuple.Create(Math.Round(output.IndicatorsPerformance, 2), outputIndicatorsClass))
                                                        </td>
                                                        <td class="text-center">
                                                            @await Html.PartialAsync("_ProgressBar", Tuple.Create(Math.Round(output.DisbursementPerformance, 2), outputDisbursementClass))
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    else
                                    {
                                        <div id="no-outputs-msg-@item.Code" class="text-center py-3 text-muted">
                                            <i class="fas fa-info-circle me-2"></i>
                                            @Localizer["No outputs found for this outcome"]
                                        </div>
                                        <table class="table table-sm outputs-table mb-0 d-none" id="outputs-table-@item.Code">
                                            <thead>
                                                <tr>
                                                    <th>@Localizer["Output Name"]</th>
                                                    <th class="text-center">@Localizer["Weight"]</th>
                                                    <th class="text-center">@Localizer["Indicators Performance"]</th>
                                                    <th class="text-center">@Localizer["Disbursement Performance"]</th>
                                                </tr>
                                            </thead>
                                            <tbody id="outputs-tbody-@item.Code">
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </td>
                        </tr>
                        <!-- Expandable Projects Row -->
                        <tr id="projects-row-@item.Code" class="projects-row" style="display: none;">
                            <td colspan="6" class="p-0">
                                <div class="projects-container">
                                    <div class="projects-header">
                                        <i class="fas fa-project-diagram me-2"></i>
                                        @Localizer["Projects"] (@outcomeProjects.Count)
                                    </div>
                                    @if (outcomeProjects.Any())
                                    {
                                        <table class="table table-sm projects-table mb-0">
                                            <thead>
                                                <tr>
                                                    <th>@Localizer["Project Name"]</th>
                                                    <th class="text-center">@Localizer["Indicators Performance"]</th>
                                                    <th class="text-center">@Localizer["Disbursement Performance"]</th>
                                                    <th class="text-center">@Localizer["Actions"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var project in outcomeProjects)
                                                {
                                                    string projectIndicatorsClass = ProgressBarHelper.GetProgressBarClass(project.performance);
                                                    string projectDisbursementClass = ProgressBarHelper.GetProgressBarClass(project.DisbursementPerformance);
                                                    <tr>
                                                        <td>
                                                            <a asp-controller="Projects" asp-action="Dashboard" asp-route-id="@project.ProjectID" class="project-name-link">
                                                                @project.ProjectName
                                                            </a>
                                                        </td>
                                                        <td class="text-center">
                                                            @await Html.PartialAsync("_ProgressBar", Tuple.Create(Math.Round(project.performance, 2), projectIndicatorsClass))
                                                        </td>
                                                        <td class="text-center">
                                                            @await Html.PartialAsync("_ProgressBar", Tuple.Create(Math.Round(project.DisbursementPerformance, 2), projectDisbursementClass))
                                                        </td>
                                                        <td class="text-center">
                                                            <a asp-controller="Projects" asp-action="Dashboard" asp-route-id="@project.ProjectID" class="btn btn-outline-primary btn-sm">
                                                                <i class="fas fa-eye me-1"></i>@Localizer["View Details"]
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    else
                                    {
                                        <div class="text-center py-3 text-muted">
                                            <i class="fas fa-info-circle me-2"></i>
                                            @Localizer["No projects found for this outcome"]
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="stat-icon warning mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                <i class="fas fa-bullseye"></i>
            </div>
            <h4 class="text-muted">@Localizer["No outcomes found"]</h4>
            <p class="text-muted">@Localizer["Create your first outcome to get started"]</p>
        </div>
    }
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        // Toggle create form
        document.getElementById('toggleCreateForm')?.addEventListener('click', function () {
            const form = document.getElementById('createOutcomeForm');
            if (form) {
                const isHidden = form.style.display === 'none';
                form.style.display = isHidden ? 'block' : 'none';

                if (isHidden) {
                    form.style.opacity = '0';
                    form.style.transform = 'translateY(-20px)';
                    setTimeout(() => {
                        form.style.transition = 'all 0.4s ease';
                        form.style.opacity = '1';
                        form.style.transform = 'translateY(0)';
                        document.getElementById('outcomeName')?.focus();
                    }, 10);
                }
            }
        });

        // Handle inline outcome creation
        $('#outcomeForm').on('submit', function (e) {
            e.preventDefault();

            const name = $('#outcomeName').val().trim();
            const frameworkCode = $('#frameworkCode').val();
            const token = $('input[name="__RequestVerificationToken"]').val();

            if (!name) {
                Swal.fire({
                    icon: 'warning',
                    title: '@Localizer["Warning"]',
                    text: '@Localizer["Please enter an outcome name"]'
                });
                return;
            }

            $.ajax({
                url: '/Outcomes/CreateInline',
                type: 'POST',
                data: {
                    name: name,
                    frameworkCode: frameworkCode,
                    __RequestVerificationToken: token
                },
                success: function (response) {
                    if (response.success) {
                        // Reload the page to show the new outcome
                        location.reload();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: response.message
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["Could not create outcome. Please try again."]'
                    });
                }
            });
        });

        function toggleOutcomeEdit(code) {
            const viewSpan = $(`#outcome-name-${code}`);
            const editContainer = $(`#outcome-name-edit-container-${code}`);
            const input = $(`#outcome-name-input-${code}`);

            // Enter edit mode
            editContainer.removeClass('d-none');
            viewSpan.addClass('d-none');
            input.focus().select();
        }

        function saveOutcomeName(code) {
            const viewSpan = $(`#outcome-name-${code}`);
            const editContainer = $(`#outcome-name-edit-container-${code}`);
            const input = $(`#outcome-name-input-${code}`);
            const newName = input.val();

            $.ajax({
                url: `/Outcomes/UpdateName`,
                type: 'POST',
                data: { id: code, name: newName },
                success: function () {
                    viewSpan.html(`<a href="/Outputs?outcomeCode=${code}" class="outcome-name-link">${newName}</a>`);
                    editContainer.addClass('d-none');
                    viewSpan.removeClass('d-none');
                    Swal.fire({
                        icon: 'success',
                        title: '@Localizer["Saved!"]',
                        text: '@Localizer["Outcome name updated successfully."]',
                        timer: 2000,
                        showConfirmButton: false
                    });
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["Could not update outcome name."]'
                    });
                }
            });
        }

        function cancelOutcomeEdit(code) {
            const viewSpan = $(`#outcome-name-${code}`);
            const editContainer = $(`#outcome-name-edit-container-${code}`);
            const input = $(`#outcome-name-input-${code}`);

            // Reset input to original value
            const originalName = viewSpan.find('a').text();
            input.val(originalName);

            editContainer.addClass('d-none');
            viewSpan.removeClass('d-none');
        }

        function toggleOutputs(code) {
            const outputsRow = document.getElementById(`outputs-row-${code}`);
            const chevron = document.getElementById(`chevron-${code}`);

            if (outputsRow.style.display === 'none') {
                outputsRow.style.display = 'table-row';
                chevron.classList.remove('fa-chevron-down');
                chevron.classList.add('fa-chevron-up');

                // Animate the container
                const container = outputsRow.querySelector('.outputs-container');
                container.style.opacity = '0';
                container.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    container.style.transition = 'all 0.3s ease';
                    container.style.opacity = '1';
                    container.style.transform = 'translateY(0)';
                }, 10);
            } else {
                outputsRow.style.display = 'none';
                chevron.classList.remove('fa-chevron-up');
                chevron.classList.add('fa-chevron-down');
            }
        }

        function toggleProjects(code) {
            const projectsRow = document.getElementById(`projects-row-${code}`);
            const chevron = document.getElementById(`projects-chevron-${code}`);

            if (projectsRow.style.display === 'none') {
                projectsRow.style.display = 'table-row';
                chevron.classList.remove('fa-project-diagram');
                chevron.classList.add('fa-times');

                // Animate the container
                const container = projectsRow.querySelector('.projects-container');
                container.style.opacity = '0';
                container.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    container.style.transition = 'all 0.3s ease';
                    container.style.opacity = '1';
                    container.style.transform = 'translateY(0)';
                }, 10);
            } else {
                projectsRow.style.display = 'none';
                chevron.classList.remove('fa-times');
                chevron.classList.add('fa-project-diagram');
            }
        }

        function toggleInlineOutputForm(outcomeCode) {
            const form = document.getElementById(`inline-output-form-${outcomeCode}`);
            const input = document.getElementById(`new-output-name-${outcomeCode}`);

            if (form.style.display === 'none') {
                form.style.display = 'block';
                form.style.opacity = '0';
                form.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    form.style.transition = 'all 0.3s ease';
                    form.style.opacity = '1';
                    form.style.transform = 'translateY(0)';
                    input.focus();
                }, 10);
            } else {
                form.style.display = 'none';
                input.value = '';
            }
        }

        function createInlineOutput(outcomeCode) {
            const input = document.getElementById(`new-output-name-${outcomeCode}`);
            const name = input.value.trim();
            const token = $('input[name="__RequestVerificationToken"]').val();

            if (!name) {
                Swal.fire({
                    icon: 'warning',
                    title: '@Localizer["Warning"]',
                    text: '@Localizer["Please enter an output name"]'
                });
                return;
            }

            $.ajax({
                url: '/Outputs/CreateInline',
                type: 'POST',
                data: {
                    name: name,
                    outcomeCode: outcomeCode,
                    __RequestVerificationToken: token
                },
                success: function (response) {
                    if (response.success) {
                        // Hide the "no outputs" message if it exists
                        const noOutputsMsg = document.getElementById(`no-outputs-msg-${outcomeCode}`);
                        if (noOutputsMsg) {
                            noOutputsMsg.style.display = 'none';
                        }

                        // Show the table if it was hidden
                        const table = document.getElementById(`outputs-table-${outcomeCode}`);
                        table.classList.remove('d-none');

                        // Add new row to the table
                        const tbody = document.getElementById(`outputs-tbody-${outcomeCode}`);
                        const newRow = `
                            <tr style="background-color: rgba(40, 167, 69, 0.1);">
                                <td>
                                    <a href="/SubOutputs?outputCode=${response.output.code}" class="output-name-link">
                                        ${response.output.name}
                                    </a>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info">${response.output.weight}%</span>
                                </td>
                                <td class="text-center">
                                    <div class="progress-container">
                                        <div class="progress modern-progress-bar">
                                            <div class="progress-bar bg-secondary" role="progressbar" style="width: 0%">
                                            </div>
                                        </div>
                                        <div class="progress-value-display">
                                            <span class="progress-percentage">0%</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="progress-container">
                                        <div class="progress modern-progress-bar">
                                            <div class="progress-bar bg-secondary" role="progressbar" style="width: 0%">
                                            </div>
                                        </div>
                                        <div class="progress-value-display">
                                            <span class="progress-percentage">0%</span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        `;
                        tbody.insertAdjacentHTML('beforeend', newRow);

                        // Update count
                        const countSpan = document.getElementById(`outputs-count-${outcomeCode}`);
                        countSpan.textContent = parseInt(countSpan.textContent) + 1;

                        // Clear and hide the form
                        input.value = '';
                        toggleInlineOutputForm(outcomeCode);

                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success"]',
                            text: '@Localizer["Output created successfully!"]',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: response.message
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["Could not create output. Please try again."]'
                    });
                }
            });
        }

        function confirmOutcomeDelete(code) {
            Swal.fire({
                title: '@Localizer["Are you sure?"]',
                text: '@Localizer["This will permanently delete the outcome and all associated data!"]',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '@Localizer["Yes, delete it!"]',
                cancelButtonText: '@Localizer["Cancel"]',
                customClass: {
                    popup: 'swal2-modern',
                    confirmButton: 'btn btn-danger',
                    cancelButton: 'btn btn-secondary'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/Outcomes/DeleteConfirmed/${code}`,
                        type: 'POST',
                        success: function () {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: '@Localizer["Outcome has been deleted successfully."]',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                // Reload page to show updated performance values
                                location.reload();
                            });
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: '@Localizer["Could not delete outcome. Please try again."]'
                            });
                        }
                    });
                }
            });
        }
        
        // Initialize page animations
        document.addEventListener('DOMContentLoaded', function() {
            // Animate table rows on load
            const tableRows = document.querySelectorAll('.table-row');
            tableRows.forEach((row, index) => {
                row.style.opacity = '0';
                row.style.transform = 'translateX(-20px)';
                setTimeout(() => {
                    row.style.transition = 'all 0.6s ease';
                    row.style.opacity = '1';
                    row.style.transform = 'translateX(0)';
                }, index * 100);
            });
            
            // Progress bar animation
            const progressBars = document.querySelectorAll('.progress-fill-modern');
            progressBars.forEach((bar, index) => {
                setTimeout(() => {
                    const width = bar.style.width;
                    bar.style.width = '0%';
                    setTimeout(() => {
                        bar.style.transition = 'width 1.5s ease-out';
                        bar.style.width = width;
                    }, 200);
                }, index * 100);
            });
        });
    </script>

