}

.modern-btn.secondary {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.modern-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
}

.modern-btn.secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    text-decoration: none;
}

/* Help Section */
.help-section {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
}

.help-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    border: 1px solid rgba(40, 167, 69, 0.3);
    padding: 2rem;
    width: 100%;
    max-width: 600px;
}

.help-header {
    display: flex;
    align-items: center;
    margin-bottom: 1.5rem;
}

.help-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 1rem;
    color: #fff;
    font-size: 1rem;
}

.help-title {
    color: #28a745;
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
}

.help-content {
    color: rgba(255, 255, 255, 0.8);
}

.help-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.help-list li {
    padding: 0.5rem 0;
    padding-left: 2rem;
    position: relative;
    line-height: 1.5;
}

.help-list li:before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0.5rem;
    color: #28a745;
    font-weight: bold;
    font-size: 1rem;
}

/* Animations */
@@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive Design */
@@media (max-width: 768px) {
    .create-form-card,
    .help-card {
        margin: 0 1rem;
    }
    
    .form-actions {
        flex-direction: column;
    }
    
    .modern-btn {
        width: 100%;
    }
    
    .info-header {
        flex-direction: column;
        text-align: center;
    }
    
    .info-icon {
        margin-right: 0;
        margin-bottom: 1rem;
    }
}
</style>

<!-- Custom JavaScript -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        @if (isFirstMeasure)
        {
            <text>
        // Radio toggle for first measure
        const phaseTargetQty = @(selectedPhase?.TargetQuantity.HasValue == true ? selectedPhase.TargetQuantity.Value.ToString("G", System.Globalization.CultureInfo.InvariantCulture) : "NaN");
        function applyTypeMode(isQuant) {
            const hasTargetQty = !isNaN(phaseTargetQty) && phaseTargetQty > 0;
            // Hide value only when quantitative AND phase has a target quantity (auto-calculated)
            document.getElementById('valueField').style.display    = (isQuant && hasTargetQty) ? 'none' : '';
            document.getElementById('quantityField').style.display = isQuant ? '' : 'none';
            document.getElementById('unitField').style.display     = isQuant ? '' : 'none';
            document.getElementById('valueInput').required         = !isQuant || !hasTargetQty;
            document.getElementById('quantityInput').required      = isQuant;
        }
        document.querySelectorAll('input[name="MeasureType"]').forEach(function(r) {
            r.addEventListener('change', function() { applyTypeMode(this.value === '1'); });
        });
            </text>
        }

        // Form validation feedback
        const form = document.getElementById('measureForm');
        const submitBtn = document.getElementById('submitBtn');
        
        // Form submission handler
        form.addEventListener('submit', function(e) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>@Localizer["Recording..."]';
        });
        
        // Auto-dismiss notifications after 5 seconds
        setTimeout(function() {
            const notifications = document.querySelectorAll('.notification-card');
            notifications.forEach(function(notification) {
                notification.style.animation = 'slideOut 0.3s ease-in';
                setTimeout(() => notification.remove(), 300);
            });
        }, 5000);
        
        // Close notification on click
        document.querySelectorAll('.notification-close').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const notification = this.closest('.notification-card');
                notification.style.animation = 'slideOut 0.3s ease-in';
                setTimeout(() => notification.remove(), 300);
            });
        });
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}