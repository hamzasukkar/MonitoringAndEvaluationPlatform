    height: 24px;
    border-radius: 6px;
    background: rgba(23, 162, 184, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #17a2b8;
    font-size: 0.8rem;
    flex-shrink: 0;
    margin-top: 2px;
}

.info-text {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    line-height: 1.4;
}

.info-text strong {
    color: #17a2b8;
}

.form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.modern-btn {
    border: none;
    border-radius: 10px;
    padding: 0.75rem 2rem;
    font-weight: 500;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    min-width: 140px;
}

.modern-btn.primary {
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
