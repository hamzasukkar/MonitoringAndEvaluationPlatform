@model IEnumerable<MonitoringAndEvaluationPlatform.Models.Measure>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@using MonitoringAndEvaluationPlatform.Enums
@{
    ViewData["Title"] = "Measures";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    ViewData["HelpFeature"] = "MEASURES";
    var selectedPhase = ViewBag.SelectedPhase as MonitoringAndEvaluationPlatform.Models.ProjectPhase;
    var selectedProject = ViewBag.SelectedProject as MonitoringAndEvaluationPlatform.Models.Project;
    var existingPhaseType = ViewBag.ExistingPhaseType as MeasureType?;
    bool inlineIsQuantitative = existingPhaseType == MeasureType.Quantitative;
    bool inlineIsQualitative  = existingPhaseType == MeasureType.Qualitative;
    bool inlineIsFirst        = existingPhaseType == null;
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <h1 class="dashboard-title">
        <i class="fas fa-chart-line me-3"></i>
        @Localizer["Measures Dashboard"]
    </h1>
    <p class="dashboard-subtitle">
        @Localizer["Track and monitor performance indicators with detailed measurements"]
    </p>
    <div class="dashboard-actions">
        @await Html.PartialAsync("_HelpButton")
        @if (ViewBag.SelectedPhaseId == null)
        {
            <a asp-action="Create" class="btn btn-gradient-primary">
                <i class="fas fa-plus me-2"></i>@Localizer["Create New Measure"]
            </a>
        }
    </div>
</div>

<div class="container-fluid">
    @if (selectedProject != null)
    {
        <!-- Project Navigation Section -->
        <div class="project-nav-modern mb-4">
            <nav class="modern-navbar">
                <div class="navbar-container">
                    <div class="navbar-collapse" id="projectNavbar">
                        <ul class="modern-nav-list">
                            <li class="nav-item-modern">
                                <a asp-action="Details" asp-controller="Projects" asp-route-id="@ViewBag.SelectedProjectId" class="nav-link-modern">
                                    <i class="fas fa-project-diagram me-2"></i>@Localizer["Project"]
                                </a>
                            </li>
                            <li class="nav-item-modern">
                                <a asp-action="Index" asp-controller="Measures" asp-route-phaseId="@ViewBag.SelectedPhaseId" class="nav-link-modern active" aria-current="page">
                                    <i class="fas fa-ruler-combined me-2"></i>@Localizer["Measures"]
                                </a>
                            </li>
                            <li class="nav-item-modern">
                                <a asp-controller="ActionPlans" asp-action="ActionPlan" asp-route-phaseId="@ViewBag.SelectedPhaseId" class="nav-link-modern">
                                    <i class="fas fa-tasks me-2"></i>@Localizer["Action Plans"]
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
    }

    @if (selectedProject != null && selectedPhase != null)
    {
        <div class="chart-card mb-4">
            <h3 class="chart-title">
                <i class="fas fa-project-diagram"></i>
                @selectedProject.ProjectName
            </h3>
            <div class="chart-content">
                <div class="info-section">
                    <div class="info-card">
                        <div class="info-header">
                            <i class="fas fa-layer-group me-2"></i>
                            <h5 class="info-title">@Localizer["Selected Phase"]</h5>
                        </div>
                        <div class="info-content">
                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-tag me-2"></i>
                                    @Localizer["Phase Name"]
                                </div>
                                <div class="info-value">@selectedPhase.Name</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-calendar-plus me-2"></i>
                                    @Localizer["Start Date"]
                                </div>
                                <div class="info-value">@selectedPhase.StartDate.ToString("MMM yyyy")</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-calendar-minus me-2"></i>
                                    @Localizer["End Date"]
                                </div>
                                <div class="info-value">@selectedPhase.EndDate.ToString("MMM yyyy")</div>
                            </div>
                            @{
                                var phaseTotal = Model.Sum(m => m.Value);
                            }
                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-chart-bar me-2"></i>
                                    @Localizer["Total Achievement"]
                                </div>
                                <div class="info-value">
                                    <span class="modern-badge badge-success">@phaseTotal.ToString("0.##")%</span>
                                </div>
                            </div>
                            @if (selectedPhase.TargetQuantity.HasValue)
                            {
                                <div class="info-row">
                                    <div class="info-label">
                                        <i class="fas fa-bullseye me-2"></i>
                                        @Localizer["Target Quantity"]
                                    </div>
                                    <div class="info-value">
                                        <span class="modern-badge badge-primary">@selectedPhase.TargetQuantity.Value.ToString("G") @Localizer["Unit"]</span>
                                    </div>
                                </div>
                                <div class="info-row">
                                    <div class="info-label">
                                        <i class="fas fa-info-circle me-2"></i>
                                        @Localizer["Achievement Calculation"]
                                    </div>
                                    <div class="info-value text-muted small">
                                        @Localizer["Value = (Quantity ÷ Target Quantity) × 100%"]
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (selectedProject != null)
    {
        <div class="chart-card mb-4">
            <h3 class="chart-title">
                <i class="fas fa-project-diagram"></i>
                @selectedProject.ProjectName - @Localizer["Measures"]
            </h3>
        </div>
    }

    @if (selectedPhase != null && selectedProject == null)
    {
        <div class="chart-card mb-4">
            <h3 class="chart-title">
                <i class="fas fa-layer-group"></i>
                @Localizer["Selected Phase"]
            </h3>
            <div class="chart-content">
                <div class="info-section">
                    <div class="info-card">
                        <div class="info-content">
                            <div class="info-row">
                                <div class="info-label">
                                    <i class="fas fa-tag me-2"></i>
                                    @Localizer["Name"]
                                </div>
                                <div class="info-value">@selectedPhase.Name</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ViewBag.SelectedPhaseId != null)
    {
        <!-- Inline Create Form -->
        <div class="chart-card mb-4">
            <h3 class="chart-title">
                <i class="fas fa-plus-circle"></i>
                @Localizer["Add New Measure"]
            </h3>
            <div class="chart-content">
                <form id="inlineMeasureForm" class="row g-3"
                      data-target-quantity="@(selectedPhase?.TargetQuantity?.ToString("G", System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                    @Html.AntiForgeryToken()
                    @if (inlineIsFirst)
                    {
                        <!-- First measure: radio buttons -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">@Localizer["Achievement Type"] *</label>
                            <div class="d-flex gap-3">
                                <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                                    <input type="radio" name="inlineMeasureType" id="inlineTypeQualitative" value="0"
                                           class="form-check-input flex-shrink-0" style="width:1.1em;height:1.1em;cursor:pointer;" />
                                    <span><strong>@Localizer["Qualitative"]</strong></span>
                                </label>
                                <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                                    <input type="radio" name="inlineMeasureType" id="inlineTypeQuantitative" value="1"
                                           class="form-check-input flex-shrink-0" style="width:1.1em;height:1.1em;cursor:pointer;" checked />
                                    <span><strong>@Localizer["Quantitative"]</strong></span>
                                </label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Subsequent measures: type badge -->
                        <div class="col-12">
                            <span class="modern-badge @(inlineIsQuantitative ? "badge-primary" : "badge-info")">
                                <i class="fas @(inlineIsQuantitative ? "fa-hashtag" : "fa-comment-alt") me-1"></i>
                                @(inlineIsQuantitative ? Localizer["Quantitative"] : Localizer["Qualitative"])
                            </span>
                            <span class="text-muted small ms-2">@Localizer["Type is set by the first measure of this phase"]</span>
                        </div>
                    }
                    <div class="col-md-4">
                        <label for="measureName" class="form-label">@Localizer["Name"] *</label>
                        <input type="text" id="measureName" name="Name" class="form-control" placeholder="@Localizer["Measure name"]" required />
                    </div>
                    <div class="col-md-4">
                        <label for="measureDate" class="form-label">@Localizer["Date"] *</label>
                        <input type="date" id="measureDate" name="Date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <!-- Value field -->
                    <div class="col-md-4" id="inlineValueField" @(inlineIsQuantitative ? "style=display:none" : "")>
                        <label for="measureValue" class="form-label">@Localizer["Achievement Value"] *</label>
                        <input type="number" id="measureValue" name="Value" step="0.01" min="0" max="100"
                               class="form-control" placeholder="0–100" @(inlineIsQuantitative ? "" : "required") />
                    </div>
                    <!-- Quantity field -->
                    <div class="col-md-3" id="inlineQuantityField" @(inlineIsQualitative || inlineIsFirst ? "style=display:none" : "")>
                        <label for="measureQuantity" class="form-label">@Localizer["Quantity"] @(inlineIsQuantitative ? "*" : "")</label>
                        <input type="number" id="measureQuantity" name="Quantity" step="0.01" min="0"
                               class="form-control" placeholder="@Localizer["How many"]" @(inlineIsQuantitative ? "required" : "") />
                        @if (selectedPhase?.TargetQuantity.HasValue == true)
                        {
                            <div class="form-text text-info">
                                <i class="fas fa-magic me-1"></i>@Localizer["Achieved quantity"] — @Localizer["Auto-calculated from Quantity ÷"] @selectedPhase.TargetQuantity.Value.ToString("G")
                            </div>
                        }
                        else
                        {
                            <div class="form-text text-warning">
                                <i class="fas fa-info-circle me-1"></i>@Localizer["No target set — quantity is used directly as achievement % (0–100)"]
                            </div>
                        }
                    </div>
                    @if (inlineIsFirst)
                    {
                        <!-- Phase Target field: only when setting type for the first time -->
                        <div class="col-md-3" id="inlineTargetQtyField" style="display:none">
                            <label for="measureTargetQty" class="form-label">@Localizer["Phase Target"]</label>
                            <input type="number" id="measureTargetQty" name="PhaseTargetQuantity" step="0.01" min="0.01"
                                   class="form-control" placeholder="@Localizer["e.g. 1000"]" />
                            <div class="form-text text-muted">
                                <i class="fas fa-bullseye me-1"></i>@Localizer["Total goal for this phase"]
                            </div>
                        </div>
                    }
                    <div class="col-md-3" id="inlineUnitField" @(inlineIsQualitative || inlineIsFirst ? "style=display:none" : "")>
                        <label for="measureUnit" class="form-label">@Localizer["Unit"]</label>
                        <input type="text" id="measureUnit" name="Unit" class="form-control" placeholder="@Localizer["e.g. tree, km, household"]" maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label for="measureNote" class="form-label">@Localizer["Note"]</label>
                        <textarea id="measureNote" name="Note" class="form-control" rows="2" placeholder="@Localizer["Optional note or description"]"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label for="measureFile" class="form-label">@Localizer["Attachment"]</label>
                        <input type="file" id="measureFile" name="MeasureFiles" class="form-control" multiple />
                        <div class="form-text text-muted"><i class="fas fa-paperclip me-1"></i>@Localizer["Optional file attachment"]</div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-gradient-primary" id="addMeasureBtn">
                            <i class="fas fa-save me-2"></i>@Localizer["Add Measure"]
                        </button>
                    </div>
                    <input type="hidden" id="phaseId" name="ProjectPhaseId" value="@ViewBag.SelectedPhaseId" />
                </form>
            </div>
        </div>
    }

    @if (selectedProject != null)
    {
        <div class="mb-4">
            <a asp-action="Details" asp-controller="Projects" asp-route-id="@selectedProject.ProjectID" class="btn btn-modern-secondary">
                <i class="fas fa-arrow-left me-2"></i>@Localizer["Back to Project"]
            </a>
        </div>
    }

    <div class="chart-card">
        <h3 class="chart-title">
            <i class="fas fa-list"></i>
            @Localizer["Measures List"]
            @if (Model.Any())
            {
                <span class="modern-badge badge-primary ms-2">@Model.Count()</span>
            }
        </h3>
        <div class="chart-content">
            @if (Model.Any())
            {
                <div class="modern-table-container">
                    <table class="modern-table">
                        <thead class="table-header">
                            <tr>
                                <th>
                                    <i class="fas fa-tag me-2"></i>@Localizer["Name"]
                                </th>
                                <th>
                                    <i class="fas fa-calendar me-2"></i>@Localizer["Date"]
                                </th>
                                <th class="text-center">
                                    <i class="fas fa-chart-line me-2"></i>@Localizer["Value"]
                                </th>
                                <th class="text-center">
                                    <i class="fas fa-percent me-2"></i>@Localizer["Percentage"]
                                </th>
                                <th class="text-center">
                                    <i class="fas fa-ruler me-2"></i>@Localizer["Unit"]
                                </th>
                                <th class="text-center">
                                    <i class="fas fa-sliders-h me-2"></i>@Localizer["Type"]
                                </th>
                                @if (ViewBag.SelectedPhaseId == null)
                                {
                                    <th>
                                        <i class="fas fa-layer-group me-2"></i>@Localizer["Phase"]
                                    </th>
                                }
                                <th class="text-center">
                                    <i class="fas fa-cogs me-2"></i>@Localizer["Actions"]
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model) {
                            <tr class="table-row" id="row-@item.Code"
                                data-target-quantity="@(item.ProjectPhase?.TargetQuantity?.ToString("G", System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                                <td>
                                    <span class="fw-semibold measure-name-display">@item.Name</span>
                                    <input type="text" class="form-control form-control-sm measure-name-edit d-none" value="@item.Name" maxlength="200" />
                                    @if (!string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        <div class="text-muted small measure-note-display" title="@item.Note">
                                            <i class="fas fa-sticky-note me-1"></i>@(item.Note.Length > 60 ? item.Note[..60] + "…" : item.Note)
                                        </div>
                                    }
                                    <textarea class="form-control form-control-sm measure-note-edit d-none mt-1" rows="2" maxlength="1000">@item.Note</textarea>
                                    <div class="d-none measure-quantity-unit-edit mt-1 d-flex gap-1">
                                        <input type="number" class="form-control form-control-sm measure-quantity-edit" value="@item.Quantity" step="0.01" min="0" placeholder="@Localizer["How many"]" style="max-width:90px;" />
                                        <input type="text" class="form-control form-control-sm measure-unit-edit" value="@item.Unit" placeholder="@Localizer["Unit"]" maxlength="100" style="max-width:100px;" />
                                    </div>
                                </td>
                                <td class="measure-date-cell">
                                    <div class="d-flex align-items-center">
                                        <div class="date-icon me-3">
                                            <i class="fas fa-calendar-alt"></i>
                                        </div>
                                        <span class="fw-semibold measure-date-display">@item.Date.ToString("yyyy-MM-dd")</span>
                                        <input type="date" class="form-control form-control-sm measure-date-edit d-none" value="@item.Date.ToString("yyyy-MM-dd")" />
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (item.MeasureType == MonitoringAndEvaluationPlatform.Enums.MeasureType.Quantitative && item.Quantity.HasValue)
                                    {
                                        <span class="modern-badge badge-success measure-value-display" data-value="@item.Value">@item.Quantity.Value.ToString("G")</span>
                                    }
                                    else
                                    {
                                        <span class="modern-badge badge-success measure-value-display" data-value="@item.Value">@item.Value.ToString("0.##")</span>
                                    }
                                    <input type="number" class="form-control form-control-sm measure-value-edit d-none" value="@item.Value" step="0.01" min="0" max="100" />
                                </td>
                                <td class="text-center">
                                    @if (item.MeasureType == MonitoringAndEvaluationPlatform.Enums.MeasureType.Quantitative)
                                    {
                                        <span class="modern-badge badge-warning measure-percentage-display">@item.Value.ToString("0.##")%</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="text-muted small">@item.Unit</span>
                                </td>
                                <td class="text-center">
                                    @if (item.MeasureType == MonitoringAndEvaluationPlatform.Enums.MeasureType.Quantitative)
                                    {
                                        <span class="modern-badge badge-primary">
                                            <i class="fas fa-hashtag me-1"></i>@Localizer["Quantitative"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="modern-badge badge-info">
                                            <i class="fas fa-comment-alt me-1"></i>@Localizer["Qualitative"]
                                        </span>
                                    }
                                </td>
                                @if (ViewBag.SelectedPhaseId == null)
                                {
                                    <td class="indicator-cell">
                                        <div class="d-flex align-items-center">
                                            <div class="indicator-icon me-3">
                                                <i class="fas fa-layer-group"></i>
                                            </div>
                                            <div>
                                                <span class="indicator-name">@item.ProjectPhase?.Name</span>
                                            </div>
                                        </div>
                                    </td>
                                }
                                <td class="text-center">
                                    <div class="btn-group action-buttons action-buttons-view" role="group">
                                        <button type="button" class="btn btn-outline-primary btn-sm action-btn edit-measure-btn"
                                                data-code="@item.Code" title="@Localizer["Edit"]">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        @if (item.Files != null && item.Files.Any())
                                        {
                                            @foreach (var f in item.Files)
                                            {
                                                <a href="@f.FilePath" target="_blank" class="btn btn-outline-secondary btn-sm action-btn" title="@f.FileName">
                                                    <i class="fas fa-file-alt"></i>
                                                </a>
                                            }
                                        }
                                        <button type="button" class="btn btn-outline-info btn-sm action-btn view-details-btn"
                                                data-code="@item.Code"
                                                data-name="@item.Name"
                                                data-date="@item.Date.ToString("yyyy-MM-dd")"
                                                data-value="@item.Value.ToString("0.##")"
                                                data-note="@item.Note"
                                                data-quantity="@item.Quantity"
                                                data-unit="@item.Unit"
                                                data-phase-name="@item.ProjectPhase?.Name"
                                                data-measure-type="@((int)item.MeasureType)"
                                                title="@Localizer["View Details"]">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-success btn-sm action-btn view-chart-btn"
                                                data-phase-id="@item.ProjectPhaseId"
                                                data-phase-name="@item.ProjectPhase?.Name"
                                                title="@Localizer["View Chart"]">
                                            <i class="fas fa-chart-line"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm action-btn"
                                               onclick="deleteMeasure('@item.Code')" title="@Localizer["Delete"]">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                    <div class="btn-group action-buttons action-buttons-edit d-none" role="group">
                                        <button type="button" class="btn btn-outline-success btn-sm action-btn save-measure-btn"
                                                data-code="@item.Code" title="@Localizer["Save"]">
                                            <i class="fas fa-check"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm action-btn cancel-edit-btn"
                                                title="@Localizer["Cancel"]">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h5 class="empty-title">@Localizer["No measures found"]</h5>
                    <p class="empty-text">
                        @if (ViewBag.SelectedPhaseId != null)
                        {
                            @Localizer["No measures have been added for this phase yet. Use the form above to add the first measure."]
                        }
                        else
                        {
                            @Localizer["No measures have been added yet."]
                        }
                    </p>
                </div>
            }
    </div>
</div>

<!-- Option 2: Quick View Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modern-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsModalLabel">
                    <i class="fas fa-info-circle me-2"></i>@Localizer["Measure Details"]
                </h5>
                <button type="button" style="margin-left:0" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fas fa-tag me-2"></i>@Localizer["Name"]
                    </div>
                    <div class="detail-value" id="modal-name"></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fas fa-calendar me-2"></i>@Localizer["Date"]
                    </div>
                    <div class="detail-value" id="modal-date"></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fas fa-chart-bar me-2"></i>@Localizer["Achievement Value"]
                    </div>
                    <div class="detail-value" id="modal-value"></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fas fa-sliders-h me-2"></i>@Localizer["Type"]
                    </div>
                    <div class="detail-value" id="modal-measure-type"></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fas fa-layer-group me-2"></i>@Localizer["Phase"]
                    </div>
                    <div class="detail-value" id="modal-indicator-name"></div>
                </div>
                <div id="modal-quantity-item" class="detail-item" style="display:none;">
                    <div class="detail-label">
                        <i class="fas fa-hashtag me-2"></i>@Localizer["Quantity"]
                    </div>
                    <div class="detail-value" id="modal-quantity"></div>
                </div>
                <div id="modal-unit-item" class="detail-item" style="display:none;">
                    <div class="detail-label">
                        <i class="fas fa-ruler me-2"></i>@Localizer["Unit"]
                    </div>
                    <div class="detail-value" id="modal-unit"></div>
                </div>
                <div id="modal-note-item" class="detail-item" style="display:none;">
                    <div class="detail-label">
                        <i class="fas fa-sticky-note me-2"></i>@Localizer["Note"]
                    </div>
                    <div class="detail-value" id="modal-note"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Option 1: Chart Modal -->
<div class="modal fade" id="chartModal" tabindex="-1" aria-labelledby="chartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modern-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="chartModalLabel">
                    <i class="fas fa-chart-line me-2"></i>@Localizer["Measures Trend"]
                </h5>
                <button type="button" class="btn-close" style="margin-left:0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="chart-indicator-info" class="mb-3"></div>
                <canvas id="measuresChart"></canvas>
            </div>
        </div>
    </div>
</div>

