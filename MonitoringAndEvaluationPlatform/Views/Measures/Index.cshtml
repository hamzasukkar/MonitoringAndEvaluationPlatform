    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Compute the sum of all measure values currently in the table,
        // optionally excluding one row by its measure code.
        function getMeasureTotal(excludeCode) {
            let total = 0;
            $('.table-row').each(function() {
                const rowCode = $(this).attr('id').replace('row-', '');
                if (excludeCode && rowCode == excludeCode) return;
                const val = parseFloat($(this).find('.measure-value-display').data('value'));
                if (!isNaN(val)) total += val;
            });
            return total;
        }

        $(document).ready(function() {
            // Option 2: Handle view details button click
            $('.view-details-btn').on('click', function() {
                const btn = $(this);
                const name = btn.data('name');
                const date = btn.data('date');
                const value = btn.data('value');
                const note = btn.data('note');
                const quantity = btn.data('quantity');
                const unit = btn.data('unit');
                const phaseName = btn.data('phase-name');
                const measureType = btn.data('measure-type');

                // Populate modal
                $('#modal-name').text(name);
                $('#modal-date').text(date);
                $('#modal-value').html('<span class="modern-badge badge-success">' + value + '</span>');
                if (measureType == 1) {
                    $('#modal-measure-type').html('<span class="modern-badge badge-primary"><i class="fas fa-hashtag me-1"></i>@Localizer["Quantitative"]</span>');
                } else {
                    $('#modal-measure-type').html('<span class="modern-badge badge-info"><i class="fas fa-comment-alt me-1"></i>@Localizer["Qualitative"]</span>');
                }
                $('#modal-indicator-name').text(phaseName);
                if (quantity !== '' && quantity !== undefined && quantity !== null) {
                    $('#modal-quantity').text(quantity + (unit ? ' ' + unit : ''));
                    $('#modal-quantity-item').show();
                    $('#modal-unit-item').hide();
                } else if (unit) {
                    $('#modal-quantity').text('—');
                    $('#modal-quantity-item').hide();
                    $('#modal-unit').text(unit);
                    $('#modal-unit-item').show();
                } else {
                    $('#modal-quantity-item').hide();
                    $('#modal-unit-item').hide();
                }
                if (note) {
                    $('#modal-note').text(note);
                    $('#modal-note-item').show();
                } else {
                    $('#modal-note-item').hide();
                }

                // Show modal
                new bootstrap.Modal(document.getElementById('detailsModal')).show();
            });

            // Option 1: Handle view chart button click
            $('.view-chart-btn').on('click', function() {
                const btn = $(this);
                const phaseId = btn.data('phase-id');
                const phaseName = btn.data('phase-name');

                // Set phase info
                $('#chart-indicator-info').html('<strong><i class="fas fa-layer-group me-2"></i>' + phaseName + '</strong>');

                // Fetch measures for this phase
                $.ajax({
                    url: '@Url.Action("GetMeasuresByPhase", "Measures")',
                    type: 'GET',
                    data: { phaseId: phaseId },
                    success: function(response) {
                        // Prepare chart data
                        const dates = response.map(m => m.date);
                        const values = response.map(m => m.value);

                        // Show modal
                        const modal = new bootstrap.Modal(document.getElementById('chartModal'));
                        modal.show();

                        // Wait for modal to be shown before creating chart
                        $('#chartModal').on('shown.bs.modal', function () {
                            const ctx = document.getElementById('measuresChart').getContext('2d');

                            // Destroy existing chart if any
                            if (window.measuresChartInstance) {
                                window.measuresChartInstance.destroy();
                            }

                            // Create new chart
                            window.measuresChartInstance = new Chart(ctx, {
                                type: 'line',
                                data: {
                                    labels: dates,
                                    datasets: [{
                                        label: '@Localizer["Achievement Value"]',
                                        data: values,
                                        borderColor: 'rgb(75, 192, 192)',
                                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                                        tension: 0.4,
                                        fill: true,
                                        pointRadius: 6,
                                        pointHoverRadius: 8,
                                        pointBackgroundColor: 'rgb(75, 192, 192)',
                                        pointBorderColor: '#fff',
                                        pointBorderWidth: 2
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: true,
                                    plugins: {
                                        legend: {
                                            display: true,
                                            position: 'top',
                                        },
                                        tooltip: {
                                            mode: 'index',
                                            intersect: false,
                                        }
                                    },
                                    scales: {
                                        y: {
                                            beginAtZero: true,
                                            grid: {
                                                color: 'rgba(0, 0, 0, 0.05)'
                                            }
                                        },
                                        x: {
                                            grid: {
                                                color: 'rgba(0, 0, 0, 0.05)'
                                            }
                                        }
                                    }
                                }
                            });
                        });
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: '@Localizer["Failed to load chart data"]',
                            confirmButtonColor: 'var(--danger-color)'
                        });
                    }
                });
            });

            // Handle edit button click
            $('.edit-measure-btn').on('click', function() {
                const row = $(this).closest('tr');
                const rowTargetQty = parseFloat(row.data('target-quantity'));
                const hasTargetQty = !isNaN(rowTargetQty) && rowTargetQty > 0;

                // Show edit inputs and hide display values
                row.find('.measure-name-display, .measure-note-display, .measure-quantity-display').addClass('d-none');
                row.find('.measure-name-edit, .measure-note-edit').removeClass('d-none');
                row.find('.measure-quantity-unit-edit').removeClass('d-none').addClass('d-flex');
                row.find('.measure-date-display').addClass('d-none');
                row.find('.measure-date-edit').removeClass('d-none');
                row.find('.measure-value-display').addClass('d-none');
                row.find('.measure-value-edit').removeClass('d-none');

                // If phase has TargetQuantity, make value read-only and auto-calculate
                if (hasTargetQty) {
                    const valueInput = row.find('.measure-value-edit');
                    valueInput.prop('readonly', true).addClass('bg-light');
                    row.find('.measure-quantity-edit').on('input.autoCalc', function() {
                        const qty = parseFloat($(this).val());
                        if (!isNaN(qty) && qty >= 0) {
                            valueInput.val(Math.min((qty / rowTargetQty) * 100, 100).toFixed(2));
                        }
                    });
                }

                // Switch button groups
                row.find('.action-buttons-view').addClass('d-none');
                row.find('.action-buttons-edit').removeClass('d-none');
            });

            // Handle cancel button click
            $('.cancel-edit-btn').on('click', function() {
                const row = $(this).closest('tr');

                // Clean up auto-calc listener and readonly state
                row.find('.measure-quantity-edit').off('input.autoCalc');
                row.find('.measure-value-edit').prop('readonly', false).removeClass('bg-light');

                // Hide edit inputs and show display values
                row.find('.measure-name-display').removeClass('d-none');
                row.find('.measure-name-edit, .measure-note-edit').addClass('d-none');
                row.find('.measure-note-display').removeClass('d-none');
                row.find('.measure-quantity-display').removeClass('d-none');
                row.find('.measure-quantity-unit-edit').addClass('d-none').removeClass('d-flex');
                row.find('.measure-date-display').removeClass('d-none');
                row.find('.measure-date-edit').addClass('d-none');
                row.find('.measure-value-display').removeClass('d-none');
                row.find('.measure-value-edit').addClass('d-none');

                // Switch button groups
                row.find('.action-buttons-view').removeClass('d-none');
                row.find('.action-buttons-edit').addClass('d-none');
            });

            // Handle save button click
            $('.save-measure-btn').on('click', function() {
                const btn = $(this);
                const measureCode = btn.data('code');
                const row = btn.closest('tr');
                const rowTargetQty = parseFloat(row.data('target-quantity'));
                const hasTargetQty = !isNaN(rowTargetQty) && rowTargetQty > 0;

                let editedValue;
                if (hasTargetQty) {
                    const qty = parseFloat(row.find('.measure-quantity-edit').val());
                    if (isNaN(qty) || qty < 0) {
                        Swal.fire({ icon: 'error', title: '@Localizer["Invalid Value"]', text: '@Localizer["Quantity is required when a target is set."]', confirmButtonColor: 'var(--danger-color)' });
                        return;
                    }
                    editedValue = Math.min((qty / rowTargetQty) * 100, 100);
                    row.find('.measure-value-edit').val(editedValue.toFixed(2));
                } else {
                    editedValue = parseFloat(row.find('.measure-value-edit').val());
                    if (editedValue < 0 || editedValue > 100) {
                        Swal.fire({ icon: 'error', title: '@Localizer["Invalid Value"]', text: '@Localizer["Value must be between 0 and 100."]', confirmButtonColor: 'var(--danger-color)' });
                        return;
                    }

                    const otherTotal = getMeasureTotal(measureCode);
                    if (otherTotal + editedValue > 100) {
                        Swal.fire({ icon: 'error', title: '@Localizer["Invalid Value"]', text: '@Localizer["Total measures value for this indicator cannot exceed 100%."]' + ' (@Localizer["Other measures total"]: ' + otherTotal.toFixed(2) + '%, @Localizer["Remaining"]: ' + (100 - otherTotal).toFixed(2) + '%)', confirmButtonColor: 'var(--danger-color)' });
                        return;
                    }
                }

                const formData = {
                    Code: measureCode,
                    Name: row.find('.measure-name-edit').val(),
                    Date: row.find('.measure-date-edit').val(),
                    Value: editedValue,
                    Note: row.find('.measure-note-edit').val(),
                    Quantity: row.find('.measure-quantity-edit').val(),
                    Unit: row.find('.measure-unit-edit').val(),
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                };

                // Disable button and show loading
                const originalHtml = btn.html();
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                // Send AJAX request
                $.ajax({
                    url: '@Url.Action("Edit", "Measures")/' + measureCode,
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        // Update display values
                        const dateValue = formData.Date;
                        const numericValue = parseFloat(formData.Value);
                        const valueFormatted = parseFloat(numericValue.toFixed(2)).toString();

                        row.find('.measure-name-display').text(formData.Name);
                        row.find('.measure-date-display').text(dateValue);
                        row.find('.measure-value-display').text(valueFormatted).attr('data-value', numericValue);

                        // Update quantity/unit display
                        const qty = formData.Quantity;
                        const unitVal = formData.Unit;
                        if (qty || unitVal) {
                            let qtyDisplay = row.find('.measure-quantity-display');
                            if (qtyDisplay.length === 0) {
                                row.find('.measure-quantity-unit-edit').before('<div class="text-muted small measure-quantity-display mt-1"><i class="fas fa-ruler me-1"></i></div>');
                                qtyDisplay = row.find('.measure-quantity-display');
                            }
                            qtyDisplay.html('<i class="fas fa-ruler me-1"></i>' + (qty || '') + ' ' + (unitVal || ''));
                        }

                        // Clean up auto-calc listener and readonly state
                        row.find('.measure-quantity-edit').off('input.autoCalc');
                        row.find('.measure-value-edit').prop('readonly', false).removeClass('bg-light');

                        // Update displayed value to reflect auto-calculated result
                        const finalValue = parseFloat(editedValue);
                        const qtyNum = parseFloat(qty);
                        // Value column shows the quantity for quantitative rows, otherwise the achievement value
                        const valueDisplayText = !isNaN(qtyNum)
                            ? parseFloat(qtyNum.toFixed(2)).toString()
                            : parseFloat(finalValue.toFixed(2)).toString();
                        row.find('.measure-value-display').text(valueDisplayText).attr('data-value', finalValue);
                        // Percentage column always reflects the achievement value
                        row.find('.measure-percentage-display').text(parseFloat(finalValue.toFixed(2)).toString() + '%');

                        // Hide edit inputs and show display values
                        row.find('.measure-name-display').removeClass('d-none');
                        row.find('.measure-name-edit').addClass('d-none');
                        row.find('.measure-note-edit').addClass('d-none');
                        row.find('.measure-quantity-display').removeClass('d-none');
                        row.find('.measure-quantity-unit-edit').addClass('d-none').removeClass('d-flex');
                        row.find('.measure-date-display').removeClass('d-none');
                        row.find('.measure-date-edit').addClass('d-none');
                        row.find('.measure-value-display').removeClass('d-none');
                        row.find('.measure-value-edit').addClass('d-none');

                        // Switch button groups
                        row.find('.action-buttons-view').removeClass('d-none');
                        row.find('.action-buttons-edit').addClass('d-none');

                        // Show success message
                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success"]',
                            text: response.message || '@Localizer["Measure updated successfully"]',
                            timer: 2000,
                            showConfirmButton: false,
                            confirmButtonColor: 'var(--primary-color)',
                            customClass: {
                                popup: 'modern-swal-popup'
                            }
                        });
                    },
                    error: function(xhr) {
                        var errMsg = '@Localizer["Failed to update measure. Please try again."]';
                        try { var r = JSON.parse(xhr.responseText); if (r.message) errMsg = r.message; } catch(e) {}
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: errMsg,
                            confirmButtonColor: 'var(--danger-color)',
                            customClass: {
                                popup: 'modern-swal-popup'
                            }
                        });
                    },
                    complete: function() {
                        // Re-enable button
                        btn.prop('disabled', false).html(originalHtml);
                    }
                });
            });

            @if (inlineIsFirst)
            {
                <text>
            // Radio toggle for first measure (inline form)
            function applyInlineTypeMode(isQuant) {
                $('#inlineValueField').toggle(!isQuant);
                $('#inlineQuantityField').toggle(isQuant);
                $('#inlineTargetQtyField').toggle(isQuant);
                $('#inlineUnitField').toggle(isQuant);
                $('#measureValue').prop('required', !isQuant);
                $('#measureQuantity').prop('required', isQuant);
                $('#measureTargetQty').prop('required', isQuant);
            }
            $('input[name="inlineMeasureType"]').on('change', function() {
                applyInlineTypeMode($(this).val() === '1');
            });
            // Sync initial field visibility with the default-checked type (Quantitative)
            applyInlineTypeMode($('input[name="inlineMeasureType"]:checked').val() === '1');
                </text>
            }

            // Auto-calculate value from quantity when TargetQuantity is set
            const phaseTargetQty = parseFloat($('#inlineMeasureForm').data('target-quantity'));
            if (!isNaN(phaseTargetQty) && phaseTargetQty > 0) {
                $('#measureQuantity').on('input', function() {
                    const qty = parseFloat($(this).val());
                    if (!isNaN(qty) && qty >= 0) {
                        const autoValue = Math.min((qty / phaseTargetQty) * 100, 100);
                        $('#measureValue').val(autoValue.toFixed(2));
                    } else {
                        $('#measureValue').val('');
                    }
                });
            }

            // Handle inline measure form submission
            $('#inlineMeasureForm').on('submit', function(e) {
                e.preventDefault();

                const phaseTargetFromData = parseFloat($(this).data('target-quantity'));
                const userEnteredTarget = parseFloat($('#measureTargetQty').val());
                const effectiveTarget = (!isNaN(phaseTargetFromData) && phaseTargetFromData > 0)
                    ? phaseTargetFromData
                    : ((!isNaN(userEnteredTarget) && userEnteredTarget > 0) ? userEnteredTarget : NaN);
                const hasTargetQty = !isNaN(effectiveTarget) && effectiveTarget > 0;

                let rawValue;
                const isQuantMode = $('#inlineQuantityField').is(':visible');

                if (isQuantMode) {
                    const qty = parseFloat($('#measureQuantity').val());
                    if (isNaN(qty) || qty < 0) {
                        Swal.fire({ icon: 'error', title: '@Localizer["Invalid Value"]', text: '@Localizer["Please enter a valid quantity."]', confirmButtonColor: 'var(--danger-color)' });
                        return;
                    }
                    rawValue = hasTargetQty ? Math.min((qty / effectiveTarget) * 100, 100) : Math.min(qty, 100);
                } else {
                    rawValue = parseFloat($('#measureValue').val());
                    if (isNaN(rawValue) || rawValue < 0 || rawValue > 100) {
                        Swal.fire({ icon: 'error', title: '@Localizer["Invalid Value"]', text: '@Localizer["Value must be between 0 and 100."]', confirmButtonColor: 'var(--danger-color)' });
                        return;
                    }

                    const currentTotal = getMeasureTotal(null);
                    if (currentTotal + rawValue > 100) {
                        Swal.fire({ icon: 'error', title: '@Localizer["Invalid Value"]', text: '@Localizer["Total measures value for this indicator cannot exceed 100%."]' + ' (@Localizer["Current total"]: ' + currentTotal.toFixed(2) + '%, @Localizer["Remaining"]: ' + (100 - currentTotal).toFixed(2) + '%)', confirmButtonColor: 'var(--danger-color)' });
                        return;
                    }
                }

                const formData = new FormData();
                formData.append('Name', $('#measureName').val());
                formData.append('Date', $('#measureDate').val());
                formData.append('Value', rawValue);
                formData.append('Note', $('#measureNote').val());
                if ($('#measureQuantity').val()) formData.append('Quantity', parseFloat($('#measureQuantity').val()));
                if (!isNaN(userEnteredTarget) && userEnteredTarget > 0) formData.append('PhaseTargetQuantity', userEnteredTarget);
                formData.append('Unit', $('#measureUnit').val());
                formData.append('ProjectPhaseId', parseInt($('#phaseId').val()));
                formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
                const fileInput = document.getElementById('measureFile');
                for (let i = 0; i < fileInput.files.length; i++) {
                    formData.append('MeasureFiles', fileInput.files[i]);
                }

                // Disable button and show loading
                const btn = $('#addMeasureBtn');
                const originalText = btn.html();
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>@Localizer["Adding..."]');

                // Send AJAX request
                $.ajax({
                    url: '@Url.Action("CreateFromDetails", "Measures")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        // Show success message
                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success"]',
                            text: response.message || '@Localizer["Measure added successfully and indicator performance updated"]',
                            timer: 2000,
                            showConfirmButton: false,
                            confirmButtonColor: 'var(--primary-color)',
                            customClass: {
                                popup: 'modern-swal-popup'
                            }
                        });

                        // Reset form
                        $('#measureName').val('');
                        $('#measureValue').val('');
                        $('#measureNote').val('');
                        $('#measureQuantity').val('');
                        $('#measureUnit').val('');
                        $('#measureDate').val('@DateTime.Today.ToString("yyyy-MM-dd")');
                        $('#measureFile').val('');

                        // Reload page to show new measure
                        setTimeout(function() {
                            location.reload();
                        }, 2000);
                    },
                    error: function(xhr) {
                        var errMsg = '@Localizer["Failed to add measure. Please try again."]';
                        try { var r = JSON.parse(xhr.responseText); if (r.message) errMsg = r.message; } catch(e) {}
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: errMsg,
                            confirmButtonColor: 'var(--danger-color)',
                            customClass: {
                                popup: 'modern-swal-popup'
                            }
                        });
                    },
                    complete: function() {
                        // Re-enable button
                        btn.prop('disabled', false).html(originalText);
                    }
                });
            });
        });

        // Delete measure function
        function deleteMeasure(measureCode) {
            Swal.fire({
                title: '@Localizer["Are you sure?"]',
                text: '@Localizer["This will delete the measure!"]',
                icon: 'warning',
                showCancelButton: true,
                cancelButtonText: '@Localizer["Cancel"]',
                confirmButtonText: '@Localizer["Yes, delete it!"]',
                reverseButtons: true,
                confirmButtonColor: 'var(--danger-color)',
                cancelButtonColor: 'var(--secondary-color)',
                customClass: {
                    popup: 'modern-swal-popup',
                    title: 'modern-swal-title'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // Send AJAX delete request
                    $.ajax({
                        url: '@Url.Action("Delete", "Measures")/' + measureCode,
                        type: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            // Show success message
                            Swal.fire({
                                icon: 'success',
                                title: '@Localizer["Deleted!"]',
                                text: '@Localizer["Measure has been deleted successfully"]',
                                timer: 2000,
                                showConfirmButton: false,
                                confirmButtonColor: 'var(--primary-color)',
                                customClass: {
                                    popup: 'modern-swal-popup'
                                }
                            }).then(() => {
                                // Remove the row from table
                                $('#row-' + measureCode).fadeOut(400, function() {
                                    $(this).remove();

                                    // Check if table is empty
                                    if ($('.table-row').length === 0) {
                                        location.reload();
                                    }
                                });
                            });
                        },
                        error: function(xhr) {
                            // Show error message
                            Swal.fire({
                                icon: 'error',
                                title: '@Localizer["Error"]',
                                text: '@Localizer["Failed to delete measure. Please try again."]',
                                confirmButtonColor: 'var(--danger-color)',
                                customClass: {
                                    popup: 'modern-swal-popup'
                                }
                            });
                        }
                    });
                }
            });
        }

        // Add loading animation on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Animate table rows
            const tableRows = document.querySelectorAll('.table-row');
            tableRows.forEach((row, index) => {
                row.style.opacity = '0';
                row.style.transform = 'translateY(20px)';
                row.style.transition = 'all 0.6s ease';

                setTimeout(() => {
                    row.style.opacity = '1';
                    row.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
}

@await Html.PartialAsync("_HelpModal")
