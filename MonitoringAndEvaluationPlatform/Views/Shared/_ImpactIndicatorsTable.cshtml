@model IEnumerable<MonitoringAndEvaluationPlatform.Models.ImpactIndicator>
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@using MonitoringAndEvaluationPlatform.Models
@inject IViewLocalizer Localizer
@inject IAuthorizationService Auth
@*
    The impact indicators table, shared by ImpactIndicators/Index, the "Impact Measurement"
    card on the project details page, and Impact/Details, so they never drift apart.

    Requires project-details.css (modern-table, empty-state) and impact-indicators.css
    (rate bar) — the calling view links them.

    NOTE: whatever query supplies this model must .Include(i => i.YearlyValues), otherwise
    every row renders 0% achieved without any error.

    Two INDEPENDENT switches control the Actions column, because they act on two different
    objects:

      ViewData["ImpactTableReadOnly"] = true
          Hides Edit and Delete, which act on the INDICATOR itself — they would remove the row
          from ImpactIndicators, not merely detach it from whatever is grouping it.

      ViewData["ImpactUnlinkOutputId"] = <project output id>
          Shows Remove, which acts on the LINK: it deletes one ProjectOutputImpactIndicator row
          for that output and leaves the indicator alone. Only Impact/Details sets it, and only
          once it has established that this user may edit THAT output — ModifyStrategy plus the
          ministry-scope rule (ViewBag.CanEditThis). This partial deliberately does not re-derive
          that: the scope half needs the ProjectOutput, which is not in this model. Same
          "caller decides" contract as ImpactController's ViewBag.EditableOutputIds, and
          ImpactController.UnlinkIndicator re-checks all of it server-side anyway.

    Impact/Details sets BOTH: there, Edit/Delete are the wrong verbs and Remove is the right one.
    The other two callers set neither.
*@
@{
    var indicators = (Model ?? Enumerable.Empty<ImpactIndicator>())
        .OrderBy(i => i.Name).ToList();

    var readOnly = ViewData["ImpactTableReadOnly"] as bool? ?? false;

    var canModify = !readOnly && (await Auth.AuthorizeAsync(User, Permissions.ModifyIndicator)).Succeeded;
    var canDelete = !readOnly && (await Auth.AuthorizeAsync(User, Permissions.DeleteIndicator)).Succeeded;

    // See above: set by the caller, and only when that caller has already established this user
    // may edit that project output. Deliberately independent of readOnly.
    var unlinkFromOutputId = ViewData["ImpactUnlinkOutputId"] as int?;
}

@if (indicators.Any())
{
    <div class="modern-table-container">
        <table class="modern-table">
            <thead class="table-header">
                <tr>
                    <th>#</th>
                    <th><i class="fas fa-tag me-1"></i>@Localizer["Indicator"]</th>
                    <th><i class="fas fa-ruler me-1"></i>@Localizer["Unit"]</th>
                    <th class="text-center"><i class="fas fa-bullseye me-1"></i>@Localizer["Target"]</th>
                    <th class="text-center"><i class="fas fa-check-double me-1"></i>@Localizer["Achieved"]</th>
                    <th style="min-width:170px"><i class="fas fa-percent me-1"></i>@Localizer["Achievement Rate"]</th>
                    <th class="text-center"><i class="fas fa-cogs me-1"></i>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 0; }
                @foreach (var ind in indicators)
                {
                    idx++;
                    <tr class="table-row">
                        <td>@idx</td>
                        <td>
                            <a href="@Url.Action("Details", "ImpactIndicators", new { id = ind.Id })"
                               class="fw-bold text-decoration-none">@ind.Name</a>
                        </td>
                        <td class="text-muted">@(string.IsNullOrWhiteSpace(ind.Unit) ? "—" : ind.Unit)</td>
                        <td class="text-center">@ind.TargetValue.ToString("N2")</td>
                        <td class="text-center fw-bold">@ind.AchievedValue.ToString("N2")</td>
                        <td><partial name="_ImpactRate" model="ind" /></td>
                        <td class="text-center">
                            <div class="btn-group action-buttons" role="group">
                                <a href="@Url.Action("Details", "ImpactIndicators", new { id = ind.Id })"
                                   class="btn btn-outline-info btn-sm action-btn" title="@Localizer["Details"]">
                                    <i class="fas fa-circle-info"></i>
                                </a>
                                @if (canModify)
                                {
                                    <a href="@Url.Action("Edit", "ImpactIndicators", new { id = ind.Id })"
                                       class="btn btn-outline-primary btn-sm action-btn" title="@Localizer["Edit"]">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                }
                                @if (canDelete)
                                {
                                    <form asp-controller="ImpactIndicators" asp-action="Delete" asp-route-id="@ind.Id"
                                          method="post" style="display:inline"
                                          onsubmit="return confirm('@Localizer["Delete this indicator? Its yearly values will also be deleted. This cannot be undone."]')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm action-btn"
                                                title="@Localizer["Delete"]">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                }
                                @*
                                    Unlinks THIS indicator from the project output being viewed.
                                    Only the ProjectOutputImpactIndicator row goes — unlike the
                                    fa-trash-alt button above, which deletes the indicator itself.
                                    Hence a different icon AND a different colour: amber, never the
                                    red of a real delete.

                                    The confirm text must contain NO apostrophe. Razor encodes '
                                    as &#x27; in an attribute, the browser decodes it before the JS
                                    parser runs, and the handler then fails to parse — which
                                    submits the form with no confirmation at all, silently.
                                *@
                                @if (unlinkFromOutputId.HasValue)
                                {
                                    <form asp-controller="Impact" asp-action="UnlinkIndicator"
                                          asp-route-id="@unlinkFromOutputId.Value"
                                          method="post" style="display:inline"
                                          onsubmit="return confirm('@Localizer["Remove this indicator from this project output? The indicator itself is not deleted. The weights of the remaining indicators will be split equally."]')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="impactIndicatorId" value="@ind.Id" />
                                        <button type="submit" class="btn btn-outline-warning btn-sm action-btn"
                                                title="@Localizer["Remove from this project output"]">
                                            <i class="fas fa-link-slash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-icon"><i class="fas fa-bullseye"></i></div>
        <h5 class="empty-title">@Localizer["No Impact Indicators Yet"]</h5>
        <p class="empty-text">@Localizer["Add an indicator to start measuring what this project delivers."]</p>
    </div>
}
