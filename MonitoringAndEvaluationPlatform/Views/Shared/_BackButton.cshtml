@using MonitoringAndEvaluationPlatform.Helpers
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject INavigationHelper NavigationHelper

@{
    var referer = Context.Request.Headers["Referer"].ToString();
    var backButtonInfo = NavigationHelper.GetBackButtonInfo(ViewData, ViewContext.RouteData, referer, Url);
}

@if (backButtonInfo.ShouldDisplay)
{
    <a href="@backButtonInfo.Url" class="back-button" title="@Localizer[backButtonInfo.Text]"
       onclick="if(document.referrer) { history.back(); return false; }">
        <i class="@backButtonInfo.IconClass"></i>
        <span class="back-button-text">@Localizer[backButtonInfo.Text]</span>
    </a>
}

<style>
    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.2rem;
        background: linear-gradient(135deg, var(--primary-color, #2196F3), var(--primary-dark, #1976D2));
        color: white !important;
        text-decoration: none !important;
        border-radius: 10px;
        font-weight: 500;
        font-size: 0.95rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 12px rgba(33, 150, 243, 0.3);
        position: relative;
        overflow: hidden;
        border: none;
    }

    .back-button::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s ease;
    }

    .back-button:hover::before {
        left: 100%;
    }

    .back-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(33, 150, 243, 0.4);
        color: white !important;
        text-decoration: none !important;
    }

    .back-button:active {
        transform: translateY(0);
    }

    .back-button i {
        font-size: 1rem;
        transition: transform 0.3s ease;
    }

    /* RTL Support - flip arrow direction */
    [dir="rtl"] .back-button i {
        transform: scaleX(-1);
    }

    /* Arrow animation on hover */
    [dir="rtl"] .back-button:hover i {
        transform: scaleX(-1) translateX(3px);
    }

    [dir="ltr"] .back-button:hover i {
        transform: translateX(-3px);
    }

    .back-button-text {
        font-weight: 500;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    /* Responsive Design - icon only on mobile */
    @@media (max-width: 768px) {
        .back-button {
            padding: 0.5rem 1rem;
            font-size: 0.85rem;
        }

        .back-button-text {
            display: none;
        }

        .back-button i {
            font-size: 1.2rem;
        }
    }

    /* Theme Support - Green theme */
    [data-theme="green"] .back-button {
        background: linear-gradient(135deg, #4CAF50, #2A4C44);
        box-shadow: 0 4px 12px rgba(76, 175, 80, 0.3);
    }

    [data-theme="green"] .back-button:hover {
        box-shadow: 0 6px 20px rgba(76, 175, 80, 0.4);
    }

    /* Animation on page load */
    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    [dir="ltr"] .back-button {
        animation: slideInLeft 0.4s ease-out;
    }

    [dir="rtl"] .back-button {
        animation: slideInRight 0.4s ease-out;
    }

    /* Focus styles for accessibility */
    .back-button:focus {
        outline: 2px solid var(--accent-color, #64B5F6);
        outline-offset: 2px;
    }

    .back-button:focus:not(:focus-visible) {
        outline: none;
    }
</style>
