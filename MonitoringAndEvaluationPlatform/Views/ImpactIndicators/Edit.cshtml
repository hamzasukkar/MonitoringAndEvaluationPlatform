@model MonitoringAndEvaluationPlatform.Models.ImpactIndicator
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "Edit Impact Indicator";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var project = ViewBag.Project as MonitoringAndEvaluationPlatform.Models.Project;
    var achievementCount = Model.Achievements?.Count ?? 0;
}

<div class="dashboard-header">
    <div class="header-content">
        <div class="page-title-section">
            <div class="page-breadcrumb">
                @if (project != null)
                {
                    <a href="@Url.Action("Details", "Projects", new { id = project.ProjectID })" class="breadcrumb-link">
                        <i class="fas fa-project-diagram"></i>@project.ProjectName
                    </a>
                    <i class="fas fa-chevron-right breadcrumb-separator"></i>
                }
                <a href="@Url.Action("Details", new { id = Model.Id })" class="breadcrumb-link">@Model.Name</a>
                <i class="fas fa-chevron-right breadcrumb-separator"></i>
                <span class="current-page">@Localizer["Edit"]</span>
            </div>
            <h1 class="dashboard-title">@Localizer["Edit Impact Indicator"]</h1>
        </div>
        <div class="header-actions">
            <a href="@Url.Action("Details", new { id = Model.Id })" class="impact-btn secondary">
                <i class="fas fa-arrow-left me-2"></i>@Localizer["Back to Indicator"]
            </a>
        </div>
    </div>
</div>

<div class="impact-form-section">
    @if (achievementCount > 0)
    {
        <div class="alert alert-info py-2 small mb-3">
            <i class="fas fa-info-circle me-1"></i>
            @Localizer["This indicator has {0} recorded achievement(s). Changing the target updates the rate immediately; narrowing the period is blocked if it would strand any of them.", achievementCount]
        </div>
    }

    <div class="impact-form-card">
        <div class="impact-form-header">
            <div class="impact-form-icon"><i class="fas fa-edit"></i></div>
            <div>
                <h3 class="impact-form-title">@Localizer["Indicator Details"]</h3>
                <p class="impact-form-subtitle">@Localizer["Editing:"] @Model.Name</p>
            </div>
        </div>

        <div class="impact-form-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="impactForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ProjectID" />

                <partial name="_IndicatorForm" model="Model" />

                <div class="impact-actions">
                    <a href="@Url.Action("Details", new { id = Model.Id })" class="impact-btn secondary">
                        <i class="fas fa-times me-2"></i>@Localizer["Cancel"]
                    </a>
                    <button type="submit" class="impact-btn primary" id="submitBtn">
                        <i class="fas fa-save me-2"></i>@Localizer["Save Changes"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/impact-indicators.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('impactForm').addEventListener('submit', function () {
            var btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>@Localizer["Saving..."]';
        });
    </script>
}
