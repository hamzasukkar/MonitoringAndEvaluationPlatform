@model MonitoringAndEvaluationPlatform.Models.ImpactIndicator
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@using MonitoringAndEvaluationPlatform.Models
@inject IViewLocalizer Localizer
@inject IAuthorizationService Auth
@{
    ViewData["Title"] = "Impact Indicator";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";

    var canModify = (await Auth.AuthorizeAsync(User, Permissions.ModifyIndicator)).Succeeded;
    var canDelete = (await Auth.AuthorizeAsync(User, Permissions.DeleteIndicator)).Succeeded;

    var unit = string.IsNullOrWhiteSpace(Model.Unit) ? "" : Model.Unit;
}

<div class="dashboard-header">
    <div class="header-content">
        <div class="page-title-section">
            <div class="page-breadcrumb">
                <a href="@Url.Action("Index", "Projects")" class="breadcrumb-link">
                    <i class="fas fa-project-diagram"></i>@Localizer["Projects"]
                </a>
                <i class="fas fa-chevron-right breadcrumb-separator"></i>
                @if (Model.Project != null)
                {
                    <a href="@Url.Action("Details", "Projects", new { id = Model.ProjectID })" class="breadcrumb-link">
                        @Model.Project.ProjectName
                    </a>
                    <i class="fas fa-chevron-right breadcrumb-separator"></i>
                }
                <span class="current-page">@Model.Name</span>
            </div>
            <h1 class="dashboard-title">@Model.Name</h1>
        </div>

        <div class="header-actions d-flex gap-2">
            @if (canModify)
            {
                <a href="@Url.Action("Edit", new { id = Model.Id })" class="impact-btn secondary">
                    <i class="fas fa-edit me-2"></i>@Localizer["Edit"]
                </a>
            }
            <a href="@Url.Action("Details", "Projects", new { id = Model.ProjectID })" class="impact-btn secondary">
                <i class="fas fa-arrow-left me-2"></i>@Localizer["Back to Project"]
            </a>
        </div>
    </div>
</div>

<div class="container-fluid">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ═══════════════════ SUMMARY ═══════════════════ -->
    <div class="impact-summary">
        <div class="impact-tile">
            <div class="impact-tile-icon target"><i class="fas fa-bullseye"></i></div>
            <div>
                <div class="impact-tile-label">@Localizer["Target"]</div>
                <div class="impact-tile-value">
                    @Model.TargetValue.ToString("N0")<span class="impact-tile-unit">@unit</span>
                </div>
            </div>
        </div>
        <div class="impact-tile">
            <div class="impact-tile-icon achieved"><i class="fas fa-check-double"></i></div>
            <div>
                <div class="impact-tile-label">@Localizer["Achieved"]</div>
                <div class="impact-tile-value">
                    @Model.AchievedValue.ToString("N0")<span class="impact-tile-unit">@unit</span>
                </div>
            </div>
        </div>
        <div class="impact-tile">
            <div class="impact-tile-icon rate"><i class="fas fa-percent"></i></div>
            <div>
                <div class="impact-tile-label">@Localizer["Achievement Rate"]</div>
                <div class="impact-tile-value">@Model.AchievementRate.ToString("0.#")%</div>
            </div>
        </div>
        <div class="impact-tile">
            <div class="impact-tile-icon remaining"><i class="fas fa-hourglass-half"></i></div>
            <div>
                <div class="impact-tile-label">@Localizer["Remaining to Target"]</div>
                <div class="impact-tile-value">
                    @Model.RemainingToTarget.ToString("N0")<span class="impact-tile-unit">@unit</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ INDICATOR INFO ═══════════════════ -->
    <div class="chart-card mb-4">
        <h3 class="chart-title">
            <i class="fas fa-info-circle me-2"></i>@Localizer["Indicator Information"]
        </h3>
        <div class="chart-content">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="impact-tile-label">@Localizer["Unit"]</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.Unit) ? Localizer["Not specified"].Value : Model.Unit)</div>
                </div>
                <div class="col-md-6">
                    <div class="impact-tile-label">@Localizer["Project"]</div>
                    <div>@(Model.Project?.ProjectName ?? "—")</div>
                </div>
                <div class="col-12">
                    <div class="impact-tile-label">@Localizer["Progress"]</div>
                    <partial name="_ImpactRate" model="Model" />
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="col-12">
                        <div class="impact-tile-label">@Localizer["Description"]</div>
                        <div>@Model.Description</div>
                    </div>
                }
            </div>

            <div class="alert alert-light border mt-3 mb-0 small">
                <i class="fas fa-calculator me-1"></i>
                <strong>@Localizer["How the rate is calculated"]:</strong>
                @Localizer["Achievement Rate"] =
                (@Model.AchievedValue.ToString("N0") ÷ @Model.TargetValue.ToString("N0")) × 100 =
                <strong>@Model.AchievementRate.ToString("0.#")%</strong>.
                <br />
                <span class="text-muted">
                    @Localizer["Impact indicators are measured separately from project execution — they do not affect project performance or the results framework."]
                </span>
            </div>

            @if (canModify)
            {
                <div class="mt-3">
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="impact-btn primary">
                        <i class="fas fa-pen-to-square me-2"></i>@Localizer["Update Achieved Value"]
                    </a>
                </div>
            }
        </div>
    </div>

    @if (canDelete)
    {
        <div class="chart-card mb-4">
            <h3 class="chart-title text-danger">
                <i class="fas fa-triangle-exclamation me-2"></i>@Localizer["Danger Zone"]
            </h3>
            <div class="chart-content d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-muted small">
                    @Localizer["An indicator linked to a framework impact target cannot be deleted until it is unlinked there."]
                </span>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('@Localizer["Delete this indicator? This cannot be undone."]')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="fas fa-trash-alt me-2"></i>@Localizer["Delete Indicator"]
                    </button>
                </form>
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/project-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/impact-indicators.css" asp-append-version="true" />
}
