@model IEnumerable<MonitoringAndEvaluationPlatform.Models.SubOutput>
@using MonitoringAndEvaluationPlatform.Helpers
@using MonitoringAndEvaluationPlatform.Models
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "SubOutputs";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var culture = Context.Features.Get<IRequestCultureFeature>().RequestCulture.Culture.Name;

    string GetMatchBadgeClass(string type)
    {
        return type switch
        {
            "SubOutput" => "bg-purple",
            "Indicator" => "bg-pink",
            "Project" => "bg-info",
            _ => "bg-secondary"
        };
    }

    string GetMatchColorClass(string type)
    {
        return type switch
        {
            "SubOutput" => "match-suboutput",
            "Indicator" => "match-indicator",
            "Project" => "match-project",
            _ => ""
        };
    }
}

@{
    ViewData["breadcrumbLevel"] = "suboutput";
}
@await Html.PartialAsync("_HierarchyBreadcrumb")

<!-- Hidden Anti-Forgery Token for AJAX requests -->
<form id="__AjaxAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="dashboard-title">
                <i class="fas fa-list-ul me-3"></i>
                @Localizer["SubOutputs Management"]
            </h1>
            <p class="dashboard-subtitle">
                @Localizer["View and manage all suboutput performance metrics across development outputs"]
            </p>
        </div>
        <div class="d-flex gap-2">
            @if ((User.IsInRole(UserRoles.SystemAdministrator) || User.IsInRole(UserRoles.MinistryStrategyManager)))
            {
                <button class="btn btn-success btn-lg shadow-sm" type="button" id="toggleCreateForm">
                    <i class="fas fa-plus me-2"></i>@Localizer["Create New SubOutput"]
                </button>
                @if (ViewBag.SelectedOutputCode != null)
                {
                    <a asp-action="AdjustWeights" asp-route-outputCode="@ViewBag.SelectedOutputCode"
                       class="btn btn-warning btn-lg shadow-sm">
                        <i class="fas fa-balance-scale me-2"></i>@Localizer["Adjust Weights"]
                    </a>
                }
            }
        </div>
    </div>
</div>

@if (ViewBag.OutputName != null)
{
    <!-- Output Context Banner -->
    <div class="framework-context-banner">
        <div class="context-content">
            <div class="context-icon">
                <i class="fas fa-layer-group"></i>
            </div>
            <div class="context-text">
                <span class="context-label">@Localizer["Output"]:</span>
                <span class="context-name">@ViewBag.OutputName</span>
            </div>
        </div>
    </div>
}

<!-- Search & Filter -->
<div class="chart-card mb-4">
    <div class="chart-title">
        <i class="fas fa-search me-2"></i>
        @Localizer["Search & Filter SubOutputs"]
    </div>
    <form asp-action="Index" method="get" class="row g-3 align-items-center" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" asp-route-outputCode="@ViewBag.SelectedOutputCode">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="searchString" id="subOutputSearchInput" class="form-control form-control-lg"
                       placeholder="@Localizer["Search suboutputs, indicators, and projects"]"
                       value="@ViewBag.CurrentFilter" />
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-search me-2"></i>@Localizer["Search"]
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Search Results Section -->
@if (ViewBag.HasSearchResults == true && ViewBag.SearchResults != null)
{
    var searchResults = (List<MonitoringAndEvaluationPlatform.ViewModel.FrameworkSearchResultViewModel>)ViewBag.SearchResults;
    var totalMatches = searchResults.Sum(r => r.TotalMatches);

    <div class="chart-card mb-4">
        <div class="chart-title d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-search me-2"></i>
                @Localizer["Search Results"] - <span class="badge bg-primary">@totalMatches @Localizer["matches found"]</span>
            </div>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-sm btn-outline-primary" id="expandAllBtn">
                    <i class="fas fa-expand-alt me-1"></i>@Localizer["Expand All"]
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary" id="collapseAllBtn">
                    <i class="fas fa-compress-alt me-1"></i>@Localizer["Collapse All"]
                </button>
            </div>
        </div>
        <div class="search-results-container">
            @foreach (var result in searchResults)
            {
                <div class="framework-search-result mb-3">
                    <div class="result-header" data-bs-toggle="collapse" data-bs-target="#matches-@result.Framework.Code">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fas fa-cubes me-2"></i>
                                <strong>@result.Framework.Name</strong>
                            </div>
                            <span class="badge bg-primary">@result.TotalMatches @Localizer["matches"]</span>
                        </div>
                    </div>
                    <div id="matches-@result.Framework.Code" class="collapse show">
                        @foreach (var match in result.Matches)
                        {
                            <div class="match-item">
                                <a href="@match.NavigationUrl" class="match-link">
                                    <div class="match-content">
                                        <div class="match-icon @GetMatchColorClass(match.Type)">
                                            <i class="@match.Icon"></i>
                                        </div>
                                        <div class="match-details">
                                            <div class="match-name">
                                                <span class="badge @GetMatchBadgeClass(match.Type) me-2">@Localizer[match.Type]</span>
                                                @match.Name
                                                @if (match.Code.HasValue)
                                                {
                                                    <span class="match-code">(#@match.Code)</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(match.ParentPath))
                                            {
                                                <div class="match-path">
                                                    <i class="fas fa-sitemap me-1"></i>@match.ParentPath
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <i class="fas fa-chevron-right match-arrow"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Collapsible SubOutput Creation Form -->
<div id="createSubOutcomeForm" class="chart-card mb-4" style="display:none;">
    <div class="chart-title">
        <i class="fas fa-plus"></i>
        @Localizer["Create New SubOutput"]
    </div>
    <form id="subOutputForm">
        @Html.AntiForgeryToken()
        <input type="hidden" id="outputCode" value="@ViewBag.SelectedOutputCode" />
        <div class="row">
            <div class="col-md-8">
                <div class="mb-3">
                    <label for="subOutputName" class="form-label fw-bold">
                        <i class="fas fa-tag me-2"></i>@Localizer["SubOutput Name"]
                    </label>
                    <input type="text" class="form-control form-control-lg" id="subOutputName" required
                           placeholder="@Localizer["Enter suboutput name"]" />
                </div>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="d-grid w-100">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save me-2"></i>@Localizer["Save SubOutput"]
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- SubOutputs Table -->
<div class="chart-card">
    <div class="chart-title d-flex justify-content-between align-items-center">
        <span>
            <i class="fas fa-list-ul"></i>
            @Localizer["SubOutputs"] (@Model.Count())
        </span>
        <div class="d-flex gap-2">
            <a asp-action="ExportExcel" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" asp-route-outputCode="@ViewBag.SelectedOutputCode"
               class="btn btn-sm btn-success" title="@Localizer["Export Excel"]" data-bs-toggle="tooltip">
                <i class="fas fa-file-excel"></i>
            </a>
            <a asp-action="ExportPdf" asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode" asp-route-outputCode="@ViewBag.SelectedOutputCode"
               class="btn btn-sm btn-danger" title="@Localizer["Export PDF"]" data-bs-toggle="tooltip">
                <i class="fas fa-file-pdf"></i>
            </a>
        </div>
    </div>
    
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover modern-table">
                <thead class="table-header">
                    <tr>
                        <th class="sortable-header">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewBag.NameSortParm"
                               asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
                               asp-route-outputCode="@ViewBag.SelectedOutputCode"
                               class="header-link">
                                <i class="fas fa-list-ul me-2"></i>@Localizer["SubOutput Name"]
                                @if (ViewBag.CurrentSort == "name")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "name_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1 text-white-50"></i>
                                }
                            </a>
                        </th>
                        <th class="text-center sortable-header">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewBag.WeightSortParm"
                               asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
                               asp-route-outputCode="@ViewBag.SelectedOutputCode"
                               class="header-link justify-content-center">
                                <i class="fas fa-weight me-2"></i>@Localizer["Weight"]
                                @if (ViewBag.CurrentSort == "weight")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "weight_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1 text-white-50"></i>
                                }
                            </a>
                        </th>
                        <th class="text-center sortable-header">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewBag.IndicatorsSortParm"
                               asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
                               asp-route-outputCode="@ViewBag.SelectedOutputCode"
                               class="header-link justify-content-center">
                                <i class="fas fa-chart-line me-2"></i>@Localizer["Indicators Performance"]
                                @if (ViewBag.CurrentSort == null || ViewBag.CurrentSort == "")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "indicators")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "indicators_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1 text-white-50"></i>
                                }
                            </a>
                        </th>
                        <th class="text-center sortable-header">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewBag.DisbursementSortParm"
                               asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
                               asp-route-outputCode="@ViewBag.SelectedOutputCode"
                               class="header-link justify-content-center">
                                <i class="fas fa-money-bill-wave me-2"></i>@Localizer["Disbursement Performance"]
                                @if (ViewBag.CurrentSort == "disbursement")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "disbursement_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1 text-white-50"></i>
                                }
                            </a>
                        </th>
                        <th class="text-center sortable-header">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewBag.OutputSortParm"
                               asp-route-frameworkCode="@ViewBag.SelectedFrameworkCode"
                               asp-route-outputCode="@ViewBag.SelectedOutputCode"
                               class="header-link justify-content-center">
                                <i class="fas fa-layer-group me-2"></i>@Localizer["Output"]
                                @if (ViewBag.CurrentSort == "output")
                                {
                                    <i class="fas fa-sort-up ms-1"></i>
                                }
                                else if (ViewBag.CurrentSort == "output_desc")
                                {
                                    <i class="fas fa-sort-down ms-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-sort ms-1 text-white-50"></i>
                                }
                            </a>
                        </th>
                        <th class="text-center">
                            <div class="header-link justify-content-center">
                                <i class="fas fa-cogs me-2"></i>@Localizer["Actions"]
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string indicatorsClass = ProgressBarHelper.GetProgressBarClass(item.IndicatorsPerformance);
                        string disbursementClass = ProgressBarHelper.GetProgressBarClass(item.DisbursementPerformance);
                        double IndicatorsPerformance = Math.Round(item.IndicatorsPerformance, 2);
                        double DisbursementPerformance = Math.Round(item.DisbursementPerformance, 2);
                        
                        <tr id="subOutput-row-@item.Code" class="table-row">
                            <td class="suboutput-name-cell">
                                <div class="d-flex align-items-center">
                                    <div class="suboutput-icon me-3">
                                        <i class="fas fa-list-ul"></i>
                                    </div>
                                    <div>
                                        <span id="suboutput-name-@item.Code" class="suboutput-name-view">
                                            <a asp-controller="Indicators" asp-action="Index"
                                               asp-route-frameworkCode="@item.Output.Outcome.FrameworkCode"
                                               asp-route-subOutputCode="@item.Code"
                                               class="suboutput-name-link">
                                                @item.Name
                                            </a>
                                        </span>
                                        <div id="suboutput-name-edit-container-@item.Code" class="d-none" data-framework-code="@item.Output.Outcome.FrameworkCode">
                                            <div class="d-flex align-items-center gap-2">
                                                <input type="text" id="suboutput-name-input-@item.Code"
                                                       class="form-control form-control-sm" value="@item.Name" />
                                                <button type="button" class="btn btn-success btn-sm" onclick="saveSubOutputName(@item.Code, @item.Output.Outcome.FrameworkCode)" title="@Localizer["Save"]">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cancelSubOutputEdit(@item.Code)" title="@Localizer["Cancel"]">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="weight-badge">
                                    <span class="badge bg-info fs-6">@item.Weight%</span>
                                </div>
                            </td>
                            <td class="text-center">
                                @await Html.PartialAsync("_ProgressBar", Tuple.Create(IndicatorsPerformance, indicatorsClass))
                            </td>
                            <td class="text-center">
                                @await Html.PartialAsync("_ProgressBar", Tuple.Create(DisbursementPerformance, disbursementClass))
                            </td>
                            <td class="text-center">
                                <div class="output-badge">
                                    <a asp-controller="Outputs" asp-action="Index" asp-route-outcomeCode="@item.Output.OutcomeCode"
                                       class="badge bg-secondary fs-6 text-decoration-none">
                                        @item.Output.Name
                                    </a>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group action-buttons" role="group">
                                    <button class="btn btn-outline-info btn-sm action-btn"
                                            onclick="toggleIndicators(@item.Code)" title="@Localizer["Show Indicators"]">
                                        <i class="fas fa-chevron-down" id="chevron-@item.Code"></i>
                                    </button>
                                    @if ((User.IsInRole(UserRoles.SystemAdministrator) || User.IsInRole(UserRoles.MinistryStrategyManager)))
                                    {
                                        <button class="btn btn-outline-primary btn-sm action-btn"
                                                onclick="toggleSubOutputEdit(@item.Code,@item.Output.Outcome.FrameworkCode)" title="Edit Name">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm action-btn"
                                                onclick="confirmSubOutputDelete(@item.Code)" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                        <!-- Expandable Indicators Row -->
                        <tr id="indicators-row-@item.Code" class="indicators-row" style="display: none;">
                            <td colspan="6" class="p-0">
                                <div class="indicators-container">
                                    <div class="indicators-header d-flex justify-content-between align-items-center">
                                        <span>
                                            <i class="fas fa-chart-line me-2"></i>
                                            @Localizer["Indicators"] (<span id="indicators-count-@item.Code">@item.Indicators.Count</span>)
                                        </span>
                                        @if ((User.IsInRole(UserRoles.SystemAdministrator) || User.IsInRole(UserRoles.MinistryStrategyManager)))
                                        {
                                            <button class="btn btn-success btn-sm" onclick="toggleInlineIndicatorForm(@item.Code)">
                                                <i class="fas fa-plus me-1"></i>@Localizer["Add Indicator"]
                                            </button>
                                        }
                                    </div>

                                    <!-- Inline Create Indicator Form -->
                                    @if ((User.IsInRole(UserRoles.SystemAdministrator) || User.IsInRole(UserRoles.MinistryStrategyManager)))
                                    {
                                        <div id="inline-indicator-form-@item.Code" class="inline-create-indicator-form" style="display: none;">
                                            <div class="row g-2 align-items-center">
                                                <div class="col">
                                                    <input type="text" class="form-control" id="new-indicator-name-@item.Code"
                                                           placeholder="@Localizer["Enter indicator name"]" />
                                                </div>
                                                <div class="col-auto">
                                                    <button type="button" class="btn btn-primary btn-sm" onclick="createInlineIndicator(@item.Code)">
                                                        <i class="fas fa-save me-1"></i>@Localizer["Save"]
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleInlineIndicatorForm(@item.Code)">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (item.Indicators.Any())
                                    {
                                        <table class="table table-sm indicators-table mb-0" id="indicators-table-@item.Code">
                                            <thead>
                                                <tr>
                                                    <th>@Localizer["Indicator Name"]</th>
                                                    <th class="text-center">@Localizer["Weight"]</th>
                                                    <th class="text-center">@Localizer["Indicators Performance"]</th>
                                                    <th class="text-center">@Localizer["Disbursement Performance"]</th>
                                                </tr>
                                            </thead>
                                            <tbody id="indicators-tbody-@item.Code">
                                                @foreach (var indicator in item.Indicators)
                                                {
                                                    string indicatorIndicatorsClass = ProgressBarHelper.GetProgressBarClass(indicator.IndicatorsPerformance);
                                                    string indicatorDisbursementClass = ProgressBarHelper.GetProgressBarClass(indicator.DisbursementPerformance);
                                                    <tr>
                                                        <td>
                                                            <a asp-controller="Indicators" asp-action="Details" asp-route-id="@indicator.IndicatorCode" class="indicator-name-link">
                                                                @indicator.Name
                                                            </a>
                                                        </td>
                                                        <td class="text-center">
                                                            <span class="badge bg-info">@Math.Round(indicator.Weight, 1)%</span>
                                                        </td>
                                                        <td class="text-center">
                                                            @await Html.PartialAsync("_ProgressBar", Tuple.Create(Math.Round(indicator.IndicatorsPerformance, 2), indicatorIndicatorsClass))
                                                        </td>
                                                        <td class="text-center">
                                                            @await Html.PartialAsync("_ProgressBar", Tuple.Create(Math.Round(indicator.DisbursementPerformance, 2), indicatorDisbursementClass))
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    else
                                    {
                                        <div id="no-indicators-msg-@item.Code" class="text-center py-3 text-muted">
                                            <i class="fas fa-info-circle me-2"></i>
                                            @Localizer["No indicators found for this sub-output"]
                                        </div>
                                        <table class="table table-sm indicators-table mb-0 d-none" id="indicators-table-@item.Code">
                                            <thead>
                                                <tr>
                                                    <th>@Localizer["Indicator Name"]</th>
                                                    <th class="text-center">@Localizer["Weight"]</th>
                                                    <th class="text-center">@Localizer["Indicators Performance"]</th>
                                                    <th class="text-center">@Localizer["Disbursement Performance"]</th>
                                                </tr>
                                            </thead>
                                            <tbody id="indicators-tbody-@item.Code">
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="stat-icon warning mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                <i class="fas fa-list-ul"></i>
            </div>
            <h4 class="text-muted">@Localizer["No suboutputs found"]</h4>
            <p class="text-muted">@Localizer["Create your first suboutput to get started"]</p>
        </div>
    }
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        // Toggle create form
        document.getElementById('toggleCreateForm')?.addEventListener('click', function () {
            const form = document.getElementById('createSubOutcomeForm');
            if (form) {
                const isHidden = form.style.display === 'none';
                form.style.display = isHidden ? 'block' : 'none';

                if (isHidden) {
                    form.style.opacity = '0';
                    form.style.transform = 'translateY(-20px)';
                    setTimeout(() => {
                        form.style.transition = 'all 0.4s ease';
                        form.style.opacity = '1';
                        form.style.transform = 'translateY(0)';
                        document.getElementById('subOutputName')?.focus();
                    }, 10);
                }
            }
        });

        // Handle inline suboutput creation
        $('#subOutputForm').on('submit', function (e) {
            e.preventDefault();

            const name = $('#subOutputName').val().trim();
            const outputCode = $('#outputCode').val();
            const token = $('input[name="__RequestVerificationToken"]').val();

            if (!name) {
                Swal.fire({
                    icon: 'warning',
                    title: '@Localizer["Warning"]',
                    text: '@Localizer["Please enter a suboutput name"]'
                });
                return;
            }

            $.ajax({
                url: '/SubOutputs/CreateInline',
                type: 'POST',
                data: {
                    name: name,
                    outputCode: outputCode,
                    __RequestVerificationToken: token
                },
                success: function (response) {
                    if (response.success) {
                        // Reload the page to show the new suboutput
                        location.reload();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: response.message
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["Could not create suboutput. Please try again."]'
                    });
                }
            });
        });

        function toggleSubOutputEdit(code, frameworkCode) {
            const viewSpan = $(`#suboutput-name-${code}`);
            const editContainer = $(`#suboutput-name-edit-container-${code}`);
            const input = $(`#suboutput-name-input-${code}`);

            // Enter edit mode
            editContainer.removeClass('d-none');
            viewSpan.addClass('d-none');
            input.focus().select();
        }

        function saveSubOutputName(code, frameworkCode) {
            const viewSpan = $(`#suboutput-name-${code}`);
            const editContainer = $(`#suboutput-name-edit-container-${code}`);
            const input = $(`#suboutput-name-input-${code}`);
            const newName = input.val();

            $.ajax({
                url: `/SubOutputs/UpdateName`,
                type: 'POST',
                data: { id: code, name: newName },
                success: function () {
                    viewSpan.html(`<a href="/Indicators?subOutputCode=${code}&frameworkCode=${frameworkCode}" class="suboutput-name-link">${newName}</a>`);
                    editContainer.addClass('d-none');
                    viewSpan.removeClass('d-none');
                    Swal.fire({
                        icon: 'success',
                        title: '@Localizer["Saved!"]',
                        text: '@Localizer["SubOutput name updated successfully."]',
                        timer: 2000,
                        showConfirmButton: false
                    });
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["Could not update suboutput name."]'
                    });
                }
            });
        }

        function cancelSubOutputEdit(code) {
            const viewSpan = $(`#suboutput-name-${code}`);
            const editContainer = $(`#suboutput-name-edit-container-${code}`);
            const input = $(`#suboutput-name-input-${code}`);

            // Reset input to original value
            const originalName = viewSpan.find('a').text();
            input.val(originalName);

            editContainer.addClass('d-none');
            viewSpan.removeClass('d-none');
        }

        function toggleIndicators(code) {
            const indicatorsRow = document.getElementById(`indicators-row-${code}`);
            const chevron = document.getElementById(`chevron-${code}`);

            if (indicatorsRow.style.display === 'none') {
                indicatorsRow.style.display = 'table-row';
                chevron.classList.remove('fa-chevron-down');
                chevron.classList.add('fa-chevron-up');

                // Animate the container
                const container = indicatorsRow.querySelector('.indicators-container');
                container.style.opacity = '0';
                container.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    container.style.transition = 'all 0.3s ease';
                    container.style.opacity = '1';
                    container.style.transform = 'translateY(0)';
                }, 10);
            } else {
                indicatorsRow.style.display = 'none';
                chevron.classList.remove('fa-chevron-up');
                chevron.classList.add('fa-chevron-down');
            }
        }

        function toggleInlineIndicatorForm(subOutputCode) {
            const form = document.getElementById(`inline-indicator-form-${subOutputCode}`);
            const input = document.getElementById(`new-indicator-name-${subOutputCode}`);

            if (form.style.display === 'none') {
                form.style.display = 'block';
                form.style.opacity = '0';
                form.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    form.style.transition = 'all 0.3s ease';
                    form.style.opacity = '1';
                    form.style.transform = 'translateY(0)';
                    input.focus();
                }, 10);
            } else {
                form.style.display = 'none';
                input.value = '';
            }
        }

        function createInlineIndicator(subOutputCode) {
            const input = document.getElementById(`new-indicator-name-${subOutputCode}`);
            const name = input.value.trim();
            const token = $('input[name="__RequestVerificationToken"]').val();

            if (!name) {
                Swal.fire({
                    icon: 'warning',
                    title: '@Localizer["Warning"]',
                    text: '@Localizer["Please enter an indicator name"]'
                });
                return;
            }

            $.ajax({
                url: '/Indicators/CreateInlineAjax',
                type: 'POST',
                data: {
                    name: name,
                    subOutputCode: subOutputCode,
                    __RequestVerificationToken: token
                },
                success: function (response) {
                    if (response.success) {
                        // Hide the "no indicators" message if it exists
                        const noIndicatorsMsg = document.getElementById(`no-indicators-msg-${subOutputCode}`);
                        if (noIndicatorsMsg) {
                            noIndicatorsMsg.style.display = 'none';
                        }

                        // Show the table if it was hidden
                        const table = document.getElementById(`indicators-table-${subOutputCode}`);
                        table.classList.remove('d-none');

                        // Add new row to the table
                        const tbody = document.getElementById(`indicators-tbody-${subOutputCode}`);
                        const newRow = `
                            <tr style="background-color: rgba(40, 167, 69, 0.1);">
                                <td>
                                    <a href="/Indicators/Details/${response.indicator.code}" class="indicator-name-link">
                                        ${response.indicator.name}
                                    </a>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info">${response.indicator.weight}%</span>
                                </td>
                                <td class="text-center">
                                    <div class="progress-container">
                                        <div class="progress modern-progress-bar">
                                            <div class="progress-bar bg-secondary" role="progressbar" style="width: 0%">
                                            </div>
                                        </div>
                                        <div class="progress-value-display">
                                            <span class="progress-percentage">0%</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="progress-container">
                                        <div class="progress modern-progress-bar">
                                            <div class="progress-bar bg-secondary" role="progressbar" style="width: 0%">
                                            </div>
                                        </div>
                                        <div class="progress-value-display">
                                            <span class="progress-percentage">0%</span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        `;
                        tbody.insertAdjacentHTML('beforeend', newRow);

                        // Update count
                        const countSpan = document.getElementById(`indicators-count-${subOutputCode}`);
                        countSpan.textContent = parseInt(countSpan.textContent) + 1;

                        // Clear and hide the form
                        input.value = '';
                        toggleInlineIndicatorForm(subOutputCode);

                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success"]',
                            text: '@Localizer["Indicator created successfully!"]',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: response.message
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["Could not create indicator. Please try again."]'
                    });
                }
            });
        }

        function confirmSubOutputDelete(code) {
            Swal.fire({
                title: '@Localizer["Are you sure?"]',
                text: '@Localizer["This will permanently delete the suboutput and all associated data!"]',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '@Localizer["Yes, delete it!"]',
                cancelButtonText: '@Localizer["Cancel"]',
                customClass: {
                    popup: 'swal2-modern',
                    confirmButton: 'btn btn-danger',
                    cancelButton: 'btn btn-secondary'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/SubOutputs/DeleteConfirmed/${code}`,
                        type: 'POST',
                        success: function () {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: '@Localizer["SubOutput has been deleted successfully."]',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                // Reload page to show updated performance values
                                location.reload();
                            });
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: '@Localizer["Could not delete suboutput. Please try again."]'
                            });
                        }
                    });
                }
            });
        }
        
        // Initialize page animations
        document.addEventListener('DOMContentLoaded', function() {
            // Animate table rows on load
            const tableRows = document.querySelectorAll('.table-row');
            tableRows.forEach((row, index) => {
                row.style.opacity = '0';
                row.style.transform = 'translateX(-20px)';
                setTimeout(() => {
                    row.style.transition = 'all 0.6s ease';
                    row.style.opacity = '1';
                    row.style.transform = 'translateX(0)';
                }, index * 100);
            });
            
            // Progress bar animation
            const progressBars = document.querySelectorAll('.progress-fill-modern');
            progressBars.forEach((bar, index) => {
                setTimeout(() => {
                    const width = bar.style.width;
                    bar.style.width = '0%';
                    setTimeout(() => {
                        bar.style.transition = 'width 1.5s ease-out';
                        bar.style.width = width;
                    }, 200);
                }, index * 100);
            });
        });

        // Expand All / Collapse All functionality for search results
        const expandAllBtn = document.getElementById('expandAllBtn');
        const collapseAllBtn = document.getElementById('collapseAllBtn');

        if (expandAllBtn) {
            expandAllBtn.addEventListener('click', function() {
                const collapseElements = document.querySelectorAll('.framework-search-result .collapse');
                collapseElements.forEach(element => {
                    const bsCollapse = new bootstrap.Collapse(element, { toggle: false });
                    bsCollapse.show();
                });
            });
        }

        if (collapseAllBtn) {
            collapseAllBtn.addEventListener('click', function() {
                const collapseElements = document.querySelectorAll('.framework-search-result .collapse');
                collapseElements.forEach(element => {
                    const bsCollapse = new bootstrap.Collapse(element, { toggle: false });
                    bsCollapse.hide();
                });
            });
        }
    </script>

