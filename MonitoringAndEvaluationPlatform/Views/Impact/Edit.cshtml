@model MonitoringAndEvaluationPlatform.ViewModel.ProjectOutputFormViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "Edit Development Impact Indicator";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
}

<div class="dashboard-header">
    <div class="impact-breadcrumb">
        <a href="@Url.Action("Index", "Impact")" class="breadcrumb-link">
            <i class="fas fa-arrow-trend-up"></i>
            @Localizer["Impact"]
        </a>
        <i class="fas fa-chevron-right breadcrumb-separator"></i>
        <span class="current-page">@Localizer["Edit Project Output"]</span>
    </div>

    <h1 class="dashboard-title">
        <i class="fas fa-edit me-3"></i>
        @Localizer["Edit Project Output"]
    </h1>
    <p class="dashboard-subtitle">
        @Model.Name
    </p>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h6 class="mb-0">
            <i class="fas fa-pen-to-square me-2"></i>@Localizer["Project Output Details"]
        </h6>
    </div>
    <div class="card-body">
        @* Same form as Create — it switches itself to Edit off Model.Id. *@
        <partial name="_ProjectOutputForm" model="Model" />
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/project-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/impact-indicators.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
