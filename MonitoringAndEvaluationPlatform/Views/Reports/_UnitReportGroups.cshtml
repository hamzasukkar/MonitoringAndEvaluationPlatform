@model List<MonitoringAndEvaluationPlatform.ViewModel.UnitReportGroup>
@using MonitoringAndEvaluationPlatform.ViewModel
@using Microsoft.AspNetCore.Localization

@{
    var culture = ViewContext.HttpContext.Features.Get<IRequestCultureFeature>()?.RequestCulture?.Culture?.Name ?? "ar";
    var isRtl = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);

    // The measures track carries a "last recorded" date; the impact track has no per-row date,
    // so the column is dropped rather than rendered empty.
    var showRecorded = ViewData["ShowRecorded"] as bool? ?? false;
    var prefix = ViewData["IdPrefix"] as string ?? "grp";
    var itemHeader = ViewData["ItemHeader"] as string ?? (isRtl ? "البند" : "Item");

    // Quantities are free-form (12 schools, 4.5 km), so whole numbers stay clean and
    // fractional ones keep two decimals instead of being rounded away.
    string Qty(double v) => v == Math.Floor(v) ? v.ToString("N0") : v.ToString("N2");

    string RateColor(double rate) => rate >= 100 ? "success"
                                   : rate >= 60  ? "info"
                                   : rate >= 30  ? "warning" : "danger";
}

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="fas fa-ruler-combined fa-3x mb-3 opacity-25"></i>
        <div>@(isRtl ? "لا توجد بيانات مطابقة للفلاتر المحددة" : "No data matches the selected filters")</div>
    </div>
}
else
{
    <div class="accordion unit-accordion" id="@(prefix)Accordion">
        @foreach (var group in Model)
        {
            var groupId = $"{prefix}-{(group.IsUnspecified ? "none" : group.UnitKey.ToString())}";
            var rate = group.AchievementRate;
            var color = RateColor(rate);
            <div class="accordion-item unit-group border-0 mb-2 shadow-sm" data-unit="@group.UnitName">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed py-3" type="button"
                            data-bs-toggle="collapse" data-bs-target="#body-@groupId"
                            aria-expanded="false" aria-controls="body-@groupId">
                        <div class="d-flex align-items-center gap-3 flex-wrap w-100 pe-3">
                            <span class="badge bg-@color bg-opacity-10 text-@color border border-@color fs-6 px-3 py-2">
                                <i class="fas fa-ruler-combined me-1"></i>
                                @(group.IsUnspecified ? (isRtl ? "بدون وحدة" : "Unspecified unit") : group.UnitName)
                            </span>

                            <span class="text-muted small">
                                <i class="fas fa-folder-open me-1"></i>
                                @group.ProjectCount @(isRtl ? "مشروع" : "projects")
                                <span class="mx-1">·</span>
                                @group.Rows.Count @(isRtl ? "بند" : "items")
                            </span>

                            @if (group.TotalTarget > 0)
                            {
                                <span class="text-muted small">
                                    <i class="fas fa-bullseye me-1"></i>
                                    @Qty(group.TotalAchieved) / @Qty(group.TotalTarget)
                                    @if (!group.IsUnspecified)
                                    {
                                        <span class="fw-semibold">@group.UnitName</span>
                                    }
                                </span>
                            }

                            @if (group.EarliestStart.HasValue && group.LatestEnd.HasValue)
                            {
                                <span class="text-muted small">
                                    <i class="fas fa-calendar-alt me-1"></i>
                                    @group.EarliestStart.Value.ToString("dd/MM/yyyy") — @group.LatestEnd.Value.ToString("dd/MM/yyyy")
                                </span>
                            }

                            <div class="ms-auto d-flex align-items-center gap-2" style="min-width:150px">
                                <div class="flex-grow-1 bg-light rounded" style="height:8px">
                                    <div class="bg-@color rounded" style="height:8px;width:@(Math.Min(rate, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                </div>
                                <span class="fw-bold text-@color small" style="min-width:52px;text-align:end">
                                    @(group.TotalTarget > 0 ? $"{rate}%" : "—")
                                </span>
                            </div>
                        </div>
                    </button>
                </h2>
                <div id="body-@groupId" class="accordion-collapse collapse" data-bs-parent="#@(prefix)Accordion">
                    <div class="accordion-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-sm align-middle mb-0 unit-rows">
                                <thead class="table-light">
                                    <tr>
                                        <th>@(isRtl ? "المشروع" : "Project")</th>
                                        <th>@(isRtl ? "الوزارة" : "Ministry")</th>
                                        <th>@itemHeader</th>
                                        <th class="text-end">@(isRtl ? "المستهدف" : "Target")</th>
                                        <th class="text-end">@(isRtl ? "المنجز" : "Achieved")</th>
                                        <th style="min-width:130px">@(isRtl ? "نسبة الإنجاز" : "Achievement")</th>
                                        <th class="text-center">@(isRtl ? "بداية المشروع" : "Project Start")</th>
                                        <th class="text-center">@(isRtl ? "نهاية المشروع" : "Project End")</th>
                                        @if (showRecorded)
                                        {
                                            <th class="text-center">@(isRtl ? "آخر قياس" : "Last Recorded")</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in group.Rows)
                                    {
                                        var rowColor = RateColor(row.AchievementRate);
                                        <tr class="unit-row">
                                            <td>
                                                <a asp-controller="Projects" asp-action="Details" asp-route-id="@row.ProjectId"
                                                   class="text-decoration-none fw-semibold">@row.ProjectName</a>
                                            </td>
                                            <td class="text-muted small">@row.MinistryName</td>
                                            <td>@row.ItemName</td>
                                            <td class="text-end">@(row.HasTarget ? Qty(row.Target) : "—")</td>
                                            <td class="text-end fw-semibold">@Qty(row.Achieved)</td>
                                            <td>
                                                @if (row.HasTarget)
                                                {
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="flex-grow-1 bg-light rounded" style="height:6px">
                                                            <div class="bg-@rowColor rounded" style="height:6px;width:@(Math.Min(row.AchievementRate, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                                        </div>
                                                        <span class="small fw-bold text-@rowColor" style="min-width:46px;text-align:end">@row.AchievementRate%</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">@(isRtl ? "بلا هدف" : "No target")</span>
                                                }
                                            </td>
                                            <td class="text-center small text-nowrap">@row.ProjectStart.ToString("dd/MM/yyyy")</td>
                                            <td class="text-center small text-nowrap">
                                                @row.ProjectEnd.ToString("dd/MM/yyyy")
                                                @if (row.IsOverdue)
                                                {
                                                    <i class="fas fa-exclamation-triangle text-danger ms-1"
                                                       title="@(isRtl ? "انتهى المشروع دون بلوغ الهدف" : "Project ended before reaching its target")"></i>
                                                }
                                            </td>
                                            @if (showRecorded)
                                            {
                                                <td class="text-center small text-nowrap">
                                                    @(row.LastRecorded?.ToString("dd/MM/yyyy") ?? "—")
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
