        // Color governorates based on project count
        function colorizeMap() {
            const maxProjects = Math.max(...governorateReportsData.map(g => g.ProjectCount), 1);
            document.getElementById('maxProjectsLabel').textContent = maxProjects + '+';

            document.querySelectorAll('.governorate').forEach(path => {
                const govNameEn = path.dataset.nameEn;
                const govData = governorateReportsData.find(g =>
                    g.Name.toLowerCase().includes(govNameEn.toLowerCase()) ||
                    govNameEn.toLowerCase().includes(g.Name.toLowerCase()) ||
                    (g.NameAr && path.dataset.nameAr === g.NameAr)
                );

                if (govData && govData.ProjectCount > 0) {
                    const ratio = govData.ProjectCount / maxProjects;
                    path.classList.remove('has-projects-low', 'has-projects-medium', 'has-projects-high', 'has-projects-very-high');
                    if (ratio <= 0.25) {
                        path.classList.add('has-projects-low');
                    } else if (ratio <= 0.5) {
                        path.classList.add('has-projects-medium');
                    } else if (ratio <= 0.75) {
                        path.classList.add('has-projects-high');
                    } else {
                        path.classList.add('has-projects-very-high');
                    }
                }
            });
        }

