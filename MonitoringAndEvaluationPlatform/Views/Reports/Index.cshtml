        // NEW: Category Reports Charts Data
        const catMinistryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MinistryReports.Take(8).Select(m => new { m.Name, m.ProjectCount, m.IndicatorsPerformance })));
        const catSectorData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectorReports.Take(8).Select(s => new { s.Name, s.ProjectCount, s.IndicatorsPerformance })));
        const catDonorData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DonorReports.Take(8).Select(d => new { d.Name, d.ProjectCount, d.IndicatorsPerformance })));
        const catSupervisorData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SupervisorReports.Take(8).Select(s => new { s.Name, s.ProjectCount, s.IndicatorsPerformance })));
        const catPmData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectManagerReports.Take(8).Select(pm => new { pm.Name, pm.ProjectCount, pm.IndicatorsPerformance })));
        const catGovernorateData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GovernorateReports.Take(8).Select(g => new { g.Name, g.ProjectCount, g.IndicatorsPerformance })));

        // Helper function to create category charts
        function createCategoryChart(canvasId, data, label, bgColor) {
            const ctx = document.getElementById(canvasId);
            if (!ctx || data.length === 0) return null;

            return new Chart(ctx.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: data.map(d => d.Name.length > 15 ? d.Name.substring(0, 12) + '...' : d.Name),
                    datasets: [{
                        label: label,
                        data: data.map(d => d.ProjectCount),
                        backgroundColor: bgColor,
                        borderColor: bgColor.replace('0.7', '1'),
                        borderWidth: 2,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 0 },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                title: function(ctx) {
                                    const idx = ctx[0].dataIndex;
                                    return data[idx].Name;
                                },
                                afterLabel: function(ctx) {
                                    const idx = ctx.dataIndex;
                                    return '@Localizer["Performance"]: ' + data[idx].IndicatorsPerformance + '%';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: '@Localizer["Projects"]'
                            }
                        },
                        x: {
                            ticks: {
                                maxRotation: 45,
                                minRotation: 45
                            }
                        }
                    }
                }
            });
        }

        // Create category charts
        const ministryProjectsChart = createCategoryChart('ministryProjectsChart', catMinistryData, '@Localizer["Projects by Ministry"]', 'rgba(33, 150, 243, 0.7)');
        const sectorProjectsChart = createCategoryChart('sectorProjectsChart', catSectorData, '@Localizer["Projects by Sector"]', 'rgba(76, 175, 80, 0.7)');
        const donorProjectsChart = createCategoryChart('donorProjectsChart', catDonorData, '@Localizer["Projects by Donor"]', 'rgba(255, 193, 7, 0.7)');
        const supervisorProjectsChart = createCategoryChart('supervisorProjectsChart', catSupervisorData, '@Localizer["Projects by Supervisor"]', 'rgba(0, 188, 212, 0.7)');
        const pmProjectsChart = createCategoryChart('pmProjectsChart', catPmData, '@Localizer["Projects by Manager"]', 'rgba(156, 39, 176, 0.7)');
        const governorateProjectsChart = createCategoryChart('governorateProjectsChart', catGovernorateData, '@Localizer["Projects by Governorate"]', 'rgba(244, 67, 54, 0.7)');

        // Tab switching for Category Reports
        document.querySelectorAll('.chart-card .btn-group .btn-outline-info').forEach(btn => {
            btn.addEventListener('click', function() {
