                        <input class="form-check-input print-section-check" type="checkbox" id="printCategories" value="print-section-categories" checked>
                        <label class="form-check-label" for="printCategories">
                            <i class="fas fa-layer-group me-2 text-info"></i>
                            @Localizer["Reports by Category"]
                            <small class="text-muted d-block">@Localizer["Ministry, Sector, Donor, Supervisor, Project Manager, Governorate reports"]</small>
                        </label>
                    </div>

                    <!-- Top Performers -->
                    <div class="form-check print-option-item">
                        <input class="form-check-input print-section-check" type="checkbox" id="printTopPerformers" value="print-section-top" checked>
                        <label class="form-check-label" for="printTopPerformers">
                            <i class="fas fa-trophy me-2 text-warning"></i>
                            @Localizer["Top Performers"]
                            <small class="text-muted d-block">@Localizer["Best performing Frameworks, Outcomes, Outputs, SubOutputs, Indicators"]</small>
                        </label>
                    </div>

                    <!-- Bottom Performers -->
                    <div class="form-check print-option-item">
                        <input class="form-check-input print-section-check" type="checkbox" id="printBottomPerformers" value="print-section-bottom" checked>
                        <label class="form-check-label" for="printBottomPerformers">
                            <i class="fas fa-exclamation-triangle me-2 text-danger"></i>
                            @Localizer["Needs Improvement"]
                            <small class="text-muted d-block">@Localizer["Lowest performing Frameworks, Outcomes, Outputs, SubOutputs, Indicators"]</small>
                        </label>
                    </div>
                </div>

                <hr class="my-3">

                <!-- Quick Select Buttons -->
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllPrintSections()">
                        <i class="fas fa-check-double me-1"></i>@Localizer["Select All"]
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="deselectAllPrintSections()">
                        <i class="fas fa-times me-1"></i>@Localizer["Deselect All"]
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>@Localizer["Cancel"]
                </button>
                <button type="button" class="btn btn-primary" onclick="executePrint()">
                    <i class="fas fa-print me-1"></i>@Localizer["Print"]
                </button>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetPerformanceClass(double value)
    {
        if (value >= 75) return "high";
        if (value >= 50) return "medium";
        return "low";
    }

    string GetHeatmapColor(double value)
    {
        // Color gradient from red (0) to yellow (50) to green (100)
        if (value >= 75)
        {
            return $"rgba(76, 175, 80, {0.6 + (value - 75) * 0.016})";
        }
        else if (value >= 50)
        {
            return $"rgba(255, 193, 7, {0.6 + (value - 50) * 0.016})";
        }
        else if (value >= 25)
        {
            return $"rgba(255, 152, 0, {0.5 + (value - 25) * 0.02})";
        }
        else
        {
            return $"rgba(244, 67, 54, {0.5 + value * 0.02})";
        }
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        // Store chart instances for later use
        let frameworkChart, distributionChart;

        // Framework Performance Chart
        const frameworkCtx = document.getElementById('frameworkPerformanceChart').getContext('2d');
        const frameworkLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FrameworkPerformanceData.Select(f => f.Name)));
        const indicatorsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FrameworkPerformanceData.Select(f => f.IndicatorsPerformance)));
        const disbursementData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FrameworkPerformanceData.Select(f => f.DisbursementPerformance)));

        frameworkChart = new Chart(frameworkCtx, {
            type: 'bar',
            data: {
                labels: frameworkLabels,
                datasets: [
                    {
                        label: '@Localizer["Indicators Performance"]',
                        data: indicatorsData,
                        backgroundColor: 'rgba(33, 150, 243, 0.8)',
                        borderColor: 'rgba(33, 150, 243, 1)',
                        borderWidth: 1
                    },
                    {
                        label: '@Localizer["Disbursement Performance"]',
                        data: disbursementData,
                        backgroundColor: 'rgba(76, 175, 80, 0.8)',
                        borderColor: 'rgba(76, 175, 80, 1)',
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 0 },
                plugins: {
                    legend: {
                        position: 'top',
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            callback: function(value) {
                                return value + '%';
                            }
                        }
                    }
                }
            }
        });

        // Performance Distribution Chart
        const distributionCtx = document.getElementById('performanceDistributionChart').getContext('2d');
        distributionChart = new Chart(distributionCtx, {
            type: 'doughnut',
            data: {
                labels: ['@Localizer["High"] (>=75%)', '@Localizer["Medium"] (50-74%)', '@Localizer["Low"] (<50%)'],
                datasets: [{
                    data: [@Model.HighPerformanceCount, @Model.MediumPerformanceCount, @Model.LowPerformanceCount],
                    backgroundColor: [
                        'rgba(76, 175, 80, 0.8)',
                        'rgba(255, 193, 7, 0.8)',
                        'rgba(244, 67, 54, 0.8)'
                    ],
                    borderColor: [
                        'rgba(76, 175, 80, 1)',
                        'rgba(255, 193, 7, 1)',
                        'rgba(244, 67, 54, 1)'
                    ],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 0 },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });

        // NEW: Radar Chart - Multi-dimensional Framework Comparison
        const radarCtx = document.getElementById('radarChart').getContext('2d');
        const radarChart = new Chart(radarCtx, {
            type: 'radar',
            data: {
                labels: frameworkLabels.slice(0, 6),
                datasets: [
                    {
                        label: '@Localizer["Indicators Performance"]',
                        data: indicatorsData.slice(0, 6),
                        backgroundColor: 'rgba(33, 150, 243, 0.2)',
                        borderColor: 'rgba(33, 150, 243, 1)',
                        borderWidth: 2,
                        pointBackgroundColor: 'rgba(33, 150, 243, 1)',
                        pointBorderColor: '#fff',
                        pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: 'rgba(33, 150, 243, 1)'
                    },
                    {
                        label: '@Localizer["Disbursement Performance"]',
                        data: disbursementData.slice(0, 6),
                        backgroundColor: 'rgba(76, 175, 80, 0.2)',
                        borderColor: 'rgba(76, 175, 80, 1)',
                        borderWidth: 2,
                        pointBackgroundColor: 'rgba(76, 175, 80, 1)',
                        pointBorderColor: '#fff',
                        pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: 'rgba(76, 175, 80, 1)'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 0 },
                plugins: {
                    legend: {
                        position: 'top',
                    }
                },
                scales: {
                    r: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            stepSize: 25,
                            callback: function(value) {
                                return value + '%';
                            }
                        }
                    }
                }
            }
        });

        // NEW: Polar Area Chart - Performance Distribution Alternative View
        const polarCtx = document.getElementById('polarChart').getContext('2d');
        const polarChart = new Chart(polarCtx, {
            type: 'polarArea',
            data: {
                labels: ['@Localizer["High Performers"]', '@Localizer["Medium Performers"]', '@Localizer["Low Performers"]', '@Localizer["Projects"]'],
                datasets: [{
                    data: [@Model.HighPerformanceCount, @Model.MediumPerformanceCount, @Model.LowPerformanceCount, Math.min(@Model.TotalProjects, 10)],
                    backgroundColor: [
                        'rgba(76, 175, 80, 0.7)',
                        'rgba(255, 193, 7, 0.7)',
                        'rgba(244, 67, 54, 0.7)',
                        'rgba(0, 188, 212, 0.7)'
                    ],
                    borderColor: [
                        'rgba(76, 175, 80, 1)',
                        'rgba(255, 193, 7, 1)',
                        'rgba(244, 67, 54, 1)',
                        'rgba(0, 188, 212, 1)'
                    ],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 0 },
                plugins: {
                    legend: {
                        position: 'right',
                    }
                },
                scales: {
                    r: {
                        beginAtZero: true
                    }
                }
            }
        });

        // NEW: Sector Performance Chart
        const sectorCtx = document.getElementById('sectorChart').getContext('2d');
        const sectorLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectorPerformanceData.Select(s => s.Name)));
        const sectorData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectorPerformanceData.Select(s => s.IndicatorsPerformance)));
        const sectorChart = new Chart(sectorCtx, {
            type: 'doughnut',
            data: {
                labels: sectorLabels,
                datasets: [{
                    data: sectorData,
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.7)', 'rgba(54, 162, 235, 0.7)', 'rgba(255, 206, 86, 0.7)',
                        'rgba(75, 192, 192, 0.7)', 'rgba(153, 102, 255, 0.7)', 'rgba(255, 159, 64, 0.7)',
                        'rgba(199, 199, 199, 0.7)', 'rgba(83, 102, 255, 0.7)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' },
                    title: { display: false }
                }
            }
        });

        // NEW: Ministry Performance Chart
        const ministryCtx = document.getElementById('ministryChart').getContext('2d');
        const ministryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MinistryPerformanceData.Select(m => m.Name)));
        const ministryIndData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MinistryPerformanceData.Select(m => m.IndicatorsPerformance)));
        const ministryDisbData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MinistryPerformanceData.Select(m => m.DisbursementPerformance)));

        const ministryChart = new Chart(ministryCtx, {
            type: 'bar',
            data: {
                labels: ministryLabels,
                datasets: [
                    {
                        label: '@Localizer["Indicators Performance"]',
                        data: ministryIndData,
                        backgroundColor: 'rgba(54, 162, 235, 0.7)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    },
                    {
                        label: '@Localizer["Disbursement Performance"]',
                        data: ministryDisbData,
                        backgroundColor: 'rgba(75, 192, 192, 0.7)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                scales: {
                    x: { beginAtZero: true, max: 100 }
                }
            }
        });

        // NEW: Financial vs Physical Progress Scatter Chart
        const scatterCtx = document.getElementById('scatterChart').getContext('2d');
        const scatterRawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectScatterData));
        const scatterData = scatterRawData.map(item => ({
            x: item.FinancialProgress,
            y: item.PhysicalProgress,
            r: Math.max(5, Math.min(30, Math.sqrt(item.Budget) / 100)), // Scale bubble size
            project: item.ProjectName,
            budget: item.Budget
        }));

        const scatterChart = new Chart(scatterCtx, {
            type: 'bubble',
            data: {
                datasets: [{
                    label: '@Localizer["Projects"]',
                    data: scatterData,
                    backgroundColor: 'rgba(255, 99, 132, 0.6)',
                    borderColor: 'rgba(255, 99, 132, 1)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        title: { display: true, text: '@Localizer["Financial Progress (%)"]' },
                        min: 0, max: 100
                    },
                    y: {
                        title: { display: true, text: '@Localizer["Physical Progress (%)"]' },
                        min: 0, max: 100
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const pt = context.raw;
                                return pt.project + ': (Fin: ' + pt.x + '%, Phy: ' + pt.y + '%, Budget: $' + pt.budget.toLocaleString() + ')';
                            }
                        }
                    }
                }
            }
        });

        // NEW: Hierarchy Horizontal Bar Chart
        const hierarchyCtx = document.getElementById('hierarchyChart').getContext('2d');
        const hierarchyChart = new Chart(hierarchyCtx, {
            type: 'bar',
            data: {
                labels: ['@Localizer["Frameworks"]', '@Localizer["Outcomes"]', '@Localizer["Outputs"]', '@Localizer["SubOutputs"]', '@Localizer["Indicators"]', '@Localizer["Projects"]'],
                datasets: [{
                    label: '@Localizer["Count"]',
                    data: [@Model.TotalFrameworks, @Model.TotalOutcomes, @Model.TotalOutputs, @Model.TotalSubOutputs, @Model.TotalIndicators, @Model.TotalProjects],
                    backgroundColor: [
                        'rgba(33, 150, 243, 0.8)',
                        'rgba(76, 175, 80, 0.8)',
                        'rgba(255, 152, 0, 0.8)',
                        'rgba(156, 39, 176, 0.8)',
                        'rgba(233, 30, 99, 0.8)',
                        'rgba(0, 188, 212, 0.8)'
                    ],
                    borderColor: [
                        'rgba(33, 150, 243, 1)',
                        'rgba(76, 175, 80, 1)',
                        'rgba(255, 152, 0, 1)',
                        'rgba(156, 39, 176, 1)',
                        'rgba(233, 30, 99, 1)',
                        'rgba(0, 188, 212, 1)'
                    ],
                    borderWidth: 2,
                    borderRadius: 8
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 0 },
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        grid: {
                            display: true,
                            color: 'rgba(0, 0, 0, 0.05)'
                        }
                    },
                    y: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });

        // NEW: Dual Performance Comparison (Mixed Chart - Line + Bar)
        const dualCtx = document.getElementById('dualComparisonChart').getContext('2d');
        const dualComparisonChart = new Chart(dualCtx, {
            type: 'bar',
            data: {
                labels: frameworkLabels,
                datasets: [
                    {
                        type: 'bar',
                        label: '@Localizer["Indicators Performance"]',
                        data: indicatorsData,
                        backgroundColor: 'rgba(33, 150, 243, 0.7)',
                        borderColor: 'rgba(33, 150, 243, 1)',
                        borderWidth: 2,
                        borderRadius: 4,
                        order: 2
                    },
                    {
                        type: 'line',
                        label: '@Localizer["Disbursement Performance"]',
                        data: disbursementData,
                        borderColor: 'rgba(255, 87, 34, 1)',
                        backgroundColor: 'rgba(255, 87, 34, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 6,
                        pointBackgroundColor: 'rgba(255, 87, 34, 1)',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        order: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 0 },
                plugins: {
                    legend: {
                        position: 'top',
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            callback: function(value) {
                                return value + '%';
                            }
                        }
                    }
                }
            }
        });

        // NEW: Gap Analysis Chart (Difference between Indicators and Disbursement)
        const gapCtx = document.getElementById('gapAnalysisChart').getContext('2d');
        const gapData = indicatorsData.map((val, idx) => val - disbursementData[idx]);
        const gapColors = gapData.map(val => val >= 0 ? 'rgba(76, 175, 80, 0.7)' : 'rgba(244, 67, 54, 0.7)');
        const gapBorders = gapData.map(val => val >= 0 ? 'rgba(76, 175, 80, 1)' : 'rgba(244, 67, 54, 1)');

        const gapAnalysisChart = new Chart(gapCtx, {
            type: 'bar',
            data: {
                labels: frameworkLabels.slice(0, 6),
                datasets: [{
                    label: '@Localizer["Performance Gap"] (@Localizer["Indicators"] - @Localizer["Disbursement"])',
                    data: gapData.slice(0, 6),
                    backgroundColor: gapColors.slice(0, 6),
                    borderColor: gapBorders.slice(0, 6),
                    borderWidth: 2,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 0 },
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const value = context.raw;
                                const sign = value >= 0 ? '+' : '';
                                return `@Localizer["Gap"]: ${sign}${value.toFixed(1)}%`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: false,
                        ticks: {
                            callback: function(value) {
                                const sign = value >= 0 ? '+' : '';
                                return sign + value + '%';
                            }
                        },
                        grid: {
                            color: function(context) {
                                if (context.tick.value === 0) {
                                    return 'rgba(0, 0, 0, 0.3)';
                                }
                                return 'rgba(0, 0, 0, 0.05)';
                            },
                            lineWidth: function(context) {
                                if (context.tick.value === 0) {
                                    return 2;
                                }
                                return 1;
                            }
                        }
                    }
                }
            }
        });

        // Syria Map Interactions
        const governorateReportsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GovernorateReports));
        const isRtlLang = @(isRtl ? "true" : "false");

        // Governorate mapping - maps path IDs to governorate info
        // Corrected mapping based on actual SVG structure
        const governorateMapping = {
            'path1': { nameEn: 'Rif Dimashq', nameAr: 'ريف دمشق', code: 'SY03' },
            'path2': { nameEn: 'Aleppo', nameAr: 'حلب', code: 'SY12' },
            'path3': { nameEn: 'Damascus', nameAr: 'دمشق', code: 'SY01' },
            'path4': { nameEn: 'Homs', nameAr: 'حمص', code: 'SY04' },
            'path5': { nameEn: 'Hama', nameAr: 'حماة', code: 'SY07' },
            'path6': { nameEn: 'Tartus', nameAr: 'طرطوس', code: 'SY14' },
            'path7': { nameEn: 'Idlib', nameAr: 'إدلب', code: 'SY08' },
            'path8': { nameEn: 'Al-Hasakah', nameAr: 'الحسكة', code: 'SY13' },
            'path9': { nameEn: 'Deir ez-Zor', nameAr: 'دير الزور', code: 'SY09' },
            'path10': { nameEn: 'Latakia', nameAr: 'اللاذقية', code: 'SY06' },
            'path11': { nameEn: 'Ar-Raqqah', nameAr: 'الرقة', code: 'SY11' },
            'path12': { nameEn: 'Daraa', nameAr: 'درعا', code: 'SY05' },
            'path13': { nameEn: 'As-Suwayda', nameAr: 'السويداء', code: 'SY10' },
            'path14': { nameEn: 'Quneitra', nameAr: 'القنيطرة', code: 'SY02' }
        };

        // Load external SVG map
        fetch('/images/syria-map.svg')
            .then(response => response.text())
            .then(svgContent => {
                const container = document.getElementById('syriaMapContainer');
                container.innerHTML = svgContent;

                // Get the SVG element
                const svg = container.querySelector('svg');
                if (svg) {
                    svg.classList.add('syria-map');
                    svg.setAttribute('id', 'syriaMap');

                    // Apply governorate class and data attributes to each path
                    Object.keys(governorateMapping).forEach(pathId => {
                        const path = svg.querySelector('#' + pathId);
                        if (path) {
                            const govInfo = governorateMapping[pathId];
                            path.classList.add('governorate');
                            path.dataset.nameEn = govInfo.nameEn;
                            path.dataset.nameAr = govInfo.nameAr;
                            path.dataset.code = govInfo.code;
                        }
                    });

                    // Initialize map after SVG is loaded
                    initializeMap();
                }
            })
            .catch(error => {
                console.error('Error loading map:', error);
                document.getElementById('syriaMapContainer').innerHTML = '<p class="text-danger text-center">@Localizer["Error loading map"]</p>';
            });

        function initializeMap() {
            // Color governorates based on project count
            colorizeMap();

            // Map tooltip
            const mapTooltip = document.getElementById('mapTooltip');

            document.querySelectorAll('.governorate').forEach(path => {
                // Mouse enter - show tooltip
                path.addEventListener('mouseenter', function(e) {
                    const govNameEn = this.dataset.nameEn;
                    const govNameAr = this.dataset.nameAr;
                    const govName = isRtlLang ? govNameAr : govNameEn;

                    const govData = governorateReportsData.find(g =>
                        g.Name.toLowerCase().includes(govNameEn.toLowerCase()) ||
                        govNameEn.toLowerCase().includes(g.Name.toLowerCase()) ||
                        (g.NameAr && govNameAr === g.NameAr)
                    );

                    let tooltipContent = `<div class="tooltip-title">${govName}</div>`;
                    if (govData) {
                        tooltipContent += `<div class="tooltip-stats">
                            <div>@Localizer["Projects"]: <strong>${govData.ProjectCount}</strong></div>
                            <div>@Localizer["Budget"]: <strong>$${govData.TotalBudget.toLocaleString()}</strong></div>
                            <div>@Localizer["Performance"]: <strong>${govData.IndicatorsPerformance}%</strong></div>
                        </div>`;
                    } else {
                        tooltipContent += `<div class="tooltip-stats">@Localizer["No projects in this governorate"]</div>`;
                    }

                    mapTooltip.innerHTML = tooltipContent;
                    mapTooltip.classList.add('visible');
                });

                // Mouse move - position tooltip
                path.addEventListener('mousemove', function(e) {
                    const container = document.querySelector('.syria-map-container');
                    const rect = container.getBoundingClientRect();
                    const x = e.clientX - rect.left + 15;
                    const y = e.clientY - rect.top + 15;
                    mapTooltip.style.left = x + 'px';
                    mapTooltip.style.top = y + 'px';
                });

                // Mouse leave - hide tooltip
                path.addEventListener('mouseleave', function() {
                    mapTooltip.classList.remove('visible');
                });

                // Click - show details
                path.addEventListener('click', function() {
                    const govNameEn = this.dataset.nameEn;
                    const govNameAr = this.dataset.nameAr;
                    const govName = isRtlLang ? govNameAr : govNameEn;
                    const govCode = this.dataset.code;

                    // Update active state
                    document.querySelectorAll('.governorate').forEach(p => p.classList.remove('active'));
                    this.classList.add('active');

                    // Find governorate data
                    const govData = governorateReportsData.find(g =>
                        g.Name.toLowerCase().includes(govNameEn.toLowerCase()) ||
                        govNameEn.toLowerCase().includes(g.Name.toLowerCase()) ||
                        (g.NameAr && govNameAr === g.NameAr)
                    );

                    // Update title
                    document.getElementById('selectedGovTitle').textContent = govName;

                    // Show/hide elements
                    document.getElementById('governorateDetails').style.display = 'none';
                    document.getElementById('governorateStats').style.display = 'block';
                    document.getElementById('resetMapBtn').style.display = 'inline-block';

                    if (govData) {
                        document.getElementById('govProjectCount').textContent = govData.ProjectCount;
                        document.getElementById('govBudget').textContent = '$' + govData.TotalBudget.toLocaleString();
                        document.getElementById('govPerformance').textContent = govData.IndicatorsPerformance + '%';
                        document.getElementById('govDisbursement').textContent = govData.DisbursementPerformance + '%';

                        // Update performance color
                        const perfValue = document.getElementById('govPerformance');
                        perfValue.className = 'gov-stat-value';
                        if (govData.IndicatorsPerformance >= 75) {
                            perfValue.style.color = '#4CAF50';
