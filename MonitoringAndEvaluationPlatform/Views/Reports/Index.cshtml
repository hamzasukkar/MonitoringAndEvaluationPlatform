        // Print Report Function - Opens the options modal
        function printReport() {
            const modal = new bootstrap.Modal(document.getElementById('printOptionsModal'));
            modal.show();
        }

        // Select All Print Sections
        function selectAllPrintSections() {
            document.querySelectorAll('.print-section-check').forEach(cb => {
                cb.checked = true;
            });
        }

        // Deselect All Print Sections
        function deselectAllPrintSections() {
            document.querySelectorAll('.print-section-check').forEach(cb => {
                cb.checked = false;
            });
        }

        // Execute Print with Selected Sections
        function executePrint() {
            // Close the modal
            const modalEl = document.getElementById('printOptionsModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            modal.hide();

            // Get selected sections
            const selectedSections = [];
            document.querySelectorAll('.print-section-check:checked').forEach(cb => {
                selectedSections.push(cb.value);
            });

            // If nothing selected, alert and return
            if (selectedSections.length === 0) {
                alert('@Localizer["Please select at least one section to print"]');
                return;
            }

            // Hide unselected sections
            document.querySelectorAll('.print-section').forEach(section => {
                if (!selectedSections.includes(section.id)) {
                    section.classList.add('print-hidden');
                } else {
                    section.classList.remove('print-hidden');
                }
            });

            // Convert charts to images before printing (only if charts section is selected)
            const chartContainers = document.querySelectorAll('#print-section-charts .chart-container, #print-section-performance .chart-container');
            const originalCanvases = [];

            chartContainers.forEach((container, index) => {
                const canvas = container.querySelector('canvas');
                if (canvas) {
                    const imgData = canvas.toDataURL('image/png');
                    const img = document.createElement('img');
                    img.src = imgData;
                    img.className = 'chart-print-image';
                    img.style.width = '100%';
                    img.style.maxHeight = '300px';
                    img.style.objectFit = 'contain';

                    originalCanvases.push({ container, canvas, img });
                    canvas.style.display = 'none';
                    container.appendChild(img);
                }
            });

            // Show all performers tables for printing (in selected sections only)
            document.querySelectorAll('.print-section:not(.print-hidden) .performers-table').forEach(t => {
                t.dataset.originalDisplay = t.style.display;
                t.style.display = 'block';
            });

            // Small delay to ensure modal is closed and DOM is updated
            setTimeout(() => {
                // Trigger print
                window.print();

                // Restore original state after print
                setTimeout(() => {
                    // Restore charts
                    originalCanvases.forEach(({ container, canvas, img }) => {
                        canvas.style.display = 'block';
                        if (img.parentNode === container) {
                            container.removeChild(img);
                        }
                    });

                    // Restore table visibility
                    document.querySelectorAll('.performers-table').forEach(t => {
                        if (t.dataset.originalDisplay !== undefined) {
                            t.style.display = t.dataset.originalDisplay;
                        }
                    });

                    // Remove print-hidden class from all sections
                    document.querySelectorAll('.print-section').forEach(section => {
                        section.classList.remove('print-hidden');
                    });
                }, 1000);
            }, 300);
        }

        // Export to Excel Function
        function exportToExcel() {
            const wb = XLSX.utils.book_new();

            // Summary Data
            const summaryData = [
                ['@Localizer["Reports Dashboard"] - @Localizer["Summary"]'],
                ['@Localizer["Generated on"]', '@DateTime.Now.ToString("dd/MM/yyyy HH:mm")'],
                [],
                ['@Localizer["Metric"]', '@Localizer["Value"]'],
                ['@Localizer["Frameworks"]', @Model.TotalFrameworks],
                ['@Localizer["Outcomes"]', @Model.TotalOutcomes],
                ['@Localizer["Outputs"]', @Model.TotalOutputs],
                ['@Localizer["SubOutputs"]', @Model.TotalSubOutputs],
                ['@Localizer["Indicators"]', @Model.TotalIndicators],
                ['@Localizer["Projects"]', @Model.TotalProjects],
                [],
                ['@Localizer["Average Indicators Performance"]', '@Model.AverageIndicatorsPerformance%'],
                ['@Localizer["Average Disbursement Performance"]', '@Model.AverageDisbursementPerformance%'],
                [],
                ['@Localizer["Performance Distribution"]'],
                ['@Localizer["High"] (>=75%)', @Model.HighPerformanceCount],
                ['@Localizer["Medium"] (50-74%)', @Model.MediumPerformanceCount],
                ['@Localizer["Low"] (<50%)', @Model.LowPerformanceCount]
            ];
            const summaryWs = XLSX.utils.aoa_to_sheet(summaryData);
            XLSX.utils.book_append_sheet(wb, summaryWs, '@Localizer["Summary"]');

            // Export all tables
            const tables = document.querySelectorAll('.performers-table .table');
            const tableNames = ['Top Frameworks', 'Top Outcomes', 'Top Outputs', 'Top SubOutputs', 'Top Indicators',
                               'Bottom Frameworks', 'Bottom Outcomes', 'Bottom Outputs', 'Bottom SubOutputs', 'Bottom Indicators'];

            tables.forEach((table, index) => {
                if (table && tableNames[index]) {
                    const ws = XLSX.utils.table_to_sheet(table);
                    XLSX.utils.book_append_sheet(wb, ws, tableNames[index].substring(0, 31));
                }
            });

            // Save file
            const fileName = 'Reports_Dashboard_' + new Date().toISOString().slice(0, 10) + '.xlsx';
            XLSX.writeFile(wb, fileName);
        }
    </script>

