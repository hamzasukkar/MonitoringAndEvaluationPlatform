@model MonitoringAndEvaluationPlatform.ViewModel.ReportsDashboardViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Microsoft.AspNetCore.Mvc.ModelBinding.Metadata

@{
    ViewData["Title"] = "Reports Dashboard";
    Layout = "~/Views/Shared/_DashboardHomeLayout.cshtml";
    var requestCultureFeature = ViewContext.HttpContext.Features.Get<IRequestCultureFeature>();
    var culture = requestCultureFeature?.RequestCulture?.Culture?.Name ?? "en";
    var isRtl = (culture ?? "en").StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    var currentDate = DateTime.Now;
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="dashboard-title">
                <i class="fas fa-chart-bar me-3"></i>
                @Localizer["Reports Dashboard"]
            </h1>
            <p class="dashboard-subtitle">
                @Localizer["Comprehensive overview of performance metrics and statistics across all hierarchy levels"]
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap report-actions">
            <button class="btn btn-outline-success" onclick="exportToExcel()">
                <i class="fas fa-file-excel me-2"></i>@Localizer["Export Excel"]
            </button>
            <button class="btn btn-outline-primary" onclick="printReport()">
                <i class="fas fa-print me-2"></i>@Localizer["Print Report"]
            </button>
        </div>
    </div>
    <!-- Report Generation Info (visible in print) -->
    <div class="report-meta print-only">
        <div class="report-meta-item">
            <i class="fas fa-calendar-alt me-2"></i>
            <span>@Localizer["Generated on"]: @currentDate.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="report-meta-item">
            <i class="fas fa-clock me-2"></i>
            <span>@Localizer["Time"]: @currentDate.ToString("HH:mm")</span>
        </div>
    </div>
</div>

<!-- Summary Cards Row -->
<div id="print-section-summary" class="row g-4 mb-4 print-section">
    <div class="col-lg-2 col-md-4 col-sm-6">
        <div class="summary-card frameworks">
            <div class="summary-icon">
                <i class="fas fa-sitemap"></i>
            </div>
            <div class="summary-content">
                <div class="summary-value">@Model.TotalFrameworks</div>
                <div class="summary-label">@Localizer["Frameworks"]</div>
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-sm-6">
        <div class="summary-card outcomes">
            <div class="summary-icon">
                <i class="fas fa-bullseye"></i>
            </div>
            <div class="summary-content">
                <div class="summary-value">@Model.TotalOutcomes</div>
                <div class="summary-label">@Localizer["Outcomes"]</div>
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-sm-6">
        <div class="summary-card outputs">
            <div class="summary-icon">
                <i class="fas fa-cube"></i>
            </div>
            <div class="summary-content">
                <div class="summary-value">@Model.TotalOutputs</div>
                <div class="summary-label">@Localizer["Outputs"]</div>
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-sm-6">
        <div class="summary-card suboutputs">
            <div class="summary-icon">
                <i class="fas fa-cubes"></i>
            </div>
            <div class="summary-content">
                <div class="summary-value">@Model.TotalSubOutputs</div>
                <div class="summary-label">@Localizer["SubOutputs"]</div>
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-sm-6">
        <div class="summary-card indicators">
            <div class="summary-icon">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="summary-content">
                <div class="summary-value">@Model.TotalIndicators</div>
                <div class="summary-label">@Localizer["Indicators"]</div>
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-sm-6">
        <div class="summary-card projects">
            <div class="summary-icon">
                <i class="fas fa-project-diagram"></i>
            </div>
            <div class="summary-content">
                <div class="summary-value">@Model.TotalProjects</div>
                <div class="summary-label">@Localizer["Projects"]</div>
            </div>
        </div>
    </div>
</div>

<!-- Syria Map Section -->
<div id="print-section-map" class="row g-4 mb-4 print-section">
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="chart-title d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-map-marked-alt me-2"></i>
                    @Localizer["Projects by Governorate"]
                </div>
                <button class="btn btn-sm btn-outline-secondary no-print" id="resetMapBtn" style="display: none;">
                    <i class="fas fa-undo me-1"></i>@Localizer["Show All"]
                </button>
            </div>
            <div class="syria-map-container">
                <div id="syriaMapContainer" class="syria-map-wrapper">
                    <!-- SVG will be loaded here -->
                    <div class="map-loading">
                        <i class="fas fa-spinner fa-spin fa-2x"></i>
                        <p>@Localizer["Loading map..."]</p>
                    </div>
                </div>

                <!-- Map Tooltip -->
                <div id="mapTooltip" class="map-tooltip"></div>
            </div>

            <!-- Map Legend -->
            <div class="map-legend mt-3">
                <div class="legend-title">@Localizer["Project Density"]</div>
                <div class="legend-scale">
                    <span class="legend-label">0</span>
                    <div class="legend-gradient-bar"></div>
                    <span class="legend-label" id="maxProjectsLabel">10+</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card h-100">
            <div class="chart-title">
                <i class="fas fa-info-circle me-2"></i>
                <span id="selectedGovTitle">@Localizer["Governorate Details"]</span>
            </div>
            <div id="governorateDetails" class="governorate-details">
                <div class="gov-placeholder">
                    <i class="fas fa-mouse-pointer fa-3x text-muted mb-3"></i>
                    <p class="text-muted">@Localizer["Click on a governorate to view details"]</p>
                </div>
            </div>
            <div id="governorateStats" class="governorate-stats" style="display: none;">
                <div class="gov-stat-item">
                    <div class="gov-stat-icon bg-primary">
                        <i class="fas fa-project-diagram"></i>
                    </div>
                    <div class="gov-stat-content">
                        <span class="gov-stat-value" id="govProjectCount">0</span>
                        <span class="gov-stat-label">@Localizer["Projects"]</span>
                    </div>
                </div>
                <div class="gov-stat-item">
                    <div class="gov-stat-icon bg-success">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                    <div class="gov-stat-content">
                        <span class="gov-stat-value" id="govBudget">$0</span>
                        <span class="gov-stat-label">@Localizer["Total Budget"]</span>
                    </div>
                </div>
                <div class="gov-stat-item">
                    <div class="gov-stat-icon bg-info">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="gov-stat-content">
                        <span class="gov-stat-value" id="govPerformance">0%</span>
                        <span class="gov-stat-label">@Localizer["Avg Performance"]</span>
                    </div>
                </div>
                <div class="gov-stat-item">
                    <div class="gov-stat-icon bg-warning">
                        <i class="fas fa-money-bill-wave"></i>
                    </div>
                    <div class="gov-stat-content">
                        <span class="gov-stat-value" id="govDisbursement">0%</span>
                        <span class="gov-stat-label">@Localizer["Disbursement"]</span>
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary btn-sm w-100" id="viewGovReportBtn">
                        <i class="fas fa-file-alt me-1"></i>@Localizer["View Full Report"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Average Performance Cards -->
<div id="print-section-performance" class="row g-4 mb-4 print-section">
    <div class="col-md-6">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-tachometer-alt me-2"></i>
                @Localizer["Average Indicators Performance"]
            </div>
            <div class="performance-gauge-container">
                <div class="performance-gauge">
                    <div class="gauge-circle @GetPerformanceClass(Model.AverageIndicatorsPerformance)">
                        <span class="gauge-value">@Model.AverageIndicatorsPerformance%</span>
                    </div>
                    <div class="gauge-label">@Localizer["Overall Performance"]</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-money-bill-wave me-2"></i>
                @Localizer["Average Disbursement Performance"]
            </div>
            <div class="performance-gauge-container">
                <div class="performance-gauge">
                    <div class="gauge-circle @GetPerformanceClass(Model.AverageDisbursementPerformance)">
                        <span class="gauge-value">@Model.AverageDisbursementPerformance%</span>
                    </div>
                    <div class="gauge-label">@Localizer["Disbursement Rate"]</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div id="print-section-charts" class="row g-4 mb-4 print-section">
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-chart-bar me-2"></i>
                @Localizer["Framework Performance Comparison"]
            </div>
            <div class="chart-container">
                <canvas id="frameworkPerformanceChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-chart-pie me-2"></i>
                @Localizer["Performance Distribution"]
            </div>
            <div class="chart-container">
                <canvas id="performanceDistributionChart"></canvas>
            </div>
            <div class="distribution-legend mt-3">
                <div class="legend-item">
                    <span class="legend-color high"></span>
                    <span>@Localizer["High"] (>=75%): @Model.HighPerformanceCount</span>
                </div>
                <div class="legend-item">
                    <span class="legend-color medium"></span>
                    <span>@Localizer["Medium"] (50-74%): @Model.MediumPerformanceCount</span>
                </div>
                <div class="legend-item">
                    <span class="legend-color low"></span>
                    <span>@Localizer["Low"] (<50%): @Model.LowPerformanceCount</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NEW: Radar Chart - Multi-dimensional Framework Comparison & Project Analysis -->
<div id="print-section-radar" class="row g-4 mb-4 print-section">
    <div class="col-lg-6">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-spider me-2"></i>
                @Localizer["Framework Performance Radar"]
            </div>
            <div class="chart-container">
                <canvas id="radarChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-chart-area me-2"></i>
                @Localizer["Polar Performance View"]
            </div>
            <div class="chart-container">
                <canvas id="polarChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- NEW: Sector & Ministry Analysis -->
<div id="print-section-sector-ministry" class="row g-4 mb-4 print-section">
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-industry me-2"></i>
                @Localizer["Projects by Sector"]
            </div>
            <div class="chart-container">
                <canvas id="sectorChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-building me-2"></i>
                @Localizer["Ministry Performance Overview"]
            </div>
            <div class="chart-container">
                <canvas id="ministryChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- NEW: Budget & Progress Analysis -->
<div id="print-section-budget-prog" class="row g-4 mb-4 print-section">
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-chart-scatter me-2"></i>
                @Localizer["Financial vs Physical Progress"]
            </div>
            <div class="chart-container">
                <canvas id="scatterChart"></canvas>
            </div>
            <p class="text-muted text-center mt-2 small">
                @Localizer["X-Axis: Financial Progress %, Y-Axis: Physical Progress % (Bubble Size = Budget)"]
            </p>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-wallet me-2"></i>
                @Localizer["Budget Overview"]
            </div>
            <div class="d-flex flex-column gap-4 justify-content-center h-100 py-3">
                <div class="summary-card projects mb-0"> <!-- Reusing style -->
                    <div class="summary-icon bg-primary text-white">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-value" style="font-size: 1.5rem;">$@Model.BudgetOverview.TotalEstimatedBudget.ToString("N0")</div>
                        <div class="summary-label">@Localizer["Total Estimated Budget"]</div>
                    </div>
                </div>
                <div class="summary-card frameworks mb-0"> <!-- Reusing style -->
                    <div class="summary-icon bg-success text-white">
                        <i class="fas fa-hand-holding-usd"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-value" style="font-size: 1.5rem;">$@Model.BudgetOverview.TotalRealBudget.ToString("N0")</div>
                        <div class="summary-label">@Localizer["Total Real Budget"]</div>
                    </div>
                </div>
                 <div class="summary-card outcomes mb-0"> <!-- Reusing style -->
                     <div class="summary-icon bg-warning text-white">
                        <i class="fas fa-percentage"></i>
                    </div>
                    <div class="summary-content">
                         @{
                             var utilization = Model.BudgetOverview.TotalEstimatedBudget > 0 
                                 ? (Model.BudgetOverview.TotalRealBudget / Model.BudgetOverview.TotalEstimatedBudget * 100) 
                                 : 0;
                         }
                        <div class="summary-value" style="font-size: 1.5rem;">@Math.Round(utilization, 1)%</div>
                        <div class="summary-label">@Localizer["Budget Utilization"]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NEW: Hierarchy Structure Overview -->
<div id="print-section-hierarchy" class="row g-4 mb-4 print-section">
    <div class="col-lg-5">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-layer-group me-2"></i>
                @Localizer["Hierarchy Levels Overview"]
            </div>
            <div class="chart-container">
                <canvas id="hierarchyChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-stream me-2"></i>
                @Localizer["Performance by Level"]
            </div>
            <div class="performance-levels-container">
                <div class="performance-level-row">
                    <div class="level-info">
                        <i class="fas fa-sitemap text-primary"></i>
                        <span class="level-name">@Localizer["Frameworks"]</span>
                        <span class="level-count">@Model.TotalFrameworks</span>
                    </div>
                    <div class="level-progress-container">
                        <div class="level-progress" data-value="@Model.AverageIndicatorsPerformance" style="--progress-color: #2196F3;">
                            <div class="level-progress-bar"></div>
                        </div>
                        <span class="level-percentage">@Model.AverageIndicatorsPerformance%</span>
                    </div>
                </div>
                <div class="performance-level-row">
                    <div class="level-info">
                        <i class="fas fa-bullseye text-success"></i>
                        <span class="level-name">@Localizer["Outcomes"]</span>
                        <span class="level-count">@Model.TotalOutcomes</span>
                    </div>
                    <div class="level-progress-container">
                        @{
                            var avgOutcomePerf = Model.TopOutcomes.Any() ? Model.TopOutcomes.Average(o => o.IndicatorsPerformance) : 0;
                        }
                        <div class="level-progress" data-value="@avgOutcomePerf" style="--progress-color: #4CAF50;">
                            <div class="level-progress-bar"></div>
                        </div>
                        <span class="level-percentage">@Math.Round(avgOutcomePerf, 1)%</span>
                    </div>
                </div>
                <div class="performance-level-row">
                    <div class="level-info">
                        <i class="fas fa-cube text-warning"></i>
                        <span class="level-name">@Localizer["Outputs"]</span>
                        <span class="level-count">@Model.TotalOutputs</span>
                    </div>
                    <div class="level-progress-container">
                        @{
                            var avgOutputPerf = Model.TopOutputs.Any() ? Model.TopOutputs.Average(o => o.IndicatorsPerformance) : 0;
                        }
                        <div class="level-progress" data-value="@avgOutputPerf" style="--progress-color: #FF9800;">
                            <div class="level-progress-bar"></div>
                        </div>
                        <span class="level-percentage">@Math.Round(avgOutputPerf, 1)%</span>
                    </div>
                </div>
                <div class="performance-level-row">
                    <div class="level-info">
                        <i class="fas fa-cubes text-purple"></i>
                        <span class="level-name">@Localizer["SubOutputs"]</span>
                        <span class="level-count">@Model.TotalSubOutputs</span>
                    </div>
                    <div class="level-progress-container">
                        @{
                            var avgSubOutputPerf = Model.TopSubOutputs.Any() ? Model.TopSubOutputs.Average(o => o.IndicatorsPerformance) : 0;
                        }
                        <div class="level-progress" data-value="@avgSubOutputPerf" style="--progress-color: #9C27B0;">
                            <div class="level-progress-bar"></div>
                        </div>
                        <span class="level-percentage">@Math.Round(avgSubOutputPerf, 1)%</span>
                    </div>
                </div>
                <div class="performance-level-row">
                    <div class="level-info">
                        <i class="fas fa-chart-line text-pink"></i>
                        <span class="level-name">@Localizer["Indicators"]</span>
                        <span class="level-count">@Model.TotalIndicators</span>
                    </div>
                    <div class="level-progress-container">
                        @{
                            var avgIndicatorPerf = Model.TopIndicators.Any() ? Model.TopIndicators.Average(o => o.IndicatorsPerformance) : 0;
                        }
                        <div class="level-progress" data-value="@avgIndicatorPerf" style="--progress-color: #E91E63;">
                            <div class="level-progress-bar"></div>
                        </div>
                        <span class="level-percentage">@Math.Round(avgIndicatorPerf, 1)%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NEW: Dual Performance Comparison Chart -->
<div id="print-section-dual" class="row g-4 mb-4 print-section">
    <div class="col-12">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-balance-scale me-2"></i>
                @Localizer["Indicators vs Disbursement Performance Comparison"]
            </div>
            <div class="chart-container" style="height: 400px;">
                <canvas id="dualComparisonChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- NEW: Performance Trend Visualization (Simulated) -->
<div id="print-section-trend" class="row g-4 mb-4 print-section">
    <div class="col-lg-6">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-wave-square me-2"></i>
                @Localizer["Performance Gap Analysis"]
            </div>
            <div class="chart-container">
                <canvas id="gapAnalysisChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="chart-card">
            <div class="chart-title">
                <i class="fas fa-th-large me-2"></i>
                @Localizer["Performance Heatmap"]
            </div>
            <div class="heatmap-container">
                @foreach (var framework in Model.FrameworkPerformanceData.Take(5))
                {
                    <div class="heatmap-row">
                        <span class="heatmap-label" title="@framework.Name">@(framework.Name.Length > 20 ? framework.Name.Substring(0, 17) + "..." : framework.Name)</span>
                        <div class="heatmap-cells">
                            <div class="heatmap-cell" style="background-color: @GetHeatmapColor(framework.IndicatorsPerformance);" title="@Localizer["Indicators"]: @framework.IndicatorsPerformance%">
                                <span class="cell-value">@Math.Round(framework.IndicatorsPerformance)%</span>
                            </div>
                            <div class="heatmap-cell" style="background-color: @GetHeatmapColor(framework.DisbursementPerformance);" title="@Localizer["Disbursement"]: @framework.DisbursementPerformance%">
                                <span class="cell-value">@Math.Round(framework.DisbursementPerformance)%</span>
                            </div>
                        </div>
                    </div>
                }
                <div class="heatmap-legend">
                    <span class="legend-label">@Localizer["Low"]</span>
                    <div class="legend-gradient"></div>
                    <span class="legend-label">@Localizer["High"]</span>
                </div>
                <div class="heatmap-axis">
                    <span>@Localizer["Indicators"]</span>
                    <span>@Localizer["Disbursement"]</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NEW: Category Reports Section -->
<div id="print-section-categories" class="chart-card mb-4 print-section">
    <div class="chart-title d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <i class="fas fa-layer-group me-2 text-info"></i>
            @Localizer["Reports by Category"]
        </div>
        <div class="btn-group no-print" role="group">
            <button type="button" class="btn btn-sm btn-outline-info active" data-target="ministryReport">@Localizer["Ministries"]</button>
            <button type="button" class="btn btn-sm btn-outline-info" data-target="sectorReport">@Localizer["Sectors"]</button>
            <button type="button" class="btn btn-sm btn-outline-info" data-target="donorReport">@Localizer["Donors"]</button>
            <button type="button" class="btn btn-sm btn-outline-info" data-target="supervisorReport">@Localizer["Supervisors"]</button>
            <button type="button" class="btn btn-sm btn-outline-info" data-target="pmReport">@Localizer["Project Managers"]</button>
            <button type="button" class="btn btn-sm btn-outline-info" data-target="governorateReport">@Localizer["Governorates"]</button>
        </div>
    </div>

    <!-- Ministry Report -->
    <div id="ministryReport" class="category-report-table" data-title="@Localizer["Ministry Report"]">
        <h5 class="print-section-title print-only">@Localizer["Ministry Report"]</h5>
        <div class="row mb-3">
            <div class="col-md-8">
                <canvas id="ministryProjectsChart" style="max-height: 300px;"></canvas>
            </div>
            <div class="col-md-4">
                <div class="category-summary-card">
                    <div class="category-stat">
                        <span class="stat-value">@Model.TotalMinistries</span>
                        <span class="stat-label">@Localizer["Total Ministries"]</span>
                    </div>
                    <div class="category-stat">
                        <span class="stat-value">@Model.MinistryReports.Sum(m => m.ProjectCount)</span>
                        <span class="stat-label">@Localizer["Projects with Ministry"]</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Localizer["Ministry"]</th>
                        <th>@Localizer["Projects"]</th>
