                    // Store selected governorate for filtering
                    window.selectedGovernorate = govNameEn;

                    // Scroll to category reports and filter by governorate
                    const categorySection = document.getElementById('print-section-categories');
                    if (categorySection) {
                        // Activate governorate tab
                        const govBtn = document.querySelector('[data-target="governorateReport"]');
