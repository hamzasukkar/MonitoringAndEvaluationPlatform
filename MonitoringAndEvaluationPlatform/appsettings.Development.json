{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Logged the username and full role set on EVERY authorization check.
      "MonitoringAndEvaluationPlatform.Infrastructure.PermissionAuthorizationHandler": "Warning"
    }
  },

  // Demo account seeding. Development only - Program.cs additionally requires
  // IsDevelopment(), so setting this in a production config has no effect.
  //
  // Passwords are NOT stored here. Set them in user-secrets, e.g.:
  //   dotnet user-secrets set "Seeding:AdminPassword"     "<password>"
  //   dotnet user-secrets set "Seeding:MinistryPassword"  "<password>"
  //   dotnet user-secrets set "Seeding:DataEntryPassword" "<password>"
  //   dotnet user-secrets set "Seeding:ReaderPassword"    "<password>"
  // Any account whose password is not configured is skipped with a warning.
  "Seeding": {
    "EnableDemoUsers": false
  }
}
